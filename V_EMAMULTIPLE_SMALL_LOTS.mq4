//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int OnInit()
  {
   Print(">>> [EA ONINIT] Fresh Start Initializing | Resetting all runtime variables & cleaning chart objects...");
   PrintFormat(">>> [DAY START CONFIG] Account=%d | Session Mode=%s | Config=%s | Reset Hours=%s",
               AccountNumber(), GetDayStartSessionModeName(),
               (InpDayStartSessionMode == DAY_START_AUTO ? "AUTO (Account-Based in Code)" : "MANUAL OVERRIDE"),
               GetDayStartSessionShortTag());
   ResetAllRuntimeVariablesOnFreshStart();
   CheckForNewDay();
// Check minimum opening balance condition (.00)
   if(!IsConnected() || AccountBalance() <= 0.0)
     {
      Print(">>> [EA ONINIT] Notice: Terminal connecting or disconnected (AccountBalance=$0.00). Balance validation deferred until connected.");
     }
   else
      if(AccountBalance() < MinimumOpeningBalanceUSD)
        {
         Print("INIT FAILED: Account Balance ($", DoubleToString(AccountBalance(), 2),
               ") is below minimum required opening balance ($", DoubleToString(MinimumOpeningBalanceUSD, 2), ").");
         LogEAError(0, "OnInit", -1,
                    StringFormat("INIT_FAILED: Account Balance ($%.2f) < MinimumOpeningBalanceUSD ($%.2f)",
                                 AccountBalance(), MinimumOpeningBalanceUSD));
         Alert("EA Init Failed: Account Balance ($" + DoubleToString(AccountBalance(), 2) +
               ") is below minimum $" + DoubleToString(MinimumOpeningBalanceUSD, 2) + " requirement!");
         return INIT_FAILED;
        }

   partialLossMultipler= 5;
   if(AccountBalance() >= 1000)
      partialLossMultipler = 20;
   else
      if(AccountBalance() >= 500)
         partialLossMultipler = 10;
      else
         if(AccountBalance() >= 200)
            partialLossMultipler = 5;




// 1ST TIME: OnInit method (Calculate balance multiplier on startup)
   double initEquity = (AccountEquity() > 0.0) ? AccountEquity() : AccountBalance();
   int lotMultiplierDiv = (AccountMultiplierLOT > 0) ? AccountMultiplierLOT : 1001;
   balancelomultipler = (int)MathRound(initEquity / (double)lotMultiplierDiv);

   if(balancelomultipler<=0)
      balancelomultipler=1;

// FlipLadderStepUSD remains base step; scaled dynamically in ladder routines
   SecurebaselinePercentage = (100.0 - (StopLossUSD * 5.0)) / 100.0;//

   EquityResetReEntryPending=false;


   EmaFlipTime = TimeCurrent();

   for(int initIndex = OrdersTotal() - 1; initIndex >= 0; initIndex--)
     {
      if(!OrderSelect(initIndex, SELECT_BY_POS, MODE_TRADES))
         continue;
      int initOrderType = OrderType();
      if(initOrderType == OP_BUYSTOP || initOrderType == OP_SELLSTOP || initOrderType == OP_BUYLIMIT || initOrderType == OP_SELLLIMIT)
         OrderDelete(OrderTicket(), clrNONE);
     }
   double ema = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, 0);
   if(ema > 0)
     {
      if(Close[0] > ema)
         LastTrackedEmaDirection = 1;
      else
         if(Close[0] < ema)
            LastTrackedEmaDirection = -1;
     }
   HasEmaFlippedSinceLoad = false;
// EmaFlipTime = 0;
   EmaFlipTime = TimeCurrent();
   if(g_emaFlipPrice <= 0.0)
      g_emaFlipPrice = GetEmaFlipPrice();

   LastTrackedSSLDirection = GetCurrentSSLDirection();
   if(LastTrackedSSLDirection != 0)
      LiveSSLInitialized = true;

   InitializePreviousEmaCycleValues();
   FLIPBasketSupportOpenedThisCycle = HasOpenFLIPBasketSupportOrder(-1);
   InitializeFLIPBasketSupportTracking();

   DrawHistoricalBouncebacks();

   OriginalLadder1ProfitUSD = Ladder1ProfitUSD;
   Ladder1StopMaxPriceUSD = Ladder1ProfitUSD*1.2;
   DefaultOrderProfitUSD = Ladder1ProfitUSD*2;
// RecoveryTriggerLossUSD = StopLossUSD/3;

   OriginalLots = Lots;
   OriginalLadder1ProfitUSD = Ladder1ProfitUSD;
   OriginalLadder2ProfitUSD = Ladder2ProfitUSD;
   OriginalLadder1StopMaxPriceUSD = Ladder1StopMaxPriceUSD;
   RecoveryTriggerLossUSD = MathAbs(RecoveryTriggerLossUSD);
   OriginalStopLossUSD = StopLossUSD;

   DeleteOurObjects();
   g_eqDdLastIconTier          = 0;
   g_eqDdCycleHighestTier      = 0;
   g_eqDdLastLoggedTier        = 0;
   g_eqDdBuyCurrentTier        = 0;
   g_eqDdBuyCycleHighestTier   = 0;
   g_eqDdBuyLastLoggedTier     = 0;
   g_eqDdBuyLastIconTier       = 0;
   g_eqDdBuyLastReachReason    = "";
   g_eqDdSellCurrentTier       = 0;
   g_eqDdSellCycleHighestTier  = 0;
   g_eqDdSellLastLoggedTier    = 0;
   g_eqDdSellLastIconTier      = 0;
   g_eqDdSellLastReachReason   = "";
   g_eqDdForceCloseBudget      = false;
   g_eqDdDayKey                = -1;
   g_eqDdPriorDayCuts          = 0;
   g_eqDdPriorDayPeakPct       = 0.0;
   g_eqDdPriorDayLotsCut       = 0.0;
   g_dubaiNightCloseDayKey       = -1;
   g_dubaiDayOpeningEquity       = 0.0;
   g_dubaiNightLastCutTime       = 0;
   g_dubaiNightCutCountToday     = 0;
   g_dubaiNightCloseDoneToday    = false;
   g_dubaiNightCloseRetryPending = false;
   g_dubaiNightLastCloseTag      = "";
   g_dubaiNightLastCloseOrders   = 0;
   g_dubaiNightLastCloseLots     = 0.0;
   g_dubaiNightLastClosePL       = 0.0;
   g_dubaiNightLastCutZeroSide   = "";
   g_dubaiNightLastCutOrders     = 0;
   g_dubaiNightLastCutLots       = 0.0;
   g_dubaiNightLastCutPL         = 0.0;
   g_dubaiNightLastCutSkippedMin = 0;
   g_hourlySideLossLastSlot      = -1;
   g_hourlySideLossNextRunTime   = 0;
   g_hourlyPlanADoneToday        = false;
   g_hourlyPlanAHitsToday        = 0;
   g_hourlyPlanALastHitEquity    = 0.0;
   g_hourlyPlanAHighestHitPct    = 0.0;
   g_hourlyPlanCLastSlot         = -1;
   g_hourlyPlanCNextRunTime      = 0;
   g_hourlyPlanCDoneToday        = false;
   g_hourlyPlanCHitsToday        = 0;
   g_hourlyPlanCLastHitEquity    = 0.0;
   g_hourlyPlanCHighestHitPct    = 0.0;
   g_hourlyPlanDLastSlot         = -1;
