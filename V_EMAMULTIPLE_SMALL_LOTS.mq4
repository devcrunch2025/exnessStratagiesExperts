//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void TrackEmaFlip()
  {
   double ema = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, 0);
   if(ema <= 0)
      return;

   int currentDirection = 0;
   if(Close[0] > ema)
      currentDirection = 1;
   else
      if(Close[0] < ema)
         currentDirection = -1;

// Check if the EMA direction has changed
   if(LastTrackedEmaDirection != 0 && currentDirection != 0 && currentDirection != LastTrackedEmaDirection)
     {
      HasEmaFlippedSinceLoad = true;
      ResetEmaFlipCutTickets();

      // Store previous EMA cycle highest values and 4X Peak + 100 buffer before updating EmaFlipTime
      int prevDir = LastTrackedEmaDirection;
      double peakDist = g_currentEmaHighestDistance;
      double peak4X   = g_currentEma4XBuffer;
      double peakPrc  = g_currentEmaPeakPrice;

      if(peakDist <= 0.0)
        {
         peakDist = (prevDir == 1) ? GetHighestEmaDistanceSinceEmaFlip() : GetLowestEmaDistanceSinceEmaFlip();
         peakPrc  = (prevDir == 1) ? GetHighestPriceSinceEmaFlip() : GetLowestPriceSinceEmaFlip();
        }

      if(peakDist <= 0.0)
        {
         int pDir = 0;
         double pPrice = 0.0;
         datetime pFlip = 0;
         peakDist = CalculatePreviousEmaCycleHighestDistance(pDir, pPrice, pFlip);
         if(pPrice > 0.0)
            peakPrc = pPrice;
        }

      double mult = (InpEmaFlipWideBreathingMultiplier > 0.0) ? InpEmaFlipWideBreathingMultiplier : 4.0;
      double extraSafe = (InpEmaFlipWideBreathingSafeExtraRaw > 0.0) ? InpEmaFlipWideBreathingSafeExtraRaw : 100.0;
      double minFloor = (InpEmaFlipWideBreathingMinFloorRaw > 0.0) ? InpEmaFlipWideBreathingMinFloorRaw : 1000.0;
      if(peak4X <= 0.0)
         peak4X = MathMax(minFloor, (peakDist * mult) + extraSafe);

      g_prevEmaHighestDistance = peakDist;
      g_prevEmaPeakPrice       = peakPrc;
      g_prevEmaDirection       = prevDir;
      g_prevEmaFlipTime        = EmaFlipTime;
      g_prevEma4XBuffer        = peak4X;

      // Reset current tracking for the new trend
      g_currentEmaHighestDistance = 0.0;
      g_currentEma4XBuffer        = 0.0;
      g_currentEmaPeakPrice       = 0.0;

      Print(">>> [EMA FLIP STORED PREV CYCLE] PrevDir=", (prevDir == 1 ? "BULLISH(+1)" : "BEARISH(-1)"),
            " | PrevHighestDist=$", DoubleToString(g_prevEmaHighestDistance, 2),
            " | PrevPeakPrice=", DoubleToString(g_prevEmaPeakPrice, Digits),
            " | Prev4XBuffer=$", DoubleToString(g_prevEma4XBuffer, 2),
            " | PrevFlipTime=", TimeToString(g_prevEmaFlipTime));

      if(InpEnableEmaFlipWideBreathingSL)
        {
         ApplyEmaFlipWideBreathingProtection(LastTrackedEmaDirection, currentDirection);
        }
      EmaFlipTime = TimeCurrent();
      g_emaFlipCandleTime = Time[0];
      g_emaFlipDirection  = currentDirection;
      g_emaFlipPrice = (currentDirection == 1 ? Ask : Bid);

      TradingHaltedUntilNextFlip = false;
      LadderHaltStartTime = 0; // Clear timer on flip
      if(ResumeDayTradingOnEmaDirectionChange)
        {
         if(g_dailyEquityTradingBlocked || DayProfitLadderTradingStopped)
           {
            ResumeDailyEquityTradingOnEmaChange(prevDir, currentDirection);
           }
        }
      ActiveEquityBaseline = AccountBalance() * SecurebaselinePercentage; // Updated to 10% less than current equity on flip
      HighestCycleProfitUSD = 0.0;
      HighestLadderLevelThisCycle = 0;

      // Reset Ended Horizontal Line Tracking on EMA flip
      g_endedEqHighPrice                  = 0.0;
      g_endedEqHighStart                  = 0;
      g_endedEqHighTime                   = 0;
      g_endedEqLowPrice                   = 0.0;
      g_endedEqLowStart                   = 0;
      g_endedEqLowTime                    = 0;
      g_lastHLineEndedTime                = 0;
      g_lastHLineEndedType                = "";
      g_lastHLineEndedPrice               = 0.0;
      g_lastHLineEndedLineStart           = 0;

      // Reset Sweep state on EMA flip
      g_forceSweepRecalc                  = true;
      g_rememberedSweepSignal             = "None";
      g_rememberedSweepBarTime            = 0;
      g_isSweepSignalConfirmed            = false;
      g_sweepSignalActiveInCurrentEmaFlip = false;
      g_sweepSignalTypeInCurrentEmaFlip   = "None";
      g_sweepSignalDetectedTimeInFlip     = 0;
      ManageSweepGlobalVariables("None");
      if(InpResetSweepOppositeBlockOnEmaFlip && g_sweepOppositeBlockSignal != "None")
         ResetSweepOppositeBlockState(StringFormat("%s block cleared: EMA flipped (%d -> %d)", g_sweepOppositeBlockSignal, prevDir, currentDirection));

      // Close previous FLIPBasketSupport orders immediately on flip change
      CloseFLIPBasketSupportOrders();
      CheckAndCloseOrphanFLIPBasketSupportOrders();

      // Reset support order creation flag for this flip cycle
      FLIPBasketSupportOpenedThisCycle = false;
      g_flipBasketSupportCreatedInCycle = 0;
      g_weakStateCountPerEmaFlip = 0;

      // MIX V1020 + V1021: Create FLIP Basket Support order on EMA flip when gap > MinEmaDistance (Strategy 1)
      if(InpEnableV1020EmaTrendSupport)
        {
         int targetSupportType = (currentDirection == 1) ? OP_BUY : OP_SELL;
         if(!HasOpenFLIPBasketSupportOrder(targetSupportType))
           {
            int oType = (currentDirection == 1) ? OP_BUY : OP_SELL;
            double emaDist = GetDistanceToEMAPrice(oType, true);
            if(emaDist > FLIPBasketSupportMinEmaDistance)
              {
               int flpTkt = CreateFLIPBasketSupportOrder(currentDirection, false, false, "_EMA");
               if(flpTkt > 0)
                 {
                  FLIPBasketSupportOpenedThisCycle = true;
                  Print(">>> [MIX V1020 Strategy 1: EMA Trend] Order created at flip: Ticket #", flpTkt,
                        " Direction=", (currentDirection == 1 ? "BUY" : "SELL"),
                        " EmaDistance=", DoubleToString(emaDist, 2));
                 }
              }
            else
              {
               Print("FLIPBasketSupport (MIX V1020 Strategy 1) deferred at flip: EMAdistance gap = ", DoubleToString(emaDist, 2),
                     " <= ", DoubleToString(FLIPBasketSupportMinEmaDistance, 2), " (Waiting for gap > ", DoubleToString(FLIPBasketSupportMinEmaDistance, 2), ")");
              }
           }
        }


      // CloseOppositeLosingOrdersBeforeSignal(currentDirection); // Close any losing orders from the previous trend

      // HighestCycleProfitUSD = 0.0;        // Add this
      // HighestLadderLevelThisCycle = 0; // <-- NEW: Reset the box trigger
      // Print("EMA FLIP DETECTED: Trend changed. Evaluating open orders for closure.");

      /*
       for(int i = OrdersTotal() - 1; i >= 0; i--)
         {
          if(OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
            {
             // Only process orders matching this EA's Symbol and Magic Number
             if(OrderSymbol() == Symbol() && OrderMagicNumber() == MagicNumber)
               {
                int type = OrderType();
      double distanceUSD = GetDistanceToEmaUSD(type, 0.01);

                // Check Market Orders (Buy/Sell)
                if(type == OP_BUY || type == OP_SELL)
                  {
                   // Calculate total P/L including swap and commission
                   double orderPL = OrderProfit() + OrderSwap() + OrderCommission();

                   // Calculate threshold: -$1 per 0.01 lot step
                   double lossThreshold = -1.0 * (OrderLots() / 0.01);

                   if(orderPL < lossThreshold || orderPL<-1.0)
                     {
                      if(type == OP_BUY && (GlobalEmaAngle30<-1  ))
                         SafeOrderClose(OrderTicket(), OrderLots(), type, Slippage, clrRed);
                      else
                         if(type == OP_SELL && (GlobalEmaAngle30>1  ))
                            SafeOrderClose(OrderTicket(), OrderLots(), type, Slippage, clrBlue);
                     }
                  }

                // Always Delete Pending Orders on Flip
                else
                   if(type == OP_BUYSTOP || type == OP_SELLSTOP || type == OP_BUYLIMIT || type == OP_SELLLIMIT)
                     {
                      SafeOrderDelete(OrderTicket(), clrYellow);
                     }
               }
            }
         }*/
     }

   if(LastTrackedEmaDirection == 0 && currentDirection != 0)
     {
      if(EmaFlipTime == 0)
         EmaFlipTime = GetActualEmaFlipTime(currentDirection);
      if(g_emaFlipPrice <= 0.0)
         g_emaFlipPrice = GetEmaFlipPrice();
     }

// Safety enforcement: If price changes flip direction, ensure any opposite regular FLIPBasketSupport order is closed (exclude LSD)
   if(currentDirection == 1 && HasOpenFLIPBasketSupportOrder(OP_SELL, true))
     {
      CloseFLIPBasketSupportOrders(OP_SELL, false);
     }
   else
      if(currentDirection == -1 && HasOpenFLIPBasketSupportOrder(OP_BUY, true))
        {
         CloseFLIPBasketSupportOrders(OP_BUY, false);
        }

// MIX V1020 + V1021: Deferred check during cycle when EMAdistance gap > MinEmaDistance (Strategy 1)
   if(InpEnableV1020EmaTrendSupport && currentDirection != 0 && !FLIPBasketSupportOpenedThisCycle)
     {
      int targetSupportType = (currentDirection == 1) ? OP_BUY : OP_SELL;
      if(!HasOpenFLIPBasketSupportOrder(targetSupportType))
        {
         int oType = (currentDirection == 1) ? OP_BUY : OP_SELL;
         double emaDist = GetDistanceToEMAPrice(oType, true);
         if(emaDist > FLIPBasketSupportMinEmaDistance)
           {
            int flpTkt = CreateFLIPBasketSupportOrder(currentDirection, false, false, "_EMA");
            if(flpTkt > 0)
              {
               FLIPBasketSupportOpenedThisCycle = true;
               Print(">>> [MIX V1020 Strategy 1: EMA Trend] Order created during cycle on EMAdistance gap > ", DoubleToString(FLIPBasketSupportMinEmaDistance, 2),
                     ": Ticket #", flpTkt, " EmaDistance=", DoubleToString(emaDist, 2), " Direction=", (currentDirection == 1 ? "BUY" : "SELL"));
              }
           }
        }
     }

   LastTrackedEmaDirection = currentDirection;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double GetDistanceToEMAPrice(int orderType = OP_BUY, bool absoluteValue = true)
  {
   double ema = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, 0);
   if(ema <= 0.0)
      return 0.0;
   RefreshRates();
   double currentPrice = (orderType == OP_BUY) ? Ask : Bid;
   double distance = currentPrice - ema;
   if(absoluteValue)
      return NormalizeDouble(MathAbs(distance), Digits);
   return NormalizeDouble(distance, Digits);
  }

//+------------------------------------------------------------------+
//| Calculate Distance from Live Price to EMA in USD ($)             |
//+------------------------------------------------------------------+
double GetDistanceToEmaUSD(int orderType, double currentLots)
  {
   double ema = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, 0);
   if(ema <= 0.0 || currentLots <= 0.0)
      return 0.0;

   RefreshRates();
   double currentPrice = (orderType == OP_BUY) ? Ask : Bid;
   double priceDistance = MathAbs(currentPrice - ema); // Raw gap in price

   double tickValue = MarketInfo(Symbol(), MODE_TICKVALUE); // Value of 1 tick in account currency
   double tickSize  = MarketInfo(Symbol(), MODE_TICKSIZE);  // Size of 1 tick (e.g., 0.00001 or 0.01)

   if(tickSize <= 0.0 || tickValue <= 0.0)
      return 0.0;

// Convert price distance to ticks, then calculate USD value based on lot size
   double distanceInTicks = priceDistance / tickSize;
   double distanceInUSD = distanceInTicks * tickValue * currentLots;

   return NormalizeDouble(distanceInUSD, 2);
  }

