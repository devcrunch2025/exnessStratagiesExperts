//+------------------------------------------------------------------+
//| Check if an order is a Horizontal Line order (EQH/EQL)          |
//+------------------------------------------------------------------+
bool IsHorizontalLineOrder(int ticket, string comment = "")
  {
   if(ticket <= 0)
      return false;
   if((g_lastEqhSellOrderTicket > 0 && ticket == g_lastEqhSellOrderTicket) ||
      (g_lastEqlBuyOrderTicket > 0 && ticket == g_lastEqlBuyOrderTicket))
      return true;

   string curComment = comment;
   if(curComment == "" || IsPartialCloseOrderComment(curComment))
     {
      curComment = GetEffectiveOrderComment(ticket, curComment);
      if(curComment == "")
        {
         if(OrderTicket() == ticket)
            curComment = OrderComment();
         else
            if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
               curComment = OrderComment();
            else
               if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_HISTORY))
                  curComment = OrderComment();
        }
     }

   if(StringFind(curComment, "EQH") >= 0 || StringFind(curComment, "EQL") >= 0)
      return true;

   int rootTicket = ResolveRootTicketFromPartialChain(ticket, comment);
   if(rootTicket > 0 &&
      ((g_lastEqhSellOrderTicket > 0 && rootTicket == g_lastEqhSellOrderTicket) ||
       (g_lastEqlBuyOrderTicket > 0 && rootTicket == g_lastEqlBuyOrderTicket)))
      return true;

   return false;
  }

//+------------------------------------------------------------------+
//| ResumeDailyEquityTradingManual                                   |
//| Unpauses trading when Day Equity stop or adverse loss is paused, |
//| re-baselining equity and refreshing all dashboard components.    |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| CreateTradingResumeChartIcon                                     |
//| Displays an icon and label on the chart to indicate that trading |
//| has resumed (either via EMA direction change or manual click).   |
//+------------------------------------------------------------------+
void CreateTradingResumeChartIcon(string reason, double curEq)
  {
   datetime barTime = Time[0];
   double markerPrice = Bid;
   double atr = iATR(Symbol(), Period(), 14, 0);
   if(atr <= 0.0)
      atr = 50.0 * Point;

   static int resumeIconSeq = 0;
   resumeIconSeq++;
   string baseName = PREFIX + "RESUME_" + IntegerToString(TimeCurrent()) + "_" + IntegerToString(resumeIconSeq);
   string txtName  = baseName + "_TXT";

   color iconColor = clrLime;
   int   iconCode  = (InpTradingResumeIconCode > 0) ? InpTradingResumeIconCode : 241;

// 1. Solid Marker Icon on candle
   ObjectCreate(0, baseName, OBJ_ARROW, 0, barTime, markerPrice);
   ObjectSetInteger(0, baseName, OBJPROP_ARROWCODE, iconCode);
   ObjectSetInteger(0, baseName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, baseName, OBJPROP_WIDTH, 4);
   ObjectSetInteger(0, baseName, OBJPROP_BACK, false);
   ObjectSetInteger(0, baseName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, baseName, OBJPROP_HIDDEN, false);

   string tooltip = StringFormat("Trading RESUMED [%s] | Base Equity: $%.2f | Time: %s",
                                 reason, curEq, TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES|TIME_SECONDS));
   ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);

// 2. Bold Text Label above the icon
   double labelPrice = markerPrice + (atr * 0.40);
   string shortReason = "RESUME";
   if(StringFind(reason, "SPIKE", 0) >= 0)
      shortReason = "SPIKE";
   else
      if(StringFind(reason, "STRONG TREND", 0) >= 0)
         shortReason = "STRONG TREND";
      else
         if(StringFind(reason, "EMA DIRECTION", 0) >= 0)
            shortReason = "EMA FLIP";
         else
            if(StringFind(reason, "MANUAL", 0) >= 0)
               shortReason = "MANUAL";
   string labelText   = StringFormat("RESUMED (%s)", shortReason);

   ObjectCreate(0, txtName, OBJ_TEXT, 0, barTime, labelPrice);
   ObjectSetString(0, txtName, OBJPROP_TEXT, labelText);
   ObjectSetString(0, txtName, OBJPROP_FONT, "Arial Black");
   ObjectSetInteger(0, txtName, OBJPROP_FONTSIZE, 9);
   ObjectSetInteger(0, txtName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, txtName, OBJPROP_BACK, false);
   ObjectSetInteger(0, txtName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, txtName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);

   ChartRedraw(0);

   PrintFormat(">>> [TRADING RESUME CHART ICON] Placed '%s' on bar %s (Eq=$%.2f)",
               labelText, TimeToString(barTime, TIME_DATE|TIME_MINUTES), curEq);
  }

//+------------------------------------------------------------------+
//| DeleteTradingResumeChartIcon                                     |
//| Removes all trading resume icons and labels from the chart.      |
//+------------------------------------------------------------------+
void DeleteTradingResumeChartIcon()
  {
   int total = ObjectsTotal(0, -1, -1);
   for(int i = total - 1; i >= 0; i--)
     {
      string name = ObjectName(0, i, -1, -1);
      if(StringFind(name, PREFIX + "RESUME_", 0) == 0)
         ObjectDelete(0, name);
     }
  }

//+------------------------------------------------------------------+
//| CreateDeepDrawdownArmedChartIcon                                 |
//| Displays an icon and bold text label on the chart to indicate    |
//| that the V-Shape Equity Recovery Shield is ARMED.                |
//+------------------------------------------------------------------+
void CreateDeepDrawdownArmedChartIcon(double startBal, double lowestEq, double gap, double recTarget)
  {
   datetime barTime = Time[0];
   double atr = iATR(Symbol(), Period(), 14, 0);
   if(atr <= 0.0)
      atr = 50.0 * Point;

   double markerPrice = Low[0] - (atr * 0.25);
   double labelPrice  = markerPrice - (atr * 0.45);

   g_deepDrawdownArmedBarTime = barTime;
   g_deepDrawdownArmedPrice   = markerPrice;

   static int armedIconSeq = 0;
   armedIconSeq++;
   string baseName = PREFIX + "V_ARMED_" + IntegerToString(TimeCurrent()) + "_" + IntegerToString(armedIconSeq);
   string txtName  = baseName + "_TXT";

   color iconColor = clrGold;
   int   iconCode  = 217; // Wingdings 217 = thick up arrow pointing to recovery

// 1. Solid Marker Icon on candle
   ObjectCreate(0, baseName, OBJ_ARROW, 0, barTime, markerPrice);
   ObjectSetInteger(0, baseName, OBJPROP_ARROWCODE, iconCode);
   ObjectSetInteger(0, baseName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, baseName, OBJPROP_WIDTH, 4);
   ObjectSetInteger(0, baseName, OBJPROP_BACK, false);
   ObjectSetInteger(0, baseName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, baseName, OBJPROP_HIDDEN, false);

   int mult = (balancelomultipler > 0) ? balancelomultipler : 1;
   string reqGapTag = (InpDeepDrawdownMinGapPct > 0.0) ? StringFormat(">=%.0f%% Bal", InpDeepDrawdownMinGapPct) : StringFormat(">=$%.0f Gap", InpDeepDrawdownMinGapUSD * mult);
   string tooltip = StringFormat("V-Shape Equity Shield ARMED | PeakBal=$%.2f | LowEq=$%.2f | Gap=-$%.2f (%s) | Bounce Target: $%.2f | Time: %s",
                                 startBal, lowestEq, gap, reqGapTag, recTarget, TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES|TIME_SECONDS));
   ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);

// 2. Bold Text Label below the icon
   string labelText = StringFormat("V-MONITORING STARTED (Gap -$%.0f | Bounce Tgt: $%.0f)", gap, recTarget);

   ObjectCreate(0, txtName, OBJ_TEXT, 0, barTime, labelPrice);
   ObjectSetString(0, txtName, OBJPROP_TEXT, labelText);
   ObjectSetString(0, txtName, OBJPROP_FONT, "Arial Black");
   ObjectSetInteger(0, txtName, OBJPROP_FONTSIZE, 9);
   ObjectSetInteger(0, txtName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, txtName, OBJPROP_BACK, false);
   ObjectSetInteger(0, txtName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, txtName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);

   ChartRedraw(0);

   PrintFormat(">>> [V-MONITORING STARTED CHART ICON] Placed '%s' on bar %s (PeakBal=$%.2f, LowEq=$%.2f, Gap=-$%.2f)",
               labelText, TimeToString(barTime, TIME_DATE|TIME_MINUTES), startBal, lowestEq, gap);
  }

//+------------------------------------------------------------------+
//| CreateDeepDrawdownClampedChartIcon                               |
//| Displays an icon and bold text label on the chart to indicate    |
//| that V-Shape Recovery has triggered and all orders are clamped.   |
//+------------------------------------------------------------------+
void CreateDeepDrawdownClampedChartIcon(double curEq, double recTarget, double emaAngle = 0.0, bool isSteepAngle = false)
  {
   datetime barTime = Time[0];
   double atr = iATR(Symbol(), Period(), 14, 0);
   if(atr <= 0.0)
      atr = 50.0 * Point;

   double markerPrice = High[0] + (atr * 0.25);
   double labelPrice  = markerPrice + (atr * 0.45);

   static int clampedIconSeq = 0;
   clampedIconSeq++;
   string baseName = PREFIX + "V_CLAMPED_" + IntegerToString(TimeCurrent()) + "_" + IntegerToString(clampedIconSeq);
   string txtName  = baseName + "_TXT";

   color iconColor = clrLime;
   int   iconCode  = 241; // Wingdings 241 = play / forward check

// 1. Solid Marker Icon on candle
   ObjectCreate(0, baseName, OBJ_ARROW, 0, barTime, markerPrice);
   ObjectSetInteger(0, baseName, OBJPROP_ARROWCODE, iconCode);
   ObjectSetInteger(0, baseName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, baseName, OBJPROP_WIDTH, 4);
   ObjectSetInteger(0, baseName, OBJPROP_BACK, false);
   ObjectSetInteger(0, baseName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, baseName, OBJPROP_HIDDEN, false);

   string tooltip = "";
   if(isSteepAngle)
      tooltip = StringFormat("V-Shape Recovery TRIGGERED & CLAMPED | Equity=$%.2f >= 90%% Target=$%.2f (EMA Angle=%.1f° > 6.0°) | Live SL Locked | Time: %s",
                             curEq, recTarget, emaAngle, TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES|TIME_SECONDS));
   else
      tooltip = StringFormat("V-Shape Recovery TRIGGERED & CLAMPED | Equity=$%.2f >= Target=$%.2f | Live SL Locked | Time: %s",
                             curEq, recTarget, TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES|TIME_SECONDS));
   ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);

// 2. Bold Text Label above the icon
   string labelText = "";
   if(isSteepAngle)
      labelText = StringFormat("V-CLAMPED (Eq: $%.0f [90%% Tgt | Ang %.1f°] | Live SL Locked)", curEq, emaAngle);
   else
      labelText = StringFormat("V-CLAMPED (Eq: $%.0f | Live SL Locked)", curEq);

   ObjectCreate(0, txtName, OBJ_TEXT, 0, barTime, labelPrice);
   ObjectSetString(0, txtName, OBJPROP_TEXT, labelText);
   ObjectSetString(0, txtName, OBJPROP_FONT, "Arial Black");
   ObjectSetInteger(0, txtName, OBJPROP_FONTSIZE, 9);
   ObjectSetInteger(0, txtName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, txtName, OBJPROP_BACK, false);
   ObjectSetInteger(0, txtName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, txtName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);

   ChartRedraw(0);

   PrintFormat(">>> [V-CLAMPED CHART ICON] Placed '%s' on bar %s (Eq=$%.2f, Target=$%.2f)",
               labelText, TimeToString(barTime, TIME_DATE|TIME_MINUTES), curEq, recTarget);
  }

//+------------------------------------------------------------------+
//| CreateDeepDrawdownEndChartIcon                                   |
//| Displays an icon and bold text label on the chart to indicate    |
//| that V-Shape Recovery has fully ended and capital is saved.       |
//+------------------------------------------------------------------+
void CreateDeepDrawdownEndChartIcon(double finalBal)
  {
   datetime barTime = Time[0];
   double atr = iATR(Symbol(), Period(), 14, 0);
   if(atr <= 0.0)
      atr = 50.0 * Point;

   double markerPrice = High[0] + (atr * 0.35);
   double labelPrice  = markerPrice + (atr * 0.45);

   static int endIconSeq = 0;
   endIconSeq++;
   string baseName = PREFIX + "V_END_" + IntegerToString(TimeCurrent()) + "_" + IntegerToString(endIconSeq);
   string txtName  = baseName + "_TXT";
   string lineName = PREFIX + "V_LINE_" + IntegerToString(TimeCurrent()) + "_" + IntegerToString(endIconSeq);

   color iconColor = clrAqua;
   int   iconCode  = 252; // Wingdings 252 = checkmark

// 1. Solid Marker Icon on candle
   ObjectCreate(0, baseName, OBJ_ARROW, 0, barTime, markerPrice);
   ObjectSetInteger(0, baseName, OBJPROP_ARROWCODE, iconCode);
   ObjectSetInteger(0, baseName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, baseName, OBJPROP_WIDTH, 4);
   ObjectSetInteger(0, baseName, OBJPROP_BACK, false);
   ObjectSetInteger(0, baseName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, baseName, OBJPROP_HIDDEN, false);

   string tooltip = StringFormat("V-Shape Recovery ENDED | Final Balance=$%.2f (Capital Saved!) | Time: %s",
                                 finalBal, TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES|TIME_SECONDS));
   ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);

// 2. Bold Text Label above the icon
   string labelText = StringFormat("V-END (Balance: $%.2f | Capital Protected)", finalBal);

   ObjectCreate(0, txtName, OBJ_TEXT, 0, barTime, labelPrice);
   ObjectSetString(0, txtName, OBJPROP_TEXT, labelText);
   ObjectSetString(0, txtName, OBJPROP_FONT, "Arial Black");
   ObjectSetInteger(0, txtName, OBJPROP_FONTSIZE, 9);
   ObjectSetInteger(0, txtName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, txtName, OBJPROP_BACK, false);
   ObjectSetInteger(0, txtName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, txtName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);

// 3. Connect V-Start to V-End with a trendline showing the complete V-recovery
   if(g_deepDrawdownArmedBarTime > 0 && g_deepDrawdownArmedPrice > 0.0)
     {
      ObjectCreate(0, lineName, OBJ_TREND, 0, g_deepDrawdownArmedBarTime, g_deepDrawdownArmedPrice, barTime, markerPrice);
      ObjectSetInteger(0, lineName, OBJPROP_COLOR, clrGold);
      ObjectSetInteger(0, lineName, OBJPROP_STYLE, STYLE_DASH);
      ObjectSetInteger(0, lineName, OBJPROP_WIDTH, 2);
      ObjectSetInteger(0, lineName, OBJPROP_RAY, false);
      ObjectSetInteger(0, lineName, OBJPROP_BACK, false);
      ObjectSetInteger(0, lineName, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, lineName, OBJPROP_HIDDEN, false);
      ObjectSetString(0, lineName, OBJPROP_TOOLTIP, StringFormat("V-Recovery Path: Start %s -> End %s",
                      TimeToString(g_deepDrawdownArmedBarTime, TIME_DATE|TIME_MINUTES), TimeToString(barTime, TIME_DATE|TIME_MINUTES)));
     }

   ChartRedraw(0);

   PrintFormat(">>> [V-END CHART ICON] Placed '%s' on bar %s (FinalBal=$%.2f)",
               labelText, TimeToString(barTime, TIME_DATE|TIME_MINUTES), finalBal);
  }

//+------------------------------------------------------------------+
//| DeleteDeepDrawdownChartIcons                                     |
//| Removes all V-Equity Armed, Clamped, End and Line objects.       |
//+------------------------------------------------------------------+
void DeleteDeepDrawdownChartIcons()
  {
   int total = ObjectsTotal(0, -1, -1);
   for(int i = total - 1; i >= 0; i--)
     {
      string name = ObjectName(0, i, -1, -1);
      if(StringFind(name, PREFIX + "V_ARMED_", 0) == 0 ||
         StringFind(name, PREFIX + "V_CLAMPED_", 0) == 0 ||
         StringFind(name, PREFIX + "V_END_", 0) == 0 ||
         StringFind(name, PREFIX + "V_LINE_", 0) == 0)
        {
         ObjectDelete(0, name);
        }
     }
  }


//+------------------------------------------------------------------+
//| PerformDayTradingResume                                          |
//| Unpauses trading when Day Equity stop or adverse loss is paused, |
//| re-baselining equity and refreshing all dashboard components.    |
//+------------------------------------------------------------------+
void PerformDayTradingResume(string reason)
  {
   double curBal = AccountBalance();
   double curEq  = (AccountEquity() > 0.0) ? AccountEquity() : curBal;

// Unpause all daily trading pause & halt flags
   g_manualTradingPaused            = false;
   g_dailyEquityTradingBlocked      = false;
   g_dailyEquityAdverseLossHitToday = false;
   DayProfitLadderTradingStopped    = false;
   TradingHaltedUntilNextFlip       = false;
   EnableTrading                    = true;
   g_dailyEquityPauseTime           = 0;
   g_dailyEquityPauseSSLDirection   = 0;
   g_dailyEquityPauseSslFlipped     = false;
   g_deepDrawdownCooldownUntil      = 0;
   g_deepDrawdownLiveSlClamped      = false;
   g_deepDrawdownCycleArmed         = false;
   g_deepDrawdownArmedTarget        = 0.0;

   double stepUSD        = DailyEquityTrailStepUSD * balancelomultipler;
   double safetyFloorUSD = (DailyEquitySafetyFloor > 0.0 ? DailyEquitySafetyFloor : DailyEquityTrailStepUSD) * balancelomultipler;

   if(InpResumeDayTradingTargetMode == RESUME_MODE_TRAIL_STEP)
     {
      // STEP-BY-STEP TRAILING RESUME MODE (User preferred)
      // Directly continue in Phase 2 trailing mode from 1 step!
      g_dailyEquityTargetHitToday      = true;  // Keep Step Trailing Phase 2 active!
      g_dailyEquityIsResumedLeg        = true;
      g_dailyEquityResumedStepHit      = false;
      g_dailyEquityResumeEquity        = curEq;
      g_dailyEquityResumeSafetyFloor   = curEq - safetyFloorUSD; // Dedicated Safety Floor buffer (curEq - DailyEquitySafetyFloor * multiplier)
      g_dailyEquityPeakEquity          = curEq;
      g_dailyEquityNextStepTarget      = curEq + stepUSD; // Only 1 step away!
      g_dailyEquityStepCount           = 0;
      g_dayTargetStartTime             = TimeCurrent();
      g_floatingLossLiveSlTriggered    = false;

      // Keep baseline for adverse loss protection
      g_dayOpeningBalance              = curEq;
      g_dubaiDayOpeningEquity          = curEq;

      double freshDayTarget = curEq + (DailyEquityStopUSD * balancelomultipler);

      PrintFormat(">>> [RESUME DAY TRADING (TRAIL STEP): %s] Trading unpaused! Base Equity=$%.2f | Fresh Day Target=$%.2f (+$%.2f) | Next Step Target=$%.2f (+$%.2f) | Safety Floor=$%.2f (-$%.2f) | Multiplier=%d",
                  reason, curEq, freshDayTarget, DailyEquityStopUSD * balancelomultipler, g_dailyEquityNextStepTarget, stepUSD, g_dailyEquityResumeSafetyFloor, safetyFloorUSD, balancelomultipler);

      LogEAEvent("INFO", "RESUME_DAY_TRADING",
                 StringFormat("[%s] Resume Trail Step! Base=$%.2f FreshTarget=$%.2f NextStep=$%.2f (+Step=$%.2f) Floor=$%.2f (-$%.2f) Mult=%d",
                              reason, curEq, freshDayTarget, g_dailyEquityNextStepTarget, stepUSD, g_dailyEquityResumeSafetyFloor, safetyFloorUSD, balancelomultipler));
     }
   else
     {
      // FULL BASIC TARGET RESUME MODE
      // Reset back to Phase 1 (full basic target from scratch)
      g_dailyEquityTargetHitToday      = false;
      g_dailyEquityIsResumedLeg        = false;
      g_dailyEquityResumedStepHit      = false;
      g_dailyEquityResumeEquity        = 0.0;
      g_dailyEquityResumeSafetyFloor   = 0.0;
      g_dayTargetStartTime             = 0;
      g_floatingLossLiveSlTriggered    = false;
      g_dayOpeningBalance              = curEq;
      g_dubaiDayOpeningEquity          = curEq;
      g_dailyEquityPeakEquity          = curEq;
      g_dailyEquityNextStepTarget      = 0.0;
      g_dailyEquityStepCount           = 0;
      g_dayTargetStartTime             = TimeCurrent();
      g_floatingLossLiveSlTriggered    = false;

      double newTarget = curEq + (DailyEquityStopUSD * balancelomultipler);

      PrintFormat(">>> [RESUME DAY TRADING (FULL TARGET): %s] Trading unpaused! New Base Equity=$%.2f | New Target=$%.2f (+$%.2f) | Multiplier=%d",
                  reason, curEq, newTarget, DailyEquityStopUSD * balancelomultipler, balancelomultipler);

      LogEAEvent("INFO", "RESUME_DAY_TRADING",
                 StringFormat("[%s] Resume Full Target! Base=$%.2f NewTarget=$%.2f Mult=%d",
                              reason, curEq, newTarget, balancelomultipler));
     }

   g_lastTradingResumeTime   = TimeCurrent();
   g_lastTradingResumeReason = reason;

// Display ICON on chart to understand trading is resumed
   CreateTradingResumeChartIcon(reason, curEq);

// Force instant update of dashboards
   DailyProtectionState activeState = GetCurrentDailyState();
   UpdateDashboardsThrottled(activeState, true);
   UpdateLeftLiveOrdersDashboard(true);
   UpdateTopCenterDubaiTimeDisplay(true);
   ChartRedraw(0);
  }

//+------------------------------------------------------------------+
//| ResumeDailyEquityTradingManual                                   |
//+------------------------------------------------------------------+
void ResumeDailyEquityTradingManual()
  {
   PerformDayTradingResume("MANUAL BUTTON CLICK");
  }


//+------------------------------------------------------------------+
//| PauseDailyEquityTradingManual                                    |
//| Pauses day trading on user manual click:                         |
//| - Sets g_dailyEquityTradingBlocked = true & g_manualTradingPaused|
//| - Deletes pending orders so no new positions trigger             |
//| - Optionally closes open orders if InpCloseOrdersOnManualPause   |
//| - Refreshes chart dashboards and buttons                         |
//+------------------------------------------------------------------+
void PauseDailyEquityTradingManual()
  {
   g_manualTradingPaused          = true;
   g_dailyEquityTradingBlocked    = true;
   g_dailyEquityPauseTime         = TimeCurrent();
   g_dailyEquityPauseSSLDirection = GetCurrentSSLDirection();
   g_dailyEquityPauseSslFlipped   = false;

// 1. Delete all pending orders so no pending triggers while paused
   int deletedPending = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int pType = OrderType();
      if(pType == OP_BUYSTOP || pType == OP_SELLSTOP || pType == OP_BUYLIMIT || pType == OP_SELLLIMIT)
        {
         if(OrderDelete(OrderTicket()))
            deletedPending++;
        }
     }

// 2. If InpCloseOrdersOnManualPause is true, close open market orders
   int closedOrders = 0;
   if(InpCloseOrdersOnManualPause)
     {
      for(int pass = 0; pass < 3; pass++)
        {
         for(int m = OrdersTotal() - 1; m >= 0; m--)
           {
            if(!OrderSelect(m, SELECT_BY_POS, MODE_TRADES))
               continue;
            if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
               continue;
            int mType = OrderType();
            if(mType == OP_BUY)
              {
               RefreshRates();
               if(OrderClose(OrderTicket(), OrderLots(), Bid, Slippage, clrOrange))
                  closedOrders++;
              }
            else
               if(mType == OP_SELL)
                 {
                  RefreshRates();
                  if(OrderClose(OrderTicket(), OrderLots(), Ask, Slippage, clrOrange))
                     closedOrders++;
                 }
           }
        }
     }

   PrintFormat(">>> [MANUAL PAUSE TRADING CLICKED] Trading PAUSED by user! Equity=$%.2f | Balance=$%.2f | Pending Deleted: %d | Closed: %d",
               AccountEquity(), AccountBalance(), deletedPending, closedOrders);

   LogEAEvent("INFO", "MANUAL_PAUSE",
              StringFormat("User clicked PAUSE TRADING button. Trading paused! Equity=$%.2f Bal=$%.2f DeletedPend=%d Closed=%d",
                           AccountEquity(), AccountBalance(), deletedPending, closedOrders));

   DeleteTradingResumeChartIcon();

   DailyProtectionState activeState = GetCurrentDailyState();
   UpdateDashboardsThrottled(activeState, true);
   UpdateLeftLiveOrdersDashboard(true);
   UpdateTopCenterDubaiTimeDisplay(true);
   ChartRedraw(0);
  }

//+------------------------------------------------------------------+
//| ResumeDailyEquityTradingOnEmaChange                              |
//+------------------------------------------------------------------+
void ResumeDailyEquityTradingOnEmaChange(int prevDir, int newDir)
  {
   string strPrev = (prevDir == 1) ? "BULLISH(+1)" : ((prevDir == -1) ? "BEARISH(-1)" : IntegerToString(prevDir));
   string strNew  = (newDir == 1)  ? "BULLISH(+1)" : ((newDir == -1)  ? "BEARISH(-1)" : IntegerToString(newDir));
   string reason  = StringFormat("EMA DIRECTION CHANGED (%s -> %s)", strPrev, strNew);
   PerformDayTradingResume(reason);
  }

//+------------------------------------------------------------------+
//| CheckAndResumeDayTradingOnEmaDirectionChange                     |
//| Called on each tick to detect if EMAdirection changed while      |
//| Day Equity trading was paused, and automatically resumes it.     |
//+------------------------------------------------------------------+
void CheckAndResumeDayTradingOnEmaDirectionChange()
  {
   if(!ResumeDayTradingOnEmaDirectionChange)
      return;

// Do not auto-resume if user explicitly clicked PAUSE TRADING manually
   if(g_manualTradingPaused)
      return;

   bool isDayPaused = (g_dailyEquityTradingBlocked || DayProfitLadderTradingStopped || TradingHaltedUntilNextFlip);
   if(!isDayPaused)
      return;

   double ema = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, 0);
   if(ema <= 0.0)
      return;

   int liveEmaDir = 0;
   if(Close[0] > ema)
      liveEmaDir = 1;
   else
      if(Close[0] < ema)
         liveEmaDir = -1;

   if(liveEmaDir == 0)
      return;

   int refDir = (LastTrackedEmaDirection != 0) ? LastTrackedEmaDirection : EMADirection;
   if(refDir != 0 && liveEmaDir != refDir)
     {
      ResumeDailyEquityTradingOnEmaChange(refDir, liveEmaDir);
     }
  }

//+------------------------------------------------------------------+
//| CheckAndResumeDayTradingOnStrongAngleAndSSL                      |
//| Auto-resumes Day Equity trading on 3 Market Conditions:          |
//| Condition 1: MathAbs(EMA Angle) is more than 4 (>= 4.0 deg)      |
//|              with SSL & slope confirming strong trend momentum   |
//|                               OR                                 |
//| Condition 2: MathAbs(EMA Angle) is less than 2 (<= 2.0 deg)      |
//|              and when Horizontal lines are started               |
//|                               OR                                 |
//| Condition 3: Spike Mismatch (EMA Direction & Angle Mismatch):    |
//|              Bullish Spike (EMA=+1, Angle<0) or Bear Spike (-1,>0|
//+------------------------------------------------------------------+
void CheckAndResumeDayTradingOnStrongAngleAndSSL()
  {
   if(!ResumeDayTradingOnStrongAngleSSL)
      return;

// Do not auto-resume if user explicitly clicked PAUSE TRADING manually
   if(g_manualTradingPaused)
      return;

   bool isDayPaused = (g_dailyEquityTradingBlocked || DayProfitLadderTradingStopped || TradingHaltedUntilNextFlip);
   if(!isDayPaused)
      return;

// Track if SSL flipped away during pause (confirms pullback took place)
   int curSslDir = GetCurrentSSLDirection();
   if(g_dailyEquityPauseSSLDirection != 0 && curSslDir != 0 && curSslDir != g_dailyEquityPauseSSLDirection)
     {
      g_dailyEquityPauseSslFlipped = true;
     }

// Check 200 EMA Direction & Angle early for Spike condition
   double ema = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, 0);
   if(ema <= 0.0)
      return;

   int liveEmaDir = 0;
   if(Close[0] > ema)
      liveEmaDir = 1;
   else if(Close[0] < ema)
      liveEmaDir = -1;

   if(liveEmaDir == 0)
      return;

   double curEmaAng = GetEmaAngleDegrees(30);
   double absAngle  = MathAbs(curEmaAng);

   // Condition 3 Spike Mismatch Early Check:
   // - Bullish Spike: EMADirection == 1 (Bull) && Angle < 0.0
   // - Bearish Spike: EMADirection == -1 (Bear) && Angle > 0.0
   bool isBullSpike = (liveEmaDir == 1 && curEmaAng < 0.0);
   bool isBearSpike = (liveEmaDir == -1 && curEmaAng > 0.0);
   bool isCond3Spike = (ResumeDayTradingOnSpikeMismatch && (isBullSpike || isBearSpike));

// 1. Minimum cooldown buffer (e.g. 10 mins) to prevent immediate same-tick re-entry into the pullback
// Spikes are sudden rapid moves; bypass cooldown if InpSpikeResumeBypassCooldown is enabled
   if(!isCond3Spike || !InpSpikeResumeBypassCooldown)
     {
      if(g_dailyEquityPauseTime > 0 && (TimeCurrent() - g_dailyEquityPauseTime) < (ResumeDayTradingMinCooldownMin * 60))
         return;
     }

// 2. Check EMA Angle & Active Horizontal Lines for Resume Conditions:
// User Rule:
// 1. When mathabs emaangle is more than 4 (>= 4.0 deg)
// OR
// 2. mathabs EMAangle is lessthan 2 (<= 2.0 deg) and when Horizontal lines are started
// OR
// 3. Spike on EMA Direction & Angle Mismatch (Bull +1 with Angle < 0, Bear -1 with Angle > 0)
   bool hasActiveRedLine   = (g_lastEqHighPrice > 0.0 && g_lastEqHighLineStart > 0);
   bool hasActiveGreenLine = (g_lastEqLowPrice  > 0.0 && g_lastEqLowLineStart  > 0);
   bool hasActiveHLine     = (hasActiveRedLine || hasActiveGreenLine);

   bool isCond1HighAngle = false;
   bool isCond2LowAngleHLine = false;

   // Condition 1: MathAbs(EMA Angle) is more than 4 (>= 4.0 deg) with slope confirming trend direction
   if(absAngle >= ResumeDayTradingHighEmaAngle)
     {
      if(liveEmaDir == 1 && curEmaAng >= ResumeDayTradingHighEmaAngle)
         isCond1HighAngle = true;
      else if(liveEmaDir == -1 && curEmaAng <= -ResumeDayTradingHighEmaAngle)
         isCond1HighAngle = true;
     }

   // Condition 2: MathAbs(EMA Angle) is less than 2 (<= 2.0 deg) AND Horizontal lines are started
   if(absAngle <= ResumeDayTradingLowEmaAngle && hasActiveHLine)
     {
      isCond2LowAngleHLine = true;
     }

   // None of the 3 conditions satisfied -> do not resume!
   if(!isCond1HighAngle && !isCond2LowAngleHLine && !isCond3Spike)
      return;

// 3. Check Directional Confirmation:
// - For Condition 1 (High Angle >= 4.0): SSL must strictly confirm EMA direction
// - For Condition 2 (Low Angle <= 2.0 with H-Line): SSL must confirm either EMA direction or active horizontal line side
// - For Condition 3 (Spike Mismatch): Target trade is driven by EMA direction (BUY for Bullish Spike, SELL for Bearish Spike)
   if(isCond1HighAngle)
     {
      if(curSslDir == 0 || curSslDir != liveEmaDir)
         return;
     }
   else if(isCond2LowAngleHLine)
     {
      if(curSslDir == 0)
         return;
      bool hLineSslAligned = (curSslDir == liveEmaDir) ||
                             (hasActiveGreenLine && curSslDir == 1) ||
                             (hasActiveRedLine && curSslDir == -1);
      if(!hLineSslAligned)
         return;
     }
   else if(isCond3Spike)
     {
      // Spike Mismatch confirmed!
     }

// 4. Choice A Freshness Check:
// - If pause happened in same direction, require that SSL flipped during pullback OR a fresh cross occurred
// - Or if direction completely changed (e.g. paused on BUY, now SELL == -1 with angle <= -4)
// - Or if spike condition occurred (sudden fresh momentum impulse)
   bool isFreshSignal = false;
   if(g_dailyEquityPauseSSLDirection == 0)
     {
      isFreshSignal = true;
     }
   else if(isCond3Spike)
     {
      // A Spike Mismatch is a sudden fresh momentum breakout!
      isFreshSignal = true;
     }
   else if(liveEmaDir != g_dailyEquityPauseSSLDirection)
     {
      // Complete trend reversal! (e.g. paused on BUY, now strong BEARISH wave with Angle <= -4 and SSL == -1)
      isFreshSignal = true;
     }
   else if(g_dailyEquityPauseSslFlipped)
     {
      // Continuation wave after pullback! (SSL dipped during pullback and freshly flipped back to align)
      isFreshSignal = true;
     }
   else if(IsBuySignal(0) || IsSellSignal(0) || IsBuySignal(1) || IsSellSignal(1))
     {
      // Fresh SSL cross confirmed on current or previous bar
      isFreshSignal = true;
     }
   else if(isCond2LowAngleHLine && hasActiveHLine)
     {
      // Fresh Horizontal Line active/started in low angle range
      isFreshSignal = true;
     }
   else if(g_dailyEquityPauseTime > 0 && (TimeCurrent() - g_dailyEquityPauseTime) >= (MathMax(ResumeDayTradingMinCooldownMin, 15) * 60))
     {
      // Cooldown buffer (at least 15m) fully elapsed and strong momentum maintained
      isFreshSignal = true;
     }

   if(!isFreshSignal)
      return;

   string dirStr = (isCond3Spike ? (isBullSpike ? "BULLISH(+1)" : "BEARISH(-1)") : ((curSslDir == 1) ? "BULLISH(+1)" : "BEARISH(-1)"));
   string reason = "";
   if(isCond1HighAngle)
     {
      reason = StringFormat("STRONG TREND RESUME (Cond 1: EMA Angle=%+.1f deg >= %.1f | SSL=%s)",
                            curEmaAng, ResumeDayTradingHighEmaAngle, dirStr);
     }
   else if(isCond2LowAngleHLine)
     {
      string hLineTag = (hasActiveRedLine && hasActiveGreenLine) ? "BOTH(R+G)" : (hasActiveRedLine ? "EQH-R(Red)" : "EQH-G(Green)");
      reason = StringFormat("STRONG TREND RESUME (Cond 2: Low Angle=%+.1f deg <= %.1f | H-Line=%s | SSL=%s)",
                            curEmaAng, ResumeDayTradingLowEmaAngle, hLineTag, dirStr);
     }
   else if(isCond3Spike)
     {
      reason = StringFormat("SPIKE RESUME (Cond 3: Spike Mismatch EMA=%+d Angle=%+.1f deg | %s)",
                            liveEmaDir, curEmaAng, (isBullSpike ? "BULL SPIKE" : "BEAR SPIKE"));
     }

   PerformDayTradingResume(reason);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void CheckForNewDay()
  {
   datetime serverTime = TimeCurrent();
   if(serverTime <= 0)
      return;

// Convert broker server time to Dubai time (UTC+4) - robust in tester & live
   datetime dubaiTime = 0;
   datetime gmt = TimeGMT();
   if(gmt > 0 && !IsTesting() && !IsOptimization())
      dubaiTime = gmt + (4 * 3600);
   else
      dubaiTime = serverTime + (ServerToDubaiOffsetHours * 3600);

   int today = GetDubai16TradingDayKey(dubaiTime);

// CRITICAL SAFEGUARD: If EA initialized while disconnected or balance was $0.00,
// capture the true opening balance as soon as connection/balance becomes available!
   double curBal = (AccountBalance() > 0.0) ? AccountBalance() : AccountEquity();
   if(g_dayOpeningBalance <= 0.0 && curBal > 0.0)
     {
      g_dayOpeningBalance     = curBal;
      g_dubaiDayOpeningEquity = curBal;
      int lotMultiplierDivDay = (AccountMultiplierLOT > 0) ? AccountMultiplierLOT : 1001;
      balancelomultipler      = (int)MathRound(curBal / (double)lotMultiplierDivDay);
      if(balancelomultipler <= 0)
         balancelomultipler = 1;
      PrintFormat(">>> [DAY BASE RECOVERY] Connected to broker: Fresh Day Base initialized to $%.2f (Multiplier=%dX)",
                  g_dayOpeningBalance, balancelomultipler);
     }

   if(today != g_dayNumber)
     {
      // NEW TRADING DAY (DUBAI 20:00 - FRESH START IN ANY SITUATION)
      bool isFirstStart               = (g_dayNumber == -1);
      bool wasTargetHitYesterday      = g_dailyEquityTargetHitToday;
      bool wasAdverseLossHitYesterday = g_dailyEquityAdverseLossHitToday;
      int  prevDayKey                 = g_dayNumber;
      g_dayNumber                     = today;

      double prevBase                 = g_dayOpeningBalance;
      // User Rule (V-SMALL-1065):
      // Start trading freshly at Dubai trading time (20:00) in ANY situation!
      // Always reset day opening base to current available balance/equity:
      double freshBase = (curBal > 0.0) ? curBal : ((AccountEquity() > 0.0) ? AccountEquity() : prevBase);
      g_dayOpeningBalance     = freshBase;
      g_dubaiDayOpeningEquity = freshBase;

      // USER RULE: On day change Dubai market opening time, change/update balance multiplier based on equity available
      double eqAvailable = (AccountEquity() > 0.0) ? AccountEquity() : freshBase;
      int lotMultiplierDivDay = (AccountMultiplierLOT > 0) ? AccountMultiplierLOT : 1001;
      balancelomultipler = (int)MathRound(eqAvailable / (double)lotMultiplierDivDay);
      if(balancelomultipler <= 0)
         balancelomultipler = 1;

      // User Choice: Keep open market positions running into the new session, but delete pending orders
      int deletedPending = 0;
      for(int p_i = OrdersTotal() - 1; p_i >= 0; p_i--)
        {
         if(!OrderSelect(p_i, SELECT_BY_POS, MODE_TRADES))
            continue;
         if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
            continue;
         int oType = OrderType();
         if(oType == OP_BUYSTOP || oType == OP_SELLSTOP || oType == OP_BUYLIMIT || oType == OP_SELLLIMIT)
           {
            int pTkt = OrderTicket();
            ResetLastError();
            if(OrderDelete(pTkt, clrGray))
               deletedPending++;
           }
        }

      // Reset ALL daily protection, pause, halt, retrace & trailing leg states to guarantee FRESH ACTIVE trading
      g_manualTradingPaused            = false;
      g_dailyEquityTradingBlocked      = false;
      g_dailyEquityTargetHitToday      = false;
      g_dailyEquityAdverseLossHitToday = false;
      DayProfitLadderTradingStopped    = false;
      TradingHaltedUntilNextFlip       = false;
      EnableTrading                    = true;
      g_dailyEquityPeakEquity          = g_dayOpeningBalance;
      g_dailyEquityNextStepTarget      = 0.0;
      g_dailyEquityStepCount           = 0;
      g_dayTargetStartTime             = TimeCurrent();
      g_floatingLossLiveSlTriggered    = false;
      g_dailyEquityPauseTime           = 0;
      g_dailyEquityPauseSSLDirection   = 0;
      g_dailyEquityPauseSslFlipped     = false;
      g_deepDrawdownCooldownUntil      = 0;
      g_deepDrawdownLiveSlClamped      = false;
      g_deepDrawdownCycleArmed         = false;
      g_deepDrawdownArmedTarget        = 0.0;
      g_deepDrawdownCycleStartBalance  = g_dayOpeningBalance;
      g_deepDrawdownCycleLowestEquity  = g_dayOpeningBalance;
      g_dailyEquityIsResumedLeg        = false; // Reset trailing/resumed leg to Phase 1 fresh day target!
      g_dailyEquityResumedStepHit      = false;
      g_dailyEquityResumeEquity        = 0.0;
      g_dailyEquityResumeSafetyFloor   = 0.0;
      g_lastTradingResumeTime          = serverTime;
      g_lastTradingResumeReason        = GetActiveSessionResumeReason(dubaiTime);

      // Synchronize session opening state and EqDD daily state
      SyncDubaiDayOpeningState(serverTime);
      CheckEqDdDailyReset();

      PrintFormat(">>> [NEW TRADING SESSION (%s - FRESH START)] DayKey=%d | DubaiTime=%s | Fresh Base=$%.2f (Prev=$%.2f) | Target=$%.2f (+Target=$%.2f) | Mult=%d [AvailEq=$%.2f] | Stale Pending Deleted=%d | Status: ACTIVE",
                  GetDayStartSessionModeName(),
                  today, TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS), g_dayOpeningBalance, prevBase,
                  g_dayOpeningBalance + (DailyEquityStopUSD * balancelomultipler), DailyEquityStopUSD * balancelomultipler,
                  balancelomultipler, eqAvailable, deletedPending);
     }
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void CheckForNewDayOld()
  {
   int today = TimeDayOfYear(TimeCurrent());

   if(today != g_dayNumber)
     {
      // NEW DAY
      g_dayNumber = today;

      // Capture the balance at the start of the new day
      g_dayOpeningBalance = AccountBalance();

      // Reset daily protection
      g_dailyEquityTradingBlocked    = false;
      g_dailyEquityTargetHitToday    = false;
      g_dailyEquityPeakEquity        = 0.0;
      g_dailyEquityNextStepTarget    = 0.0;
      g_dailyEquityStepCount         = 0;
      g_dailyEquityIsResumedLeg      = false;
      g_dailyEquityResumedStepHit    = false;
      g_dailyEquityResumeEquity      = 0.0;
      g_dailyEquityResumeSafetyFloor = 0.0;

      Print("NEW DAY detected. Opening Balance = ",
            DoubleToString(g_dayOpeningBalance, 2));

      //InpHourlyPlanADayProfitPct=InpHourlyPlanADayProfitPct+2;
      //InpHourlyPlanCDayProfitPct =InpHourlyPlanCDayProfitPct+2;
      //InpHourlyPlanDStartPct= InpHourlyPlanDStartPct+2;
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsDailyEquityStopReacheddmanual()
  {
   double stopEquity = g_dayOpeningBalance *
                       (DailyEquityStopUSD / 100.0);


   stopEquity=g_dayOpeningBalance+(DailyEquityStopUSD* balancelomultipler);

   Print("stopEquity ", DoubleToString(stopEquity, 2), " AccountEquity() ", DoubleToString(AccountEquity(), 2));

   if(AccountEquity() <= stopEquity)
     {
      g_dailyEquityTradingBlocked = true;
      return true;
     }

   return g_dailyEquityTradingBlocked;
  }
//+------------------------------------------------------------------+
//|                                                                  |

//+------------------------------------------------------------------+
//| GetDailyEquityRetraceFloorPct: Dynamic tiered retrace floor %     |
//| USER RULE (VMULTI-1235):                                         |
//| Peak >= $300 -> Floor is 10%                                     |
//| Peak >= $200 -> Floor is 20%                                     |
//| Peak >= $100 -> Floor is 30%                                     |
//| Peak >= $50  -> Floor is 50%                                     |
//| Peak <  $50  -> Floor is Baseline (Default 50% / 70%)            |
//+------------------------------------------------------------------+
double GetDailyEquityRetraceFloorPct(double peakProfit)
  {
   int mult = (balancelomultipler > 0) ? balancelomultipler : 1;

   if(peakProfit >= (200.0 / 5.0) * mult)   // $60 * multiplier
      return 10.0;
   if(peakProfit >= (150.0 / 5.0) * mult)   // $40 * multiplier
      return 20.0;
   if(peakProfit >= (100.0 / 5.0) * mult)   // $20 * multiplier
      return 30.0;
   if(peakProfit >= (50.0 / 5.0) * mult)    // $10 * multiplier
      return 50.0;

   return (DailyEquityRetraceFloorPct > 0.0) ? DailyEquityRetraceFloorPct : 50.0;
  }

//+------------------------------------------------------------------+
//| GetEffectiveDailyTargetEquity: Calculates target equity with      |
//| dynamic hourly decay ($1*mult/hr) down to min profit floor.      |
//| USER RULE (V-SMALL-1020 / VMULTI-1265):                           |
//| - 1st hour (0-60m): Base Target (e.g. $161 at 1X, +$4)           |
//| - 2nd hour (60-120m): Base Target - $1*mult (e.g. $160, +$3)     |
//| - 3rd hour (120-180m): Base Target - $2*mult (e.g. $159, +$2)    |
//| - Floor (180m+): Base + $1*mult (e.g. $158, +$1 minimum profit)  |
//+------------------------------------------------------------------+
double GetEffectiveDailyTargetEquity(int &outHoursDecay, double &outDecayUSD)
  {
   outHoursDecay = 0;
   outDecayUSD   = 0.0;

   double dailyTarget = DailyEquityStopUSD;
   datetime dubaiTime = 0;
   datetime gmt = TimeGMT();
   if(gmt > 0 && !IsTesting() && !IsOptimization())
      dubaiTime = gmt + (4 * 3600);
   else
      dubaiTime = TimeCurrent() + (ServerToDubaiOffsetHours * 3600);

   int dayOfWeek = TimeDayOfWeek(dubaiTime);
   if(dayOfWeek == 6 || dayOfWeek == 0)
      dailyTarget = DailyEquityStopUSD / 2.0;

   int mult = (balancelomultipler > 0) ? balancelomultipler : 1;
   double openBase = (g_dayOpeningBalance > 0.0) ? g_dayOpeningBalance : AccountBalance();
   double baseTargetEquity = openBase + (dailyTarget * mult);

   if(!InpEnableHourlyTargetDecay || g_dailyEquityTargetHitToday || openBase <= 0.0)
      return baseTargetEquity;

// Identify earliest open EA order time or target cycle start time
   datetime activeStart = g_dayTargetStartTime;
   datetime earliestOpen = 0;
   int openEaOrders = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      if(OrderType() != OP_BUY && OrderType() != OP_SELL)
         continue;

      openEaOrders++;
      if(earliestOpen == 0 || OrderOpenTime() < earliestOpen)
         earliestOpen = OrderOpenTime();
     }

   if(openEaOrders > 0)
     {
      if(activeStart <= 0 || (earliestOpen > 0 && earliestOpen < activeStart))
         activeStart = earliestOpen;
      if(g_dayTargetStartTime <= 0)
         g_dayTargetStartTime = activeStart;
     }

   if(openEaOrders <= 0 || activeStart <= 0 || TimeCurrent() <= activeStart)
      return baseTargetEquity;

   int elapsedHours = (int)((TimeCurrent() - activeStart) / 3600);
   if(elapsedHours <= 0)
      return baseTargetEquity;

   outHoursDecay = elapsedHours;
   outDecayUSD   = elapsedHours * InpHourlyTargetDecayUSD * mult;
   double effTarget = baseTargetEquity - outDecayUSD;
   double minFloor  = openBase + (InpMinTargetProfitFloorUSD * mult);
   if(effTarget < minFloor)
      effTarget = minFloor;

   return effTarget;
  }

//+------------------------------------------------------------------+
//| IsDailyEquityStopReached                                         |
//| 1. On DailyEquityStopUSD reached: Modifies open orders SL to     |
//|    current price, continues trading to collect $5 steps.         |
//| 2. On +$5 step hit: Modifies SL to current price step-by-step.   |
//| 3. On Tiered Retrace Floor: Closes all orders and pauses for day.|
//+------------------------------------------------------------------+
bool IsDailyEquityStopReached()
  {
   if(g_dailyEquityTradingBlocked)
      return true;

   double dailyTarget = DailyEquityStopUSD;

// Get Dubai time (UTC+4) - robust in tester & live
   datetime dubaiTime = 0;
   datetime gmt = TimeGMT();
   if(gmt > 0 && !IsTesting() && !IsOptimization())
      dubaiTime = gmt + (4 * 3600);
   else
      dubaiTime = TimeCurrent() + (ServerToDubaiOffsetHours * 3600);

   int dayOfWeek = TimeDayOfWeek(dubaiTime);

// Saturday = 6, Sunday = 0
   if(dayOfWeek == 6 || dayOfWeek == 0)
     {
      dailyTarget = DailyEquityStopUSD / 2.0;
     }

   int mult = (balancelomultipler > 0) ? balancelomultipler : 1;
   double curEquity    = AccountEquity();

// ==============================================================
// ADVERSE DAY PROTECTION ($200 Loss Stop)
// If Day Equity drops $200 below Day Opening Balance,
// close all open orders and pause trading until next day Dubai 16:00
// ==============================================================
   if(DailyEquityMaxLossUSD > 0.0 && g_dayOpeningBalance > 0.0)
     {
      double maxLossUSD        = DailyEquityMaxLossUSD * mult;
      double adverseStopEquity = g_dayOpeningBalance - maxLossUSD;
      if(curEquity <= adverseStopEquity)
        {
         g_dailyEquityTradingBlocked      = true;
         g_dailyEquityAdverseLossHitToday = true;
         g_dailyEquityPauseTime           = TimeCurrent();
         g_dailyEquityPauseSSLDirection   = GetCurrentSSLDirection();
         g_dailyEquityPauseSslFlipped     = false;

         PrintFormat(">>> [ADVERSE DAY EQUITY PROTECTION HIT (-$%.2f)] Dubai=%s (DayKey=%d) | OpenBal=$%.2f | CurEquity=$%.2f | DayLoss=-$%.2f >= $%.2f | Closing ALL orders and pausing trading until next day Dubai reset (%s).",
                     maxLossUSD, TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                     GetDubai16TradingDayKey(dubaiTime), g_dayOpeningBalance, curEquity,
                     (g_dayOpeningBalance - curEquity), maxLossUSD, GetNextSessionWaitHourStr(dubaiTime));

         CloseAndDeleteAllEAOrdersOnTradingStop();

         return true;
        }
     }

   int hoursDecay = 0;
   double decayUSD = 0.0;
   double targetEquity = GetEffectiveDailyTargetEquity(hoursDecay, decayUSD);
   double stepUSD      = DailyEquityTrailStepUSD * mult;

// Track peak equity once target is hit today
   if(g_dailyEquityTargetHitToday && curEquity > g_dailyEquityPeakEquity)
      g_dailyEquityPeakEquity = curEquity;

// Dynamic Tiered Retrace Floor of Maximum Collected Profit (DailyEquityStopUSD + all $5 steps)
   double totalPeakProfit = (g_dailyEquityPeakEquity > g_dayOpeningBalance) ? (g_dailyEquityPeakEquity - g_dayOpeningBalance) : (dailyTarget * mult);
   if(totalPeakProfit < dailyTarget * mult)
      totalPeakProfit = dailyTarget * mult;

   double currentFloorPct = GetDailyEquityRetraceFloorPct(totalPeakProfit);
   double floorProfit = totalPeakProfit * (currentFloorPct / 100.0);
   double floorEquity = g_dayOpeningBalance + floorProfit;

// ==============================================================
// RESUMED LEG: STEP-BY-STEP TRAILING PROFIT MODE
// ==============================================================
   if(g_dailyEquityIsResumedLeg && InpResumeDayTradingTargetMode == RESUME_MODE_TRAIL_STEP)
     {
      double profitInResumedLeg = (g_dailyEquityPeakEquity > g_dailyEquityResumeEquity) ? (g_dailyEquityPeakEquity - g_dailyEquityResumeEquity) : 0.0;
      double resumedFloorEquity = 0.0;
      double resumedFloorPct    = 0.0;

      if(!g_dailyEquityResumedStepHit)
        {
         // Before Step 1 hit: protect with safety buffer (curEq - stepUSD)
         resumedFloorEquity = g_dailyEquityResumeSafetyFloor;
         resumedFloorPct    = 0.0;
        }
      else
        {
         // Step 1 hit: Breakeven of resume equity is fully locked!
         // Ratchet floor up based on tiered % of profit gained in this resumed leg
         resumedFloorPct       = GetDailyEquityRetraceFloorPct(profitInResumedLeg);
         double legFloorProfit = profitInResumedLeg * (resumedFloorPct / 100.0);
         resumedFloorEquity    = g_dailyEquityResumeEquity + legFloorProfit;
         if(resumedFloorEquity < g_dailyEquityResumeEquity)
            resumedFloorEquity = g_dailyEquityResumeEquity;
        }

      // Collect +stepUSD profit step-by-step
      if(curEquity >= g_dailyEquityNextStepTarget && g_dailyEquityNextStepTarget > 0.0)
        {
         g_dailyEquityResumedStepHit = true;
         g_dailyEquityStepCount++;
         Print(StringFormat("[DAILY EQUITY RESUMED STEP #%d HIT] Equity=$%.2f | Peak=$%.2f (+$%.2f) | Dynamic Floor=$%.2f | Modifying SL to Current Price | Next Step Target=$%.2f",
                            g_dailyEquityStepCount, curEquity, g_dailyEquityPeakEquity, profitInResumedLeg, resumedFloorEquity, (curEquity + stepUSD)));

         g_dailyEquityNextStepTarget = curEquity + stepUSD;

         ModifyOpenOrdersToCurrentPriceSL(StringFormat("Resumed Step #%d", g_dailyEquityStepCount));
        }

      // Stop trading and pause for the day when coming back to floor of maximum collected profit
      if(curEquity <= resumedFloorEquity)
        {
         g_dailyEquityTradingBlocked    = true;
         g_dailyEquityPauseTime         = TimeCurrent();
         g_dailyEquityPauseSSLDirection = GetCurrentSSLDirection();
         g_dailyEquityPauseSslFlipped   = false;

         PrintFormat(">>> [DAILY EQUITY RETRACE STOP (RESUMED LEG)] Maximum peak profit collected was $%.2f (%d steps). Equity dropped to floor ($%.2f <= $%.2f). Closing all orders and pausing until next day Dubai reset (%s).",
                     profitInResumedLeg, g_dailyEquityStepCount, curEquity, resumedFloorEquity, GetNextSessionWaitHourStr(dubaiTime));

         CloseAndDeleteAllEAOrdersOnTradingStop();

         return true;
        }
     }
// ==============================================================
// STANDARD PHASE 1: INITIAL TARGET HIT ($50 * multiplier reached)
// ==============================================================
   else
      if(!g_dailyEquityTargetHitToday)
        {
         if(curEquity >= targetEquity)
           {
            g_dailyEquityTargetHitToday = true;
            g_dailyEquityPeakEquity     = curEquity;
            g_dailyEquityStepCount      = 0;
            g_dailyEquityNextStepTarget = curEquity + stepUSD; // Next $5 milestone

            totalPeakProfit = g_dailyEquityPeakEquity - g_dayOpeningBalance;
            currentFloorPct = GetDailyEquityRetraceFloorPct(totalPeakProfit);
            floorProfit     = totalPeakProfit * (currentFloorPct / 100.0);
            floorEquity     = g_dayOpeningBalance + floorProfit;

            string decayNote = (hoursDecay > 0) ? StringFormat(" [Hourly Decay #%dh: Base $%.0f -> EffTgt $%.0f]", hoursDecay, g_dayOpeningBalance + (dailyTarget * mult), targetEquity) : "";
            Print(StringFormat("[DAILY EQUITY PROFIT TARGET HIT%s] Target=$%.2f | CurEquity=$%.2f (Profit=+$%.2f) | Closing Losing Orders & Live SL Clamping Profit Orders | Trail Step=$%.2f | Dynamic %.0f%% Floor=$%.2f (%.0f%% of $%.2f) | Continuing trading with DailyEquityTrailStepUSD...",
                               decayNote, targetEquity, curEquity, (curEquity - g_dayOpeningBalance), stepUSD, currentFloorPct, floorEquity, currentFloorPct, totalPeakProfit));

            // User Rule (V-SMALL-1023 / VMULTI-1268):
            // On Day Equity Target Hit (with 1h, 2h delay adjustments):
            // 1. Close all losing EA market orders immediately.
            // 2. Modify all profitable EA orders with live stop-loss price.
            CloseLosingOrdersAndLiveSLProfitOrders(StringFormat("Daily Equity Target Hit%s", decayNote));

            // Post-Exit Action: as usual start DailyEquityTrailStepUSD process
           }
        }
      // ==============================================================
      // PHASE 2: TARGET HIT TODAY - COLLECT $5 STEPS / RETRACE TO TIERED FLOOR
      // ==============================================================
      else
        {
         // Track peak equity
         if(curEquity > g_dailyEquityPeakEquity)
            g_dailyEquityPeakEquity = curEquity;

         // Recalculate dynamic tiered floor of maximum peak profit collected (Daily target + steps)
         totalPeakProfit = g_dailyEquityPeakEquity - g_dayOpeningBalance;
         currentFloorPct = GetDailyEquityRetraceFloorPct(totalPeakProfit);
         floorProfit     = totalPeakProfit * (currentFloorPct / 100.0);
         floorEquity     = g_dayOpeningBalance + floorProfit;

         // Collect +$5 step profit step-by-step
         if(curEquity >= g_dailyEquityNextStepTarget && g_dailyEquityNextStepTarget > 0.0)
           {
            g_dailyEquityStepCount++;
            Print(StringFormat("[DAILY EQUITY +$5 STEP #%d HIT] Equity=$%.2f | Peak=$%.2f (+$%.2f) | Dynamic %.0f%% Floor=$%.2f (%.0f%% of $%.2f) | Modifying SL to Current Price | Next Step Target=$%.2f",
                               g_dailyEquityStepCount, curEquity, g_dailyEquityPeakEquity, totalPeakProfit, currentFloorPct, floorEquity, currentFloorPct, totalPeakProfit, (curEquity + stepUSD)));

            g_dailyEquityNextStepTarget = curEquity + stepUSD;

            ModifyOpenOrdersToCurrentPriceSL(StringFormat("+$5 Step #%d", g_dailyEquityStepCount));
           }

         // Stop trading and pause for the day when coming back to tiered floor of maximum collected profit
         if(curEquity <= floorEquity)
           {
            g_dailyEquityTradingBlocked    = true;
            g_dailyEquityPauseTime         = TimeCurrent();
            g_dailyEquityPauseSSLDirection = GetCurrentSSLDirection();
            g_dailyEquityPauseSslFlipped   = false;

            Print(StringFormat("[DAILY EQUITY RETRACE STOP] Maximum peak profit collected was $%.2f (Daily target + %d x $5 steps). Equity dropped to %.0f%% floor ($%.2f <= $%.2f). Closing all orders and pausing until next day Dubai reset (%s).",
                               totalPeakProfit, g_dailyEquityStepCount, currentFloorPct, curEquity, floorEquity, GetNextSessionWaitHourStr(dubaiTime)));

            CloseAndDeleteAllEAOrdersOnTradingStop();

            return true;
           }
        }

   return g_dailyEquityTradingBlocked;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsDailyEquityStopReachedAlldays()
  {
// Calculates the ceiling equity (e.g., 100 * (1.0 + 0.05) = 105)
   double targetEquity = g_dayOpeningBalance * (1.0 + (DailyEquityStopUSD / 100.0));

   targetEquity=g_dayOpeningBalance+(DailyEquityStopUSD* balancelomultipler);

// Print("targetEquity: ", DoubleToString(targetEquity, 2), " AccountEquity(): ", DoubleToString(AccountEquity(), 2));

// Stop trading if equity hits or exceeds the target
   if(AccountEquity() >= targetEquity)
     {
      g_dailyEquityTradingBlocked    = true;
      g_dailyEquityPauseTime         = TimeCurrent();
      g_dailyEquityPauseSSLDirection = GetCurrentSSLDirection();
      g_dailyEquityPauseSslFlipped   = false;

      Print("[DAILY EQUITY PROFIT TARGET HIT] Closing all orders and pausing until new day.");

      CloseAndDeleteAllEAOrdersOnTradingStop();

      return true;
     }

   return g_dailyEquityTradingBlocked;
  }

//+------------------------------------------------------------------+
//| CheckDeepDrawdownRecoveryShield                                  |
//| Choice B: V-Shape Drawdown Recovery Breakeven Shield             |
//| When an open basket suffers a deep drawdown (gap >= $50 * mult)  |
//| and then recovers back towards balance (within $2.0 * mult),     |
//| this function:                                                   |
//| 1. Arms when drawdown gap >= InpDeepDrawdownMinGapUSD * mult.    |
//| 2. On recovery, deletes all pending orders (stops new risk).     |
//| 3. Clamps all open market orders' SL to live market price.       |
//| 4. Trails SL higher if price continues moving into profit.       |
//| 5. Initiates cooldown pause once the clamped basket exits.       |
//+------------------------------------------------------------------+
void CheckDeepDrawdownRecoveryShield()
  {
   if(!InpEnableDeepDrawdownRecoveryShield)
      return;

// Count open EA market orders
   int openMarketOrders = CountOrdersByType(OP_BUY) + CountOrdersByType(OP_SELL);
   int mult = (balancelomultipler > 0) ? balancelomultipler : 1;
   double curBal = AccountBalance();
   double curEq  = (AccountEquity() > 0.0) ? AccountEquity() : curBal;

// -------------------------------------------------------------
// 1. NO OPEN MARKET ORDERS: Basket is flat / idle
// -------------------------------------------------------------
   if(openMarketOrders == 0)
     {
      // If the clamped basket just finished exiting, start cooldown
      if(g_deepDrawdownLiveSlClamped)
        {
         if(InpDeepDrawdownCooldownMinutes > 0)
            g_deepDrawdownCooldownUntil = TimeCurrent() + (InpDeepDrawdownCooldownMinutes * 60);

         PrintFormat(">>> [DEEP DRAWDOWN RECOVERY BASKET EXITED] Capital protected at Balance=$%.2f | Cooldown active for %dm until %s.",
                     curBal, InpDeepDrawdownCooldownMinutes, TimeToString(g_deepDrawdownCooldownUntil, TIME_DATE|TIME_MINUTES|TIME_SECONDS));

         LogEAEvent("INFO", "DEEP_DD_SHIELD",
                    StringFormat("Basket exited! Capital protected at Balance=$%.2f Cooldown until %s",
                                 curBal, TimeToString(g_deepDrawdownCooldownUntil, TIME_DATE|TIME_MINUTES|TIME_SECONDS)));

         // Display V-END chart icon and connect recovery path
         CreateDeepDrawdownEndChartIcon(curBal);
        }

      // Reset cycle state
      if(g_deepDrawdownLiveSlClamped)
        {
         if(InpDeepDrawdownCooldownMinutes > 0)
            g_deepDrawdownCooldownUntil = TimeCurrent() + (InpDeepDrawdownCooldownMinutes * 60);

         PrintFormat(">>> [DEEP DRAWDOWN RECOVERY BASKET EXITED] Capital protected at Balance=$%.2f | Cooldown active for %dm until %s.",
                     curBal, InpDeepDrawdownCooldownMinutes, TimeToString(g_deepDrawdownCooldownUntil, TIME_DATE|TIME_MINUTES|TIME_SECONDS));

         LogEAEvent("INFO", "DEEP_DD_SHIELD",
                    StringFormat("Basket exited! Capital protected at Balance=$%.2f Cooldown until %s",
                                 curBal, TimeToString(g_deepDrawdownCooldownUntil, TIME_DATE|TIME_MINUTES|TIME_SECONDS)));

         // Display V-END chart icon and connect recovery path
         CreateDeepDrawdownEndChartIcon(curBal);

         // Clamped recovery complete -> Reset baseline to new protected balance
         g_deepDrawdownCycleStartBalance     = curBal;
         g_deepDrawdownCycleLowestEquity     = curEq;
        }
      else
        {
         // Orders closed without recovery clamping (e.g. partial closes or stop losses)
         // Retain highest account balance; only advance if balance reached a NEW HIGH
         if(curBal > g_deepDrawdownCycleStartBalance || g_deepDrawdownCycleStartBalance <= 0.0)
            g_deepDrawdownCycleStartBalance = curBal;
         g_deepDrawdownCycleLowestEquity     = curEq;
        }

      g_deepDrawdownLiveSlClamped         = false;
      g_deepDrawdownCycleArmed            = false;
      g_deepDrawdownArmedTarget           = 0.0;
      return;
     }

// -------------------------------------------------------------
// 2. ACTIVE OPEN BASKET: Track cycle baseline and lowest equity
// -------------------------------------------------------------
// Always store the highest account balance reached (never decrease if orders close at a loss)
   if(curBal > g_deepDrawdownCycleStartBalance || g_deepDrawdownCycleStartBalance <= 0.0)
      g_deepDrawdownCycleStartBalance = curBal;

   if(curEq < g_deepDrawdownCycleLowestEquity || g_deepDrawdownCycleLowestEquity <= 0.0)
      g_deepDrawdownCycleLowestEquity = curEq;

   double gap = g_deepDrawdownCycleStartBalance - g_deepDrawdownCycleLowestEquity;
   double minGapThreshold = 0.0;
   if(InpDeepDrawdownMinGapPct > 0.0 && g_deepDrawdownCycleStartBalance > 0.0)
      minGapThreshold = g_deepDrawdownCycleStartBalance * (InpDeepDrawdownMinGapPct / 100.0);
   else
      minGapThreshold = InpDeepDrawdownMinGapUSD * mult;

// -------------------------------------------------------------
// 3. ARM SHIELD: If drawdown gap exceeds threshold
// -------------------------------------------------------------
   if(!g_deepDrawdownCycleArmed && gap >= minGapThreshold)
     {
      g_deepDrawdownCycleArmed = true;
      if(curBal > g_deepDrawdownCycleStartBalance)
         g_deepDrawdownCycleStartBalance = curBal;

      // Base recovery target is pegged to HIGHEST account balance (stored balance does not reduce when orders close)
      double baseTarget = g_deepDrawdownCycleStartBalance;
      double recTarget  = baseTarget - (InpDeepDrawdownRecoveryBufferUSD * mult);
      g_deepDrawdownArmedTarget = recTarget;
      string gapTag     = (InpDeepDrawdownMinGapPct > 0.0) ? StringFormat("%.0f%% of Balance", InpDeepDrawdownMinGapPct) : StringFormat("$%.0f", minGapThreshold);

      PrintFormat(">>> [DEEP DRAWDOWN SHIELD ARMED] HighestBal=$%.2f | LowestEq=$%.2f | Gap=-$%.2f >= Threshold=$%.2f (%s) | Waiting for bounce to $%.2f to clamp Live SL",
                  g_deepDrawdownCycleStartBalance, g_deepDrawdownCycleLowestEquity, gap, minGapThreshold, gapTag, recTarget);

      LogEAEvent("WARN", "DEEP_DD_SHIELD",
                 StringFormat("ARMED! HighestBal=$%.2f LowestEq=$%.2f Gap=-$%.2f Threshold=$%.2f (%s) Target=$%.2f",
                              g_deepDrawdownCycleStartBalance, g_deepDrawdownCycleLowestEquity, gap, minGapThreshold, gapTag, recTarget));

      // Display chart icon and label to clearly show V-Equity Armed on chart
      CreateDeepDrawdownArmedChartIcon(g_deepDrawdownCycleStartBalance, g_deepDrawdownCycleLowestEquity, gap, recTarget);
     }

// -------------------------------------------------------------
// 4. RECOVERY TRIGGER: When armed and equity recovers near balance
// -------------------------------------------------------------
   if(g_deepDrawdownCycleArmed && !g_deepDrawdownLiveSlClamped)
     {
      // Target remains pegged to armed highest account balance (never drops if curBal reduced due to closed orders)
      double baseTarget = g_deepDrawdownCycleStartBalance;
      double recTarget  = (g_deepDrawdownArmedTarget > 0.0) ? g_deepDrawdownArmedTarget : (baseTarget - (InpDeepDrawdownRecoveryBufferUSD * mult));
      if(g_deepDrawdownArmedTarget <= 0.0)
         g_deepDrawdownArmedTarget = recTarget;

      double curEmaAng = (GlobalEmaAngle30 != 0.0) ? GlobalEmaAngle30 : GetEmaAngleDegrees(30);
      double absEmaAng = MathAbs(curEmaAng);

      double effectiveTarget = recTarget;
      bool   isSteepAngle    = false;
      if(InpDeepDrawdownSteepAngleDeg > 0.0 && absEmaAng > InpDeepDrawdownSteepAngleDeg)
        {
         effectiveTarget = g_deepDrawdownArmedTarget * (InpDeepDrawdownSteepAngleTargetPct / 100.0);
         isSteepAngle    = true;
        }

      if(curEq >= effectiveTarget)
        {
         g_deepDrawdownLiveSlClamped = true;

         string reasonDetail = isSteepAngle ?
                               StringFormat("CurEq=$%.2f >= 90%% Target=$%.2f (Armed Target=$%.2f, EMA Angle=%.1f° > %.1f°)",
                                            curEq, effectiveTarget, g_deepDrawdownArmedTarget, curEmaAng, InpDeepDrawdownSteepAngleDeg) :
                               StringFormat("CurEq=$%.2f >= Target=$%.2f (Base=$%.2f, Max Gap was -$%.2f)",
                                            curEq, recTarget, baseTarget, gap);

         PrintFormat(">>> [DEEP DRAWDOWN V-SHAPE RECOVERY TRIGGERED!] %s | Clamping ALL Open Orders to Live Market SL & Deleting Pendings!",
                     reasonDetail);

         LogEAEvent("CRITICAL", "DEEP_DD_SHIELD",
                    StringFormat("TRIGGERED! %s Clamping %d orders to Live SL & deleting pendings",
                                 reasonDetail, openMarketOrders));

         // 1. Delete all pending orders so no new counter-risk triggers
         if(InpDeepDrawdownDeletePendings)
           {
            DeleteAllPendingEAOrders();
           }

         // 2. Clamp ALL open market orders to Live Market SL (forceAllOrders = true)
         ModifyOpenOrdersToCurrentPriceSL("Deep Drawdown Recovery Shield", true);

         // 3. Display chart icon and label to show V-Equity Clamped
         CreateDeepDrawdownClampedChartIcon(curEq, effectiveTarget, curEmaAng, isSteepAngle);
        }
     }

// -------------------------------------------------------------
// 5. TRAIL CLAMPED SL: If price continues running into profit
// -------------------------------------------------------------
   if(g_deepDrawdownLiveSlClamped && InpDeepDrawdownTrailLiveSL)
     {
      ModifyOpenOrdersToCurrentPriceSL("Deep Drawdown Recovery Trailing", true);
     }
  }

//+------------------------------------------------------------------+
//| CheckBasketLossDeRiskAndBreakevenProtection                      |
//| USER RULE: When basket floating loss >= $10 * mult:              |
//| 1. For newer orders opened below (BUY) or above (SELL):          |
//|    When order moves >= $50 raw distance into profit:             |
//|    Modify order StopLoss to OrderOpenPrice (Breakeven).          |
//| 2. For older losing order (#1):                                  |
//|    Set exit target to OrderOpenPrice ($0 loss on bounce).        |
//+------------------------------------------------------------------+
void CheckBasketLossDeRiskAndBreakevenProtection()
  {
   if(!InpEnableBasketDeRiskOnLoss)
      return;

   int mult = (balancelomultipler > 0) ? balancelomultipler : 1;
   double lossThreshold = InpBasketDeRiskTriggerLossUSD * mult;

// ---------------------------------------------------------------
// 1. Gather all open market BUY and SELL orders for this EA
// ---------------------------------------------------------------
   int buyTickets[];
   datetime buyOpenTimes[];
   double buyOpenPrices[];

   int sellTickets[];
   datetime sellOpenTimes[];
   double sellOpenPrices[];

   int buyCount = 0;
   int sellCount = 0;

   double buyBasketPL = 0.0;
   double sellBasketPL = 0.0;

   int total = OrdersTotal();
   for(int i = 0; i < total; i++)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType == OP_BUY)
        {
         ArrayResize(buyTickets, buyCount + 1);
         ArrayResize(buyOpenTimes, buyCount + 1);
         ArrayResize(buyOpenPrices, buyCount + 1);

         buyTickets[buyCount]    = OrderTicket();
         buyOpenTimes[buyCount]  = OrderOpenTime();
         buyOpenPrices[buyCount] = OrderOpenPrice();
         buyCount++;

         buyBasketPL += (OrderProfit() + OrderSwap() + OrderCommission());
        }
      else
         if(oType == OP_SELL)
           {
            ArrayResize(sellTickets, sellCount + 1);
            ArrayResize(sellOpenTimes, sellCount + 1);
            ArrayResize(sellOpenPrices, sellCount + 1);

            sellTickets[sellCount]    = OrderTicket();
            sellOpenTimes[sellCount]  = OrderOpenTime();
            sellOpenPrices[sellCount] = OrderOpenPrice();
            sellCount++;

            sellBasketPL += (OrderProfit() + OrderSwap() + OrderCommission());
           }
     }

// ---------------------------------------------------------------
// 2. PROCESS BUY BASKET: Floating Loss >= $10 * mult
// ---------------------------------------------------------------
   if(buyCount >= 2 && buyBasketPL <= -lossThreshold)
     {
      // Find oldest BUY order (Order #1) by earliest open time
      int oldestBuyIdx = 0;
      datetime earliestBuyTime = buyOpenTimes[0];
      for(int b = 1; b < buyCount; b++)
        {
         if(buyOpenTimes[b] < earliestBuyTime)
           {
            earliestBuyTime = buyOpenTimes[b];
            oldestBuyIdx = b;
           }
        }
      int oldestBuyTicket = buyTickets[oldestBuyIdx];

      // A. For all other newer BUY orders (#2, #3, etc. opened below #1):
      for(int b = 0; b < buyCount; b++)
        {
         if(b == oldestBuyIdx)
            continue; // Skip Order #1 for profit BE SL

         int tkt = buyTickets[b];
         if(!OrderSelect(tkt, SELECT_BY_TICKET, MODE_TRADES))
            continue;

         double oOpen = OrderOpenPrice();
         double curSL = NormalizeDouble(OrderStopLoss(), Digits);
         double curTP = NormalizeDouble(OrderTakeProfit(), Digits);

         // Check if price moved >= InpBasketDeRiskOrderProfitDistRaw ($50 raw distance) in profit
         if(Bid >= oOpen + InpBasketDeRiskOrderProfitDistRaw)
           {
            // If StopLoss is not already at or above open price
            if(curSL < oOpen || curSL == 0.0)
              {
               double beSL = NormalizeDouble(oOpen, Digits);
               bool modified = SafeOrderModify(tkt, oOpen, beSL, curTP, 0, clrLimeGreen, "BasketDeRisk_BE_SL");
               if(modified)
                 {
                  PrintFormat(">>> [BASKET DE-RISK BE SL] BUY Order #%d (+%.1f raw pts profit >= $%.0f) | StopLoss locked at OpenPrice=%.2f (Breakeven)",
                              tkt, (Bid - oOpen), InpBasketDeRiskOrderProfitDistRaw, beSL);
                 }
              }
           }
        }

      // B. For the oldest losing BUY order (#1):
      if(InpBasketDeRiskOlderOrderExitAtBE)
        {
         if(OrderSelect(oldestBuyTicket, SELECT_BY_TICKET, MODE_TRADES))
           {
            double oOpen = OrderOpenPrice();
            double curTP = NormalizeDouble(OrderTakeProfit(), Digits);
            double curSL = NormalizeDouble(OrderStopLoss(), Digits);

            // If price bounced back to or above Order #1's open price -> close immediately at breakeven ($0 loss)
            if(Bid >= oOpen)
              {
               PrintFormat(">>> [BASKET DE-RISK OLDER ORDER EXIT] BUY Order #%d bounced back to OpenPrice=%.2f (Bid=%.2f) | Closing at Breakeven ($0 Loss)!",
                           oldestBuyTicket, oOpen, Bid);
               SafeOrderCloseMarket(oldestBuyTicket, OrderLots(), Slippage, clrGold);
              }
            // Otherwise, set TakeProfit to OpenPrice if not already set and valid
            else
               if(oOpen > Ask + (MarketInfo(Symbol(), MODE_STOPLEVEL) * Point))
                 {
                  if(MathAbs(curTP - oOpen) > Point)
                    {
                     SafeOrderModify(oldestBuyTicket, oOpen, curSL, oOpen, 0, clrGold, "BasketDeRisk_Older_TP");
                    }
                 }
           }
        }
     }

// ---------------------------------------------------------------
// 3. PROCESS SELL BASKET: Floating Loss >= $10 * mult
// ---------------------------------------------------------------
   if(sellCount >= 2 && sellBasketPL <= -lossThreshold)
     {
      // Find oldest SELL order (Order #1) by earliest open time
      int oldestSellIdx = 0;
      datetime earliestSellTime = sellOpenTimes[0];
      for(int s = 1; s < sellCount; s++)
        {
         if(sellOpenTimes[s] < earliestSellTime)
           {
            earliestSellTime = sellOpenTimes[s];
            oldestSellIdx = s;
           }
        }
      int oldestSellTicket = sellTickets[oldestSellIdx];

      // A. For all other newer SELL orders (#2, #3, etc. opened above #1):
      for(int s = 0; s < sellCount; s++)
        {
         if(s == oldestSellIdx)
            continue; // Skip Order #1 for profit BE SL

         int tkt = sellTickets[s];
         if(!OrderSelect(tkt, SELECT_BY_TICKET, MODE_TRADES))
            continue;

         double oOpen = OrderOpenPrice();
         double curSL = NormalizeDouble(OrderStopLoss(), Digits);
         double curTP = NormalizeDouble(OrderTakeProfit(), Digits);

         // Check if price moved >= InpBasketDeRiskOrderProfitDistRaw ($50 raw distance) in profit (Ask <= oOpen - 50)
         if(Ask <= oOpen - InpBasketDeRiskOrderProfitDistRaw)
           {
            // If StopLoss is not already at or below open price
            if(curSL > oOpen || curSL == 0.0)
              {
               double beSL = NormalizeDouble(oOpen, Digits);
               bool modified = SafeOrderModify(tkt, oOpen, beSL, curTP, 0, clrTomato, "BasketDeRisk_BE_SL");
               if(modified)
                 {
                  PrintFormat(">>> [BASKET DE-RISK BE SL] SELL Order #%d (+%.1f raw pts profit >= $%.0f) | StopLoss locked at OpenPrice=%.2f (Breakeven)",
                              tkt, (oOpen - Ask), InpBasketDeRiskOrderProfitDistRaw, beSL);
                 }
              }
           }
        }

      // B. For the oldest losing SELL order (#1):
      if(InpBasketDeRiskOlderOrderExitAtBE)
        {
         if(OrderSelect(oldestSellTicket, SELECT_BY_TICKET, MODE_TRADES))
           {
            double oOpen = OrderOpenPrice();
            double curTP = NormalizeDouble(OrderTakeProfit(), Digits);
            double curSL = NormalizeDouble(OrderStopLoss(), Digits);

            // If price bounced back to or below Order #1's open price -> close immediately at breakeven ($0 loss)
            if(Ask <= oOpen)
              {
               PrintFormat(">>> [BASKET DE-RISK OLDER ORDER EXIT] SELL Order #%d bounced back to OpenPrice=%.2f (Ask=%.2f) | Closing at Breakeven ($0 Loss)!",
                           oldestSellTicket, oOpen, Ask);
               SafeOrderCloseMarket(oldestSellTicket, OrderLots(), Slippage, clrGold);
              }
            // Otherwise, set TakeProfit to OpenPrice if not already set and valid
            else
               if(oOpen < Bid - (MarketInfo(Symbol(), MODE_STOPLEVEL) * Point))
                 {
                  if(MathAbs(curTP - oOpen) > Point)
                    {
                     SafeOrderModify(oldestSellTicket, oOpen, curSL, oOpen, 0, clrGold, "BasketDeRisk_Older_TP");
                    }
                 }
           }
        }
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void OnTick()
  {
   RefreshRates();

// Update live trend & angle metrics on every incoming tick (even when paused)
   GlobalEmaAngle30   = GetEmaAngleDegrees(30);
   GlobalEmaAngle200  = GetEmaAngleDegrees(200);
   GlobalSSLDirection = GetCurrentSSLDirection();
   double tickEma200  = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, 0);
   if(tickEma200 > 0.0)
      EMADirection = (Bid > tickEma200) ? 1 : ((Bid < tickEma200) ? -1 : 0);

   CheckForNewDay();
   CheckAndResumeDayTradingOnEmaDirectionChange();
   CheckAndResumeDayTradingOnStrongAngleAndSSL();
   CheckDeepDrawdownRecoveryShield(); // Choice B: V-Shape Deep Drawdown Recovery Breakeven Shield
   CheckBasketLossDeRiskAndBreakevenProtection(); // Basket Loss >= $10: Below order BE SL at +$50 raw & Older order BE exit
   IsDailyEquityStopReached(); // Check target every tick; sets g_dailyEquityTradingBlocked and closes all orders if hit

   // Record every tick highest spike bucket profit and protect 50% of profit (runs on every incoming tick)
   ManageSpikeProfitLadder();

   // USER RULE: On opposite horizontal line start: modify profitable order SL to live price
   ManageHorizontalLineProfitLiveStopLoss();

   // USER RULE: When ANY horizontal line ends: modify open orders (profit > $0.50) SL to live price
   ManageHorizontalLineEndedProfitLiveStopLoss();

   bool isTradingPausedOrBlocked = (g_dailyEquityTradingBlocked || g_manualTradingPaused || DayProfitLadderTradingStopped || g_dailyEquityAdverseLossHitToday || TradingHaltedUntilNextFlip);

   if(isTradingPausedOrBlocked)
     {
      // Safety check: ensure all EA orders are truly closed and pending deleted (unless manual pause keeping open market orders)
      if(!g_manualTradingPaused || InpCloseOrdersOnManualPause)
        {
         int activeEAOrders = 0;
         for(int act_i = OrdersTotal() - 1; act_i >= 0; act_i--)
           {
            if(OrderSelect(act_i, SELECT_BY_POS, MODE_TRADES))
              {
               if(OrderSymbol() == Symbol() && OrderMagicNumber() == MagicNumber)
                  activeEAOrders++;
              }
           }
         if(activeEAOrders > 0)
           {
            PrintFormat(">>> [DAILY STOP SAFETY CHECK] %d order(s) still open/pending after stop! Forcing close/delete...", activeEAOrders);
            CloseAndDeleteAllEAOrdersOnTradingStop();
           }
        }

      // ==============================================================
      // SPEED OPTIMIZATION (ONLY TESTING):
      // Testing time + Trading Paused = Hide Dashboard and icons, chart icons, lines etc.
      // EA moves much faster in testing time without dashboard, lines and icons.
      // ==============================================================
      if((IsTesting() || IsOptimization()) && InpHideVisualsWhenPausedInTesting)
        {
         if(!g_testerPausedVisualsCleaned)
           {
            HideAllVisualsAndIconsInTestingPaused();
            g_testerPausedVisualsCleaned = true;
            Print(">>> [TESTER SPEEDUP] Trading Paused: Dashboards, chart icons & lines hidden. Fast-forwarding tester ticks...");
           }
         return;
        }

      DailyProtectionState pauseDashState = GetCurrentDailyState();
      UpdateDashboardsThrottled(pauseDashState);
      UpdateDubaiTradingPauseDashboard(); // Keep dashboard updated while paused
      UpdateLeftLiveOrdersDashboard();    // Refresh live dashboard while paused
      if(ShowTopCenterDubaiTime)
         UpdateTopCenterDubaiTimeDisplay();

      // Draw chart indicators, lines & icons on every incoming tick while trading is paused
      if(ShowSSLLines)
         UpdateSSLChannelOnTick();
      UpdateEMALineOnChart();
      UpdateLiquiditySweepDetectorOnChart();

      // Draw live SSL signal arrows / labels if SSL flips while paused
      if(ShowSignalArrows || ShowSignalText)
        {
         if(IsLiveBuySignal())
            DrawLiveSignal(0, true);
         else
            if(IsLiveSellSignal())
               DrawLiveSignal(0, false);
        }

      ChartRedraw(0);

      return;
     }
   else
     {
      if(IsTesting() || IsOptimization())
        {
         if(g_testerPausedVisualsCleaned)
           {
            g_testerPausedVisualsCleaned = false;
            // Reset update throttles so dashboards and indicators are redrawn immediately upon resume
            LastDashboardUpdateSec   = 0;
            g_lastLeftDashUpdateMs   = 0;
            g_lastTopDubaiUpdateMs   = 0;
            LastSSLUpdateMs          = 0;
            LastEMARedrawMs          = 0;
            g_forceSweepRecalc       = true;
            Print(">>> [TESTER SPEEDUP] Trading Resumed: Restoring dashboards, chart icons & lines.");
           }
        }
     }

   if(AccountEquity()<=0)
      return ;

   CurrentTickSequence++;
   g_onTickSequence++;
   InvalidateOrderCache();
   ResetTradeErrorRetryGuards();
   TradeOperationFailedThisTick = false;
   ResetTradeRequestBudget();
   g_eqDdForceCloseBudget = false;


   profitAfterFlip = GetProfitAfterLastEmaFlip();


   if(GetOpenPL(OP_BUY)<0 || GetOpenPL(OP_SELL)<0)
     {

      MinimumSLModifyGapRaw=10;//
     }



// balancelomultipler is fixed per session/day to prevent floating drawdown truncation


// Priority #1 (VMULTI-1243): Method 6 Multi-Order Combination Close / Release
   ModifyMethod6MultiOrderCombinationsOver5USD();
// Priority #2: Individual Order Profit Ladder (All Lots + Level 1+ Half-Close)
   if(g_lastMethod6ActionTick != CurrentTickSequence)
      SecureOneDollarProfit();
   CheckEmaFlipHalfDistancePartialLossCut();
   CheckMaxLossCap001Lots();
   Check90PctSLAdversePartialCutAndDoubleSL();
   ManageEquityDrawdownTieredLotReduction();
   ManageHourlySideLoss20PctCut();
   ManageAdversePriceStepLossCut();
   Check50PctDrawdownReliefTightenSL();
   CheckEquitySurplusReset();
   PruneEquityHitSecuredTickets();

   if(InpEnableBasketProfitClose)
      CheckBasketProfitClose();

   // USER RULE: Spike Profit Ladder ($5 step ladder, live SL trail & 50% profit protection)
   ManageSpikeProfitLadder();

   if(InpCancelPendingReEntryOnLoss)
      CancelPendingReEntryOnLoss(0);

   CloseProfitableOrderCombinations(); // Method 4: Combination profit handler (> $1*mult, $150 SL gap)
   CheckAndCloseOrphanFLIPBasketSupportOrders(); // Ensure FLIPBasketSupport is never orphan/single without regular basket orders
   ManageOverallBasketProfit();//modify basket orders at $1 profit
   ManageFLIPBasketSupportTrailingStopLoss(); // Dedicated step-trailing StopLoss on every 100 step move in positive profit

   ManageDayProfitLadder();

   if(enable5PercentClose)
      Manage5PercentLadderReset();

// modifyOnlySellOrders & modifyOnlyBuyOrders DISABLED: Preserves SecureOneDollarProfit proportional ladder breathing room
   if(InpEnableModifyOnlyBuySellBasket)
     {
      if(GetTotalSellOrders()>1)
         modifyOnlySellOrders();
      if(GetTotalBuyOrders()>1)
         modifyOnlyBuyOrders();
     }
   CheckAndCloseOrphanFLIPBasketSupportOrders();


//ManageDubaiNightOneSideCloseAll();

// IsDailyEquityStopReached(); // Moved to top of OnTick() for immediate close on first hit tick

   UpdateMomentumBackground();
   UpdateDubaiTradingPauseDashboard();
   uint tickStartMs=GetTickCount();

// STREAMLINED EXITS: Disabled conflicting secondary ladders to let Manage5PercentLadderReset & SecureOneDollarProfit lead
// CheckEquityBalanceProfitTarget(); // DISABLED: Prevents premature 25-cent clamp
// CheckDynamicStepLadder();          // DISABLED: Consolidated into master Manage5PercentLadderReset
   EquityProfitLadder5();             // Enabled: Lowest Equity Recovery Ladder (-$100 SL gap on step hit)
// CloseOppositeOrdersOnEmaDistance();// DISABLED: Preserves breathing cushion during EMA trend shifts

   UpdateLiquiditySweepDetectorOnChart();
   SyncHorizontalLineActivationTimers();
   SyncSweepOppositeBlockState();
   SyncHorizontalLineStartPendingCleanup();
// ManageLsdSweepLineStopLossProtection(); // DISABLED: LSD Sweep lines only create FlipBasketSupport, DO NOT modify/close orders

   if(MathAbs(GlobalEmaAngle30) < InpHorizontalOrderMaxEmaAngle && EMADirection == -1)
     {
      CheckNewGreenLineCloseSellAndOpenBuy(); // USER RULE: On new EQH-G green line: close SELL if loss < $1*mult & open SSL Long 0.02*mult
     }

   if(MathAbs(GlobalEmaAngle30) < InpHorizontalOrderMaxEmaAngle && EMADirection == 1)
     {
      CheckNewRedLineCloseBuyAndOpenSell();
     }

   if(InpEnableLsdSweepFlipBasketSupport)
      CheckLsdSweepFlipBasketSupportOrder(); // Stage 2: Line Active support order creation (Disabled)
   ManageHorizontalOrderEndedStopLoss(); // USER RULE: When horizontal line ends, modify open horizontal order with $50 gap SL
   ManageHorizontalLineEndedBreakoutStopLoss(); // USER RULE: When horizontal line ends & price breaks past line by $100: modify ALL open orders SL to LinePrice +/- $200
   ManageHorizontalLineProfitLiveStopLoss(); // USER RULE: Opposite horizontal line active + order profit >= $0.50 -> modify SL to live price
   ManageHorizontalLineEndedProfitLiveStopLoss(); // USER RULE: When ANY horizontal line ends: modify open orders (profit > $0.50) SL to live price
   Check1HourHorizontalLinePendingOrders(); // USER RULE: If horizontal line live > 1 hour & live price near $50 -> create pending order (Red: SELL, Green: BUY)

   OnTickCore();
   OnTickPerformanceEnd(tickStartMs);

   ModifyPairProfitWithStopLoss(); // Method 1: Multi-order pair/triplet SL modifier (> $1*mult, $150 SL gap)
// ModifyMethod6MultiOrderCombinationsOver5USD(); // Moved to Priority #1 before SecureOneDollarProfit() (VMULTI-1243)
   CheckAndDrawMultiOrderClosedIcons(); // Multi-order closed icons (+2, +3, +4...) for all 6 methods
   ProcessMethodAnalyticsTracker(); // Track released profit for all methods


   if(Time[0] != LastVShapeCheckedTime)
     {
      GlobalVShapeBuy = false;
      GlobalVShapeSell = false;
      LastVShapeCheckedTime = Time[0];

      // 1. Alert, Clear Opposite Orders, and Draw
      if(DetectBounceback(1, 1))
        {
         GlobalVShapeBuy = true;
         DrawBouncebackIcon(Time[1], Low[1] - (50 * Point), 1);
         Print("GLOBAL EVENT: Bullish Bounce Detected! Closing Sells & waiting 5 mins.");

         // for(int i = OrdersTotal() - 1; i >= 0; i--)
         //   {
         //    if(OrderSelect(i, SELECT_BY_POS, MODE_TRADES) && OrderSymbol() == Symbol() && OrderMagicNumber() == MagicNumber)
         //      {
         //       if(OrderType() == OP_SELL)
         //          SafeOrderClose(OrderTicket(), OrderLots(), OP_SELL, Slippage, clrBlue);
         //       else
         //          if(OrderType() == OP_SELLSTOP || OrderType() == OP_SELLLIMIT)
         //             SafeOrderDelete(OrderTicket(), clrBlue);
         //      }
         //   }

         PendingVShapeBuyTime = TimeCurrent();
         PendingVShapeBuyPrice = Close[1];
        }

      if(DetectBounceback(-1, 1))
        {
         GlobalVShapeSell = true;
         DrawBouncebackIcon(Time[1], High[1] + (50 * Point), -1);
         Print("GLOBAL EVENT: Bearish Bounce Detected! Closing Buys & waiting 5 mins.");

         // for(int i = OrdersTotal() - 1; i >= 0; i--)
         //   {
         //    if(OrderSelect(i, SELECT_BY_POS, MODE_TRADES) && OrderSymbol() == Symbol() && OrderMagicNumber() == MagicNumber)
         //      {
         //       if(OrderType() == OP_BUY)
         //          SafeOrderClose(OrderTicket(), OrderLots(), OP_BUY, Slippage, clrRed);
         //       else
         //          if(OrderType() == OP_BUYSTOP || OrderType() == OP_BUYLIMIT)
         //             SafeOrderDelete(OrderTicket(), clrRed);
         //      }
         //   }

         PendingVShapeSellTime = TimeCurrent();
         PendingVShapeSellPrice = Close[1];
        }

      for(int i = 1; i <= 10; i++)
        {
         if(DetectBounceback(1, i))
            GlobalVShapeBuy = true;
         if(DetectBounceback(-1, i))
            GlobalVShapeSell = true;
        }

      ScanAndMarkStructuralPatterns();


     } // <-- End of new candle block
   DrawMomentumMarkers();

// ==========================================================
// 5-MINUTE TIMER CHECKS (RUNS EVERY TICK, OUTSIDE BAR BLOCK)
// ==========================================================
   if(PendingVShapeBuyTime > 0 && TimeCurrent() >= PendingVShapeBuyTime + 300)
     {
      if((Ask - PendingVShapeBuyPrice) / Point > 30)
        {
         GlobalVShapeBuy  = true;
         GlobalVShapeSell = false;
         if(EnableTrading)
            OpenBuy();
         GlobalVShapeBuy  = false;
        }
      else
        {
         Print("Bullish bounce canceled: Price did not increase by 30 points in 5 mins.");
        }
      PendingVShapeBuyTime = 0;
     }

   if(PendingVShapeSellTime > 0 && TimeCurrent() >= PendingVShapeSellTime + 300)
     {
      if((PendingVShapeSellPrice - Bid) / Point > 30)
        {
         GlobalVShapeSell = true;
         GlobalVShapeBuy  = false;
         if(EnableTrading)
            OpenSell();
         GlobalVShapeSell = false;
        }
      else
        {
         Print("Bearish bounce canceled: Price did not drop by 30 points in 5 mins.");
        }
      PendingVShapeSellTime = 0;
     }

   ProcessOrderLoggerTick();

  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| Close / Delete all pending orders when SSL signal changes        |
//+------------------------------------------------------------------+
int CloseAllPendingOrdersOnSSLChange(int fromDirection, int toDirection)
  {
   int deletedCount = 0;
   RefreshRates();

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;

      // Match current chart symbol and EA magic number
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int type = OrderType();
      if(type == OP_BUYSTOP || type == OP_SELLSTOP || type == OP_BUYLIMIT || type == OP_SELLLIMIT)
        {
         int ticket = OrderTicket();
         string typeStr = (type == OP_BUYSTOP ? "BUY STOP" : (type == OP_SELLSTOP ? "SELL STOP" : (type == OP_BUYLIMIT ? "BUY LIMIT" : "SELL LIMIT")));
         double lots = OrderLots();
         double openPrice = OrderOpenPrice();

         ResetLastError();
         if(OrderDelete(ticket, clrYellow))
           {
            deletedCount++;
            Print(">>> [SSL SIGNAL CHANGE] Deleted Pending Order #", ticket,
                  " (", typeStr, " ", DoubleToString(lots, 2), " @ ", DoubleToString(openPrice, Digits), ")");
           }
         else
           {
            Print(">>> [SSL SIGNAL CHANGE] Failed to delete Pending Order #", ticket, " | Error: ", GetLastError());
           }
        }
     }

   if(deletedCount > 0)
     {
      InvalidateTotalEAOrdersCache();
      string fromStr = (fromDirection == 1) ? "BUY (+1)" : (fromDirection == -1 ? "SELL (-1)" : "NONE (0)");
      string toStr   = (toDirection == 1) ? "BUY (+1)" : (toDirection == -1 ? "SELL (-1)" : "NONE (0)");
      Print(">>> [SSL SIGNAL CHANGE] Total Pending Orders Deleted: ", deletedCount, " (SSL changed from ", fromStr, " to ", toStr, ")");
     }

   return deletedCount;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void ForceDeleteAllPendingOrders()
  {
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int type = OrderType();
      if(type == OP_BUYSTOP || type == OP_SELLSTOP || type == OP_BUYLIMIT || type == OP_SELLLIMIT)
        {
         ResetLastError();
         if(!OrderDelete(OrderTicket(), clrYellow))
            Print("Force delete failed for ticket: ", OrderTicket(), " Error: ", GetLastError());
        }
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void CheckMomentumExhaustionExits()
  {
   double adxMain = iADX(Symbol(), PERIOD_M1, 14, PRICE_CLOSE, MODE_MAIN, 0);
   double adxPrev = iADX(Symbol(), PERIOD_M1, 14, PRICE_CLOSE, MODE_MAIN, 1);
   if(adxPrev > 35.0 && adxMain < 35.0)
     {
      for(int i=OrdersTotal()-1; i>=0; i--)
        {
         if(OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
           {
            if(OrderSymbol()==Symbol() && OrderMagicNumber()==MagicNumber && (OrderProfit() + OrderSwap() + OrderCommission()) > 0)
               SafeOrderClose(OrderTicket(), OrderLots(), OrderType(), Slippage, clrYellow);
           }
        }
     }
  }
//+------------------------------------------------------------------+
//| Check Stored Signals and Execute on EMA Trend Flip               |
//+------------------------------------------------------------------+
void CheckStoredSignals(DailyProtectionState &dailyState)
  {
   if(!EnableTrading || IsDailyTradingStopped(dailyState))
      return;

   int maxMemorySeconds = 7200; // 2 hours expiration window

   if(StoredSellSignalActive)
     {
      if(TimeCurrent() - StoredSellSignalTime > maxMemorySeconds)
        {
         StoredSellSignalActive = false;
         Print("STORED SELL SIGNAL EXPIRED: 2 hours elapsed without EMA flip.");
        }
      else
         if(PassesEMAFilter(OP_SELL))
           {
            Print("EMA FLIPPED TO SELL MODE: Executing stored SSL Sell signal.");
            StoredSignalOverride = true;
            if(GetTotalEAOrders() < MaxOpenOrders)
               OpenSell();
            StoredSignalOverride = false;
            StoredSellSignalActive = false;
           }
     }

   if(StoredBuySignalActive)
     {
      if(TimeCurrent() - StoredBuySignalTime > maxMemorySeconds)
        {
         StoredBuySignalActive = false;
         Print("STORED BUY SIGNAL EXPIRED: 2 hours elapsed without EMA flip.");
        }
      else
         if(PassesEMAFilter(OP_BUY))
           {
            Print("EMA FLIPPED TO BUY MODE: Executing stored SSL Buy signal.");
            StoredSignalOverride = true;
            if(GetTotalEAOrders() < MaxOpenOrders)
               OpenBuy();
            StoredSignalOverride = false;
            StoredBuySignalActive = false;
           }
     }
  }

//+------------------------------------------------------------------+
//| Modify an open order's Stop Loss by Ticket                      |
//+------------------------------------------------------------------+
bool ModifyOrderStopLossByTicket(int ticket, double newStopLoss)
  {
// Select the order by ticket
   if(!OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
     {
      Print("Failed to select order #", ticket, " for modification. Error: ", GetLastError());
      return false;
     }

// Ensure the order is still open and belongs to the current chart symbol
   if(OrderCloseTime() != 0)
     {
      Print("Order #", ticket, " is already closed. Cannot modify.");
      return false;
     }

   if(OrderSymbol() != Symbol())
     {
      Print("Order #", ticket, " symbol (", OrderSymbol(), ") does not match chart symbol (", Symbol(), ").");
      return false;
     }

   int    type      = OrderType();
   double openPrice = OrderOpenPrice();
   double currentTP = OrderTakeProfit();
   double currentSL = OrderStopLoss();

// Only modify if the stop loss is actually different
   if(NormalizeDouble(currentSL, Digits) == NormalizeDouble(newStopLoss, Digits))
     {
      return true; // Already set to this SL
     }

// Send the modification request
   bool modified =SafeOrderModify(ticket, openPrice, newStopLoss, currentTP, 0, clrYellow);

   if(!modified)
     {
      Print("Failed to modify Stop Loss for order #", ticket, ". Error: ", GetLastError());
      return false;
     }

   Print("Successfully updated Stop Loss for order #", ticket, " to ", DoubleToString(newStopLoss, Digits));
   return true;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void OnTickCore()
  {
   static int s_lastCoreBudgetResetSeq = -1;
   CurrentTickSequence++;
   CachedTotalEAOrders=-1;
   CachedTotalEAOrdersTick=-1;
   ResetTradeErrorRetryGuards();
   TradeOperationFailedThisTick = false;
   CheckLadderHaltResume(); // <-- ADD THIS LINE HERE

   TrackEmaFlip();
   ManagePriceGap1000DayProfit5PctCloseAll();
   CheckFlipProfitTarget(); // Add this line


//////////ManageFlipProfitLadder(); // Add this line// LEVEL 1 Step$5 profit ladder is not required - wrong calculation and closeing orders immidiatly/partial close orders having problem becauseo f this
// Manage50EmaClosures();
// ManageEmaAngleOppositeClose(); // <-- Add this here
   ProcessDeferredOrders();


   if(TradeOperationFailedThisTick)
     {
      if(ShowSSLLines)
         UpdateSSLChannelOnTick();
      UpdateEMALineOnChart();
      return;
     }

   if(s_lastCoreBudgetResetSeq != g_onTickSequence)
     {
      ResetTradeRequestBudget();
      s_lastCoreBudgetResetSeq = g_onTickSequence;
     }
   RefreshRates();

// --- UPDATE GLOBAL TICK VARIABLES ---
   GlobalEmaAngle30 = GetEmaAngleDegrees(30);
   GlobalEmaAngle200 = GetEmaAngleDegrees(200);

   int currentSSLDirection = GetCurrentSSLDirection();

// USER RULE (VMULTI-1232): When MOM marker is active on current bar and EMA direction confirms or flipped, align SSL with MOM
   if(g_momOverrideBarTime == Time[0] && g_momOverrideDirection != 0)
     {
      if(EMADirection == 0 || EMADirection == g_momOverrideDirection)
        {
         currentSSLDirection = g_momOverrideDirection;
        }
     }

   if(LiveSSLInitialized && LastTrackedSSLDirection != 0 && currentSSLDirection != 0 && currentSSLDirection != LastTrackedSSLDirection)
     {
      if(DeletePendingOrdersOnSSLChange)
        {
         CloseAllPendingOrdersOnSSLChange(LastTrackedSSLDirection, currentSSLDirection);
        }
      LastTrackedSSLDirection = currentSSLDirection;
     }
   else
      if(!LiveSSLInitialized && currentSSLDirection != 0)
        {
         LiveSSLInitialized = true;
         LastTrackedSSLDirection = currentSSLDirection;
        }

   GlobalSSLDirection = currentSSLDirection;
   Global30MinDiffBuy = Get30MinDifference(OP_BUY);
   Global30MinDiffSell = Get30MinDifference(OP_SELL);

   Get5MinDifferenceBuy1 = Get5MinDifference(OP_BUY);
   Get5MinDifferenceSell1 = Get5MinDifference(OP_SELL);




   UpdateOrderCacheIfNeeded();

   TradeResetThisTick = false;

   if(StartupProtectionTicks < 1)
     {
      StartupProtectionTicks++;
      EAStartupComplete = true;
     }

   static DailyProtectionState dailyState;
   if(!dailyState.Initialized)
      InitializeDailyProtectionState(dailyState);


// ADD THIS LINE HERE:

   if(ProcessServerRecovery(dailyState))
     {
      if(ShowSSLLines)
         UpdateSSLChannelOnTick();
      UpdateEMALineOnChart();
      UpdateDashboardsThrottled(dailyState);
      return;
     }



   UpdateDailyLossProtection(dailyState);

   CheckLatestClosedTradeProtection();
// CheckMissedSignalMemory(dailyState); // <-- Add this here
   CheckStoredSignals(dailyState); // <-- Add this here

   if(IsProtectedEquityWaiting())
     {
      if(ShowSSLLines)
         UpdateSSLChannelOnTick();
      UpdateEMALineOnChart();
      UpdateDashboardsThrottled(dailyState);
      return;
     }

   CheckRecoveryOrders();
   CheckReverse100OppositeOrders();     // 1-Time >$100 Opposite 2X Reverse Order (priority over Type 2/Hedge)
   CheckLsdStructuralRecoveryOrders();  // EQL/EQH Structural Recovery (Type 2)
   CheckType3WeakEmaRecoveryOrders();   // Weak EMA Reversal Recovery (Type 3)
   CheckTrendShiftHedgeRecoveryOrders(); // Trend-Shift Hedge Rescue (Disabled / replaced by Reverse100)
   if(TradeOperationFailedThisTick)
     {
      UpdateDashboardsThrottled(dailyState);
      return;
     }
   ManageRecoveryBasket();
   if(TradeOperationFailedThisTick)
     {
      UpdateDashboardsThrottled(dailyState);
      return;
     }
   ManageReverse100AdverseStepPartialClose();
   if(TradeOperationFailedThisTick)
     {
      UpdateDashboardsThrottled(dailyState);
      return;
     }

   if(DayProfitLadderTargetCleanupPending && !DayProfitLadderTradingStopped)
     {
      if(!CloseAllEAOrdersForLadderReset())
        {
         UpdateDashboardsThrottled(dailyState);
         return;
        }
      DayProfitLadderTargetCleanupPending = false;
      SaveDayProfitLadderState();
     }

   if(DayProfitLadderResumePending && DayProfitLadderResumeDirection != 0 && !DayProfitLadderTradingStopped)
     {
      int resumeDirection = DayProfitLadderResumeDirection;
      DayProfitLadderResumeTradeAttempt = true;
      bool ladderPendingCreated=false;
      if(resumeDirection == 1)
         ladderPendingCreated=CreateDayProfitLadderPending(OP_BUY);
      else
         if(resumeDirection == -1)
            ladderPendingCreated=CreateDayProfitLadderPending(OP_SELL);
      DayProfitLadderResumeTradeAttempt = false;
      if(ladderPendingCreated)
        {
         DayProfitLadderResumePending = false;
         DayProfitLadderResumeDirection = 0;
        }
     }

   if(TradeOperationFailedThisTick)
     {
      UpdateDashboardsThrottled(dailyState);
      return;
     }
   ProcessStartupSignal(dailyState);
   if(TradeOperationFailedThisTick)
     {
      UpdateDashboardsThrottled(dailyState);
      return;
     }
   if(EquityResetReEntryPending)
      ProcessEquityResetReEntry(dailyState);
   if(TradeOperationFailedThisTick)
     {
      UpdateDashboardsThrottled(dailyState);
      return;
     }

   if(ShowSSLLines)
      UpdateSSLChannelOnTick();
   UpdateEMALineOnChart();

   if(!TradeResetThisTick)
      ManageProfitReEntryMomentumGate();
   if(TradeOperationFailedThisTick)
     {
      UpdateDashboardsThrottled(dailyState);
      return;
     }
   if(!TradeResetThisTick)
      ProcessPendingReEntry(dailyState);
   if(TradeOperationFailedThisTick)
     {
      UpdateDashboardsThrottled(dailyState);
      return;
     }

   if(TradeOperationFailedThisTick)
     {
      UpdateDashboardsThrottled(dailyState);
      return;
     }
   if(EnableProfitLadder1 || EnableProfitLadder2)
      ManageProfitLadder();

   if(InpEnablePartialLossCut)
      ManagePartialClosesLoss();

   if(TradeOperationFailedThisTick)
     {
      UpdateDashboardsThrottled(dailyState);
      return;
     }

   UpdateDashboardsThrottled(dailyState);

// CloseOppositeProfitableOrdersIndependent(OP_BUY);

// CloseOppositeProfitableOrdersIndependent(OP_SELL);


   if(Bars < SSLPeriod + 20)
      return;

   bool buySignal  = IsLiveBuySignal();
   bool sellSignal = IsLiveSellSignal();

   int currentTrend = GlobalSSLDirection;
   if(InpFollowEmaIgnoreSsl)
     {
      if(EMADirection == 1)
        {
         currentTrend = 1;
         sellSignal   = false;
        }
      else if(EMADirection == -1)
        {
         currentTrend = -1;
         buySignal    = false;
        }
     }

   bool missingBuyOrder = (currentTrend == 1 && CountDirectionOrders(OP_BUY) == 0 && CountDirectionOrders(OP_BUYSTOP) == 0);
   bool missingSellOrder = (currentTrend == -1 && CountDirectionOrders(OP_SELL) == 0 && CountDirectionOrders(OP_SELLSTOP) == 0);

   if(InpFollowEmaIgnoreSsl)
     {
      if(EMADirection == 1)
        {
         sellSignal       = false;
         missingSellOrder = false;
        }
      else if(EMADirection == -1)
        {
         buySignal        = false;
         missingBuyOrder  = false;
        }
     }

   // USER RULE: Unconditional Spike Order Creation
   // "create spike orders without any condition"
   // "EMAdirection is 1 , but ema angle is negative means spike in bullish so create BUY orders. 
   //  similary EMAdirection is -1 but EMAangle is positive value then create SELL orders normal ssl orders with pending orders"
   // Method 2: 1-Bar Candle Spike Velocity (Surge >= $300 with Wick Rejection)
   bool method2Bullish = false;
   bool method2Bearish = false;
   CheckCandleSpikeVelocity(method2Bullish, method2Bearish);
   g_isMethod2BullishSpike = method2Bullish;
   g_isMethod2BearishSpike = method2Bearish;

   bool isBullishSpike = false;
   bool isBearishSpike = false;

   if(method2Bullish)
     {
      isBullishSpike = true;
     }
   else if(method2Bearish)
     {
      isBearishSpike = true;
     }
   else if(IsType1BullishSpike(true))
     {
      isBullishSpike = true;
     }
   else if(IsType1BearishSpike(true))
     {
      isBearishSpike = true;
     }

   if(isBullishSpike)
     {
      sellSignal = false;
      missingSellOrder = false;

      // Clean up stale pending spike orders if price drifted away (or delete all pending if operating in direct market mode)
      CleanupStaleSpikePendingOrders(OP_BUYSTOP, (InpSpikeOrderPendingGapUSD <= 0.0 ? 0.0 : InpSpikeOrderStaleCleanupDistUSD));

      // Create Spike BUY order: when pending value is 0 open market orders without pending; when > 0 maintain 1 pending stop
      static datetime s_lastSpikeBuyTime = 0;
      bool canCreateSpikeBuy = false;
      if(InpSpikeOrderPendingGapUSD <= 0.0)
         canCreateSpikeBuy = (TimeCurrent() - s_lastSpikeBuyTime >= InpSpikeOrderCooldownSec);
      else
         canCreateSpikeBuy = (CountSpikePendingOrders(OP_BUYSTOP) == 0 && (TimeCurrent() - s_lastSpikeBuyTime >= 1));

      if(canCreateSpikeBuy)
        {
         s_lastSpikeBuyTime = TimeCurrent();
         if(!method2Bullish)
            g_lastType1SpikeTime = Time[0];
         g_lastMethod2SpikeTime = Time[0];
         OpenBuy("SPIKE_BUY");
        }
     }
   else if(isBearishSpike)
     {
      buySignal = false;
      missingBuyOrder = false;

      // Clean up stale pending spike orders if price drifted away (or delete all pending if operating in direct market mode)
      CleanupStaleSpikePendingOrders(OP_SELLSTOP, (InpSpikeOrderPendingGapUSD <= 0.0 ? 0.0 : InpSpikeOrderStaleCleanupDistUSD));

      // Create Spike SELL order: when pending value is 0 open market orders without pending; when > 0 maintain 1 pending stop
      static datetime s_lastSpikeSellTime = 0;
      bool canCreateSpikeSell = false;
      if(InpSpikeOrderPendingGapUSD <= 0.0)
         canCreateSpikeSell = (TimeCurrent() - s_lastSpikeSellTime >= InpSpikeOrderCooldownSec);
      else
         canCreateSpikeSell = (CountSpikePendingOrders(OP_SELLSTOP) == 0 && (TimeCurrent() - s_lastSpikeSellTime >= 1));

      if(canCreateSpikeSell)
        {
         s_lastSpikeSellTime = TimeCurrent();
         if(!method2Bearish)
            g_lastType1SpikeTime = Time[0];
         g_lastMethod2SpikeTime = Time[0];
         OpenSell("SPIKE_SELL");
        }
     }

   if(buySignal || missingBuyOrder)
     {
      if(buySignal)
         DrawLiveSignal(0, true);
      if(LastLiveSignalCandle != Time[0] || LastLiveSSLDirection != 1 || missingBuyOrder)
        {
         LastLiveSignalCandle = Time[0];
         LastLiveSSLDirection = 1;

         if(EnableTrading && !IsDailyTradingStopped(dailyState))
           {
            // if(CloseOppositeOrdersOnSignal)
            // CloseOppositeProfitableOrdersOnSignal(OP_BUY);

            // CloseOppositeProfitableOrdersIndependent(OP_BUY);
            // CloseOppositeOrders(OP_BUY);

            if(GetTotalEAOrders() < MaxOpenOrders)
              {
               if(PassesEMAFilter(OP_BUY))
                 {
                  OpenBuy();
                 }
               else
                 {
                  StoredBuySignalActive = true;
                  StoredBuySignalTime = TimeCurrent();
                  StoredSellSignalActive = false;
                  Print("SSL BUY SIGNAL STORED: Blocked by EMA. Waiting for EMA to turn bullish.");
                 }
              }
           }
        }
     }
   else
      if(sellSignal || missingSellOrder)
        {
         if(sellSignal)
            DrawLiveSignal(0, false);
         if(LastLiveSignalCandle != Time[0] || LastLiveSSLDirection != -1 || missingSellOrder)
           {
            LastLiveSignalCandle = Time[0];
            LastLiveSSLDirection = -1;

            if(EnableTrading && !IsDailyTradingStopped(dailyState))
              {
               // if(CloseOppositeOrdersOnSignal)
               // CloseOppositeProfitableOrdersOnSignal(OP_SELL);
               // CloseOppositeOrders(OP_SELL);

               // CloseOppositeProfitableOrdersIndependent(OP_SELL);

               if(GetTotalEAOrders() < MaxOpenOrders)
                 {
                  if(PassesEMAFilter(OP_SELL))
                    {
                     OpenSell();
                    }
                  else
                    {
                     StoredSellSignalActive = true;
                     StoredSellSignalTime = TimeCurrent();
                     StoredBuySignalActive = false;
                     Print("SSL SELL SIGNAL STORED: Blocked by EMA. Waiting for EMA to turn bearish.");
                    }
                 }
              }
           }
        }

   if(Bars >= SSLPeriod + 20 && !TradeResetThisTick)
      CheckForProfitableClosedOrder(dailyState);
  }
//+------------------------------------------------------------------+
//| Evaluate Stored Missed Signals for Market Follow-Through         |
//+------------------------------------------------------------------+
void CheckMissedSignalMemory(DailyProtectionState &dailyState)
  {
   if(MissedSignalType == 0)
      return;

// EXPIRATION: Clear memory if 15 minutes (900 seconds) have passed without confirmation
   if(TimeCurrent() - MissedSignalTime > 15 * 60)
     {
      Print("MISSED SIGNAL EXPIRED: 15 minutes elapsed without market confirmation.");
      MissedSignalType = 0;
      MissedSignalPrice = 0.0;
      MissedSignalTime = 0;
      return;
     }

   RefreshRates();

// Check for Buy confirmation (Price moves UP from stored reference price by at least 10 points)
   if(MissedSignalType == 1)
     {
      if((Ask - MissedSignalPrice) / Point >= 10.0)
        {
         Print("MISSED BUY CONFIRMED: Market moved up in stored direction. Executing order.");
         MissedSignalOverride = true;
         if(EnableTrading && !IsDailyTradingStopped(dailyState))
            OpenBuy();
         MissedSignalOverride = false;

         // Reset memory
         MissedSignalType = 0;
        }
     }
// Check for Sell confirmation (Price moves DOWN from stored reference price by at least 10 points)
   else
      if(MissedSignalType == -1)
        {
         if((MissedSignalPrice - Bid) / Point >= 10.0)
           {
            Print("MISSED SELL CONFIRMED: Market moved down in stored direction. Executing order.");
            MissedSignalOverride = true;
            if(EnableTrading && !IsDailyTradingStopped(dailyState))
               OpenSell();
            MissedSignalOverride = false;

            // Reset memory
            MissedSignalType = 0;
           }
        }
  }
datetime EmaAngleExtremeStartTime = 0;
int      EmaAngleExtremeSign      = 0; // Directional sign of the extreme angle (+1 if > +5.0 deg, -1 if < -5.0 deg)

//+------------------------------------------------------------------+
//| Close Opposite Orders on Extreme EMA Angle (> 5° for 30 Mins)    |
//+------------------------------------------------------------------+
void ManageEmaAngleOppositeClose()
  {
   double emaAngle = GlobalEmaAngle30;
   int currentSign = (emaAngle > 5.0) ? 1 : ((emaAngle < -5.0) ? -1 : 0);

// Check if angle magnitude exceeds 5.0 degrees continuously in a single direction
   if(currentSign != 0)
     {
      // If timer is not running, OR if angle flipped direction (+5 to -5 or vice versa), restart timer
      if(EmaAngleExtremeStartTime == 0 || EmaAngleExtremeSign != currentSign)
        {
         EmaAngleExtremeStartTime = TimeCurrent(); // Start tracking duration when threshold is first crossed
         EmaAngleExtremeSign      = currentSign;
        }
      else
         if(TimeCurrent() - EmaAngleExtremeStartTime >= 30 * 60) // Check if 30 minutes have elapsed in the SAME direction
           {
            for(int i = OrdersTotal() - 1; i >= 0; i--)
              {
               if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
                  continue;
               if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
                  continue;

               int orderType = OrderType();

               // If EMA angle > 5 continuously for 30m, close all SELL orders
               if(currentSign == 1 && orderType == OP_SELL)
                 {
                  Print("EMA ANGLE TRIGGER (> 5° for 30m): Closing SELL order. Angle: ", DoubleToString(emaAngle, 2));
                  SafeOrderClose(OrderTicket(), OrderLots(), OP_SELL, Slippage, clrRed);
                 }

               // If EMA angle < -5 continuously for 30m, close all BUY orders
               else
                  if(currentSign == -1 && orderType == OP_BUY)
                    {
                     Print("EMA ANGLE TRIGGER (< -5° for 30m): Closing BUY order. Angle: ", DoubleToString(emaAngle, 2));
                     SafeOrderClose(OrderTicket(), OrderLots(), OP_BUY, Slippage, clrRed);
                    }
              }
           }
     }
   else
     {
      // Reset the timer and sign immediately if the angle flattens or drops back within 5 degrees
      EmaAngleExtremeStartTime = 0;
      EmaAngleExtremeSign      = 0;
     }
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool HasMinimumSameOrderGap(int orderType, double minimumGapRaw, double proposedEntryPrice = 0.0)
  {
   RefreshRates();
   bool isBuy = (orderType == OP_BUY || orderType == OP_BUYSTOP || orderType == OP_BUYLIMIT);
   double checkPrice = proposedEntryPrice;
   if(checkPrice <= 0.0)
     {
      double pendingGap = GetSSLLongShortPendingGapRaw(orderType, false);
      double minStopDist = GetRequiredStopDistance();
      if(isBuy)
        {
         double ep = Ask + pendingGap;
         if(ep < Ask + minStopDist)
            ep = Ask + minStopDist;
         checkPrice = ep;
        }
      else
        {
         double ep = Bid - pendingGap;
         if(ep > Bid - minStopDist)
            ep = Bid - minStopDist;
         checkPrice = ep;
        }
     }
   checkPrice = NormalizeDouble(checkPrice, Digits);

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int t = OrderType();
      bool matchDir = isBuy ? (t == OP_BUY || t == OP_BUYSTOP || t == OP_BUYLIMIT) : (t == OP_SELL || t == OP_SELLSTOP || t == OP_SELLLIMIT);
      if(!matchDir)
         continue;
      if(MathAbs(checkPrice - OrderOpenPrice()) < minimumGapRaw)
         return false;
     }
   return true;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double GetOpenPL(int OrderTypeFilter)
  {
   if(OrderTypeFilter == OP_BUY)
      return GlobalBuyPL;
   if(OrderTypeFilter == OP_SELL)
      return GlobalSellPL;
   return 0.0;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double GetOppositeOrdersLots(int orderType)
  {
   UpdateOrderCacheIfNeeded();
   double totalLots = 0.01;
   if(orderType == OP_BUY)
      totalLots += g_orderCache.sellLots;
   else
      if(orderType == OP_SELL)
         totalLots += g_orderCache.buyLots;
   return NormalizeLots(totalLots > 0.0 ? totalLots : OriginalLots);
  }

int reEntryCounter=0;
bool ServerRecoveryPending = false;
int  ServerRecoveryLastError = 0;
datetime ServerRecoveryDetectedTime = 0;
int ServerRecoveryResetCount = 0;
int ServerRecoveryMaxRetries = 5;
int ServerRecoveryRetryDelayMs = 400;
string ReEntryGVPrefix = "SSL_REENTRY_";
bool ReEntryRetryPending = false;
int ReEntryRetryClosedType = -1;
double ReEntryRetryClosedPrice = 0.0;
int LosingSLCount = 0;
int LastProtectedLossTicket = -1;
int BlockedSLDirection = 0;
int FreshSSLRequiredDirection = 0;
datetime SLProtectionUntil = 0;

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool CanOpenRiskOrder(int orderType, double requestedLot)
  {
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber || OrderType() != orderType)
         continue;
      double existingLot = OrderLots();
      if(MathAbs(existingLot - requestedLot) > 0.000001)
         continue;
      double pl = OrderProfit() + OrderSwap() + OrderCommission();
      double lossLimit = 3.0 * (requestedLot / 0.01);
      if(pl <= -lossLimit)
         return false;
     }
   return true;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double GetMaxOpenLotByType(int orderType)
  {
   double maxLot = 0.0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber || OrderType() != orderType)
         continue;
      if(OrderLots() > maxLot)
         maxLot = OrderLots();
     }
   return maxLot;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double GetReEntryLot(int reEntryNumber)
  {
   double lot = 0.05 - (reEntryNumber * 0.01);
   if(lot < 0.01)
      lot = 0.01;
   return NormalizeLots(lot);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool HasExistingProfitReEntryOrder()
  {
   for(int i=OrdersTotal()-1; i>=0; i--)
     {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES))
         continue;
      if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber)
         continue;
      if(StringFind(OrderComment(),"SSL Profit ReEntry",0)==0)
         return true;
     }
   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void LoadReEntryCounter() { reEntryCounter=0; }
void SaveReEntryCounter() { return; }

//+------------------------------------------------------------------+
//| Check if SSL Order or Directional Basket is in Loss              |
//+------------------------------------------------------------------+
bool IsSslOrderInLoss(int orderType, double lossThresholdUSD = 0.0)
  {
   UpdateOrderCacheIfNeeded();

   int dirType = (orderType == OP_BUY || orderType == OP_BUYSTOP || orderType == OP_BUYLIMIT) ? OP_BUY : OP_SELL;

// 1. Overall directional basket P/L check
   double basketPL = GetOpenPL(dirType);
   if(basketPL < -lossThresholdUSD)
      return true;

// 2. Individual open market order check for symbol and magic
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      if(OrderType() != dirType)
         continue;

      double orderPL = OrderProfit() + OrderSwap() + OrderCommission();
      if(orderPL < -lossThresholdUSD)
        {
         string comm = OrderComment();
         if(StringFind(comm, "SSL Long", 0) >= 0 ||
            StringFind(comm, "SSL Short", 0) >= 0 ||
            StringFind(comm, "EQH-R Short", 0) >= 0 ||
            StringFind(comm, "EQH-G Long", 0) >= 0 ||
            StringFind(comm, "SSL Profit ReEntry", 0) >= 0 ||
            StringFind(comm, "ReEntry", 0) >= 0 ||
            StringFind(comm, "SSL", 0) >= 0)
           {
            return true;
           }
         return true;
        }
     }

   return false;
  }

//+------------------------------------------------------------------+
//| Cancel Pending Profit ReEntry Orders when SSL Position is in Loss|
//+------------------------------------------------------------------+
void CancelPendingReEntryOnLoss(int checkDirection = 0)
  {
   if(!InpCancelPendingReEntryOnLoss)
      return;

// checkDirection: 0 = both, 1 = Buy only, -1 = Sell only
   bool buyInLoss = (checkDirection == 0 || checkDirection == 1) && IsSslOrderInLoss(OP_BUY, InpReEntryMaxAllowedLossUSD);
   bool sellInLoss = (checkDirection == 0 || checkDirection == -1) && IsSslOrderInLoss(OP_SELL, InpReEntryMaxAllowedLossUSD);

   if(!buyInLoss && !sellInLoss)
      return;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType != OP_BUYSTOP && oType != OP_SELLSTOP && oType != OP_BUYLIMIT && oType != OP_SELLLIMIT)
         continue;

      string comm = OrderComment();
      if(StringFind(comm, "SSL Profit ReEntry", 0) < 0)
         continue;

      if(buyInLoss && (oType == OP_BUYSTOP || oType == OP_BUYLIMIT))
        {
         Print("REENTRY CANCELLED | Deleting pending Buy ReEntry Ticket #", OrderTicket(),
               " because SSL Buy position is in loss (PL: $", DoubleToString(GetOpenPL(OP_BUY), 2), ")");
         SafeOrderDelete(OrderTicket(), clrYellow);
        }
      else
         if(sellInLoss && (oType == OP_SELLSTOP || oType == OP_SELLLIMIT))
           {
            Print("REENTRY CANCELLED | Deleting pending Sell ReEntry Ticket #", OrderTicket(),
                  " because SSL Sell position is in loss (PL: $", DoubleToString(GetOpenPL(OP_SELL), 2), ")");
            SafeOrderDelete(OrderTicket(), clrYellow);
           }
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsRetryableTradeError(int err)
  {
   switch(err)
     {
      case 4:
      case 6:
      case 128:
      case 135:
      case 136:
      case 137:
      case 138:
      case 146:
         return true;
     }
   return false;
  }

bool IsInvalidStopError(int err) { return (err == 130); }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double GetRequiredStopDistance()
  {
   double stopPts = MarketInfo(Symbol(),MODE_STOPLEVEL);
   double freezePts = 0.0;
   if(EnableFreezeLevelProtection)
      freezePts = MarketInfo(Symbol(),MODE_FREEZELEVEL);
   double requiredPts = MathMax(stopPts,freezePts) + SLProtectionSafetyBufferPoints;
   if(requiredPts < 1.0)
      requiredPts = 1.0;
   return requiredPts * Point;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool PrepareStopLossForOrder(int orderType,double referencePrice,double &stopLoss)
  {
   if(stopLoss <= 0.0)
      return true;
   RefreshRates();
   double minDistance=GetRequiredStopDistance();
   if(orderType==OP_BUY || orderType==OP_BUYSTOP || orderType==OP_BUYLIMIT)
     {
      double maxSL=Bid-minDistance;
      if(orderType==OP_BUYSTOP || orderType==OP_BUYLIMIT)
         maxSL=MathMin(maxSL,referencePrice-minDistance);
      if(maxSL<=0.0)
         return false;
      if(stopLoss>maxSL)
         stopLoss=maxSL;
     }
   else
      if(orderType==OP_SELL || orderType==OP_SELLSTOP || orderType==OP_SELLLIMIT)
        {
         double minSL=Ask+minDistance;
         if(orderType==OP_SELLSTOP || orderType==OP_SELLLIMIT)
            minSL=MathMax(minSL,referencePrice+minDistance);
         if(minSL<=0.0)
            return false;
         if(stopLoss<minSL)
            stopLoss=minSL;
        }
      else
         return true;
   stopLoss=NormalizeDouble(stopLoss,Digits);
   if(orderType==OP_BUY || orderType==OP_BUYSTOP || orderType==OP_BUYLIMIT)
     {
      if(stopLoss<=0.0 || stopLoss>=Bid)
         return false;
      if((orderType==OP_BUYSTOP || orderType==OP_BUYLIMIT) && stopLoss>=referencePrice)
         return false;
     }
   else
     {
      if(stopLoss<=Ask)
         return false;
      if((orderType==OP_SELLSTOP || orderType==OP_SELLLIMIT) && stopLoss<=referencePrice)
         return false;
     }
   return true;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsDirectionBlockedAfterSL(int orderType)
  {
   if(ContinueTradingAfterSL || !EnableSLProtection)
      return false;
   int dir=(orderType==OP_BUY)?1:-1;
   if(SLProtectionUntil>TimeCurrent() && BlockedSLDirection==dir)
      return true;
   if(RequireFreshSSLAfterLosingSL && FreshSSLRequiredDirection==dir)
      return true;
   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool HasBasketNewOrderLossLimit()
  {
   if(!EnableSLProtection || BasketNewOrderLossLimitUSD<=0.0)
      return false;
   double basket=0.0;
   for(int i=OrdersTotal()-1; i>=0; i--)
     {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES))
         continue;
      if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber)
         continue;
      if(OrderType()!=OP_BUY && OrderType()!=OP_SELL)
         continue;
      basket += OrderProfit()+OrderSwap()+OrderCommission();
     }
   return basket<=-BasketNewOrderLossLimitUSD;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int CountDirectionOrders(int orderType)
  {
   int count=0;
   for(int i=OrdersTotal()-1; i>=0; i--)
     {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES))
         continue;
      if(OrderSymbol()==Symbol() && OrderMagicNumber()==MagicNumber && OrderType()==orderType)
         count++;
     }
   return count;
  }

//+------------------------------------------------------------------+
//| IsSameCandleEmaFlip                                              |
//| Verifies if the current candle (Bar 0) is the single candle      |
//| where the EMA direction flipped from one direction to another.   |
//| Rejects if more than 1 candle has crossed since the flip.        |
//+------------------------------------------------------------------+
bool IsSameCandleEmaFlip(int requestedDirection)
  {
   if(Bars < 2)
      return false;

   double ema0 = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, 0);
   double ema1 = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, 1);
   if(ema0 <= 0.0 || ema1 <= 0.0)
      return false;

   // Direction 1: Bullish (+1) -> price flipped above EMA
   if(requestedDirection == 1)
     {
      // 1. Structural check: previous candle (Bar 1) closed below or at EMA, and Bar 0 is above EMA
      bool prevWasBearish = (Close[1] <= ema1);

      // 2. Intra-bar runtime check: EMA flipped to Bullish on current candle Bar 0
      bool runtimeFlipThisBar = (g_emaFlipCandleTime == Time[0] && g_emaFlipDirection == 1);

      // 3. Historical scanner check: actual EMA flip occurred on Bar 0
      bool scannerFlipThisBar = (GetActualEmaFlipTime(1) == Time[0]);

      return (prevWasBearish || runtimeFlipThisBar || scannerFlipThisBar);
     }
   // Direction -1: Bearish (-1) -> price flipped below EMA
   else if(requestedDirection == -1)
     {
      // 1. Structural check: previous candle (Bar 1) closed above or at EMA, and Bar 0 is below EMA
      bool prevWasBullish = (Close[1] >= ema1);

      // 2. Intra-bar runtime check: EMA flipped to Bearish on current candle Bar 0
      bool runtimeFlipThisBar = (g_emaFlipCandleTime == Time[0] && g_emaFlipDirection == -1);

      // 3. Historical scanner check: actual EMA flip occurred on Bar 0
      bool scannerFlipThisBar = (GetActualEmaFlipTime(-1) == Time[0]);

      return (prevWasBullish || runtimeFlipThisBar || scannerFlipThisBar);
     }

   return false;
  }

//+------------------------------------------------------------------+
//| IsType1BullishSpike / IsType1BearishSpike                        |
//| Evaluates Type 1 Spike condition: Angle mismatch + Single candle |
//| EMA flip requirement.                                            |
//+------------------------------------------------------------------+
bool IsType1BullishSpike(bool checkCandleLimit = true)
  {
   if(!InpEnableSpikeOrderCreation)
      return false;
   if(EMADirection != 1 || GlobalEmaAngle30 >= 0.0)
      return false;
   if(InpType1SpikeRequireSameCandleEmaFlip && !IsSameCandleEmaFlip(1))
      return false;
   if(checkCandleLimit && InpType1SpikeMaxOrdersPerCandle > 0 && g_lastType1SpikeTime == Time[0])
      return false;
   return true;
  }

bool IsType1BearishSpike(bool checkCandleLimit = true)
  {
   if(!InpEnableSpikeOrderCreation)
      return false;
   if(EMADirection != -1 || GlobalEmaAngle30 <= 0.0)
      return false;
   if(InpType1SpikeRequireSameCandleEmaFlip && !IsSameCandleEmaFlip(-1))
      return false;
   if(checkCandleLimit && InpType1SpikeMaxOrdersPerCandle > 0 && g_lastType1SpikeTime == Time[0])
      return false;
   return true;
  }

//+------------------------------------------------------------------+
//| CheckCandleSpikeVelocity: Method 2 Spike Detection               |
//| Detects 1-Bar Candle Spike Velocity (ATR or Dollar Range Surge)  |
//| and Upper/Lower Wick Rejection                                   |
//| - Upward Surge + Upper Wick Pullback -> Bearish Spike (SELL)     |
//| - Downward Dump + Lower Wick Bounce  -> Bullish Spike (BUY)      |
//+------------------------------------------------------------------+
void CheckCandleSpikeVelocity(bool &outBullishSpike, bool &outBearishSpike)
  {
   outBullishSpike = false;
   outBearishSpike = false;

   if(!InpEnableMethod2CandleSpike || !InpEnableSpikeOrderCreation)
      return;

   // Prevent multiple spike orders on the same candle if limited
   if(InpSpikeMaxOrdersPerCandle > 0 && g_lastMethod2SpikeTime == Time[0])
      return;

   double atr = iATR(Symbol(), Period(), 14, 1);
   if(atr <= 0)
      atr = 50.0 * Point;

   // Effective surge threshold: minimum dollar amount required ($300 default)
   double minSurgeUSD = InpSpikeCandleMinSurgeUSD;
   if(minSurgeUSD <= 0.0)
      minSurgeUSD = 300.0;

   // 1. LIVE CANDLE (Bar 0) INTRABAR CHECK:
   // Bearish Spike: Candle surged UP, topped out, and pulled back forming upper wick -> SELL
   double surgeUp0  = High[0] - Open[0];
   double range0    = High[0] - Low[0];
   double pullBack0 = High[0] - Bid;
   bool isSurgeUp0  = ((surgeUp0 >= minSurgeUSD || (range0 >= minSurgeUSD && Bid > Open[0])) &&
                       (InpSpikeCandleMinAtrMult <= 0.0 || surgeUp0 >= InpSpikeCandleMinAtrMult * atr));
   bool isWickDown0 = (pullBack0 >= InpSpikeWickPullbackUSD);

   if(isSurgeUp0 && isWickDown0)
     {
      outBearishSpike = true;
      static datetime lastLogBear0 = 0;
      if(TimeCurrent() - lastLogBear0 >= 5)
        {
         lastLogBear0 = TimeCurrent();
         PrintFormat(">>> [METHOD 2 SPIKE DETECTED] BEARISH SPIKE (Bar 0) | SurgeUp=$%.2f (Req=$%.2f), Pullback=$%.2f (Req=$%.2f), ATR=$%.2f -> SELL SPIKE",
                     surgeUp0, minSurgeUSD, pullBack0, InpSpikeWickPullbackUSD, atr);
        }
      return;
     }

   // Bullish Spike: Candle dumped DOWN, bottomed out, and bounced forming lower wick -> BUY
   double dumpDown0 = Open[0] - Low[0];
   double bounce0   = Ask - Low[0];
   bool isDumpDown0 = ((dumpDown0 >= minSurgeUSD || (range0 >= minSurgeUSD && Ask < Open[0])) &&
                       (InpSpikeCandleMinAtrMult <= 0.0 || dumpDown0 >= InpSpikeCandleMinAtrMult * atr));
   bool isWickUp0   = (bounce0 >= InpSpikeWickPullbackUSD);

   if(isDumpDown0 && isWickUp0)
     {
      outBullishSpike = true;
      static datetime lastLogBull0 = 0;
      if(TimeCurrent() - lastLogBull0 >= 5)
        {
         lastLogBull0 = TimeCurrent();
         PrintFormat(">>> [METHOD 2 SPIKE DETECTED] BULLISH SPIKE (Bar 0) | DumpDown=$%.2f (Req=$%.2f), Bounce=$%.2f (Req=$%.2f), ATR=$%.2f -> BUY SPIKE",
                     dumpDown0, minSurgeUSD, bounce0, InpSpikeWickPullbackUSD, atr);
        }
      return;
     }

   // 2. PREVIOUS COMPLETED CANDLE (Bar 1) CHECK (Within first 15 seconds of new candle):
   if(TimeCurrent() - Time[0] <= 15 && g_lastMethod2SpikeTime != Time[1])
     {
      double surgeUp1  = High[1] - Open[1];
      double wickUp1   = High[1] - MathMax(Open[1], Close[1]);
      bool isSurgeUp1  = ((surgeUp1 >= minSurgeUSD || (High[1] - Low[1] >= minSurgeUSD && Close[1] > Open[1])) &&
                          (InpSpikeCandleMinAtrMult <= 0.0 || surgeUp1 >= InpSpikeCandleMinAtrMult * atr));
      bool isWickDown1 = (wickUp1 >= InpSpikeWickPullbackUSD);

      if(isSurgeUp1 && isWickDown1)
        {
         outBearishSpike = true;
         PrintFormat(">>> [METHOD 2 SPIKE DETECTED] BEARISH SPIKE (Bar 1 Closed) | SurgeUp=$%.2f, Wick=$%.2f -> SELL SPIKE",
                     surgeUp1, wickUp1);
         return;
        }

      double dumpDown1 = Open[1] - Low[1];
      double wickDown1 = MathMin(Open[1], Close[1]) - Low[1];
      bool isDumpDown1 = ((dumpDown1 >= minSurgeUSD || (High[1] - Low[1] >= minSurgeUSD && Close[1] < Open[1])) &&
                          (InpSpikeCandleMinAtrMult <= 0.0 || dumpDown1 >= InpSpikeCandleMinAtrMult * atr));
      bool isWickUp1   = (wickDown1 >= InpSpikeWickPullbackUSD);

      if(isDumpDown1 && isWickUp1)
        {
         outBullishSpike = true;
         PrintFormat(">>> [METHOD 2 SPIKE DETECTED] BULLISH SPIKE (Bar 1 Closed) | DumpDown=$%.2f, Wick=$%.2f -> BUY SPIKE",
                     dumpDown1, wickDown1);
         return;
        }
     }
  }

//+------------------------------------------------------------------+
//| CountSpikePendingOrders: Counts pending spike orders by type     |
//+------------------------------------------------------------------+
int CountSpikePendingOrders(int pendingType)
  {
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      if(OrderType() != pendingType)
         continue;
      string cmt = OrderComment();
      if(StringFind(cmt, "SPIKE") >= 0)
         count++;
     }
   return count;
  }

//+------------------------------------------------------------------+
//| CleanupStaleSpikePendingOrders: Deletes stale spike pending orders|
//+------------------------------------------------------------------+
void CleanupStaleSpikePendingOrders(int pendingType, double maxDistUSD = 50.0)
  {
   RefreshRates();
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      if(OrderType() != pendingType)
         continue;
      string cmt = OrderComment();
      if(StringFind(cmt, "SPIKE") < 0)
         continue;

      double openPx = OrderOpenPrice();
      double dist = (pendingType == OP_BUYSTOP) ? MathAbs(Ask - openPx) : MathAbs(Bid - openPx);
      if(dist > maxDistUSD)
        {
         SafeOrderDelete(OrderTicket(), clrOrange);
         InvalidateTotalEAOrdersCache();
         PrintFormat(">>> [STALE SPIKE PENDING DELETED] Deleted #%d Entry=%.2f Dist=$%.2f > $%.2f to place fresh order near market",
                     OrderTicket(), openPx, dist, maxDistUSD);
        }
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsSafeToCreateMarketOrder(int orderType)
  {
   if(TradingHaltedUntilNextFlip) // Add this block
      return false;
   if(!IsDayProfitLadderTradingAllowed())
      return false;
   if(!IsDayProfitLadderTradingAllowed())
      return false;
   if(!EnableSLProtection)
      return true;
   if(!IsConnected())
      return false;
   if(HasBasketNewOrderLossLimit())
      return false;
   if(MaxSameDirectionOrders>0 && CountDirectionOrders(orderType)>=MaxSameDirectionOrders)
      return false;
   if(IsDirectionBlockedAfterSL(orderType))
      return false;
   return true;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void DeleteAllPendingEAOrders()
  {
   for(int i=OrdersTotal()-1; i>=0; i--)
     {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES))
         continue;
      if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber)
         continue;
      int type=OrderType();
      if(type==OP_BUYSTOP || type==OP_SELLSTOP || type==OP_BUYLIMIT || type==OP_SELLLIMIT)
         SafeOrderDelete(OrderTicket(),clrRed);
     }
  }

//+------------------------------------------------------------------+
//| DeleteOldestPendingEAOrder: Frees a slot when max orders reached  |
//+------------------------------------------------------------------+
bool DeleteOldestPendingEAOrder(string reason = "Make room for new order")
  {
   int oldestTicket = -1;
   datetime oldestTime = 0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int type = OrderType();
      if(type == OP_BUYSTOP || type == OP_SELLSTOP || type == OP_BUYLIMIT || type == OP_SELLLIMIT)
        {
         datetime oTime = OrderOpenTime();
         if(oldestTicket == -1 || oTime < oldestTime)
           {
            oldestTicket = OrderTicket();
            oldestTime = oTime;
           }
        }
     }

   if(oldestTicket > 0)
     {
      Print(">>> [TOO MANY ORDERS AUTO-CLEANUP] Deleting oldest pending order #", oldestTicket,
            " (created ", TimeToString(oldestTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS), ") | Reason: ", reason);
      bool del = SafeOrderDelete(oldestTicket, clrYellow);
      if(del)
        {
         InvalidateTotalEAOrdersCache();
         return true;
        }
     }
   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void RegisterLosingSLProtection(int ticket,int orderType,double profit)
  {
   if(!EnableSLProtection || ticket<=0 || profit>=0.0 || ticket==LastProtectedLossTicket)
      return;
   LastProtectedLossTicket=ticket;
   LosingSLCount++;
   BlockedSLDirection=(orderType==OP_BUY)?1:-1;
   FreshSSLRequiredDirection=BlockedSLDirection;
   SLProtectionUntil=TimeCurrent()+MathMax(0,SLCooldownCandles)*Period()*60;
   if(DeletePendingOrdersAfterLosingSL && !ContinueTradingAfterSL)
      DeleteAllPendingEAOrders();
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void RegisterProfitableClose()
  {
   LosingSLCount=0;
   BlockedSLDirection=0;
   SLProtectionUntil=0;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void CheckLatestClosedTradeProtection()
  {
   if(!EnableSLProtection)
      return;
   static int lastHistoryCount = -1;
   int curHistoryTotal = OrdersHistoryTotal();
   if(curHistoryTotal == lastHistoryCount)
      return;
   lastHistoryCount = curHistoryTotal;

   datetime latest=0;
   int ticket=-1,type=-1;
   double profit=0.0;
   for(int i=curHistoryTotal-1; i>=0; i--)
     {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_HISTORY))
         continue;
      if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber)
         continue;
      if(OrderType()!=OP_BUY && OrderType()!=OP_SELL)
         continue;
      if(OrderCloseTime()>latest)
        {
         latest=OrderCloseTime();
         ticket=OrderTicket();
         type=OrderType();
         profit=OrderProfit()+OrderSwap()+OrderCommission();
         break;
        }
     }
   if(ticket<0)
      return;
   static int lastSeenProtectionTicket=-1;
   if(ticket==lastSeenProtectionTicket)
      return;
   lastSeenProtectionTicket=ticket;
   if(profit<0.0)
      RegisterLosingSLProtection(ticket,type,profit);
   else
      if(profit>0.0)
         RegisterProfitableClose();
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void MarkServerError(int err, string operation, int ticket = -1, string details = "")
  {
   TradeOperationFailedThisTick = true;
   ServerRecoveryPending=true;
   ServerRecoveryLastError=err;
   ServerRecoveryDetectedTime=TimeCurrent();
   LogEAError(err, operation, ticket, details);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsTradeEnvironmentHealthy()
  {
   if(!IsConnected())
      return false;
   RefreshRates();
   if(Bid<=0 || Ask<=0 || !IsTradeAllowed())
      return false;
   return true;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void ResetRuntimeAfterServerError(DailyProtectionState &state)
  {
   RefreshRates();
   TradeResetThisTick=false;
   OrderCreatedThisCandle=false;
   LastOrderCandleTime=0;
   StartupProtectionTicks=0;
   EAStartupComplete=true;
   state.ClosedOrdersToday=CountClosedOrdersSinceInitialization();
   LiveSSLInitialized=false;
   LastLiveSSLDirection=GlobalSSLDirection;
   LastLiveSignalCandle=Time[0];
   if(HasExistingProfitReEntryOrder())
      LoadReEntryCounter();
   ServerRecoveryResetCount++;
   ServerRecoveryPending=false;
   ServerRecoveryLastError=0;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool ProcessServerRecovery(DailyProtectionState &state)
  {
   if(!ServerRecoveryPending)
      return false;
   if(IsTradeEnvironmentHealthy())
     {
      ServerRecoveryPending=false;
      ServerRecoveryLastError=0;
      return false;
     }
   ResetRuntimeAfterServerError(state);
   return true;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int FindExistingOrderForRequest(int orderType,double lots,double price,string orderComment,datetime requestTime)
  {
   RefreshRates();
   double priceTolerance=MathMax(Point*20.0,Point*Slippage*2.0);
   for(int i=OrdersTotal()-1; i>=0; i--)
     {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES))
         continue;
      if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber || OrderType()!=orderType)
         continue;
      if(MathAbs(OrderLots()-lots)>0.0000001 || OrderComment()!=orderComment || OrderOpenTime()+3<requestTime)
         continue;
      if(orderType==OP_BUY || orderType==OP_SELL)
        {
         if(MathAbs(OrderOpenPrice()-price)<=priceTolerance)
            return OrderTicket();
        }
      else
        {
         if(MathAbs(OrderOpenPrice()-price)<=MathMax(Point,priceTolerance))
            return OrderTicket();
        }
     }
   return -1;
  }

void ResetTradeRequestBudget() { TradeRequestsThisTick=0; }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool CanSendTradeRequest(string operation,string details="")
  {
   if(MaxTradeRequestsPerTick<=0)
      return true;
   if(TradeRequestsThisTick>=MaxTradeRequestsPerTick)
      return false;
   TradeRequestsThisTick++;
   return true;
  }


