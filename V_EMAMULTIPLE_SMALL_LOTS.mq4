int GetTotalEAOrders()
  {
   UpdateOrderCacheIfNeeded();
   return g_orderCache.totalOrders;
  }

void InvalidateTotalEAOrdersCache() { InvalidateOrderCache(); }

//+------------------------------------------------------------------+
//| GetSSLLongShortPendingGapRaw                                     |
//| Calculates the raw price gap for SSL pending stop orders.        |
//| USER RULE: If directional basket loss <= -$10 * mult:            |
//| BUY pending gap is doubled, SELL pending gap is doubled.         |
//+------------------------------------------------------------------+
double GetSSLLongShortPendingGapRaw(int orderType, bool logMessage = false)
  {
   double baseGap = (SSLLongShortPendingGapRaw > 0.0) ? SSLLongShortPendingGapRaw : 20.0;
   if(!InpEnablePendingGapDoubleOnLoss)
      return baseGap;

   int mult = (balancelomultipler > 0) ? balancelomultipler : 1;
   double lossThreshold = InpPendingGapDoubleLossThresholdUSD * mult;

   if(orderType == OP_BUY || orderType == OP_BUYSTOP || orderType == OP_BUYLIMIT)
     {
      double buyPL = GetOpenPL(OP_BUY);
      if(buyPL <= -lossThreshold)
        {
         double doubledGap = baseGap * InpPendingGapLossMultiplier;
         if(logMessage)
           {
            PrintFormat(">>> [PENDING GAP DOUBLED] BUY Basket Loss=$%.2f <= -$%.2f | Doubled pending order gap from $%.0f to $%.0f",
                        buyPL, lossThreshold, baseGap, doubledGap);
           }
         return doubledGap;
        }
     }
   else
      if(orderType == OP_SELL || orderType == OP_SELLSTOP || orderType == OP_SELLLIMIT)
        {
         double sellPL = GetOpenPL(OP_SELL);
         if(sellPL <= -lossThreshold)
           {
            double doubledGap = baseGap * InpPendingGapLossMultiplier;
            if(logMessage)
              {
               PrintFormat(">>> [PENDING GAP DOUBLED] SELL Basket Loss=$%.2f <= -$%.2f | Doubled pending order gap from $%.0f to $%.0f",
                           sellPL, lossThreshold, baseGap, doubledGap);
              }
            return doubledGap;
           }
        }

   return baseGap;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void OpenBuy(string MOMorder="")
  {
   bool isSpikeOrder = (MOMorder == "SPIKE_BUY" || (InpEnableSpikeOrderCreation && (IsType1BullishSpike(false) || g_isMethod2BullishSpike)));

   if(!isSpikeOrder)
     {
      if(InpEnableCustomRules && !PassesUserRules(OP_BUY))
        {
         Print("Order Blocked InpEnableCustomRules");
         return;
        }
      if(!IsSafeToCreateMarketOrder(OP_BUY) || !PassesEMAFilter(OP_BUY) || !IsOneCandleOrderAllowed() || GetTotalEAOrders() >= MaxOpenOrders)
        {
         Print("Order Blocked IsSafeToCreateMarketOrder");
         return;
        }
     }
   RefreshRates();
   bool isSpikeMarketOrder = (isSpikeOrder && InpSpikeOrderPendingGapUSD <= 0.0);
   double pendingGap = isSpikeOrder ? InpSpikeOrderPendingGapUSD : GetSSLLongShortPendingGapRaw(OP_BUY, true);
   double minStopDist = GetRequiredStopDistance();
   double entryPrice = Ask;

   if(isSpikeMarketOrder)
     {
      entryPrice = NormalizeDouble(Ask, Digits);
     }
   else
     {
      entryPrice = Ask + pendingGap;
      if(entryPrice < Ask + minStopDist)
         entryPrice = Ask + minStopDist;
      entryPrice = NormalizeDouble(entryPrice, Digits);
     }

   // USER RULE: Spike orders verify minimum gap between two orders is $50 (InpSpikeOrderMinGapUSD)
   double requiredGap = isSpikeOrder ? InpSpikeOrderMinGapUSD : GetDynamicOrderGap(OP_BUY);
   if(!HasMinimumSameOrderGap(OP_BUY, requiredGap, entryPrice))
     {
      Print("Order Blocked HasMinimumSameOrderGap: ", (isSpikeOrder ? "[SPIKE] " : ""), "Required Gap=", DoubleToString(requiredGap, 2), " Proposed Entry=", DoubleToString(entryPrice, Digits));
      return;
     }
   reEntryCounter=0;
   SaveReEntryCounter();
   ChangeLots(GlobalSellPL,"SSL Long",OP_BUY,0,MOMorder);
   
   
   if(isSpikeOrder)
      StopLossRawPriceGap = (InpSpikeOrderStopLossRawPriceGap > 0.0) ? InpSpikeOrderStopLossRawPriceGap : 200.0;
   else
      StopLossRawPriceGap = 3000.0;

   double slDistance = isSpikeOrder ? ((InpSpikeOrderStopLossRawPriceGap > 0.0) ? InpSpikeOrderStopLossRawPriceGap : 200.0) : ((StopLossRawPriceGap > 0.0) ? StopLossRawPriceGap : 3000.0);
   double tpDistance = (TakeProfitRawPriceGap > 0.0) ? TakeProfitRawPriceGap : 500.0;

   double stopLoss = (slDistance > 0.0) ? NormalizeDouble(entryPrice - slDistance, Digits) : 0.0;
   double takeProfit = (tpDistance > 0.0) ? NormalizeDouble(entryPrice + tpDistance, Digits) : 0.0;

   if(DeleteOppositePendingOnSignal)
      DeleteOppositePendingOrders(OP_BUY);

   string buyComment = isSpikeOrder ? "SSL Long SPIKE" : ((MOMorder == "MOM_BUY" || isMOMOrder) ? "SSL Long MOM" : "SSL Long");
   
  
   
   int ticket = 0;
   if(isSpikeMarketOrder)
     {
      ticket = SafeOrderSend(Symbol(), OP_BUY, Lots, Ask, Slippage, stopLoss, takeProfit, buyComment, MagicNumber, BuyColor);
      if(ticket > 0)
        {
         OrderCreatedThisCandle = true;
         LastOrderCandleTime = Time[0];
         Print(buyComment, " MARKET ORDER CREATED: BUY Ticket #", ticket, " Lots=", DoubleToString(Lots, 2),
               " Entry=", DoubleToString(Ask, Digits),
               " SL=", DoubleToString(stopLoss, Digits), " TP=", DoubleToString(takeProfit, Digits));
        }
     }
   else
     {
      ticket = SafeOrderSend(Symbol(), OP_BUYSTOP, Lots, entryPrice, Slippage, stopLoss, takeProfit, buyComment, MagicNumber, BuyColor);
      if(ticket > 0)
        {
         OrderCreatedThisCandle = true;
         LastOrderCandleTime = Time[0];
         Print(buyComment, " PENDING ORDER CREATED: BUY STOP Ticket #", ticket, " Lots=", DoubleToString(Lots, 2),
               " Entry=", DoubleToString(entryPrice, Digits), " (Ask+", DoubleToString(pendingGap, 2), ")",
               " SL=", DoubleToString(stopLoss, Digits), " TP=", DoubleToString(takeProfit, Digits));
        }
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double NormalizeLots(double lots)
  {
   double minLot  = MarketInfo(Symbol(), MODE_MINLOT);
   double maxLot  = MarketInfo(Symbol(), MODE_MAXLOT);
   double lotStep = MarketInfo(Symbol(), MODE_LOTSTEP);
   if(lotStep <= 0.0)
      lotStep = minLot > 0.0 ? minLot : 0.01;
   lots = MathMax(minLot, MathMin(maxLot, lots));
   lots = MathFloor((lots + 1e-9) / lotStep) * lotStep;
   lots = MathMax(minLot, MathMin(maxLot, lots));
   int digits = 0;
   double step = lotStep;
   while(digits < 8 && MathAbs(step - MathRound(step)) > 1e-8)
     {
      step *= 10.0;
      digits++;
     }
   return NormalizeDouble(lots, digits);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void OpenSell(string MOMorder="")
  {
   bool isSpikeOrder = (MOMorder == "SPIKE_SELL" || (InpEnableSpikeOrderCreation && (IsType1BearishSpike(false) || g_isMethod2BearishSpike)));

   if(!isSpikeOrder)
     {
      if(InpEnableCustomRules && !PassesUserRules(OP_SELL))
        {
         Print("InpEnableCustomRules ");
         return;
        }
      if(!IsSafeToCreateMarketOrder(OP_SELL) || !PassesEMAFilter(OP_SELL) || !IsOneCandleOrderAllowed() || GetTotalEAOrders() >= MaxOpenOrders)
        {
         Print("IsSafeToCreateMarketOrder ");
         return;
        }
     }
   RefreshRates();
   bool isSpikeMarketOrder = (isSpikeOrder && InpSpikeOrderPendingGapUSD <= 0.0);
   double pendingGap = isSpikeOrder ? InpSpikeOrderPendingGapUSD : GetSSLLongShortPendingGapRaw(OP_SELL, true);
   double minStopDist = GetRequiredStopDistance();
   double entryPrice = Bid;

   if(isSpikeMarketOrder)
     {
      entryPrice = NormalizeDouble(Bid, Digits);
     }
   else
     {
      entryPrice = Bid - pendingGap;
      if(entryPrice > Bid - minStopDist)
         entryPrice = Bid - minStopDist;
      entryPrice = NormalizeDouble(entryPrice, Digits);
     }

   // USER RULE: Spike orders verify minimum gap between two orders is $50 (InpSpikeOrderMinGapUSD)
   double requiredGap = isSpikeOrder ? InpSpikeOrderMinGapUSD : GetDynamicOrderGap(OP_SELL);
   if(!HasMinimumSameOrderGap(OP_SELL, requiredGap, entryPrice))
     {
      Print("Order Blocked HasMinimumSameOrderGap: ", (isSpikeOrder ? "[SPIKE] " : ""), "Required Gap=", DoubleToString(requiredGap, 2), " Proposed Entry=", DoubleToString(entryPrice, Digits));
      return;
     }
   reEntryCounter=0;
   SaveReEntryCounter();
   ChangeLots(GlobalBuyPL,"SSL Short",OP_SELL,0,MOMorder);
   
   if(isSpikeOrder)
      StopLossRawPriceGap = (InpSpikeOrderStopLossRawPriceGap > 0.0) ? InpSpikeOrderStopLossRawPriceGap : 200.0;
   else
      StopLossRawPriceGap = 3000.0;

   double slDistance = isSpikeOrder ? ((InpSpikeOrderStopLossRawPriceGap > 0.0) ? InpSpikeOrderStopLossRawPriceGap : 200.0) : ((StopLossRawPriceGap > 0.0) ? StopLossRawPriceGap : 3000.0);
   double tpDistance = (TakeProfitRawPriceGap > 0.0) ? TakeProfitRawPriceGap : 500.0;

   double stopLoss = (slDistance > 0.0) ? NormalizeDouble(entryPrice + slDistance, Digits) : 0.0;
   double takeProfit = (tpDistance > 0.0) ? NormalizeDouble(entryPrice - tpDistance, Digits) : 0.0;

   if(DeleteOppositePendingOnSignal)
      DeleteOppositePendingOrders(OP_SELL);

   string sellComment = isSpikeOrder ? "SSL Short SPIKE" : ((MOMorder == "MOM_SELL" || isMOMOrder) ? "SSL Short MOM" : "SSL Short");
   int ticket = 0;
   if(isSpikeMarketOrder)
     {
      ticket = SafeOrderSend(Symbol(), OP_SELL, Lots, Bid, Slippage, stopLoss, takeProfit, sellComment, MagicNumber, SellColor);
      if(ticket > 0)
        {
         OrderCreatedThisCandle = true;
         LastOrderCandleTime = Time[0];
         Print(sellComment, " MARKET ORDER CREATED: SELL Ticket #", ticket, " Lots=", DoubleToString(Lots, 2),
               " Entry=", DoubleToString(Bid, Digits),
               " SL=", DoubleToString(stopLoss, Digits), " TP=", DoubleToString(takeProfit, Digits));
        }
     }
   else
     {
      ticket = SafeOrderSend(Symbol(), OP_SELLSTOP, Lots, entryPrice, Slippage, stopLoss, takeProfit, sellComment, MagicNumber, SellColor);
      if(ticket > 0)
        {
         OrderCreatedThisCandle = true;
         LastOrderCandleTime = Time[0];
         Print(sellComment, " PENDING ORDER CREATED: SELL STOP Ticket #", ticket, " Lots=", DoubleToString(Lots, 2),
               " Entry=", DoubleToString(entryPrice, Digits), " (Bid-", DoubleToString(pendingGap, 2), ")",
               " SL=", DoubleToString(stopLoss, Digits), " TP=", DoubleToString(takeProfit, Digits));
        }
     }
  }

