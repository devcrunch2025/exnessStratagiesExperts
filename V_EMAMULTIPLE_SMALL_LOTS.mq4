//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
// Global tracking counters for oscillation boundary filter
int g_oscillationBlockedBuys  = 0;
int g_oscillationBlockedSells = 0;

//+------------------------------------------------------------------+
//| GetCurrentOscillationRange: Measures active range High, Low, & R |
//+------------------------------------------------------------------+
double GetCurrentOscillationRange(double &outHigh, double &outLow, double &outRelPos)
  {
   outHigh   = 0.0;
   outLow    = 0.0;
   outRelPos = 50.0;

   int lookback = (InpOscillationLookbackBars > 0) ? InpOscillationLookbackBars : 720;
   if(lookback >= Bars)
      lookback = Bars - 1;
   if(lookback < 10)
      return 0.0;

   int hIdx = iHighest(Symbol(), Period(), MODE_HIGH, lookback, 1);
   int lIdx = iLowest(Symbol(), Period(), MODE_LOW, lookback, 1);
   if(hIdx < 0 || lIdx < 0)
      return 0.0;

   double rHigh = High[hIdx];
   double rLow  = Low[lIdx];

// Also incorporate confirmed LSD structural levels if active
   double eqh = GetEQR_R_Price(true);
   if(eqh <= 0.0)
      eqh = GetEQR_R_Price(false);
   double eql = GetEQR_G_Price(true);
   if(eql <= 0.0)
      eql = GetEQR_G_Price(false);

   if(eqh > 0.0 && eqh > rHigh * 0.95 && eqh < rHigh * 1.05)
      rHigh = MathMax(rHigh, eqh);
   if(eql > 0.0 && eql > rLow * 0.95 && eql < rLow * 1.05)
      rLow = MathMin(rLow, eql);

   double rangeWidth = rHigh - rLow;
   outHigh = rHigh;
   outLow  = rLow;

   RefreshRates();
   double livePrice = (Bid + Ask) / 2.0;
   if(rangeWidth > 0.0)
     {
      outRelPos = ((livePrice - rLow) / rangeWidth) * 100.0;
     }

   return rangeWidth;
  }

//+------------------------------------------------------------------+
//| GetOscillationRegimeName: Classifies market oscillation regime   |
//+------------------------------------------------------------------+
string GetOscillationRegimeName(double rangeWidth)
  {
   if(rangeWidth <= 0.0)
      return "UNKNOWN";
   if(rangeWidth <= InpOscillationTightThreshold)
      return "TIGHT_COMPRESSION";
   if(rangeWidth <= InpOscillationStandardThreshold)
      return "STANDARD_OSCILLATION";
   if(rangeWidth <= InpOscillationMacroThreshold)
      return "MACRO_OSCILLATION";
   return "MOMENTUM_BREAKOUT";
  }

//+------------------------------------------------------------------+
//| GetDynamicBasketProfitTarget: Returns dynamic target in USD     |
//+------------------------------------------------------------------+
double GetDynamicBasketProfitTarget()
  {
   if(!InpEnableOscillationEngine)
      return InpBasketProfitTargetUSD;

   double rH = 0.0, rL = 0.0, rPos = 50.0;
   double rW = GetCurrentOscillationRange(rH, rL, rPos);
   if(rW <= 0.0)
      return InpBasketProfitTargetUSD;

   if(rW <= InpOscillationTightThreshold)
      return InpTightRangeTargetUSD;
   else
      if(rW <= InpOscillationStandardThreshold)
         return InpStandardRangeTargetUSD;
      else
         return InpMacroRangeTargetUSD;
  }

//+------------------------------------------------------------------+
//| PassesOscillationBoundaryFilter: Boundary 35/65 Asymmetry Gate   |
//+------------------------------------------------------------------+
bool PassesOscillationBoundaryFilter(int orderType)
  {
   if(!InpEnableOscillationEngine || !InpEnableBoundaryAsymmetryFilter)
      return true;

   double rHigh = 0.0, rLow = 0.0, relPos = 50.0;
   double rWidth = GetCurrentOscillationRange(rHigh, rLow, relPos);
   if(rWidth <= 0.0)
      return true;

   RefreshRates();
   double curBid = Bid;
   double curAsk = Ask;

// Check if market is in confirmed MOMENTUM BREAKOUT mode
   bool isBearishBreakout = (curBid < (rLow - 50.0 * Point) && EMADirection == -1 && GlobalSSLDirection == -1);
   bool isBullishBreakout = (curAsk > (rHigh + 50.0 * Point) && EMADirection == 1 && GlobalSSLDirection == 1);

// ==========================================================
// BUY DIRECTION EVALUATION
// ==========================================================
   if(orderType == OP_BUY || orderType == OP_BUYSTOP || orderType == OP_BUYLIMIT)
     {
      // If market is in confirmed downward runaway breakout, FREEZE all BUYs!
      if(isBearishBreakout)
        {
         g_oscillationBlockedBuys++;
         static datetime lastBrtLog = 0;
         if(TimeCurrent() - lastBrtLog >= 60)
           {
            lastBrtLog = TimeCurrent();
            Print(">>> [BREAKOUT PROTECTION] Blocked BUY during active Bearish Breakout! (Bid=",
                  DoubleToString(curBid, Digits), " < RangeLow=", DoubleToString(rLow, Digits),
                  ", Range=$", DoubleToString(rWidth, 2), ")");
           }
         return false;
        }

      // If price broke above ceiling with bullish momentum, breakout buy is permitted
      if(isBullishBreakout)
         return true;

      // USER RULE: Bullish Spike Exception (Angle mismatch OR Method 2 Candle Spike -> allow BUY orders)
      if(InpEnableSpikeOrderCreation && (IsType1BullishSpike(false) || g_isMethod2BullishSpike))
         return true;

      // Inside oscillation: Block BUY if price is in Upper Ceiling Zone (>= 65%)
      if(rWidth >= InpOscillationTightThreshold && relPos >= InpBoundaryCeilingPercent)
        {
         g_oscillationBlockedBuys++;
         static datetime lastBuyCeilLog = 0;
         if(TimeCurrent() - lastBuyCeilLog >= 60)
           {
            lastBuyCeilLog = TimeCurrent();
            Print(">>> [OSCILLATION ASYMMETRY] Blocked BUY near Range Ceiling! (RelPos=",
                  DoubleToString(relPos, 1), "% >= ", DoubleToString(InpBoundaryCeilingPercent, 0),
                  "%, Range=$", DoubleToString(rWidth, 2),
                  ", High=", DoubleToString(rHigh, Digits), ", Low=", DoubleToString(rLow, Digits), ")");
           }
         return false;
        }
     }

// ==========================================================
// SELL DIRECTION EVALUATION
// ==========================================================
   else
      if(orderType == OP_SELL || orderType == OP_SELLSTOP || orderType == OP_SELLLIMIT)
        {
         // If market is in confirmed upward runaway breakout, FREEZE all SELLs!
         if(isBullishBreakout)
           {
            g_oscillationBlockedSells++;
            static datetime lastBrtLogS = 0;
            if(TimeCurrent() - lastBrtLogS >= 60)
              {
               lastBrtLogS = TimeCurrent();
               Print(">>> [BREAKOUT PROTECTION] Blocked SELL during active Bullish Breakout! (Ask=",
                     DoubleToString(curAsk, Digits), " > RangeHigh=", DoubleToString(rHigh, Digits),
                     ", Range=$", DoubleToString(rWidth, 2), ")");
              }
            return false;
           }

         // If price broke below floor with bearish momentum, breakout sell is permitted
         if(isBearishBreakout)
            return true;

         // USER RULE: Bearish Spike Exception (Angle mismatch OR Method 2 Candle Spike -> allow SELL orders)
         if(InpEnableSpikeOrderCreation && (IsType1BearishSpike(false) || g_isMethod2BearishSpike))
            return true;

         // Inside oscillation: Block SELL if price is in Lower Floor Zone (<= 35%)
         if(rWidth >= InpOscillationTightThreshold && relPos <= InpBoundaryFloorPercent)
           {
            g_oscillationBlockedSells++;
            static datetime lastSellFloorLog = 0;
            if(TimeCurrent() - lastSellFloorLog >= 60)
              {
               lastSellFloorLog = TimeCurrent();
               Print(">>> [OSCILLATION ASYMMETRY] Blocked SELL near Range Floor! (RelPos=",
                     DoubleToString(relPos, 1), "% <= ", DoubleToString(InpBoundaryFloorPercent, 0),
                     "%, Range=$", DoubleToString(rWidth, 2),
                     ", High=", DoubleToString(rHigh, Digits), ", Low=", DoubleToString(rLow, Digits), ")");
              }
            return false;
           }
        }

   return true;
  }

//+------------------------------------------------------------------+
//| GetNewestOpenOrderTime: Returns open time of latest order in dir |
//+------------------------------------------------------------------+
datetime GetNewestOpenOrderTime(int orderType)
  {
   int baseType = (orderType == OP_BUY || orderType == OP_BUYSTOP || orderType == OP_BUYLIMIT) ? OP_BUY : OP_SELL;
   datetime newestTime = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      if(OrderType() != baseType)
         continue;
      string comment = OrderComment();
      if(IsAnyRecoveryOrder(OrderTicket(), comment))
         continue; // Ignore recovery orders, track regular basket
      if(OrderOpenTime() > newestTime)
         newestTime = OrderOpenTime();
     }
   return newestTime;
  }

//+------------------------------------------------------------------+
//| GetDynamicOrderGap: Calculates dynamic minimum price gap between |
//| same-direction orders. Adapts intelligently based on:            |
//| 1. Trend strength & EMA pullback (IsEmaWEAK)                     |
//| 2. Directional consensus (SSL vs EMA agreement)                  |
//| 3. Floating drawdown (widens grid spacing progressively on loss) |
//| 4. Signal matching (matched vs unmatched fallback)              |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| GetActiveLsdSweepSignalForGap:                                   |
//| Returns -1 (BSLS) or +1 (SSLS) if an LSD sweep signal is active  |
//| and within InpLsdSweepGapDurationMinutes for dynamic order gaps. |
//| Returns 0 if no sweep signal or expired.                         |
//+------------------------------------------------------------------+
int GetActiveLsdSweepSignalForGap()
  {
   if(!InpLsdEnableSweepGapMultiplier)
      return 0;

   int sig = GetLsdSweepSignal();
   if(sig == 0)
      return 0;

// Check duration if configured (> 0 min)
   if(InpLsdSweepGapDurationMinutes > 0)
     {
      datetime sigTime = g_rememberedSweepBarTime;
      if(sigTime == 0)
         sigTime = g_lastSweepBarTime;

      if(sigTime > 0)
        {
         int elapsedSec = (int)(TimeCurrent() - sigTime);
         if(elapsedSec > InpLsdSweepGapDurationMinutes * 60)
            return 0; // Expired past configured duration
        }
     }
   return sig;
  }

//+------------------------------------------------------------------+
//| Details calculation for Dynamic Order Gap (raw before cap, reason) |
//+------------------------------------------------------------------+
double GetDynamicOrderGapDetails(int orderType, double &rawGapBeforeCap, string &reasonStr, bool logMessages = false)
  {
   rawGapBeforeCap = 0.0;
   reasonStr = "";

// USER RULE (VMULTI-1232): Allow tighter gap for MOM breakout entries (default $50, bypassing large drawdown grid gaps)
   if(isMOMOrder)
     {
      double momGap = (InpMomOrderMinGapRaw > 0.0) ? InpMomOrderMinGapRaw : 50.0;
      rawGapBeforeCap = momGap;
      reasonStr = "MOM Order";
      return momGap;
     }

   double baseGap = (MinimumSameOrderGapRawMatched > 0.0) ? MinimumSameOrderGapRawMatched : 50.0;
   double unmatchedGap = (MinimumSameOrderGapRawUnmatched > 0.0) ? MinimumSameOrderGapRawUnmatched : 50.0;
   bool isAdaptive = false;

// Adaptive Grid Gap scaling to current oscillation width (R / 8)
   if(InpEnableOscillationEngine && InpEnableAdaptiveGridGap)
     {
      double rH = 0.0, rL = 0.0, rPos = 50.0;
      double rW = GetCurrentOscillationRange(rH, rL, rPos);
      if(rW > 0.0)
        {
         double adaptGap = rW / 8.0;
         adaptGap = MathMax(InpAdaptiveGridGapMin, MathMin(InpAdaptiveGridGapMax, adaptGap));
         baseGap = adaptGap;
         isAdaptive = true;
        }
     }

   int sslDir = GlobalSSLDirection;
   int emaDir = EMADirection;

   double curEmaAng = (GlobalEmaAngle30 != 0.0) ? GlobalEmaAngle30 : GetEmaAngleDegrees(30);
   double absEmaAng = MathAbs(curEmaAng);
   double angleThreshold = (InpDynamicGapAngleThreshold > 0.0) ? InpDynamicGapAngleThreshold : 4.0;
   bool isAngleSteepForGap = (absEmaAng >= angleThreshold);

   // Check if orderType matches EMADirection (+1 Bullish matches BUY, -1 Bearish matches SELL)
   bool isEmaDirMatched = (emaDir == 1 && (orderType == OP_BUY || orderType == OP_BUYSTOP || orderType == OP_BUYLIMIT)) ||
                          (emaDir == -1 && (orderType == OP_SELL || orderType == OP_SELLSTOP || orderType == OP_SELLLIMIT));

   // Base multipliers
   int multiplier = 1;
   double sweepMult = 1.0;
   string sweepName = "";

   if(isAngleSteepForGap)
     {
      // USER RULE (V-SMALL-1057): When EMA angle >= 4.0 and orderType does NOT match EMADirection,
      // disable Drawdown Scaling and Sweep Guard (gap remains at Base Gap instead of scaling to 4X/2X).
      if(!isEmaDirMatched && InpDisableDDAndSweepGapWhenEmaUnmatched)
        {
         multiplier = 1;
         sweepMult = 1.0;
         sweepName = "";
        }
      else
        {
         // 1. Evaluate indicators alignment and risk conditions (Angle >= 4.0)
         bool isWeak = IsEmaWEAKDistanceReduced50PercentFromPeak(orderType);
         bool isConflicted = (sslDir != 0 && emaDir != 0 && sslDir != emaDir);

         if(isWeak)
            multiplier = MathMax(multiplier, 2);
         else if(isConflicted)
            multiplier = MathMax(multiplier, 2);

         // 2. Floating loss scaling: progressively widen gap on drawdown (Angle >= 4.0)
         double pl = GetOpenPL(orderType);
         if(pl < 0.0)
           {
            double lossStep = 3.0 * (balancelomultipler > 0 ? balancelomultipler : 1);
            int lossMultiplier = 1 + (int)MathFloor(MathAbs(pl) / lossStep);
            lossMultiplier = MathMin(lossMultiplier, 4); // Cap to safe maximum 4X
            multiplier = MathMax(multiplier, lossMultiplier);
           }

         // 2B. Aging Reversal Gap Reduction: Stagnant basket (>=30 min) turning with momentum
         if(InpEnableAgingGapReduction && pl < 0.0)
           {
            datetime latestTime = GetNewestOpenOrderTime(orderType);
            int minElapsedSec = (InpAgingGapElapsedMinutes > 0 ? InpAgingGapElapsedMinutes : 30) * 60;
            if(latestTime > 0 && (TimeCurrent() - latestTime) >= minElapsedSec)
              {
               bool trendConfirmed = true;
               if(InpAgingGapRequireTrendConfirmation)
                 {
                  if(orderType == OP_BUY || orderType == OP_BUYSTOP || orderType == OP_BUYLIMIT)
                     trendConfirmed = (sslDir == 1 && (Close[0] >= Open[0] || Bid >= Close[1]));
                  else if(orderType == OP_SELL || orderType == OP_SELLSTOP || orderType == OP_SELLLIMIT)
                     trendConfirmed = (sslDir == -1 && (Close[0] <= Open[0] || Ask <= Close[1]));
                  else
                     trendConfirmed = false;
                 }

               if(trendConfirmed)
                 {
                  double mult = (InpAgingGapReductionMultiplier > 0.0) ? InpAgingGapReductionMultiplier : 0.5;
                  double reducedGap = baseGap * mult;
                  if(reducedGap < 20.0)
                     reducedGap = 20.0; // Enforce safe minimum separation

                  if(logMessages)
                    {
                     static datetime lastAgingLog = 0;
                     if(TimeCurrent() - lastAgingLog >= 60)
                       {
                        lastAgingLog = TimeCurrent();
                        Print(">>> [AGING REVERSAL GAP REDUCTION] Direction=", (orderType == OP_BUY ? "BUY" : "SELL"),
                              " | LatestOrderAge=", (int)((TimeCurrent() - latestTime) / 60), "m >= ", InpAgingGapElapsedMinutes, "m",
                              " | Basket PL=$", DoubleToString(pl, 2),
                              " | Overriding Drawdown Gap $", DoubleToString(baseGap * multiplier, 2),
                              " -> Halved Gap $", DoubleToString(reducedGap, 2));
                       }
                    }
                  rawGapBeforeCap = reducedGap;
                  reasonStr = "Aging Halved";
                  return reducedGap;
                 }
              }
           }

         // 3. LSD SWEEP GAP EXPANSION (BSLS doubles BUY gap, SSLS doubles SELL gap) (Angle >= 4.0)
         int sweepSig = GetActiveLsdSweepSignalForGap();
         if(sweepSig == -1 && (orderType == OP_BUY || orderType == OP_BUYSTOP || orderType == OP_BUYLIMIT))
           {
            sweepMult = (InpLsdAdverseSweepGapMultiplier > 0.0) ? InpLsdAdverseSweepGapMultiplier : 2.0;
            sweepName = "BSLS 2X";
            if(logMessages)
              {
               static datetime lastBslsGapLog = 0;
               if(TimeCurrent() - lastBslsGapLog >= 60)
                 {
                  lastBslsGapLog = TimeCurrent();
                  Print(">>> [LSD BSLS DUMP GUARD] BSLS active -> BUY order gap DOUBLED (", DoubleToString(sweepMult, 1),
                        "X) to protect against dump!");
                 }
              }
           }
         else if(sweepSig == 1 && (orderType == OP_SELL || orderType == OP_SELLSTOP || orderType == OP_SELLLIMIT))
           {
            sweepMult = (InpLsdAdverseSweepGapMultiplier > 0.0) ? InpLsdAdverseSweepGapMultiplier : 2.0;
            sweepName = "SSLS 2X";
            if(logMessages)
              {
               static datetime lastSslsGapLog = 0;
               if(TimeCurrent() - lastSslsGapLog >= 60)
                 {
                  lastSslsGapLog = TimeCurrent();
                  Print(">>> [LSD SSLS SQUEEZE GUARD] SSLS active -> SELL order gap DOUBLED (", DoubleToString(sweepMult, 1),
                        "X) to protect against pump squeeze!");
                 }
              }
           }
        }
     }

   double resultGap = 0.0;
   // USER RULE (V-SMALL-1052): Required Gap = Base Gap when EMA angle < 4.
   //                           Required Gap = Base Gap * Drawdown Multiplier * Sweep Guard Multiplier when EMA angle >= 4.
   if(!isAngleSteepForGap)
     {
      resultGap = baseGap;
      reasonStr = StringFormat("Base Gap (Angle %.1f < %.1f)", absEmaAng, angleThreshold);
     }
   else
     {
      bool sslMatches = ((orderType == OP_BUY && sslDir == 1) || (orderType == OP_SELL && sslDir == -1));
      if(sslMatches)
         resultGap = baseGap * multiplier * sweepMult;
      else
        {
         // Lazy evaluation of pattern direction only if SSL is not matching
         int patternDir = GetCachedPatternDirection();
         bool patternMatches = ((orderType == OP_BUY && patternDir == 1) || (orderType == OP_SELL && patternDir == -1));
         if(patternMatches)
            resultGap = baseGap * multiplier * sweepMult;
         else
            resultGap = MathMax(unmatchedGap, baseGap * multiplier) * sweepMult;
        }

      // Build descriptive reason string
      if(!isEmaDirMatched && InpDisableDDAndSweepGapWhenEmaUnmatched)
         reasonStr = StringFormat("EMA Unmatched (Ang %.1f>=%.1f: DD & Sweep Disabled)", absEmaAng, angleThreshold);
      else if(multiplier > 1 && sweepMult > 1.0)
         reasonStr = StringFormat("DD %dX * %s (Ang %.1f>=%.1f)", multiplier, sweepName, absEmaAng, angleThreshold);
      else if(sweepMult > 1.0)
         reasonStr = StringFormat("%s (Ang %.1f>=%.1f)", sweepName, absEmaAng, angleThreshold);
      else if(multiplier > 1)
         reasonStr = StringFormat("DD %dX (Ang %.1f>=%.1f)", multiplier, absEmaAng, angleThreshold);
      else if(isAdaptive)
         reasonStr = StringFormat("Adaptive Grid (Ang %.1f>=%.1f)", absEmaAng, angleThreshold);
      else if(sslMatches)
         reasonStr = StringFormat("SSL Matched (Ang %.1f>=%.1f)", absEmaAng, angleThreshold);
      else
         reasonStr = StringFormat("Unmatched (Ang %.1f>=%.1f)", absEmaAng, angleThreshold);
     }

   rawGapBeforeCap = resultGap;
   return resultGap;
  }

//+------------------------------------------------------------------+
double GetDynamicOrderGap(int orderType)
  {
   double rawGap = 0.0;
   string reason = "";
   return GetDynamicOrderGapDetails(orderType, rawGap, reason, true);
  }

