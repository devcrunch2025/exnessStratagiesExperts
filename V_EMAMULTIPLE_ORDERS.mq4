// (DubaiNightCloseGvKey defined above SyncDubaiDayOpeningState)

//+------------------------------------------------------------------+
//| DrawDubaiNightCloseIcon                                          |
//| Draws chart icon & bold label on candle when ManageDubaiNight    |
//| executes Path-B (-50%/30m) cut, Path-A (>5%) close, or 23:45 All |
//+------------------------------------------------------------------+
void DrawDubaiNightCloseIcon(string eventKind, int cutSeq, string zeroSide, int ordersHit, double lotsCut, double estPL, double dayEqPct, double emaAngle, datetime hitTime = 0, double hitPrice = 0.0)
  {
   if(!InpDrawDubaiNightCloseIcon || ordersHit <= 0)
      return;

   if(hitTime <= 0)
      hitTime = TimeCurrent();

   datetime barTime = ((Bars > 0 && Time[0] > 0) ? Time[0] : hitTime);
   string   keyTag  = (eventKind == "CUT") ? ("CUT" + IntegerToString(MathMax(1, cutSeq))) : eventKind;
   string   baseName = PREFIX + "DNIGHT_" + keyTag + "_" + IntegerToString((int)barTime);
   string   txtName  = baseName + "_TXT";

   double atr = iATR(Symbol(), Period(), 14, 1);
   if(atr <= 0.0)
      atr = 30 * Point;
   if(atr <= 0.0)
      atr = 1.0;

   double baseLow    = ((Bars > 0 && Low[0] > 0.0) ? Low[0] : Bid);
   double offsetMult = 0.70;
   if(eventKind == "CUT")
      offsetMult = 0.70 + ((MathMax(1, cutSeq) - 1) % 3) * 0.55;
   else
      if(eventKind == "FINAL")
         offsetMult = 1.30;

   double markerPrice = (hitPrice > 0.0 ? hitPrice : baseLow) - (atr * offsetMult);
   double labelPrice  = markerPrice - (atr * 0.45);

   color  iconColor = clrMagenta;
   string labelText = "";
   string titleTag  = "";
   if(eventKind == "PATH_A")
     {
      iconColor = clrLime;
      labelText = StringFormat("NIGHT DAY>%.0f%% ALL (x%d -%.2fL)", InpDubaiNightDayProfitPct, ordersHit, lotsCut);
      titleTag  = StringFormat("PATH-A DAY EQUITY >%.0f%% CLOSE ALL", InpDubaiNightDayProfitPct);
     }
   else
      if(eventKind == "FINAL")
        {
         iconColor = clrTomato;
         labelText = StringFormat("NIGHT %02d:%02d ALL (x%d -%.2fL)", InpDubaiNightForceCloseHour, InpDubaiNightForceCloseMinute, ordersHit, lotsCut);
         titleTag  = StringFormat("%02d:%02d FINAL FORCE CLOSE ALL", InpDubaiNightForceCloseHour, InpDubaiNightForceCloseMinute);
        }
      else
        {
         iconColor = clrMagenta;
         string zeroTag = (zeroSide != "" ? (zeroSide + "=0 | ") : "");
         labelText = StringFormat("N-CUT#%d %s-%.2fL (x%d)", MathMax(1, cutSeq), zeroTag, lotsCut, ordersHit);
         titleTag  = StringFormat("PATH-B -%.0f%%/%dm PARTIAL CUT #%d (%s=0)",
                                  InpDubaiNightPartialCutPct, InpDubaiNightCutIntervalMinutes,
                                  MathMax(1, cutSeq), (zeroSide != "" ? zeroSide : "1-SIDE"));
        }

   datetime dubaiDT = hitTime + (ServerToDubaiOffsetHours * 3600);
   string   plSign  = (estPL >= 0.0) ? "+" : "-";
   string   eqSign  = (dayEqPct >= 0.0) ? "+" : "";
   string   tooltip = StringFormat("%s | Orders: %d (-%.2fL) | P/L: %s$%.2f | DayEq: %s%.2f%% | |Ang|: %.2f | Dubai: %s | Broker: %s",
                                   titleTag, ordersHit, lotsCut, plSign, MathAbs(estPL),
                                   eqSign, dayEqPct, MathAbs(emaAngle),
                                   TimeToString(dubaiDT, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                                   TimeToString(hitTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS));

   if(ObjectFind(0, baseName) >= 0 || ObjectFind(0, txtName) >= 0)
     {
      if(ObjectFind(0, txtName) >= 0)
        {
         ObjectSetString(0, txtName, OBJPROP_TEXT, labelText);
         ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);
        }
      if(ObjectFind(0, baseName) >= 0)
         ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);
      ChartRedraw(0);
      return;
     }

   int iconCode = (InpDubaiNightIconCode > 0 ? InpDubaiNightIconCode : 117);
   int fontSize = (InpDubaiNightIconFontSize > 0 ? InpDubaiNightIconFontSize : 10);

   ObjectCreate(0, baseName, OBJ_ARROW, 0, barTime, markerPrice);
   ObjectSetInteger(0, baseName, OBJPROP_ARROWCODE, iconCode);
   ObjectSetInteger(0, baseName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, baseName, OBJPROP_WIDTH, 4);
   ObjectSetInteger(0, baseName, OBJPROP_BACK, false);
   ObjectSetInteger(0, baseName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, baseName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);

   ObjectCreate(0, txtName, OBJ_TEXT, 0, barTime, labelPrice);
   ObjectSetString(0, txtName, OBJPROP_TEXT, labelText);
   ObjectSetString(0, txtName, OBJPROP_FONT, "Arial Black");
   ObjectSetInteger(0, txtName, OBJPROP_FONTSIZE, fontSize);
   ObjectSetInteger(0, txtName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, txtName, OBJPROP_ANCHOR, ANCHOR_UPPER);
   ObjectSetInteger(0, txtName, OBJPROP_BACK, false);
   ObjectSetInteger(0, txtName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, txtName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);

   ChartRedraw(0);

   PrintFormat(">>> [DUBAI NIGHT CHART ICON] Placed '%s' on bar %s (Dubai %s)",
               labelText, TimeToString(barTime, TIME_DATE|TIME_MINUTES),
               TimeToString(dubaiDT, TIME_MINUTES|TIME_SECONDS));
  }

//+------------------------------------------------------------------+
//| ManageDubaiNightOneSideCloseAll                                  |
//| Runs inside configured Dubai night window (default Start..End):  |
//| A) Day Equity Profit > 5% vs Dubai opening day equity -> closes  |
//|    ALL open orders immediately (any angle / side count, 1x/day). |
//| B) OR when MathAbs(GlobalEmaAngle30) is between 0.0 and 1.0 deg: |
//|    1) Before 11:45 PM (23:45): when either BUY == 0 or SELL == 0 |
//|       (while opposite side has open orders), slowly cuts 50% LOT |
//|       of each eligible order (>minLot) every 30 minutes.         |
//|    2) At/after 11:45 PM (23:45): finally closes ALL remaining    |
//|       open orders completely regardless of side counts (1x/day). |
//| Resets status, cut counters & opening equity on next Dubai day.  |
//+------------------------------------------------------------------+
void ManageDubaiNightOneSideCloseAll()
  {
   datetime nowServer = TimeCurrent();
   if(nowServer <= 0)
      return;

   datetime dubaiTime   = nowServer + (ServerToDubaiOffsetHours * 3600);
   int      dubaiHour   = TimeHour(dubaiTime);
   int      dubaiMinute = TimeMinute(dubaiTime);
   int      dubaiMod    = dubaiHour * 60 + dubaiMinute;
   int      dubaiDayKey = TimeYear(dubaiTime) * 1000 + TimeDayOfYear(dubaiTime);
   bool     isTestRun   = (IsTesting() || IsOptimization());
   string   gvKey       = DubaiNightCloseGvKey();
   string   gvLastCutK  = "EA_DUBAI_LAST_CUT_" + IntegerToString(MagicNumber) + "_" + Symbol();
   string   gvCutCntK   = "EA_DUBAI_CUT_CNT_"  + IntegerToString(MagicNumber) + "_" + Symbol();
   double   curEquity   = AccountEquity();

// Ensure Dubai opening day equity & rollover state are initialized / synced
   SyncDubaiDayOpeningState(nowServer);

   if(!InpEnableDubaiNightOneSideCloseAll)
      return;

   if(g_dubaiNightCloseDoneToday)
      return;

// Check Dubai window
   int  startMod      = InpDubaiNightCloseStartHour * 60;
   int  endMod        = InpDubaiNightCloseEndHour   * 60;
   int  forceMod      = InpDubaiNightForceCloseHour * 60 + InpDubaiNightForceCloseMinute;
   bool inDubaiWindow = false;
   if(InpDubaiNightCloseStartHour < InpDubaiNightCloseEndHour)
      inDubaiWindow = (dubaiHour >= InpDubaiNightCloseStartHour && dubaiHour < InpDubaiNightCloseEndHour);
   else
      if(InpDubaiNightCloseStartHour > InpDubaiNightCloseEndHour)
         inDubaiWindow = (dubaiHour >= InpDubaiNightCloseStartHour || dubaiHour < InpDubaiNightCloseEndHour);
      else
         inDubaiWindow = (dubaiHour == InpDubaiNightCloseStartHour);

   if(!inDubaiWindow)
     {
      g_dubaiNightCloseRetryPending = false;
      return;
     }

// Path A (OR): Day Equity Profit > 5% vs Dubai Opening Day Equity -> immediate full close-all
   double dayProfitUSD = (g_dubaiDayOpeningEquity > 0.0) ? (curEquity - g_dubaiDayOpeningEquity) : 0.0;
   double dayProfitPct = (g_dubaiDayOpeningEquity > 0.0) ? ((dayProfitUSD / g_dubaiDayOpeningEquity) * 100.0) : 0.0;
   bool   isDayProfitTriggered = (InpEnableDubaiNightDayProfitClose &&
                                  g_dubaiDayOpeningEquity > 0.0 &&
                                  dayProfitPct > InpDubaiNightDayProfitPct);

// Path B: Fresh live EMA30 angle gate (MathAbs(EMAangle) in [0.0, 1.0])
   double curEmaAngle  = GetEmaAngleDegrees(30);
   GlobalEmaAngle30    = curEmaAngle;
   double absEmaAngle  = MathAbs(curEmaAngle);
   bool   angleInRange = (!InpEnableDubaiNightEmaAngleFilter ||
                          (absEmaAngle + 1e-9 >= InpDubaiNightMinEmaAngleDeg &&
                           absEmaAngle - 1e-9 <= InpDubaiNightMaxEmaAngleDeg));
   if(!isDayProfitTriggered && !angleInRange && !g_dubaiNightCloseRetryPending)
      return;

   bool isForceCloseTime = false;
   if(InpEnableDubaiNightForceCloseAll)
     {
      if(startMod <= endMod)
         isForceCloseTime = (dubaiMod >= forceMod);
      else
         if(forceMod >= startMod)
            isForceCloseTime = (dubaiMod >= forceMod || dubaiMod < endMod);
         else
            isForceCloseTime = (dubaiMod >= forceMod && dubaiMod < endMod);
     }

// Snapshot live open market orders for this Symbol & MagicNumber
   int buyCount  = 0;
   int sellCount = 0;
   int openTickets[1000];
   ArrayInitialize(openTickets, 0);
   int openCount = 0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType == OP_BUY)
        {
         buyCount++;
         if(openCount < 1000)
            openTickets[openCount++] = OrderTicket();
        }
      else
         if(oType == OP_SELL)
           {
            sellCount++;
            if(openCount < 1000)
               openTickets[openCount++] = OrderTicket();
           }
     }

// Must have at least 1 open order
   if(openCount == 0)
     {
      if(g_dubaiNightCloseRetryPending)
        {
         g_dubaiNightCloseRetryPending = false;
         g_dubaiNightCloseDoneToday    = true;
         g_dubaiNightCloseLastHitTime  = nowServer;
         g_dubaiNightLastCloseTag      = isDayProfitTriggered ? StringFormat("DAY>%.0f%%", InpDubaiNightDayProfitPct)
                                         : StringFormat("%02d:%02d ALL", InpDubaiNightForceCloseHour, InpDubaiNightForceCloseMinute);
         if(!isTestRun)
            GlobalVariableSet(gvKey, (double)dubaiDayKey);
        }
      return;
     }

   bool oneSideZero = (buyCount == 0 && sellCount > 0) || (sellCount == 0 && buyCount > 0);
   bool doFullClose = (isDayProfitTriggered || (angleInRange && isForceCloseTime) || g_dubaiNightCloseRetryPending);

   string zeroSideName   = (buyCount == 0) ? "BUY" : "SELL";
   string activeSideName = (buyCount > 0) ? ((sellCount > 0) ? "BUY+SELL" : "BUY") : "SELL";

// ===== BRANCH 1: FULL CLOSE ALL OPEN ORDERS (Path A Day Equity > 5% OR Path B >= 11:45 PM) =====
   if(doFullClose)
     {
      RefreshRates();
      string triggerTag    = "";
      string triggerReason = "";
      if(isDayProfitTriggered)
        {
         triggerTag    = StringFormat("DAY PROFIT >%.0f%%", InpDubaiNightDayProfitPct);
         triggerReason = StringFormat("Eq=$%.2f vs OpenEq=$%.2f (+$%.2f / +%.2f%% > %.1f%%) | BUY=%d SELL=%d | EMAang=%.2f",
                                      curEquity, g_dubaiDayOpeningEquity, dayProfitUSD, dayProfitPct,
                                      InpDubaiNightDayProfitPct, buyCount, sellCount, curEmaAngle);
        }
      else
        {
         triggerTag    = StringFormat("%02d:%02d FINAL CLOSE ALL", InpDubaiNightForceCloseHour, InpDubaiNightForceCloseMinute);
         triggerReason = StringFormat("Final %02d:%02d Dubai (BUY=%d, SELL=%d, Prior 50%% Cuts=%d) | EMAang=%.2f (|%.2f|<=%.1f)",
                                      InpDubaiNightForceCloseHour, InpDubaiNightForceCloseMinute,
                                      buyCount, sellCount, g_dubaiNightCutCountToday,
                                      curEmaAngle, absEmaAngle, InpDubaiNightMaxEmaAngleDeg);
        }

      int    closedCount = 0;
      int    failCount   = 0;
      double closedLots  = 0.0;
      double closedPL    = 0.0;

      for(int k = 0; k < openCount; k++)
        {
         int tkt = openTickets[k];
         if(!OrderSelect(tkt, SELECT_BY_TICKET, MODE_TRADES))
            continue;
         if(OrderCloseTime() != 0)
            continue;
         if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
            continue;

         int oType = OrderType();
         if(oType != OP_BUY && oType != OP_SELL)
            continue;

         double oLots = OrderLots();
         double oPL   = OrderProfit() + OrderSwap() + OrderCommission();
         color  cClr  = (oType == OP_BUY) ? clrRed : clrBlue;

         RefreshRates();
         ResetLastError();
         g_eqDdForceCloseBudget = true;
         bool ok = SafeOrderCloseMarket(tkt, oLots, Slippage, cClr);
         g_eqDdForceCloseBudget = false;

         if(ok)
           {
            closedCount++;
            closedLots += oLots;
            closedPL   += oPL;
           }
         else
           {
            failCount++;
            PrintFormat(">>> [DUBAI NIGHT FULL CLOSE FAIL] Ticket #%d (%s %.2fL) Err=%d | DubaiTime=%s",
                        tkt, (oType == OP_BUY ? "BUY" : "SELL"), oLots, GetLastError(),
                        TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS));
           }
        }

      if(closedCount > 0 || failCount > 0)
         InvalidateOrderCache();

      int remainingOpen = 0;
      for(int j = OrdersTotal() - 1; j >= 0; j--)
        {
         if(!OrderSelect(j, SELECT_BY_POS, MODE_TRADES))
            continue;
         if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
            continue;
         int rType = OrderType();
         if(rType == OP_BUY || rType == OP_SELL)
            remainingOpen++;
        }

      if(remainingOpen == 0 && (closedCount > 0 || failCount == 0))
        {
         g_dubaiNightCloseRetryPending = false;
         g_dubaiNightCloseDoneToday    = true;
         g_dubaiNightCloseLastHitTime  = nowServer;
         g_dubaiNightLastCloseTag      = isDayProfitTriggered ? StringFormat("DAY>%.0f%%", InpDubaiNightDayProfitPct)
                                         : StringFormat("%02d:%02d ALL", InpDubaiNightForceCloseHour, InpDubaiNightForceCloseMinute);
         g_dubaiNightLastCloseOrders   = closedCount;
         g_dubaiNightLastCloseLots     = closedLots;
         g_dubaiNightLastClosePL       = closedPL;
         if(!isTestRun)
            GlobalVariableSet(gvKey, (double)dubaiDayKey);

         PrintFormat(">>> [DUBAI NIGHT %s] DubaiTime=%s (Broker=%s) | %s -> Closed ALL %d %s Open Order(s) (%.2fL, NetPL=%s$%.2f) | Locked 1x Today Until Next Day",
                     triggerTag,
                     TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                     TimeToString(nowServer, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                     triggerReason, closedCount, activeSideName, closedLots,
                     (closedPL >= 0.0 ? "+" : "-"), MathAbs(closedPL));

         if(closedCount > 0)
            DrawDubaiNightCloseIcon((isDayProfitTriggered ? "PATH_A" : "FINAL"), g_dubaiNightCutCountToday, activeSideName,
                                    closedCount, closedLots, closedPL, dayProfitPct, curEmaAngle, nowServer, 0.0);

         LastDashboardUpdateMs = 0;
         if(ShowLeftLiveOrdersDashboard)
            UpdateLeftLiveOrdersDashboard();
        }
      else
         if(closedCount > 0 && remainingOpen > 0)
           {
            g_dubaiNightCloseRetryPending = true;
            PrintFormat(">>> [DUBAI NIGHT PARTIAL PASS] Closed=%d Fail=%d RemainingOpen=%d | Retry armed",
                        closedCount, failCount, remainingOpen);
            DrawDubaiNightCloseIcon((isDayProfitTriggered ? "PATH_A" : "FINAL"), g_dubaiNightCutCountToday, activeSideName,
                                    closedCount, closedLots, closedPL, dayProfitPct, curEmaAngle, nowServer, 0.0);
           }
      return;
     }

// ===== BRANCH 2: PATH B BEFORE 11:45 PM -> SLOW 50% LOT CUT EVERY 30 MIN WHEN ONE SIDE == 0 & |EMAang| 0..1 =====
   if(!angleInRange || !oneSideZero)
      return;

   int cutCooldownSec = MathMax(60, InpDubaiNightCutIntervalMinutes * 60);
   if(g_dubaiNightLastCutTime > 0 && (nowServer - g_dubaiNightLastCutTime) < cutCooldownSec)
      return;

   RefreshRates();
   double minLot  = MarketInfo(Symbol(), MODE_MINLOT);
   double lotStep = MarketInfo(Symbol(), MODE_LOTSTEP);
   if(minLot <= 0.0)
      minLot = 0.01;
   if(lotStep <= 0.0)
      lotStep = 0.01;
   int    lotDigits = (lotStep >= 1.0) ? 0 : ((lotStep >= 0.1) ? 1 : ((lotStep >= 0.01) ? 2 : 3));
   double cutFrac   = InpDubaiNightPartialCutPct / 100.0;
   if(cutFrac <= 0.0)
      cutFrac = 0.50;
   if(cutFrac > 0.99)
      cutFrac = 0.99;

   int    cutHits       = 0;
   int    cutFail       = 0;
   int    skippedMinLot = 0;
   double cutLotsTotal  = 0.0;
   double cutPLTotal    = 0.0;

   for(int p = 0; p < openCount; p++)
     {
      int tkt = openTickets[p];
      if(!OrderSelect(tkt, SELECT_BY_TICKET, MODE_TRADES))
         continue;
      if(OrderCloseTime() != 0)
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;

      double oLots      = OrderLots();
      double maxPartial = NormalizeDouble(oLots - minLot, lotDigits);
      if(maxPartial < (lotStep - 1e-8))
        {
         skippedMinLot++;
         continue;
        }

      double closeLots = NormalizeDouble(MathRound((oLots * cutFrac) / lotStep + 1e-9) * lotStep, lotDigits);
      if(closeLots < lotStep)
         closeLots = lotStep;
      if(closeLots > maxPartial)
         closeLots = maxPartial;
      if(closeLots < (lotStep - 1e-8))
        {
         skippedMinLot++;
         continue;
        }

      double oPL   = OrderProfit() + OrderSwap() + OrderCommission();
      double estPL = (oLots > 0.0) ? (oPL * (closeLots / oLots)) : 0.0;
      color  cClr  = clrOrangeRed;

      RefreshRates();
      ResetLastError();
      g_eqDdForceCloseBudget = true;
      bool ok = SafeOrderCloseMarket(tkt, closeLots, Slippage, cClr);
      g_eqDdForceCloseBudget = false;

      if(ok)
        {
         cutHits++;
         cutLotsTotal += closeLots;
         cutPLTotal   += estPL;
        }
      else
        {
         cutFail++;
         PrintFormat(">>> [DUBAI PATH-B 50%% CUT FAIL] Ticket #%d (%s %.2fL cut %.2fL) Err=%d | DubaiTime=%s",
                     tkt, (oType == OP_BUY ? "BUY" : "SELL"), oLots, closeLots, GetLastError(),
                     TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS));
        }
     }

   if(cutHits > 0 || cutFail > 0)
      InvalidateOrderCache();

   g_dubaiNightLastCutSkippedMin = skippedMinLot;
   if(cutHits > 0)
     {
      g_dubaiNightLastCutTime = nowServer;
      g_dubaiNightCutCountToday++;
      g_dubaiNightLastCutZeroSide = zeroSideName;
      g_dubaiNightLastCutOrders   = cutHits;
      g_dubaiNightLastCutLots     = cutLotsTotal;
      g_dubaiNightLastCutPL       = cutPLTotal;
      if(!isTestRun)
        {
         GlobalVariableSet(gvLastCutK, (double)g_dubaiNightLastCutTime);
         GlobalVariableSet(gvCutCntK, (double)g_dubaiNightCutCountToday);
        }

      PrintFormat(">>> [DUBAI PATH-B -%.0f%% CUT #%d (%dm)] DubaiTime=%s (Broker=%s) | %s Open=0 | EMAang=%.2f | Cut %d Order(s) (-%.2fL, EstPL=%s$%.2f, MinLotKept:%d, Fail:%d) | Next Cut in %dm or Final Close @ %02d:%02d",
                  InpDubaiNightPartialCutPct, g_dubaiNightCutCountToday, InpDubaiNightCutIntervalMinutes,
                  TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  TimeToString(nowServer, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  zeroSideName, curEmaAngle, cutHits, cutLotsTotal,
                  (cutPLTotal >= 0.0 ? "+" : "-"), MathAbs(cutPLTotal),
                  skippedMinLot, cutFail, InpDubaiNightCutIntervalMinutes,
                  InpDubaiNightForceCloseHour, InpDubaiNightForceCloseMinute);

      DrawDubaiNightCloseIcon("CUT", g_dubaiNightCutCountToday, zeroSideName,
                              cutHits, cutLotsTotal, cutPLTotal, dayProfitPct, curEmaAngle, nowServer, 0.0);

      LastDashboardUpdateMs = 0;
      if(ShowLeftLiveOrdersDashboard)
         UpdateLeftLiveOrdersDashboard();
     }
  }
//+------------------------------------------------------------------+
//| Verify if BUY or SELL order is allowed based on EMA & 300 gap    |
//+------------------------------------------------------------------+
bool IsOrderAllowedByTrendAndGap(int orderType)
  {
   RefreshRates();

   bool isBuyRequest  = (orderType == OP_BUY || orderType == OP_BUYSTOP || orderType == OP_BUYLIMIT);
   bool isSellRequest = (orderType == OP_SELL || orderType == OP_SELLSTOP || orderType == OP_SELLLIMIT);

// Check counter-trend Buy orders when EMA direction is bearish (-1)
   if(EMADirection == -1 && isBuyRequest)
     {
      for(int i = OrdersTotal() - 1; i >= 0; i--)
        {
         if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
            continue;
         if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
            continue;

         if(OrderType() == OP_BUY)
           {
            double priceGap = MathAbs(Ask - OrderOpenPrice());
            if(priceGap < 300.0)
              {
               Print("TRADE BLOCKED | EMADirection is Sell, open Buy exists, gap < 300.");
               return false;
              }
           }
        }
     }

// Check counter-trend Sell orders when EMA direction is bullish (1)
   if(EMADirection == 1 && isSellRequest)
     {
      for(int i = OrdersTotal() - 1; i >= 0; i--)
        {
         if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
            continue;
         if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
            continue;

         if(OrderType() == OP_SELL)
           {
            double priceGap = MathAbs(Bid - OrderOpenPrice());
            if(priceGap < 300.0)
              {
               Print("TRADE BLOCKED | EMADirection is Buy, open Sell exists, gap < 300.");
               return false;
              }
           }
        }
     }

   return true;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool emaflipstrongorweak()
  {
   static bool cachedVal = false;
   static int  cachedTick = -1;
   if(cachedTick == CurrentTickSequence && CurrentTickSequence > 0)
      return cachedVal;

   if(EmaFlipTime == 0)
     {
      cachedVal = false;
      cachedTick = CurrentTickSequence;
      return false;
     }

   RefreshRates();

   int flipShift = iBarShift(Symbol(), Period(), EmaFlipTime, false);
   if(flipShift < 0)
      flipShift = Bars - 1;

// 100.0 means exactly $100 USD price movement on BTCUSD
   double threshold = 100.0;

// Handle Buy Direction (EMAdirection == 1)
   if(EMADirection == 1)
     {
      double highestPrice = -1.0;
      for(int i = flipShift; i >= 0; i--)
        {
         if(High[i] > highestPrice)
            highestPrice = High[i];
        }

      double pullbackFromHigh = highestPrice - Bid;
      if(pullbackFromHigh >= threshold)
         cachedVal = false; // Weak (Price pulled back $100+ USD from the peak)
      else
         cachedVal = true; // Strong
     }
// Handle Sell Direction (EMAdirection == -1)
   else
      if(EMADirection == -1)
        {
         double lowestPrice = 999999.0;
         for(int i = flipShift; i >= 0; i--)
           {
            if(Low[i] < lowestPrice)
               lowestPrice = Low[i];
           }

         // Measures how many USD the Ask price has bounced UP from the lowest low
         double bounceFromLow = Ask - lowestPrice;
         if(bounceFromLow >= threshold)
            cachedVal = false; // Weak (Price bounced up $100+ USD from the low -> do not sell)
         else
            cachedVal = true; // Strong (Price has not bounced by $100+ USD)
        }
      else
        {
         cachedVal = false;
        }

   cachedTick = CurrentTickSequence;
   return cachedVal;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool emaflipstrongorweakOld()
  {
   if(EmaFlipTime == 0)
      return false;

   RefreshRates();

   int flipShift = iBarShift(Symbol(), Period(), EmaFlipTime, false);
   if(flipShift < 0)
      flipShift = Bars - 1;

   double threshold = 2*100.0 * Point;

// Handle Buy Direction (EMAdirection == 1)
   if(EMADirection == 1)
     {
      double highestPrice = 0.0;
      for(int i = flipShift-15; i >= 0; i--)
        {
         if(High[i] > highestPrice)
            highestPrice = High[i];
        }

      double pullbackFromHigh = highestPrice - Bid;
      if(pullbackFromHigh >= threshold)
         return false; // Weak

      return true; // Strong
     }
// Handle Sell Direction (EMAdirection == -1)
   else
      if(EMADirection == -1)
        {
         double lowestPrice = 999999.0;
         for(int i = flipShift-15; i >= 0; i--)
           {
            if(Low[i] < lowestPrice)
               lowestPrice = Low[i];
           }

         double bounceFromLow = Ask - lowestPrice;
         if(bounceFromLow >= threshold)
            return false; // Weak

         return true; // Strong
        }

   return false;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool HasAnyLargeCandle(string symbol, ENUM_TIMEFRAMES timeframe, int candleCount, double threshold, bool checkBody = true)
  {
   for(int i = 1; i <= candleCount; i++)
     {
      double o = iOpen(symbol, timeframe, i);
      double c = iClose(symbol, timeframe, i);
      double h = iHigh(symbol, timeframe, i);
      double l = iLow(symbol, timeframe, i);

      double size = checkBody ? MathAbs(o - c) : MathAbs(h - l);

      if(size > threshold)
         return true;
     }
   return false;
  }
string TradeMonitoringLog="";
bool IsFarEnoughFromPeak(string symbol, double proximityThreshold = 50.0)
  {
// Last 1 hour on M1 = 60 candles (starting from bar 1)
   int highestBar = iHighest(symbol, PERIOD_M1, MODE_HIGH, 60, 10);
   if(highestBar < 0)
      return true;

   double highestPrice = iHigh(symbol, PERIOD_M1, highestBar);
   double currentPrice = SymbolInfoDouble(symbol, SYMBOL_BID); // or Close[0]

// Check if current price is within 'proximityThreshold' (e.g., 50) of the highest price
   if((highestPrice - currentPrice) <= proximityThreshold)
     {
      return false; // Too close to the 1-hour high
     }

   return true;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsFarEnoughFromTrough(string symbol, double proximityThreshold = 50.0)
  {
// Last 1 hour on M1 = 60 candles (starting from bar 1)
   int lowestBar = iLowest(symbol, PERIOD_M1, MODE_LOW, 60, 1);
   if(lowestBar < 0)
      return true;

   double lowestPrice = iLow(symbol, PERIOD_M1, lowestBar);
   double currentPrice = SymbolInfoDouble(symbol, SYMBOL_BID); // or Close[0]

// Check if current price is within 'proximityThreshold' (e.g., 50) of the lowest price
   if((currentPrice - lowestPrice) <= proximityThreshold)
     {
      return false; // Too close to the 1-hour low (don't sell right at the bottom)
     }

   return true;
  }

