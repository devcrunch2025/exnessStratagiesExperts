//+------------------------------------------------------------------+
//| Check if an order is a Horizontal Line order (EQH/EQL)          |
//+------------------------------------------------------------------+
bool IsHorizontalLineOrder(int ticket, string comment = "")
  {
   if(ticket <= 0)
      return false;
   if((g_lastEqhSellOrderTicket > 0 && ticket == g_lastEqhSellOrderTicket) ||
      (g_lastEqlBuyOrderTicket > 0 && ticket == g_lastEqlBuyOrderTicket))
      return true;

   string curComment = comment;
   if(curComment == "" || IsPartialCloseOrderComment(curComment))
     {
      curComment = GetEffectiveOrderComment(ticket, curComment);
      if(curComment == "")
        {
         if(OrderTicket() == ticket)
            curComment = OrderComment();
         else
            if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
               curComment = OrderComment();
            else
               if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_HISTORY))
                  curComment = OrderComment();
        }
     }

   if(StringFind(curComment, "EQH") >= 0 || StringFind(curComment, "EQL") >= 0)
      return true;

   int rootTicket = ResolveRootTicketFromPartialChain(ticket, comment);
   if(rootTicket > 0 &&
      ((g_lastEqhSellOrderTicket > 0 && rootTicket == g_lastEqhSellOrderTicket) ||
       (g_lastEqlBuyOrderTicket > 0 && rootTicket == g_lastEqlBuyOrderTicket)))
      return true;

   return false;
  }
void CheckForNewDay()
{
   // Convert broker server time to Dubai time (UTC+4)
   datetime dubaiTime = TimeGMT() + 4 * 3600;

   // Trading day starts at 16:00 Dubai time
   datetime tradingDayStart = dubaiTime - (15 * 3600);// 3PM - one hour before - 4PM dubai

   int today = TimeYear(tradingDayStart) * 10000
             + TimeMonth(tradingDayStart) * 100
             + TimeDay(tradingDayStart);

   if(today != g_dayNumber)
   {
      // NEW TRADING DAY
      g_dayNumber = today;

      // Capture opening balance
      g_dayOpeningBalance = AccountBalance();

      // Reset daily protection
      g_dailyEquityTradingBlocked = false;
      g_dailyEquityTargetHitToday = false;
      g_dailyEquityPeakEquity = 0.0;
      g_dailyEquityNextStepTarget = 0.0;
      g_dailyEquityStepCount = 0;

      Print("NEW TRADING DAY detected (Dubai 4 PM). Opening Balance = ",
            DoubleToString(g_dayOpeningBalance, 2));
   }
}
