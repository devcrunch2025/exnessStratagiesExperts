void OnDeinit(const int reason)
  {
   RemoveDubaiTradingPauseDashboard();
   DeleteOurObjects();
   ClearEMALineObjects();
   DeleteLiquiditySweepObjects();
   ClearSweepGlobalVariables();
   GenerateTesterSummaryReport();
   PrintMethodAnalyticsSummaryReport();
   if(g_drawdownReliefAppliedCount > 0 || g_drawdownReliefHitSuccessCount > 0)
     {
      double mult = (balancelomultipler > 0) ? balancelomultipler : 1.0;
      PrintFormat(">>> [DRAWDOWN RELIEF SUMMARY] Total Tighten Executions: %d | Total SL Hits (Loss Capped): %d | Mode: Repeating on every $%.2f DD",
                  g_drawdownReliefAppliedCount, g_drawdownReliefHitSuccessCount,
                  (InpDrawdownReliefMinPeakUSD * mult));
     }
   if(g_eqDdTotalPartialCuts > 0 || g_eqDdTotalCloseAllOrders > 0)
     {
      string tierRangeStr = InpEqDdEnableTier1 ? "10%-90%" : "20%-90%";
      PrintFormat(">>> [EQ-DD LOT SHIELD SUMMARY] Peak DD=%.2f%% | Partial Cuts (%s Tiers): %d | Close-All Orders: %d | Total Lots Reduced: %.2fL",
                  g_eqDdSessionPeakPct, tierRangeStr, g_eqDdTotalPartialCuts, g_eqDdTotalCloseAllOrders, g_eqDdTotalLotsReduced);
     }
   if(g_hourlyPlanATotalSweeps > 0 || g_hourlySideLossTotalCuts > 0 || g_hourlySideLossCheckCount > 0 || g_hourlyPlanCTotalSweeps > 0 || g_hourlyPlanCCheckCount > 0 || g_hourlyPlanDTotalSweeps > 0 || g_hourlyPlanDCheckCount > 0)
     {
      string planBDesc = InpEnableHourlyPlanBSideLossCut
                         ? StringFormat("Side>%.0f%% -%.0f%%L", InpHourlySideLossThresholdPct, InpHourlySideLossCutPct)
                         : "OFF";
      PrintFormat(">>> [1H PLAN A/B/C/D SUMMARY] 1H-Chk(%dm): %d | Plan-A (DayEq>%.0f%%): Sweeps=%d Orders=%d (-%.2fL) | Plan-B (%s): Sweeps=%d Cuts=%d (-%.2fL) | 15M-Chk(%dm): %d | Plan-C (DayEq>%.0f%%): Sweeps=%d Orders=%d (-%.2fL) | 1M-Chk(%ds): %d | Plan-D (%.0f-%.0f%% 1hRst): Sweeps=%d Orders=%d (-%.2fL)",
                  InpHourlySideLossIntervalMinutes, g_hourlySideLossCheckCount,
                  InpHourlyPlanADayProfitPct, g_hourlyPlanATotalSweeps, g_hourlyPlanATotalOrders, g_hourlyPlanATotalLots,
                  planBDesc,
                  g_hourlySideLossTotalSweeps, g_hourlySideLossTotalCuts, g_hourlySideLossTotalLotsCut,
                  InpHourlyPlanCIntervalMinutes, g_hourlyPlanCCheckCount,
                  InpHourlyPlanCDayProfitPct, g_hourlyPlanCTotalSweeps, g_hourlyPlanCTotalOrders, g_hourlyPlanCTotalLots,
                  InpHourlyPlanDIntervalSeconds, g_hourlyPlanDCheckCount,
                  InpHourlyPlanDStartPct, InpHourlyPlanDMaxPct,
                  g_hourlyPlanDTotalSweeps, g_hourlyPlanDTotalOrders, g_hourlyPlanDTotalLots);
     }
   if(g_priceGapCloseTotalSweeps > 0)
     {
      PrintFormat(">>> [PRICE GAP >%.0f & DAY EQ >%.0f%% SUMMARY] Sweeps=%d Orders=%d (-%.2fL) | LastAnchor=%s | LastHit=%s GST",
                  InpPriceGapCloseRawGap, InpPriceGapCloseDayProfitPct,
                  g_priceGapCloseTotalSweeps, g_priceGapCloseTotalOrders, g_priceGapCloseTotalLots,
                  DoubleToString(g_priceGapCloseAnchorPrice, Digits),
                  (g_priceGapCloseLastHitTime > 0 ? FormatDubaiShortDT(g_priceGapCloseLastHitTime, true) : "NONE"));
     }
   if(g_stepLossTotalSweeps > 0)
     {
      PrintFormat(">>> [ADVERSE STEP LOSS SUMMARY] Steps=%d Partials=%d Worst0.01Closes=%d (-%.2fL) | Last=%s @%s GST",
                  g_stepLossTotalSweeps, g_stepLossTotalPartialCuts, g_stepLossTotalFullCloses, g_stepLossTotalLotsCut,
                  g_stepLossLastHitSide, (g_stepLossLastHitTime > 0 ? FormatDubaiShortDT(g_stepLossLastHitTime, true) : "NONE"));
     }
   if(g_rev100StepCutTotalCuts > 0)
     {
      PrintFormat(">>> [>%.2fL -$%.0f STEP CUT SUMMARY] Cuts=%d TotalLots=-%.2fL (AllOrders=%s) | LastRoot=#%d Step#%d (Adv=$%.1f) @%s GST",
                  InpReverse100AdverseStepMinLots, InpReverse100AdverseStepRaw,
                  g_rev100StepCutTotalCuts, g_rev100StepCutTotalLots,
                  (InpAdverseStep100AllOrders ? "YES" : "NO"),
                  g_rev100StepCutLastRecTicket, g_rev100StepCutLastStep, g_rev100StepCutLastAdvGap,
                  (g_rev100StepCutLastHitTime > 0 ? FormatDubaiShortDT(g_rev100StepCutLastHitTime, true) : "NONE"));
     }
  }

