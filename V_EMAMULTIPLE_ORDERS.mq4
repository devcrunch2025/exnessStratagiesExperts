//+------------------------------------------------------------------+
//| ExecuteHourlySideLossCutForSide                                  |
//| Partial-closes 20% LOT (min lot 0.01 preserved) on losing open   |
//| orders STRICTLY for one side (OP_BUY or OP_SELL).                |
//+------------------------------------------------------------------+
void ExecuteHourlySideLossCutForSide(int sideType, double balance, double sideNetPL, double sideLossPct, datetime nowServer, double cutPct, double minLotCfg)
  {
   bool     isBuy       = (sideType == OP_BUY);
   string   sideName    = isBuy ? "BUY" : "SELL";
   double   sideLossUSD = (sideNetPL < 0.0) ? (-sideNetPL) : 0.0;
   datetime dubaiTime   = nowServer + (ServerToDubaiOffsetHours * 3600);

   RefreshRates();
   double minLot  = MarketInfo(Symbol(), MODE_MINLOT);
   double lotStep = MarketInfo(Symbol(), MODE_LOTSTEP);
   if(minLot <= 0.0)
      minLot = 0.01;
   if(lotStep <= 0.0)
      lotStep = 0.01;

   int    lotDigits = (lotStep >= 1.0) ? 0 : ((lotStep >= 0.1) ? 1 : ((lotStep >= 0.01) ? 2 : 3));
   double effMinLot = MathMax(minLot, minLotCfg);
   double minCutLot = MathMax(lotStep, minLotCfg);
   double cutFrac   = cutPct / 100.0;
   if(cutFrac <= 0.0)
      cutFrac = 0.20;
   if(cutFrac > 0.99)
      cutFrac = 0.99;

// Phase 1: Snapshot losing open market orders strictly on sideType (never mixed with opposite side)
   int candTickets[500];
   ArrayInitialize(candTickets, 0);
   int candCount     = 0;
   int losingCount   = 0;
   int skippedMinLot = 0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      if(OrderType() != sideType)
         continue;

      double netPL = OrderProfit() + OrderSwap() + OrderCommission();
      if(netPL >= 0.0)
         continue;

      losingCount++;

      double oLots      = OrderLots();
      double maxPartial = NormalizeDouble(oLots - effMinLot, lotDigits);
      if(maxPartial < (lotStep - 1e-8))
        {
         skippedMinLot++;
         continue;
        }

      if(candCount < 500)
         candTickets[candCount++] = OrderTicket();
     }

   if(candCount == 0)
     {
      if(losingCount > 0)
        {
         PrintFormat(">>> [1H %s LOSS >%.0f%% MINLOT KEPT] Dubai=%s | Bal=$%.2f | %s Loss=%.2f%% (-$%.2f) | All %d losing order(s) at min lot %.2f (SkipCut).",
                     sideName, InpHourlySideLossThresholdPct,
                     TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                     balance, sideName, sideLossPct, sideLossUSD, losingCount, effMinLot);
        }
      return;
     }

// Phase 2: Partial-close 20% LOT on each snapshotted candidate order (minimum LOT = 0.01)
   int    cutHits       = 0;
   int    cutFail       = 0;
   double cutLotsTotal  = 0.0;
   double cutEstPLTotal = 0.0;

   for(int k = 0; k < candCount; k++)
     {
      int tkt = candTickets[k];
      if(!OrderSelect(tkt, SELECT_BY_TICKET, MODE_TRADES))
         continue;
      if(OrderCloseTime() != 0 || OrderType() != sideType)
         continue;

      double netPL = OrderProfit() + OrderSwap() + OrderCommission();
      if(netPL >= 0.0)
         continue;

      double oLots      = OrderLots();
      double maxPartial = NormalizeDouble(oLots - effMinLot, lotDigits);
      if(maxPartial < (lotStep - 1e-8))
        {
         skippedMinLot++;
         continue;
        }

      double closeLots = NormalizeDouble(MathRound((oLots * cutFrac) / lotStep + 1e-9) * lotStep, lotDigits);
      if(closeLots < minCutLot)
         closeLots = minCutLot;
      if(closeLots > maxPartial)
         closeLots = maxPartial;
      if(closeLots < (lotStep - 1e-8))
        {
         skippedMinLot++;
         continue;
        }

      double estPL = (oLots > 0.0) ? (netPL * (closeLots / oLots)) : 0.0;
      double remLots = NormalizeDouble(oLots - closeLots, lotDigits);

      RefreshRates();
      ResetLastError();
      g_eqDdForceCloseBudget = true;
      bool ok = SafeOrderCloseMarket(tkt, closeLots, Slippage, clrOrangeRed);
      g_eqDdForceCloseBudget = false;

      if(ok)
        {
         cutHits++;
         cutLotsTotal  += closeLots;
         cutEstPLTotal += estPL;
         g_hourlySideLossTotalCuts++;
         g_hourlySideLossTotalLotsCut += closeLots;

         PrintFormat(">>> [1H %s LOSS CUT -%.0f%%L] Dubai=%s | Bal=$%.2f | %s DD=%.2f%% (-$%.2f) | Order #%d (%.2fL -> Cut %.2fL, Rem %.2fL, EstPL=%s$%.2f)",
                     sideName, cutPct, TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                     balance, sideName, sideLossPct, sideLossUSD,
                     tkt, oLots, closeLots, remLots, (estPL >= 0.0 ? "+" : "-"), MathAbs(estPL));
        }
      else
        {
         cutFail++;
         PrintFormat(">>> [1H %s LOSS CUT FAIL] Ticket #%d (%.2fL cut %.2fL) Err=%d | Dubai=%s",
                     sideName, tkt, oLots, closeLots, GetLastError(),
                     TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS));
        }
     }

   if(cutHits > 0 || cutFail > 0)
      InvalidateOrderCache();

   if(cutHits > 0)
     {
      g_hourlySideLossTotalSweeps++;
      g_hourlySideLossLastHitTime   = nowServer;
      g_hourlySideLossLastHitSide   = sideName;
      g_hourlySideLossLastHitPct    = sideLossPct;
      g_hourlySideLossLastHitUSD    = sideLossUSD;
      g_hourlySideLossLastHitOrders = cutHits;
      g_hourlySideLossLastHitLots   = cutLotsTotal;
      g_hourlySideLossLastHitPL     = cutEstPLTotal;

      PrintFormat(">>> [1H %s LOSS CUT COMPLETE] Dubai=%s (Broker=%s) | %s Loss=%.2f%% (-$%.2f) > %.1f%% | Cut %d Order(s) (-%.2fL, EstPL=%s$%.2f, MinLotKept:%d, Fail:%d)",
                  sideName, TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  TimeToString(nowServer, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  sideName, sideLossPct, sideLossUSD, InpHourlySideLossThresholdPct,
                  cutHits, cutLotsTotal, (cutEstPLTotal >= 0.0 ? "+" : "-"), MathAbs(cutEstPLTotal),
                  skippedMinLot, cutFail);

      DrawHourlySideLossCutIcon(sideName, sideLossPct, sideLossUSD, balance, cutPct, cutHits, cutLotsTotal, cutEstPLTotal, nowServer, 0.0);
      LastDashboardUpdateMs = 0;
     }
  }

//+------------------------------------------------------------------+
//| ExecuteHourlyPlanACloseAll                                       |
//| Plan A: When Day Equity Profit > 5% vs Dubai 00:00 opening equity|
//| closes ALL open market orders (OP_BUY & OP_SELL) for Symbol/Magic|
//| Returns true if Plan A handled this hourly tick (skips Plan B).  |
//+------------------------------------------------------------------+
bool ExecuteHourlyPlanACloseAll(double dayOpenEq, double curEquity, double dayProfitUSD, double dayProfitPct, datetime nowServer)
  {
   datetime dubaiTime = nowServer + (ServerToDubaiOffsetHours * 3600);
   bool     isTestRun = (IsTesting() || IsOptimization());

// Snapshot all live open market orders (OP_BUY + OP_SELL) for this Symbol & MagicNumber
   int buyCount  = 0;
   int sellCount = 0;
   int openTickets[1000];
   ArrayInitialize(openTickets, 0);
   int openCount = 0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType == OP_BUY)
        {
         buyCount++;
         if(openCount < 1000)
            openTickets[openCount++] = OrderTicket();
        }
      else
         if(oType == OP_SELL)
           {
            sellCount++;
            if(openCount < 1000)
               openTickets[openCount++] = OrderTicket();
           }
     }

   double planAThr = (InpHourlyPlanADayProfitPct > 0.0) ? InpHourlyPlanADayProfitPct : 5.0;

   if(openCount == 0)
     {
      g_hourlyPlanATargetHits++;
      g_hourlyPlanAHitsToday++;
      PrintFormat(">>> [1H HOUR TARGET HIT +%.1f%% (0 OPEN)] Dubai=%s (Broker=%s) | Eq=$%.2f vs Open=$%.2f (+$%.2f / +%.2f%%) > %.1f%% | 0 open orders [OR Plan B skipped]",
                  dayProfitPct, TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  TimeToString(nowServer, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  curEquity, dayOpenEq, dayProfitUSD, dayProfitPct, planAThr);
      DrawHourlyPlanACloseIcon(dayProfitPct, dayProfitUSD, dayOpenEq, curEquity, 0, 0.0, 0.0, nowServer, 0.0, g_hourlyPlanATargetHits);
      return true;
     }

   int    closedCount = 0;
   int    failCount   = 0;
   double closedLots  = 0.0;
   double closedPL    = 0.0;

   for(int k = 0; k < openCount; k++)
     {
      int tkt = openTickets[k];
      if(!OrderSelect(tkt, SELECT_BY_TICKET, MODE_TRADES))
         continue;
      if(OrderCloseTime() != 0)
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;

      double oLots = OrderLots();
      double oPL   = OrderProfit() + OrderSwap() + OrderCommission();
      color  cClr  = (oType == OP_BUY) ? clrRed : clrBlue;

      RefreshRates();
      ResetLastError();
      g_eqDdForceCloseBudget = true;
      bool ok = SafeOrderCloseMarket(tkt, oLots, Slippage, cClr);
      g_eqDdForceCloseBudget = false;

      if(ok)
        {
         closedCount++;
         closedLots += oLots;
         closedPL   += oPL;
        }
      else
        {
         failCount++;
         PrintFormat(">>> [1H PLAN-A CLOSE FAIL] Ticket #%d (%s %.2fL) Err=%d | Dubai=%s",
                     tkt, (oType == OP_BUY ? "BUY" : "SELL"), oLots, GetLastError(),
                     TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS));
        }
     }

   if(closedCount > 0 || failCount > 0)
      InvalidateOrderCache();

   int remainingOpen = 0;
   for(int j = OrdersTotal() - 1; j >= 0; j--)
     {
      if(!OrderSelect(j, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int rType = OrderType();
      if(rType == OP_BUY || rType == OP_SELL)
         remainingOpen++;
     }

   if(closedCount > 0)
     {
      g_hourlyPlanATotalSweeps++;
      g_hourlyPlanATargetHits++;
      g_hourlyPlanATotalOrders += closedCount;
      g_hourlyPlanATotalLots   += closedLots;
      g_hourlyPlanAHitsToday++;
      g_hourlyPlanALastHitTime  = nowServer;
      g_hourlyPlanALastPct      = dayProfitPct;
      g_hourlyPlanALastUSD      = dayProfitUSD;
      g_hourlyPlanALastOrders   = closedCount;
      g_hourlyPlanALastLots     = closedLots;
      g_hourlyPlanALastPL       = closedPL;

      if(InpHourlyPlanAOncePerDay && remainingOpen == 0 && failCount == 0)
        {
         g_hourlyPlanADoneToday = true;
         if(!isTestRun && g_dubaiNightCloseDayKey > 0)
            GlobalVariableSet("EA_HRLY_PLANA_DONE_" + IntegerToString(MagicNumber) + "_" + Symbol(), (double)g_dubaiNightCloseDayKey);
        }

      PrintFormat(">>> [1H PLAN-A DAY EQ >%.1f%% CLOSE ALL] Dubai=%s (Broker=%s) | Eq=$%.2f vs Open=$%.2f (+$%.2f / +%.2f%%) -> Closed ALL %d Order(s) (B:%d S:%d | -%.2fL, NetPL=%s$%.2f, Fail=%d, Rem=%d) [OR Plan B skipped]",
                  planAThr, TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  TimeToString(nowServer, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  curEquity, dayOpenEq, dayProfitUSD, dayProfitPct,
                  closedCount, buyCount, sellCount, closedLots,
                  (closedPL >= 0.0 ? "+" : "-"), MathAbs(closedPL), failCount, remainingOpen);

      DrawHourlyPlanACloseIcon(dayProfitPct, dayProfitUSD, dayOpenEq, curEquity, closedCount, closedLots, closedPL, nowServer, 0.0, g_hourlyPlanATargetHits);
      LastDashboardUpdateMs = 0;
      if(ShowLeftLiveOrdersDashboard)
         UpdateLeftLiveOrdersDashboard();
     }
   else
      if(failCount > 0)
        {
         PrintFormat(">>> [1H PLAN-A ATTEMPT FAILED] Dubai=%s | DayEq=+%.2f%% (>%.1f%%) | Open=%d Fail=%d Rem=%d [OR Plan B skipped]",
                     TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                     dayProfitPct, planAThr, openCount, failCount, remainingOpen);
        }

   return true;
  }

//+------------------------------------------------------------------+
//| ExecuteHourlyPlanCCloseAll                                       |
//| Plan C (Extra, every 15 min): When Day Equity Profit > 10% vs    |
//| Dubai 00:00 opening equity, closes ALL open market orders        |
//| (OP_BUY & OP_SELL) for Symbol & MagicNumber.                     |
//+------------------------------------------------------------------+
bool ExecuteHourlyPlanCCloseAll(double dayOpenEq, double curEquity, double dayProfitUSD, double dayProfitPct, datetime nowServer, int &remainingOpenOut)
  {
   remainingOpenOut = 0;
   datetime dubaiTime = nowServer + (ServerToDubaiOffsetHours * 3600);
   bool     isTestRun = (IsTesting() || IsOptimization());

   int buyCount  = 0;
   int sellCount = 0;
   int openTickets[1000];
   ArrayInitialize(openTickets, 0);
   int openCount = 0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType == OP_BUY)
        {
         buyCount++;
         if(openCount < 1000)
            openTickets[openCount++] = OrderTicket();
        }
      else
         if(oType == OP_SELL)
           {
            sellCount++;
            if(openCount < 1000)
               openTickets[openCount++] = OrderTicket();
           }
     }

   if(openCount == 0)
      return false;

   double planCThr    = (InpHourlyPlanCDayProfitPct > 0.0) ? InpHourlyPlanCDayProfitPct : 10.0;
   int    closedCount = 0;
   int    failCount   = 0;
   double closedLots  = 0.0;
   double closedPL    = 0.0;

   for(int k = 0; k < openCount; k++)
     {
      int tkt = openTickets[k];
      if(!OrderSelect(tkt, SELECT_BY_TICKET, MODE_TRADES))
         continue;
      if(OrderCloseTime() != 0)
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;

      double oLots = OrderLots();
      double oPL   = OrderProfit() + OrderSwap() + OrderCommission();
      color  cClr  = (oType == OP_BUY) ? clrRed : clrBlue;

      RefreshRates();
      ResetLastError();
      g_eqDdForceCloseBudget = true;
      bool ok = SafeOrderCloseMarket(tkt, oLots, Slippage, cClr);
      g_eqDdForceCloseBudget = false;

      if(ok)
        {
         RecordOrderCloseReason(tkt, "15M_PLAN_C_DAY_PROFIT_10PCT");
         closedCount++;
         closedLots += oLots;
         closedPL   += oPL;
        }
      else
        {
         failCount++;
         PrintFormat(">>> [1H PLAN-C 15M CLOSE FAIL] Ticket #%d (%s %.2fL) Err=%d | Dubai=%s",
                     tkt, (oType == OP_BUY ? "BUY" : "SELL"), oLots, GetLastError(),
                     TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS));
        }
     }

   if(closedCount > 0 || failCount > 0)
      InvalidateOrderCache();

   int remainingOpen = 0;
   for(int j = OrdersTotal() - 1; j >= 0; j--)
     {
      if(!OrderSelect(j, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int rType = OrderType();
      if(rType == OP_BUY || rType == OP_SELL)
         remainingOpen++;
     }
   remainingOpenOut = remainingOpen;

   if(closedCount > 0)
     {
      g_hourlyPlanCTotalSweeps++;
      g_hourlyPlanCTotalOrders += closedCount;
      g_hourlyPlanCTotalLots   += closedLots;
      g_hourlyPlanCHitsToday++;
      g_hourlyPlanCLastHitTime  = nowServer;
      g_hourlyPlanCLastPct      = dayProfitPct;
      g_hourlyPlanCLastUSD      = dayProfitUSD;
      g_hourlyPlanCLastOrders   = closedCount;
      g_hourlyPlanCLastLots     = closedLots;
      g_hourlyPlanCLastPL       = closedPL;

      if(InpHourlyPlanCOncePerDay && remainingOpen == 0 && failCount == 0)
        {
         g_hourlyPlanCDoneToday = true;
         if(!isTestRun && g_dubaiNightCloseDayKey > 0)
            GlobalVariableSet("EA_HRLY_PLANC_DONE_" + IntegerToString(MagicNumber) + "_" + Symbol(), (double)g_dubaiNightCloseDayKey);
        }

      PrintFormat(">>> [1H PLAN-C 15M DAY EQ >%.1f%% CLOSE ALL] Dubai=%s (Broker=%s) | Eq=$%.2f vs Open=$%.2f (+$%.2f / +%.2f%%) -> Closed ALL %d Order(s) (B:%d S:%d | -%.2fL, NetPL=%s$%.2f, Fail=%d, Rem=%d)",
                  planCThr, TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  TimeToString(nowServer, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  curEquity, dayOpenEq, dayProfitUSD, dayProfitPct,
                  closedCount, buyCount, sellCount, closedLots,
                  (closedPL >= 0.0 ? "+" : "-"), MathAbs(closedPL), failCount, remainingOpen);

      DrawHourlyPlanCCloseIcon(dayProfitPct, dayProfitUSD, dayOpenEq, curEquity, closedCount, closedLots, closedPL, nowServer, 0.0, g_hourlyPlanCTotalSweeps);
      LastDashboardUpdateMs = 0;
      if(ShowLeftLiveOrdersDashboard)
         UpdateLeftLiveOrdersDashboard();
      return true;
     }
   else
      if(failCount > 0)
        {
         PrintFormat(">>> [1H PLAN-C 15M ATTEMPT FAILED] Dubai=%s | DayEq=+%.2f%% (>%.1f%%) | Open=%d Fail=%d Rem=%d",
                     TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                     dayProfitPct, planCThr, openCount, failCount, remainingOpen);
        }

   return false;
  }

//+------------------------------------------------------------------+
//| ExecuteHourlyPlanDCloseAll                                       |
//| Plan D (Extra, every 1 min, resets every 1 hour):                |
//| Minute 1 (:00) > 31%, Minute 2 (:01) > 32%, ..., Min 60 > 90%.   |
//| When Day Equity Profit % exceeds current minute threshold,       |
//| closes ALL open market orders (OP_BUY & OP_SELL) and optionally  |
//| locks the remaining minutes of the current hour until :00 reset. |
//+------------------------------------------------------------------+
bool ExecuteHourlyPlanDCloseAll(double dayOpenEq, double curEquity, double dayProfitUSD, double dayProfitPct, int minInHour, double planDThr, long curHourSlot, datetime nowServer, int &remainingOpenOut)
  {
   remainingOpenOut = 0;
   datetime dubaiTime = nowServer + (ServerToDubaiOffsetHours * 3600);
   bool     isTestRun = (IsTesting() || IsOptimization());

   int buyCount  = 0;
   int sellCount = 0;
   int openTickets[1000];
   ArrayInitialize(openTickets, 0);
   int openCount = 0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType == OP_BUY)
        {
         buyCount++;
         if(openCount < 1000)
            openTickets[openCount++] = OrderTicket();
        }
      else
         if(oType == OP_SELL)
           {
            sellCount++;
            if(openCount < 1000)
               openTickets[openCount++] = OrderTicket();
           }
     }

   if(openCount == 0)
      return false;

   string closeReasonTag = StringFormat("1M_PLAN_D_M%d_GT%.0fPCT", minInHour, planDThr);
   int    closedCount    = 0;
   int    failCount      = 0;
   double closedLots     = 0.0;
   double closedPL       = 0.0;

   for(int k = 0; k < openCount; k++)
     {
      int tkt = openTickets[k];
      if(!OrderSelect(tkt, SELECT_BY_TICKET, MODE_TRADES))
         continue;
      if(OrderCloseTime() != 0)
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;

      double oLots = OrderLots();
      double oPL   = OrderProfit() + OrderSwap() + OrderCommission();
      color  cClr  = (oType == OP_BUY) ? clrRed : clrBlue;

      RefreshRates();
      ResetLastError();
      g_eqDdForceCloseBudget = true;
      bool ok = SafeOrderCloseMarket(tkt, oLots, Slippage, cClr);
      g_eqDdForceCloseBudget = false;

      if(ok)
        {
         RecordOrderCloseReason(tkt, closeReasonTag);
         closedCount++;
         closedLots += oLots;
         closedPL   += oPL;
        }
      else
        {
         failCount++;
         PrintFormat(">>> [1M PLAN-D CLOSE FAIL] Min#%d (>%.0f%%) | Ticket #%d (%s %.2fL) Err=%d | Dubai=%s",
                     minInHour, planDThr, tkt, (oType == OP_BUY ? "BUY" : "SELL"), oLots, GetLastError(),
                     TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS));
        }
     }

   if(closedCount > 0 || failCount > 0)
      InvalidateOrderCache();

   int remainingOpen = 0;
   for(int j = OrdersTotal() - 1; j >= 0; j--)
     {
      if(!OrderSelect(j, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int rType = OrderType();
      if(rType == OP_BUY || rType == OP_SELL)
         remainingOpen++;
     }
   remainingOpenOut = remainingOpen;

   if(closedCount > 0)
     {
      g_hourlyPlanDTotalSweeps++;
      g_hourlyPlanDTotalOrders += closedCount;
      g_hourlyPlanDTotalLots   += closedLots;
      g_hourlyPlanDHitsToday++;
      g_hourlyPlanDLastHitTime      = nowServer;
      g_hourlyPlanDLastHitMinIdx    = minInHour;
      g_hourlyPlanDLastHitThreshPct = planDThr;
      g_hourlyPlanDLastPct          = dayProfitPct;
      g_hourlyPlanDLastUSD          = dayProfitUSD;
      g_hourlyPlanDLastOrders       = closedCount;
      g_hourlyPlanDLastLots         = closedLots;
      g_hourlyPlanDLastPL           = closedPL;

      if(InpHourlyPlanDOncePerHour && remainingOpen == 0 && failCount == 0)
        {
         g_hourlyPlanDDoneHourSlot = curHourSlot;
         if(!isTestRun)
            GlobalVariableSet("EA_HRLYD_DONEH_" + IntegerToString(MagicNumber) + "_" + Symbol(), (double)curHourSlot);
        }

      if(InpHourlyPlanDOncePerDay && remainingOpen == 0 && failCount == 0)
        {
         g_hourlyPlanDDoneToday = true;
         if(!isTestRun && g_dubaiNightCloseDayKey > 0)
            GlobalVariableSet("EA_HRLY_PLAND_DONE_" + IntegerToString(MagicNumber) + "_" + Symbol(), (double)g_dubaiNightCloseDayKey);
        }

      PrintFormat(">>> [1M PLAN-D MIN#%d DAY EQ >%.0f%% CLOSE ALL] Dubai=%s (Broker=%s) | Eq=$%.2f vs Open=$%.2f (+$%.2f / +%.2f%%) -> Closed ALL %d Order(s) (B:%d S:%d | -%.2fL, NetPL=%s$%.2f, Fail=%d, Rem=%d)%s",
                  minInHour, planDThr, TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  TimeToString(nowServer, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  curEquity, dayOpenEq, dayProfitUSD, dayProfitPct,
                  closedCount, buyCount, sellCount, closedLots,
                  (closedPL >= 0.0 ? "+" : "-"), MathAbs(closedPL), failCount, remainingOpen,
                  ((InpHourlyPlanDOncePerHour && remainingOpen == 0 && failCount == 0) ? " [Hour Locked -> Next :00 Reset]" : ""));

      DrawHourlyPlanDCloseIcon(minInHour, planDThr, dayProfitPct, dayProfitUSD, dayOpenEq, curEquity, closedCount, closedLots, closedPL, nowServer, 0.0, g_hourlyPlanDTotalSweeps);
      LastDashboardUpdateMs = 0;
      if(ShowLeftLiveOrdersDashboard)
         UpdateLeftLiveOrdersDashboard();
      return true;
     }
   else
      if(failCount > 0)
        {
         PrintFormat(">>> [1M PLAN-D MIN#%d ATTEMPT FAILED] Dubai=%s | DayEq=+%.2f%% (>%.0f%%) | Open=%d Fail=%d Rem=%d",
                     minInHour, TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                     dayProfitPct, planDThr, openCount, failCount, remainingOpen);
        }

   return false;
  }

//+------------------------------------------------------------------+
//| ManageHourlySideLoss20PctCut                                     |
//| Runs Plan D every 1 min (31%->90% rising, 1h reset),             |
//| Plan C every 15 min, and Plan A / Plan B every 1 hour (60m):     |
//| Plan D (Extra, 1m): Min 1 >31%, Min 2 >32%, ..., Min 60 >90%,    |
//|         closes ALL open orders & resets at every top of hour.    |
//| Plan C (Extra, 15m): If Day Equity Profit > 10% vs Dubai 00:00   |
//|         opening equity, close ALL open orders immediately.       |
//| Plan A (1H): If Day Equity Profit > 5% vs Dubai 00:00 opening    |
//|         equity, close ALL open orders immediately (BUY + SELL).  |
//| OR Plan B (1H): Evaluate BUY-only & SELL-only floating loss %    |
//|         vs Balance independently and cut 20% LOT on > 20% loss.  |
//+------------------------------------------------------------------+
void ManageHourlySideLoss20PctCut()
  {
   if(!InpEnableHourlySideLossCut)
      return;

   datetime nowServer = TimeCurrent();
   if(nowServer <= 0)
      return;

// Ensure Dubai 00:00 GST opening equity & midnight rollover are synced BEFORE any 1H Plan A/C/D check
   SyncDubaiDayOpeningState(nowServer);

   bool isTestRun = (IsTesting() || IsOptimization());

// ===== EXTRA PLAN D: Check every 1 min (Min 1 >31% .. Min 60 >90%, Reset every 1 hour) -> Close ALL =====
   int    intervalDSec = MathMax(1, InpHourlyPlanDIntervalSeconds);
   long   curSlotD     = (long)(((long)nowServer) / intervalDSec);
   int    minInHourD   = 1;
   long   curHourSlotD = 0;
   double planDThr     = ResolveHourlyPlanDMinuteAndThreshold(nowServer, minInHourD, curHourSlotD);
   string gvSlotDK     = "EA_HRLYD_SLOT_"  + IntegerToString(MagicNumber) + "_" + Symbol() + "_" + IntegerToString(intervalDSec);
   string gvRunDK      = "EA_HRLYD_RUN_"   + IntegerToString(MagicNumber) + "_" + Symbol() + "_" + IntegerToString(intervalDSec);
   string gvPlanDHrK   = "EA_HRLYD_DONEH_" + IntegerToString(MagicNumber) + "_" + Symbol();
   string gvPlanDCycK  = "EA_HRLYD_CYCH_"  + IntegerToString(MagicNumber) + "_" + Symbol();
   bool   planDClosedAllThisTick = false;

   if(!g_hourlyPlanDDoneHourLoaded)
     {
      g_hourlyPlanDDoneHourLoaded = true;
      if(!isTestRun)
        {
         if(GlobalVariableCheck(gvPlanDHrK))
           {
            long savedDoneH = (long)MathRound(GlobalVariableGet(gvPlanDHrK));
            if(savedDoneH == curHourSlotD)
               g_hourlyPlanDDoneHourSlot = savedDoneH;
            else
               GlobalVariableDel(gvPlanDHrK);
           }
         if(g_hourlyPlanDCycleHourSlot < 0 && GlobalVariableCheck(gvPlanDCycK))
           {
            long savedCycH = (long)MathRound(GlobalVariableGet(gvPlanDCycK));
            if(savedCycH == curHourSlotD)
               g_hourlyPlanDCycleHourSlot = savedCycH;
           }
        }
     }

   if(g_hourlyPlanDCycleHourSlot != curHourSlotD)
     {
      long prevCycleHourD = g_hourlyPlanDCycleHourSlot;
      bool prevWasLockedD = (prevCycleHourD >= 0 && g_hourlyPlanDDoneHourSlot == prevCycleHourD);
      g_hourlyPlanDCycleHourSlot = curHourSlotD;
      if(!isTestRun)
        {
         GlobalVariableSet(gvPlanDCycK, (double)curHourSlotD);
         if(GlobalVariableCheck(gvPlanDHrK) && (long)MathRound(GlobalVariableGet(gvPlanDHrK)) != curHourSlotD)
            GlobalVariableDel(gvPlanDHrK);
        }
      if(prevCycleHourD >= 0 && InpEnableHourlyPlanDDayProfitClose)
        {
         datetime dubaiRstD = nowServer + (ServerToDubaiOffsetHours * 3600);
         PrintFormat(">>> [1M PLAN-D HOURLY RESET] New 1H Cycle | Dubai=%s (Broker=%s) | Min#%d Thr=>%.0f%% (Range %.0f%%->%.0f%% | PrevHourLocked=%s)",
                     TimeToString(dubaiRstD, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                     TimeToString(nowServer, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                     minInHourD, planDThr, InpHourlyPlanDStartPct, InpHourlyPlanDMaxPct,
                     (prevWasLockedD ? "YES->UNLOCKED" : "NO"));
        }
     }

   if(g_hourlyPlanDLastSlot < 0)
     {
      if(!isTestRun && GlobalVariableCheck(gvSlotDK))
        {
         long savedSlotD = (long)MathRound(GlobalVariableGet(gvSlotDK));
         if(savedSlotD == curSlotD)
           {
            g_hourlyPlanDLastSlot      = curSlotD;
            g_hourlyPlanDNextRunTime   = (datetime)((curSlotD + 1) * (long)intervalDSec);
            g_hourlyPlanDLastMinIdx    = minInHourD;
            g_hourlyPlanDLastThreshPct = planDThr;
            if(GlobalVariableCheck(gvRunDK))
               g_hourlyPlanDLastRunTime = (datetime)MathRound(GlobalVariableGet(gvRunDK));
           }
        }

      if(g_hourlyPlanDLastSlot < 0 && intervalDSec >= 120)
        {
         long secsIntoSlotD = ((long)nowServer) % intervalDSec;
         if(secsIntoSlotD > 60)
           {
            g_hourlyPlanDLastSlot      = curSlotD;
            g_hourlyPlanDNextRunTime   = (datetime)((curSlotD + 1) * (long)intervalDSec);
            g_hourlyPlanDLastMinIdx    = minInHourD;
            g_hourlyPlanDLastThreshPct = planDThr;
            if(!isTestRun)
               GlobalVariableSet(gvSlotDK, (double)curSlotD);
           }
        }
     }

   if(curSlotD == g_hourlyPlanDLastSlot)
     {
      g_hourlyPlanDNextRunTime   = (datetime)((curSlotD + 1) * (long)intervalDSec);
      g_hourlyPlanDLastMinIdx    = minInHourD;
      g_hourlyPlanDLastThreshPct = planDThr;
     }
   else
     {
      g_hourlyPlanDLastSlot      = curSlotD;
      g_hourlyPlanDLastRunTime   = nowServer;
      g_hourlyPlanDNextRunTime   = (datetime)((curSlotD + 1) * (long)intervalDSec);
      g_hourlyPlanDLastMinIdx    = minInHourD;
      g_hourlyPlanDLastThreshPct = planDThr;
      if(InpEnableHourlyPlanDDayProfitClose)
        {
         g_hourlyPlanDCheckCount++;
         if(!isTestRun)
           {
            GlobalVariableSet(gvSlotDK, (double)curSlotD);
            GlobalVariableSet(gvRunDK, (double)nowServer);
           }

         double curEqD    = AccountEquity();
         double dayOpenD  = g_dubaiDayOpeningEquity;
         double dayProfUD = (dayOpenD > 0.0) ? (curEqD - dayOpenD) : 0.0;
         double dayProfPD = (dayOpenD > 0.0) ? ((dayProfUD / dayOpenD) * 100.0) : 0.0;
         bool   planDLockedH = (InpHourlyPlanDOncePerHour && g_hourlyPlanDDoneHourSlot == curHourSlotD);
         bool   planDLockedD = (InpHourlyPlanDOncePerDay && g_hourlyPlanDDoneToday);
         bool   planDHit  = (!planDLockedH && !planDLockedD && dayOpenD > 0.0 && dayProfPD > planDThr);
         if(planDHit)
           {
            int remOpenD = 0;
            if(ExecuteHourlyPlanDCloseAll(dayOpenD, curEqD, dayProfUD, dayProfPD, minInHourD, planDThr, curHourSlotD, nowServer, remOpenD) && remOpenD == 0)
               planDClosedAllThisTick = true;
           }
        }
     }

// ===== EXTRA PLAN C: Check every 15 min -> Day Equity Profit > 10% vs Dubai 00:00 opening equity -> Close ALL =====
   int    intervalCSec = MathMax(60, InpHourlyPlanCIntervalMinutes * 60);
   long   curSlotC     = (long)(((long)nowServer) / intervalCSec);
   string gvSlotCK     = "EA_HRLYC_SLOT_" + IntegerToString(MagicNumber) + "_" + Symbol() + "_" + IntegerToString(InpHourlyPlanCIntervalMinutes);
   string gvRunCK      = "EA_HRLYC_RUN_"  + IntegerToString(MagicNumber) + "_" + Symbol() + "_" + IntegerToString(InpHourlyPlanCIntervalMinutes);
   bool   planCClosedAllThisTick = false;

   if(g_hourlyPlanCLastSlot < 0)
     {
      if(!isTestRun && GlobalVariableCheck(gvSlotCK))
        {
         long savedSlotC = (long)MathRound(GlobalVariableGet(gvSlotCK));
         if(savedSlotC == curSlotC)
           {
            g_hourlyPlanCLastSlot    = curSlotC;
            g_hourlyPlanCNextRunTime = (datetime)((curSlotC + 1) * (long)intervalCSec);
            if(GlobalVariableCheck(gvRunCK))
               g_hourlyPlanCLastRunTime = (datetime)MathRound(GlobalVariableGet(gvRunCK));
           }
        }

      if(g_hourlyPlanCLastSlot < 0)
        {
         long secsIntoSlotC = ((long)nowServer) % intervalCSec;
         if(secsIntoSlotC > 60)
           {
            g_hourlyPlanCLastSlot    = curSlotC;
            g_hourlyPlanCNextRunTime = (datetime)((curSlotC + 1) * (long)intervalCSec);
            if(!isTestRun)
               GlobalVariableSet(gvSlotCK, (double)curSlotC);
           }
        }
     }

   if(curSlotC == g_hourlyPlanCLastSlot)
     {
      g_hourlyPlanCNextRunTime = (datetime)((curSlotC + 1) * (long)intervalCSec);
     }
   else
     {
      g_hourlyPlanCLastSlot    = curSlotC;
      g_hourlyPlanCLastRunTime = nowServer;
      g_hourlyPlanCNextRunTime = (datetime)((curSlotC + 1) * (long)intervalCSec);
      g_hourlyPlanCCheckCount++;
      if(!isTestRun)
        {
         GlobalVariableSet(gvSlotCK, (double)curSlotC);
         GlobalVariableSet(gvRunCK, (double)nowServer);
        }

      if(!planDClosedAllThisTick)
        {
         double curEqC    = AccountEquity();
         double dayOpenC  = g_dubaiDayOpeningEquity;
         double dayProfUC = (dayOpenC > 0.0) ? (curEqC - dayOpenC) : 0.0;
         double dayProfPC = (dayOpenC > 0.0) ? ((dayProfUC / dayOpenC) * 100.0) : 0.0;
         double planCThr  = (InpHourlyPlanCDayProfitPct > 0.0) ? InpHourlyPlanCDayProfitPct : 10.0;
         bool   planCHit  = (InpEnableHourlyPlanCDayProfitClose &&
                             (!InpHourlyPlanCOncePerDay || !g_hourlyPlanCDoneToday) &&
                             dayOpenC > 0.0 &&
                             dayProfPC > planCThr);
                             
                             //15 min//30 min
         if(planCHit && MathAbs( GlobalEmaAngle30)>4 && !IsEmaWEAKDistanceReduced50PercentFromPeak())
           {
            int remOpenC = 0;
            if(ExecuteHourlyPlanCCloseAll(dayOpenC, curEqC, dayProfUC, dayProfPC, nowServer, remOpenC) && remOpenC == 0)
               planCClosedAllThisTick = true;
           }
        }
     }

// ===== 1-HOUR PLAN A / PLAN B TIMER GATE (60 MIN) =====
   int    intervalSec = MathMax(60, InpHourlySideLossIntervalMinutes * 60);
   long   curSlot     = (long)(((long)nowServer) / intervalSec);
   string gvSlotK     = "EA_HRLY_LOSS_SLOT_" + IntegerToString(MagicNumber) + "_" + Symbol() + "_" + IntegerToString(InpHourlySideLossIntervalMinutes);
   string gvRunK      = "EA_HRLY_LOSS_RUN_"  + IntegerToString(MagicNumber) + "_" + Symbol() + "_" + IntegerToString(InpHourlySideLossIntervalMinutes);

   if(g_hourlySideLossLastSlot < 0)
     {
      if(!isTestRun && GlobalVariableCheck(gvSlotK))
        {
         long savedSlot = (long)MathRound(GlobalVariableGet(gvSlotK));
         if(savedSlot == curSlot)
           {
            g_hourlySideLossLastSlot    = curSlot;
            g_hourlySideLossNextRunTime = (datetime)((curSlot + 1) * (long)intervalSec);
            if(GlobalVariableCheck(gvRunK))
               g_hourlySideLossLastRunTime = (datetime)MathRound(GlobalVariableGet(gvRunK));
            return;
           }
        }

      long secsIntoSlot = ((long)nowServer) % intervalSec;
      if(secsIntoSlot > 60)
        {
         g_hourlySideLossLastSlot    = curSlot;
         g_hourlySideLossNextRunTime = (datetime)((curSlot + 1) * (long)intervalSec);
         if(!isTestRun)
            GlobalVariableSet(gvSlotK, (double)curSlot);
         return;
        }
     }

   if(curSlot == g_hourlySideLossLastSlot)
     {
      g_hourlySideLossNextRunTime = (datetime)((curSlot + 1) * (long)intervalSec);
      return;
     }

   g_hourlySideLossLastSlot    = curSlot;
   g_hourlySideLossLastRunTime = nowServer;
   g_hourlySideLossNextRunTime = (datetime)((curSlot + 1) * (long)intervalSec);
   g_hourlySideLossCheckCount++;
   if(!isTestRun)
     {
      GlobalVariableSet(gvSlotK, (double)curSlot);
      GlobalVariableSet(gvRunK, (double)nowServer);
     }

// If Plan D or Plan C already closed 100% of open market orders on this tick, avoid duplicate icon/close
   if(planDClosedAllThisTick || planCClosedAllThisTick)
      return;

// ===== PLAN A: Day Equity Profit > 5% vs Dubai 00:00 opening equity -> Close ALL open orders =====
   double curEquity    = AccountEquity();
   double dayOpenEq    = g_dubaiDayOpeningEquity;
   double dayProfitUSD = (dayOpenEq > 0.0) ? (curEquity - dayOpenEq) : 0.0;
   double dayProfitPct = (dayOpenEq > 0.0) ? ((dayProfitUSD / dayOpenEq) * 100.0) : 0.0;
   double planAThresh  = (InpHourlyPlanADayProfitPct > 0.0) ? InpHourlyPlanADayProfitPct : 5.0;
   bool   planADayHit  = (InpEnableHourlyPlanADayProfitClose &&
                          (!InpHourlyPlanAOncePerDay || !g_hourlyPlanADoneToday) &&
                          dayOpenEq > 0.0 &&
                          dayProfitPct > planAThresh);
                          
                          //1 hour 
   if(planADayHit)// && MathAbs( GlobalEmaAngle30)>4 && !IsEmaWEAKDistanceReduced50PercentFromPeak())
     {
      ExecuteHourlyPlanACloseAll(dayOpenEq, curEquity, dayProfitUSD, dayProfitPct, nowServer);
      return; // Plan A triggered -> OR skips Plan B on this hourly evaluation
     }

// ===== OR PLAN B: Per-Side Floating Loss > 20% -> Close 20% LOT (Min 0.01) =====
   if(!InpEnableHourlyPlanBSideLossCut)
      return;

   double balance = AccountBalance();
   if(balance <= 0.0)
      return;

   double buyNetPL = 0.0, buyDdPct = 0.0, sellNetPL = 0.0, sellDdPct = 0.0;
   int    buyCount = 0, sellCount = 0;
   CalcEqDdSideDrawdowns(balance, buyNetPL, buyDdPct, sellNetPL, sellDdPct, buyCount, sellCount);

   double threshPct = (InpHourlySideLossThresholdPct > 0.0) ? InpHourlySideLossThresholdPct : 20.0;
   double cutPct    = (InpHourlySideLossCutPct > 0.0 && InpHourlySideLossCutPct <= 100.0) ? InpHourlySideLossCutPct : 20.0;
   double minLotCfg = (InpHourlySideLossMinLot > 0.0) ? InpHourlySideLossMinLot : 0.01;

// Evaluate BUY only and SELL only independently (never combine BUY + SELL floating loss)
   if(buyCount > 0 && buyNetPL < 0.0 && buyDdPct > threshPct)
      ExecuteHourlySideLossCutForSide(OP_BUY, balance, buyNetPL, buyDdPct, nowServer, cutPct, minLotCfg);

   if(sellCount > 0 && sellNetPL < 0.0 && sellDdPct > threshPct)
      ExecuteHourlySideLossCutForSide(OP_SELL, balance, sellNetPL, sellDdPct, nowServer, cutPct, minLotCfg);
  }

// ===== PRICE GAP (>1000 RAW) & DAY EQUITY PROFIT (>5%) CLOSE ALL STATE =====
bool     g_priceGapCloseAnchorLoaded    = false; // True once anchor is initialized / restored for active flip cycle
double   g_priceGapCloseAnchorPrice     = 0.0;   // Dedicated anchor (starts at active EMA flip price, updates to close price after Close-All)
double   g_priceGapCloseSourceFlipPx    = 0.0;   // Active EMA flip price that seeded/reset the current anchor cycle
datetime g_priceGapCloseAnchorFlipT     = 0;     // EmaFlipTime paired with g_priceGapCloseSourceFlipPx
int      g_priceGapCloseTotalSweeps     = 0;     // Total Close-All sweeps executed in session
int      g_priceGapCloseTotalOrders     = 0;     // Total open orders closed across sweeps
double   g_priceGapCloseTotalLots       = 0.0;   // Total lots closed across sweeps
datetime g_priceGapCloseLastHitTime     = 0;     // Broker TimeCurrent() of latest Close-All execution
double   g_priceGapCloseLastAnchor      = 0.0;   // Anchor price used by latest Close-All execution
double   g_priceGapCloseLastPrice       = 0.0;   // Market mid-price at latest Close-All execution
double   g_priceGapCloseLastGapRaw      = 0.0;   // Raw gap |price - anchor| at latest Close-All execution
double   g_priceGapCloseLastDayPct      = 0.0;   // Day equity profit % at latest Close-All execution
double   g_priceGapCloseLastDayUSD      = 0.0;   // Day equity profit USD at latest Close-All execution
int      g_priceGapCloseLastOrders      = 0;     // Open orders closed in latest Close-All execution
double   g_priceGapCloseLastLots        = 0.0;   // Lots closed in latest Close-All execution
double   g_priceGapCloseLastPL          = 0.0;   // Net P/L closed in latest Close-All execution
datetime g_priceGapCloseFailLogTime     = 0;     // Throttle timer for failed close-all retries

//+------------------------------------------------------------------+
//| PriceGapCloseGvKey                                               |
//| Per-magic/symbol GlobalVariable key for live restart persistence |
//+------------------------------------------------------------------+
string PriceGapCloseGvKey(string suffix)
  {
   return "EA_PGAP_" + suffix + "_" + IntegerToString(MagicNumber) + "_" + Symbol();
  }

//+------------------------------------------------------------------+
//| SyncPriceGapCloseAnchor                                          |
//| Keeps a dedicated anchor for ManagePriceGap1000DayProfit5PctCloseAll:
//| - Starts at active EMA flip price (GetEmaFlipPrice()).           |
//| - Restores updated live anchor across MT4 restarts if EMA flip   |
//|   cycle has not changed.                                         |
//| - Resets cleanly to new EMA flip price on any new EMA flip.      |
//+------------------------------------------------------------------+
void SyncPriceGapCloseAnchor(double curFlipPrice, bool isTestRun)
  {
   if(curFlipPrice <= 0.0)
      return;

   string   gvAnchorK   = PriceGapCloseGvKey("ANCHOR");
   string   gvSrcFlipK  = PriceGapCloseGvKey("SRCFLIP");
   string   gvFlipBarK  = PriceGapCloseGvKey("FLIPBAR");
   datetime curFlipBarT = GetActualEmaFlipTime();
   if(curFlipBarT <= 0 && EmaFlipTime > 0)
      curFlipBarT = EmaFlipTime;

   if(!g_priceGapCloseAnchorLoaded)
     {
      bool restored = false;
      if(!isTestRun && GlobalVariableCheck(gvAnchorK))
        {
         double   savedAnchor   = GlobalVariableGet(gvAnchorK);
         double   savedSrcFlip  = GlobalVariableCheck(gvSrcFlipK) ? GlobalVariableGet(gvSrcFlipK) : 0.0;
         datetime savedFlipBarT = GlobalVariableCheck(gvFlipBarK) ? (datetime)MathRound(GlobalVariableGet(gvFlipBarK)) : 0;

         bool sameFlipCycle = false;
         if(savedAnchor > 0.0)
           {
            if(savedFlipBarT > 0 && curFlipBarT > 0 && Bars > 0)
              {
               int savedBarIdx = iBarShift(Symbol(), Period(), savedFlipBarT, false);
               int curBarIdx   = iBarShift(Symbol(), Period(), curFlipBarT, false);
               if(savedBarIdx >= 0 && curBarIdx >= 0 && MathAbs(savedBarIdx - curBarIdx) <= 1)
                  sameFlipCycle = true;
              }
            else
               if(savedSrcFlip > 0.0)
                 {
                  double tol = MathMax(Point * 10.0, curFlipPrice * 0.001);
                  if(MathAbs(savedSrcFlip - curFlipPrice) <= tol)
                     sameFlipCycle = true;
                 }
           }

         if(sameFlipCycle)
           {
            g_priceGapCloseAnchorPrice  = savedAnchor;
            g_priceGapCloseSourceFlipPx = (savedSrcFlip > 0.0) ? savedSrcFlip : curFlipPrice;
            g_priceGapCloseAnchorFlipT  = EmaFlipTime;
            restored = true;
           }
        }

      if(!restored)
        {
         g_priceGapCloseAnchorPrice  = curFlipPrice;
         g_priceGapCloseSourceFlipPx = curFlipPrice;
         g_priceGapCloseAnchorFlipT  = EmaFlipTime;
         if(!isTestRun)
           {
            GlobalVariableSet(gvAnchorK,  g_priceGapCloseAnchorPrice);
            GlobalVariableSet(gvSrcFlipK, g_priceGapCloseSourceFlipPx);
            if(curFlipBarT > 0)
               GlobalVariableSet(gvFlipBarK, (double)curFlipBarT);
           }
        }

      g_priceGapCloseAnchorLoaded = true;
      return;
     }

// Detect new EMA flip in runtime (via EmaFlipTime change or active flip price change)
   bool flipTimeChanged  = (EmaFlipTime > 0 && g_priceGapCloseAnchorFlipT > 0 && EmaFlipTime != g_priceGapCloseAnchorFlipT);
   bool flipPriceChanged = (g_priceGapCloseSourceFlipPx > 0.0 && MathAbs(curFlipPrice - g_priceGapCloseSourceFlipPx) > (Point * 0.5));
   if(flipTimeChanged || flipPriceChanged || g_priceGapCloseAnchorPrice <= 0.0)
     {
      double prevAnchor = g_priceGapCloseAnchorPrice;
      g_priceGapCloseAnchorPrice  = curFlipPrice;
      g_priceGapCloseSourceFlipPx = curFlipPrice;
      g_priceGapCloseAnchorFlipT  = EmaFlipTime;

      if(!isTestRun)
        {
         GlobalVariableSet(gvAnchorK,  g_priceGapCloseAnchorPrice);
         GlobalVariableSet(gvSrcFlipK, g_priceGapCloseSourceFlipPx);
         if(curFlipBarT > 0)
            GlobalVariableSet(gvFlipBarK, (double)curFlipBarT);
        }

      PrintFormat(">>> [PRICE GAP ANCHOR RESET ON EMA FLIP] PrevAnchor=%s -> NewFlipAnchor=%s",
                  DoubleToString(prevAnchor, Digits), DoubleToString(g_priceGapCloseAnchorPrice, Digits));
     }
  }

//+------------------------------------------------------------------+
//| DrawPriceGap1000CloseIcon                                        |
//| Places chart marker & label when Gap>1000 & DayEq>5% closes all  |
//+------------------------------------------------------------------+
void DrawPriceGap1000CloseIcon(int sweepSeq, double gapRaw, double anchorPx, double hitPrice, double dayEqPct, double dayEqUSD, int ordersClosed, double lotsClosed, double netPL, datetime hitTime = 0)
  {
   if(!InpDrawPriceGapCloseIcon || ordersClosed <= 0)
      return;

   if(hitTime <= 0)
      hitTime = TimeCurrent();

   datetime barTime  = ((Bars > 0 && Time[0] > 0) ? Time[0] : hitTime);
   string   baseName = PREFIX + "PGAP1000_" + IntegerToString((int)barTime) + "_" + IntegerToString(MathMax(1, sweepSeq));
   string   txtName  = baseName + "_TXT";

   double atr = iATR(Symbol(), Period(), 14, 1);
   if(atr <= 0.0)
      atr = 30 * Point;
   if(atr <= 0.0)
      atr = 1.0;

   double baseLow     = ((Bars > 0 && Low[0] > 0.0) ? Low[0] : Bid);
   double markerPrice = baseLow - (atr * 2.35);
   double labelPrice  = markerPrice - (atr * 0.40);

   color iconColor = InpPriceGapCloseIconColor;
   int   iconCode  = (InpPriceGapCloseIconCode > 0 ? InpPriceGapCloseIconCode : 119);
   int   fontSize  = (InpPriceGapCloseIconFontSize > 0 ? InpPriceGapCloseIconFontSize : 10);

   datetime dubaiDT   = hitTime + (ServerToDubaiOffsetHours * 3600);
   string   plSign    = (netPL >= 0.0) ? "+" : "-";
   double   gapReq    = (InpPriceGapCloseRawGap > 0.0) ? InpPriceGapCloseRawGap : 1000.0;
   double   pctReq    = (InpPriceGapCloseDayProfitPct > 0.0) ? InpPriceGapCloseDayProfitPct : 5.0;
   string   labelText = StringFormat("GAP>%.0f +DAY>%.0f%% ALL (x%d -%.2fL)", gapReq, pctReq, ordersClosed, lotsClosed);
   string   tooltip   = StringFormat("PRICE GAP >%.0f & DAY EQ >%.0f%% CLOSE ALL #%d | Gap:$%.1f (Anc:%s -> Px:%s) | DayEq:+%.2f%% (+$%.2f) | Closed:%d (-%.2fL, NetPL:%s$%.2f) | Dubai:%s",
                                     gapReq, pctReq, MathMax(1, sweepSeq), gapRaw,
                                     DoubleToString(anchorPx, Digits), DoubleToString(hitPrice, Digits),
                                     dayEqPct, dayEqUSD, ordersClosed, lotsClosed,
                                     plSign, MathAbs(netPL),
                                     TimeToString(dubaiDT, TIME_DATE|TIME_MINUTES|TIME_SECONDS));

   ObjectCreate(0, baseName, OBJ_ARROW, 0, barTime, markerPrice);
   ObjectSetInteger(0, baseName, OBJPROP_ARROWCODE, iconCode);
   ObjectSetInteger(0, baseName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, baseName, OBJPROP_WIDTH, 4);
   ObjectSetInteger(0, baseName, OBJPROP_BACK, false);
   ObjectSetInteger(0, baseName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, baseName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);

   ObjectCreate(0, txtName, OBJ_TEXT, 0, barTime, labelPrice);
   ObjectSetString(0, txtName, OBJPROP_TEXT, labelText);
   ObjectSetString(0, txtName, OBJPROP_FONT, "Arial Black");
   ObjectSetInteger(0, txtName, OBJPROP_FONTSIZE, fontSize);
   ObjectSetInteger(0, txtName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, txtName, OBJPROP_BACK, false);
   ObjectSetInteger(0, txtName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, txtName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);

   ChartRedraw(0);
  }

//+------------------------------------------------------------------+
//| ManagePriceGap1000DayProfit5PctCloseAll                          |
//| Runs every tick (after TrackEmaFlip) independently of existing   |
//| methods:                                                         |
//| When |MarketPrice - Anchor| > 1000 raw (initially active EMA     |
//| flip price) AND Day Equity Profit > 5% vs Dubai 00:00 opening    |
//| equity -> close ALL open market orders (OP_BUY & OP_SELL), then  |
//| update Anchor to current close-time market price so it repeats   |
//| only after another > 1000 raw move (and resets on new EMA flip). |
//+------------------------------------------------------------------+
void ManagePriceGap1000DayProfit5PctCloseAll()
  {
   if(!InpEnablePriceGapDayProfitClose)
      return;

   datetime nowServer = TimeCurrent();
   if(nowServer <= 0)
      return;

// Sync Dubai 00:00 GST day opening equity & anchor against active EMA flip cycle
   SyncDubaiDayOpeningState(nowServer);

   bool   isTestRun    = (IsTesting() || IsOptimization());
   double curFlipPrice = GetEmaFlipPrice();
   SyncPriceGapCloseAnchor(curFlipPrice, isTestRun);
   if(g_priceGapCloseAnchorPrice <= 0.0)
      return;

   RefreshRates();
   double curPrice = (Bid > 0.0 && Ask > 0.0) ? ((Bid + Ask) * 0.5)
                     : ((Bars > 0 && Close[0] > 0.0) ? Close[0] : Bid);
   if(curPrice <= 0.0)
      return;

   double rawGap   = MathAbs(curPrice - g_priceGapCloseAnchorPrice);
   double gapReq   = (InpPriceGapCloseRawGap > 0.0) ? InpPriceGapCloseRawGap : 1000.0;
   double eqPctReq = (InpPriceGapCloseDayProfitPct > 0.0) ? InpPriceGapCloseDayProfitPct : 5.0;

   double curEquity    = AccountEquity();
   double dayOpenEq    = g_dubaiDayOpeningEquity;
   double dayProfitUSD = (dayOpenEq > 0.0) ? (curEquity - dayOpenEq) : 0.0;
   double dayProfitPct = (dayOpenEq > 0.0) ? ((dayProfitUSD / dayOpenEq) * 100.0) : 0.0;

   if(rawGap <= gapReq || dayOpenEq <= 0.0 || dayProfitPct <= eqPctReq)
      return;

// Snapshot all live open market orders (OP_BUY + OP_SELL) for this Symbol & MagicNumber
   int buyCount  = 0;
   int sellCount = 0;
   int openTickets[1000];
   ArrayInitialize(openTickets, 0);
   int openCount = 0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType == OP_BUY)
        {
         buyCount++;
         if(openCount < 1000)
            openTickets[openCount++] = OrderTicket();
        }
      else
         if(oType == OP_SELL)
           {
            sellCount++;
            if(openCount < 1000)
               openTickets[openCount++] = OrderTicket();
           }
     }

   if(openCount == 0)
      return; // Keep anchor until actual open orders are closed

   datetime dubaiTime   = nowServer + (ServerToDubaiOffsetHours * 3600);
   double   usedAnchor  = g_priceGapCloseAnchorPrice;
   int      closedCount = 0;
   int      failCount   = 0;
   double   closedLots  = 0.0;
   double   closedPL    = 0.0;

   for(int k = 0; k < openCount; k++)
     {
      int tkt = openTickets[k];
      if(!OrderSelect(tkt, SELECT_BY_TICKET, MODE_TRADES))
         continue;
      if(OrderCloseTime() != 0)
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;

      double oLots = OrderLots();
      double oPL   = OrderProfit() + OrderSwap() + OrderCommission();
      color  cClr  = (oType == OP_BUY) ? clrRed : clrBlue;

      RefreshRates();
      ResetLastError();
      g_eqDdForceCloseBudget = true;
      bool ok = SafeOrderCloseMarket(tkt, oLots, Slippage, cClr);
      g_eqDdForceCloseBudget = false;

      if(ok)
        {
         closedCount++;
         closedLots += oLots;
         closedPL   += oPL;
        }
      else
        {
         failCount++;
         if(g_priceGapCloseFailLogTime == 0 || (nowServer - g_priceGapCloseFailLogTime) >= 10)
           {
            PrintFormat(">>> [PRICE GAP >%.0f CLOSE FAIL] Ticket #%d (%s %.2fL) Err=%d | Dubai=%s",
                        gapReq, tkt, (oType == OP_BUY ? "BUY" : "SELL"), oLots, GetLastError(),
                        TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS));
           }
        }
     }

   if(closedCount > 0 || failCount > 0)
      InvalidateOrderCache();

   int remainingOpen = 0;
   for(int j = OrdersTotal() - 1; j >= 0; j--)
     {
      if(!OrderSelect(j, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int rType = OrderType();
      if(rType == OP_BUY || rType == OP_SELL)
         remainingOpen++;
     }

   if(closedCount > 0)
     {
      RefreshRates();
      double newAnchor = (Bid > 0.0 && Ask > 0.0) ? ((Bid + Ask) * 0.5) : curPrice;
      if(newAnchor <= 0.0)
         newAnchor = curPrice;

      if(remainingOpen == 0)
        {
         g_priceGapCloseAnchorPrice = newAnchor;
         if(!isTestRun)
            GlobalVariableSet(PriceGapCloseGvKey("ANCHOR"), g_priceGapCloseAnchorPrice);
        }

      g_priceGapCloseTotalSweeps++;
      g_priceGapCloseTotalOrders += closedCount;
      g_priceGapCloseTotalLots   += closedLots;
      g_priceGapCloseLastHitTime  = nowServer;
      g_priceGapCloseLastAnchor   = usedAnchor;
      g_priceGapCloseLastPrice    = curPrice;
      g_priceGapCloseLastGapRaw   = rawGap;
      g_priceGapCloseLastDayPct   = dayProfitPct;
      g_priceGapCloseLastDayUSD   = dayProfitUSD;
      g_priceGapCloseLastOrders   = closedCount;
      g_priceGapCloseLastLots     = closedLots;
      g_priceGapCloseLastPL       = closedPL;

      PrintFormat(">>> [PRICE GAP >%.0f & DAY EQ >%.1f%% CLOSE ALL] Dubai=%s (Broker=%s) | Gap=$%.2f (Anc:%s -> Px:%s) | Eq=$%.2f vs Open=$%.2f (+$%.2f / +%.2f%%) -> Closed %d Order(s) (B:%d S:%d | -%.2fL, NetPL=%s$%.2f, Fail=%d, Rem=%d) | NextAnchor=%s",
                  gapReq, eqPctReq,
                  TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  TimeToString(nowServer, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  rawGap, DoubleToString(usedAnchor, Digits), DoubleToString(curPrice, Digits),
                  curEquity, dayOpenEq, dayProfitUSD, dayProfitPct,
                  closedCount, buyCount, sellCount, closedLots,
                  (closedPL >= 0.0 ? "+" : "-"), MathAbs(closedPL), failCount, remainingOpen,
                  DoubleToString(g_priceGapCloseAnchorPrice, Digits));

      DrawPriceGap1000CloseIcon(g_priceGapCloseTotalSweeps, rawGap, usedAnchor, curPrice, dayProfitPct, dayProfitUSD, closedCount, closedLots, closedPL, nowServer);
      LastDashboardUpdateMs = 0;
      if(ShowLeftLiveOrdersDashboard)
         UpdateLeftLiveOrdersDashboard();
     }
   else
      if(failCount > 0)
        {
         if(g_priceGapCloseFailLogTime == 0 || (nowServer - g_priceGapCloseFailLogTime) >= 10)
           {
            g_priceGapCloseFailLogTime = nowServer;
            PrintFormat(">>> [PRICE GAP >%.0f & DAY EQ >%.1f%% ATTEMPT FAILED] Dubai=%s | Gap=$%.2f | DayEq=+%.2f%% | Open=%d Fail=%d Rem=%d",
                        gapReq, eqPctReq, TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                        rawGap, dayProfitPct, openCount, failCount, remainingOpen);
           }
        }
  }

// ===== ADVERSE PRICE-CHANGE STEP LOSS CUTTER STATE =====
bool     g_stepLossLoaded              = false; // True once persisted anchors/steps loaded on live restart
double   g_stepLossBuyAnchor           = 0.0;   // BUY losing-cycle Bid anchor (advances on each cut step; resets when flat/profit)
double   g_stepLossSellAnchor          = 0.0;   // SELL losing-cycle Ask anchor (advances on each cut step; resets when flat/profit)
int      g_stepLossBuySteps            = 0;     // Sequential step cuts executed in current BUY drawdown cycle
int      g_stepLossSellSteps           = 0;     // Sequential step cuts executed in current SELL drawdown cycle
double   g_stepLossLastBuyAdv          = 0.0;   // Latest BUY directional adverse distance from BUY anchor
double   g_stepLossLastSellAdv         = 0.0;   // Latest SELL directional adverse distance from SELL anchor
double   g_stepLossLastReqBuyGap       = 3000.0;// Active BUY step threshold (3000 normal, 2000 emergency)
double   g_stepLossLastReqSellGap      = 3000.0;// Active SELL step threshold (3000 normal, 2000 emergency)
int      g_stepLossTotalSweeps         = 0;     // Total step-cut events executed in session
int      g_stepLossTotalPartialCuts    = 0;     // Total individual partial-close cuts on >0.01L orders
int      g_stepLossTotalFullCloses     = 0;     // Total individual worst 0.01L full-closes executed
double   g_stepLossTotalLotsCut        = 0.0;   // Total lots reduced across all step cuts
datetime g_stepLossLastHitTime         = 0;     // Broker TimeCurrent() of latest step-cut event
string   g_stepLossLastHitSide         = "";    // Side cut on latest event ("BUY" or "SELL")
bool     g_stepLossLastHitEmerg        = false; // True if latest event fired under >30% Emergency Equity DD
double   g_stepLossLastHitAdvGap       = 0.0;   // Adverse raw move on latest step-cut event
double   g_stepLossLastHitSidePct      = 0.0;   // Side floating loss % of Balance on latest step-cut
double   g_stepLossLastHitEqDdPct      = 0.0;   // Total Equity DD % of Balance on latest step-cut
int      g_stepLossLastHitPartials     = 0;     // Number of >0.01L partial cuts on latest event
int      g_stepLossLastHitFulls        = 0;     // Number of worst 0.01L full closes on latest event
double   g_stepLossLastHitLots         = 0.0;   // Total lots cut on latest event
double   g_stepLossLastHitPL           = 0.0;   // Estimated P/L closed on latest event
datetime g_stepLossBuyFailLogTime      = 0;     // Throttle timer for BUY failure logs
datetime g_stepLossSellFailLogTime     = 0;     // Throttle timer for SELL failure logs

//+------------------------------------------------------------------+
//| StepLossGvKey                                                    |
//| Per-magic/symbol GlobalVariable key for live restart persistence |
//+------------------------------------------------------------------+
string StepLossGvKey(string suffix)
  {
   return "EA_SPLOSS_" + suffix + "_" + IntegerToString(MagicNumber) + "_" + Symbol();
  }

//+------------------------------------------------------------------+
//| DrawAdversePriceStepCutIcon                                      |
//| Places chart marker & label above candle when step loss cut runs |
//+------------------------------------------------------------------+
void DrawAdversePriceStepCutIcon(string sideName, bool isEmergency, int stepNo, double advGap, double sideDdPct, double eqDdPct, int partHits, int fullHits, double lotsCut, double estPL, datetime hitTime = 0)
  {
   if(!InpDrawAdverseStepLossIcon || (partHits + fullHits) <= 0)
      return;

   if(hitTime <= 0)
      hitTime = TimeCurrent();

   datetime barTime  = ((Bars > 0 && Time[0] > 0) ? Time[0] : hitTime);
   string   objSide  = (sideName != "" ? sideName : "SIDE");
   string   baseName = PREFIX + "SPLOSS_" + objSide + "_" + IntegerToString((int)barTime) + "_" + IntegerToString(MathMax(1, g_stepLossTotalSweeps));
   string   txtName  = baseName + "_TXT";

   double atr = iATR(Symbol(), Period(), 14, 1);
   if(atr <= 0.0)
      atr = 30 * Point;
   if(atr <= 0.0)
      atr = 1.0;

   double baseHigh    = ((Bars > 0 && High[0] > 0.0) ? High[0] : Bid);
   double sideOffset  = (objSide == "SELL") ? 2.15 : 1.70;
   double markerPrice = baseHigh + (atr * sideOffset);
   double labelPrice  = markerPrice + (atr * 0.35);

   color iconColor = isEmergency ? clrRed : InpAdverseStepLossIconColor;
   int   iconCode  = (InpAdverseStepLossIconCode > 0 ? InpAdverseStepLossIconCode : 226);
   int   fontSize  = (InpAdverseStepLossIconFontSize > 0 ? InpAdverseStepLossIconFontSize : 10);

   datetime dubaiDT   = hitTime + (ServerToDubaiOffsetHours * 3600);
   string   plSign    = (estPL >= 0.0) ? "+" : "-";
   string   modeTag   = isEmergency ? "EMERG" : "STEP";
   string   labelText = StringFormat("%s#%d %s -$%.0f (P%d/F%d -%.2fL)",
                                     modeTag, stepNo, objSide, advGap, partHits, fullHits, lotsCut);
   string   tooltip   = StringFormat("ADVERSE PRICE STEP LOSS CUT (%s #%d) | %s SideLoss:%.2f%% EqDD:%.2f%% | AdvGap:$%.1f | Partials:%d + Worst0.01Closes:%d (-%.2fL, EstPL:%s$%.2f) | Dubai:%s",
                                     (isEmergency ? "EMERGENCY DD>30%" : "NORMAL"), stepNo, objSide,
                                     sideDdPct, eqDdPct, advGap, partHits, fullHits, lotsCut,
                                     plSign, MathAbs(estPL),
                                     TimeToString(dubaiDT, TIME_DATE|TIME_MINUTES|TIME_SECONDS));

   ObjectCreate(0, baseName, OBJ_ARROW, 0, barTime, markerPrice);
   ObjectSetInteger(0, baseName, OBJPROP_ARROWCODE, iconCode);
   ObjectSetInteger(0, baseName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, baseName, OBJPROP_WIDTH, 4);
   ObjectSetInteger(0, baseName, OBJPROP_BACK, false);
   ObjectSetInteger(0, baseName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, baseName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);

   ObjectCreate(0, txtName, OBJ_TEXT, 0, barTime, labelPrice);
   ObjectSetString(0, txtName, OBJPROP_TEXT, labelText);
   ObjectSetString(0, txtName, OBJPROP_FONT, "Arial Black");
   ObjectSetInteger(0, txtName, OBJPROP_FONTSIZE, fontSize);
   ObjectSetInteger(0, txtName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, txtName, OBJPROP_BACK, false);
   ObjectSetInteger(0, txtName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, txtName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);

   ChartRedraw(0);
  }

//+------------------------------------------------------------------+
//| ProcessAdversePriceStepCutForSide                                |
//| Evaluates ONE side independently (OP_BUY or OP_SELL):            |
//| - Resets anchor when flat or side NetPL >= 0.                    |
//| - Seeds directional anchor when side enters drawdown.            |
//| - Activates when side loss > 10% Balance (or Emergency DD > 30%).|
//| - Every 3000 raw (2000 raw in Emergency >30% DD) adverse move:   |
//|   1) Partial-closes 20% LOT (35% in Emerg) on >0.01L losers, and |
//|   2) Full-closes worst losing already-0.01L order(s) (1 normal,  |
//|      up to 2 in Emergency), excluding orders trimmed this step!  |
//+------------------------------------------------------------------+
void ProcessAdversePriceStepCutForSide(int sideType, double balance, double equity, double eqDdPct, double sideNetPL, double sideDdPct, int sideCount, datetime nowServer)
  {
   bool   isBuy     = (sideType == OP_BUY);
   string sideName  = isBuy ? "BUY" : "SELL";
   string sideKeyCh = isBuy ? "B" : "S";
   bool   isTestRun = (IsTesting() || IsOptimization());
   string gvAncK    = StepLossGvKey(sideKeyCh + "_ANC");
   string gvStpK    = StepLossGvKey(sideKeyCh + "_STP");

   double curAnchor = isBuy ? g_stepLossBuyAnchor : g_stepLossSellAnchor;
   int    curSteps  = isBuy ? g_stepLossBuySteps  : g_stepLossSellSteps;

   double normRawGap = (InpStepLossRawGap > 0.0) ? InpStepLossRawGap : 3000.0;
   double emergRawGp = (InpStepLossEmergencyRawGap > 0.0) ? InpStepLossEmergencyRawGap : 2000.0;
   double actPctReq  = (InpStepLossActivateSidePct > 0.0) ? InpStepLossActivateSidePct : 10.0;
   double emergDdReq = (InpStepLossEmergencyDdPct > 0.0) ? InpStepLossEmergencyDdPct : 30.0;
   double normCutPct = (InpStepLossCutPct > 0.0 && InpStepLossCutPct <= 100.0) ? InpStepLossCutPct : 20.0;
   double emergCtPct = (InpStepLossEmergencyCutPct > 0.0 && InpStepLossEmergencyCutPct <= 100.0) ? InpStepLossEmergencyCutPct : 35.0;
   int    normMinCls = (InpStepLossMinLotClosePerStep >= 0) ? InpStepLossMinLotClosePerStep : 1;
   int    emergMnCls = (InpStepLossEmergMinLotClosePerStep >= 0) ? InpStepLossEmergMinLotClosePerStep : 2;
   double minLotCfg  = (InpStepLossMinLot > 0.0) ? InpStepLossMinLot : 0.01;
   double minOrdLoss = (InpStepLossMinOrderLossUSD >= 0.0) ? InpStepLossMinOrderLossUSD : 1.0;

// Reset side cycle cleanly whenever side has no orders or recovers to net breakeven/profit
   if(sideCount <= 0 || sideNetPL >= 0.0)
     {
      if(curAnchor > 0.0 || curSteps > 0)
        {
         datetime dubaiT = nowServer + (ServerToDubaiOffsetHours * 3600);
         PrintFormat(">>> [ADVERSE STEP LOSS RESET] %s recovered/flat | PriorSteps=%d | Dubai=%s",
                     sideName, curSteps, TimeToString(dubaiT, TIME_DATE|TIME_MINUTES|TIME_SECONDS));
        }

      if(isBuy)
        {
         g_stepLossBuyAnchor    = 0.0;
         g_stepLossBuySteps     = 0;
         g_stepLossLastBuyAdv   = 0.0;
         g_stepLossLastReqBuyGap = normRawGap;
        }
      else
        {
         g_stepLossSellAnchor    = 0.0;
         g_stepLossSellSteps     = 0;
         g_stepLossLastSellAdv   = 0.0;
         g_stepLossLastReqSellGap = normRawGap;
        }

      if(!isTestRun)
        {
         if(GlobalVariableCheck(gvAncK))
            GlobalVariableDel(gvAncK);
         if(GlobalVariableCheck(gvStpK))
            GlobalVariableDel(gvStpK);
        }
      return;
     }

   RefreshRates();
   double sidePrice = isBuy ? Bid : Ask;
   if(sidePrice <= 0.0)
      sidePrice = (Bars > 0 && Close[0] > 0.0) ? Close[0] : 0.0;
   if(sidePrice <= 0.0)
      return;

   if(curAnchor <= 0.0)
     {
      curAnchor = sidePrice;
      curSteps  = 0;
      if(isBuy)
        {
         g_stepLossBuyAnchor = curAnchor;
         g_stepLossBuySteps  = 0;
        }
      else
        {
         g_stepLossSellAnchor = curAnchor;
         g_stepLossSellSteps  = 0;
        }
      if(!isTestRun)
        {
         GlobalVariableSet(gvAncK, curAnchor);
         GlobalVariableSet(gvStpK, 0.0);
        }
     }

   double advMove     = MathMax(0.0, (isBuy ? (curAnchor - sidePrice) : (sidePrice - curAnchor)));
   bool   isEmergency = (eqDdPct > emergDdReq && sideDdPct >= MathMin(5.0, actPctReq));
   double reqGap      = isEmergency ? emergRawGp : normRawGap;
   double cutPct      = isEmergency ? emergCtPct : normCutPct;
   int    maxMinClose = isEmergency ? emergMnCls : normMinCls;

   if(isBuy)
     {
      g_stepLossLastBuyAdv    = advMove;
      g_stepLossLastReqBuyGap = reqGap;
     }
   else
     {
      g_stepLossLastSellAdv    = advMove;
      g_stepLossLastReqSellGap = reqGap;
     }

   bool isActivated = (sideDdPct > actPctReq) || isEmergency;
   if(!isActivated || advMove + 1e-9 < reqGap)
      return;

   double minLot  = MarketInfo(Symbol(), MODE_MINLOT);
   double lotStep = MarketInfo(Symbol(), MODE_LOTSTEP);
   if(minLot <= 0.0)
      minLot = 0.01;
   if(lotStep <= 0.0)
      lotStep = 0.01;

   int    lotDigits = (lotStep >= 1.0) ? 0 : ((lotStep >= 0.1) ? 1 : ((lotStep >= 0.01) ? 2 : 3));
   double effMinLot = MathMax(minLot, minLotCfg);
   double minCutLot = MathMax(lotStep, minLotCfg);
   double cutFrac   = cutPct / 100.0;
   if(cutFrac <= 0.0)
      cutFrac = 0.20;
   if(cutFrac > 0.99)
      cutFrac = 0.99;

// Snapshot splittable (>0.01L) and already-minimum-lot (<=0.01L) losing orders BEFORE cutting,
// so an order trimmed down to 0.01L in THIS step waits for the NEXT step before being considered for full close.
   int    splitTickets[500];
   int    minTickets[500];
   double minPLs[500];
   ArrayInitialize(splitTickets, 0);
   ArrayInitialize(minTickets, 0);
   ArrayInitialize(minPLs, 0.0);
   int splitCount = 0;
   int minCount   = 0;

   for(int pass = 0; pass < 2 && (splitCount + minCount) == 0; pass++)
     {
      double lossCutoff = (pass == 0) ? minOrdLoss : 0.0;
      for(int i = OrdersTotal() - 1; i >= 0; i--)
        {
         if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
            continue;
         if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
            continue;
         if(OrderType() != sideType)
            continue;

         double netPL = OrderProfit() + OrderSwap() + OrderCommission();
         if(netPL >= -lossCutoff - 1e-9)
            continue;

         double oLots      = OrderLots();
         double maxPartial = NormalizeDouble(oLots - effMinLot, lotDigits);
         if(maxPartial >= (lotStep - 1e-8))
           {
            if(splitCount < 500)
               splitTickets[splitCount++] = OrderTicket();
           }
         else
           {
            if(minCount < 500)
              {
               minTickets[minCount] = OrderTicket();
               minPLs[minCount]     = netPL;
               minCount++;
              }
           }
        }
     }

   if(splitCount == 0 && minCount == 0)
      return;

// Sort already-0.01L losing orders by deepest loss first (most negative P/L ascending)
   for(int a = 0; a < minCount - 1; a++)
     {
      int bestIdx = a;
      for(int b = a + 1; b < minCount; b++)
        {
         if(minPLs[b] < minPLs[bestIdx])
            bestIdx = b;
        }
      if(bestIdx != a)
        {
         int    tmpTkt = minTickets[a];
         double tmpPL  = minPLs[a];
         minTickets[a]       = minTickets[bestIdx];
         minPLs[a]           = minPLs[bestIdx];
         minTickets[bestIdx] = tmpTkt;
         minPLs[bestIdx]     = tmpPL;
        }
     }

   datetime dubaiTime  = nowServer + (ServerToDubaiOffsetHours * 3600);
   int      partHits   = 0;
   int      fullHits   = 0;
   int      failCount  = 0;
   double   lotsCutTot = 0.0;
   double   estPLTot   = 0.0;
   color    closeClr   = isEmergency ? clrRed : clrOrange;

// Step Part 1: Partial-close 20% LOT (35% in Emergency) on losing orders > 0.01L
   for(int k = 0; k < splitCount; k++)
     {
      int tkt = splitTickets[k];
      if(!OrderSelect(tkt, SELECT_BY_TICKET, MODE_TRADES))
         continue;
      if(OrderCloseTime() != 0 || OrderType() != sideType)
         continue;

      double netPL = OrderProfit() + OrderSwap() + OrderCommission();
      if(netPL >= 0.0)
         continue;

      double oLots      = OrderLots();
      double maxPartial = NormalizeDouble(oLots - effMinLot, lotDigits);
      if(maxPartial < (lotStep - 1e-8))
         continue;

      double closeLots = NormalizeDouble(MathRound((oLots * cutFrac) / lotStep + 1e-9) * lotStep, lotDigits);
      if(closeLots < minCutLot)
         closeLots = minCutLot;
      if(closeLots > maxPartial)
         closeLots = maxPartial;
      if(closeLots < (lotStep - 1e-8))
         continue;

      double estPL   = (oLots > 0.0) ? (netPL * (closeLots / oLots)) : 0.0;
      double remLots = NormalizeDouble(oLots - closeLots, lotDigits);

      RefreshRates();
      ResetLastError();
      g_eqDdForceCloseBudget = true;
      bool ok = SafeOrderCloseMarket(tkt, closeLots, Slippage, closeClr);
      g_eqDdForceCloseBudget = false;

      if(ok)
        {
         partHits++;
         lotsCutTot += closeLots;
         estPLTot   += estPL;
         g_stepLossTotalPartialCuts++;
         g_stepLossTotalLotsCut += closeLots;

         PrintFormat(">>> [STEP LOSS PARTIAL -%.0f%%L%s] %s #%d (%.2fL -> Cut %.2fL, Rem %.2fL, EstPL=%s$%.2f) | Adv=$%.1f %sDD=%.2f%% EqDD=%.2f%%",
                     cutPct, (isEmergency ? " EMERG" : ""), sideName, tkt,
                     oLots, closeLots, remLots, (estPL >= 0.0 ? "+" : "-"), MathAbs(estPL),
                     advMove, sideName, sideDdPct, eqDdPct);
        }
      else
        {
         failCount++;
         datetime lastF = isBuy ? g_stepLossBuyFailLogTime : g_stepLossSellFailLogTime;
         if(lastF == 0 || (nowServer - lastF) >= 10)
           {
            PrintFormat(">>> [STEP LOSS PARTIAL FAIL] %s #%d (%.2fL cut %.2fL) Err=%d | Dubai=%s",
                        sideName, tkt, oLots, closeLots, GetLastError(),
                        TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS));
           }
        }
     }

// Step Part 2: Full-close worst already-0.01L losing order(s) step-by-step (1 Normal / 2 Emergency)
   int fullClosedDone = 0;
   for(int m = 0; m < minCount && fullClosedDone < maxMinClose; m++)
     {
      int tkt = minTickets[m];
      if(!OrderSelect(tkt, SELECT_BY_TICKET, MODE_TRADES))
         continue;
      if(OrderCloseTime() != 0 || OrderType() != sideType)
         continue;

      double netPL = OrderProfit() + OrderSwap() + OrderCommission();
      if(netPL >= 0.0)
         continue;

      double oLots = OrderLots();

      RefreshRates();
      ResetLastError();
      g_eqDdForceCloseBudget = true;
      bool ok = SafeOrderCloseMarket(tkt, oLots, Slippage, closeClr);
      g_eqDdForceCloseBudget = false;

      if(ok)
        {
         fullClosedDone++;
         fullHits++;
         lotsCutTot += oLots;
         estPLTot   += netPL;
         g_stepLossTotalFullCloses++;
         g_stepLossTotalLotsCut += oLots;

         PrintFormat(">>> [STEP LOSS WORST 0.01L CLOSE%s] %s #%d (%.2fL, NetPL=%s$%.2f) | Adv=$%.1f %sDD=%.2f%% EqDD=%.2f%%",
                     (isEmergency ? " EMERG" : ""), sideName, tkt, oLots,
                     (netPL >= 0.0 ? "+" : "-"), MathAbs(netPL),
                     advMove, sideName, sideDdPct, eqDdPct);
        }
      else
        {
         failCount++;
         datetime lastF = isBuy ? g_stepLossBuyFailLogTime : g_stepLossSellFailLogTime;
         if(lastF == 0 || (nowServer - lastF) >= 10)
           {
            PrintFormat(">>> [STEP LOSS 0.01L CLOSE FAIL] %s #%d (%.2fL) Err=%d | Dubai=%s",
                        sideName, tkt, oLots, GetLastError(),
                        TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS));
           }
        }
     }

   if(partHits > 0 || fullHits > 0 || failCount > 0)
      InvalidateOrderCache();

   if((partHits + fullHits) > 0)
     {
      RefreshRates();
      double nextAnchor = isBuy ? Bid : Ask;
      if(nextAnchor <= 0.0)
         nextAnchor = sidePrice;

      int nextStep = curSteps + 1;
      if(isBuy)
        {
         g_stepLossBuyAnchor     = nextAnchor;
         g_stepLossBuySteps      = nextStep;
         g_stepLossLastBuyAdv    = 0.0;
         g_stepLossLastReqBuyGap = reqGap;
        }
      else
        {
         g_stepLossSellAnchor     = nextAnchor;
         g_stepLossSellSteps      = nextStep;
         g_stepLossLastSellAdv    = 0.0;
         g_stepLossLastReqSellGap = reqGap;
        }

      g_stepLossTotalSweeps++;
      g_stepLossLastHitTime     = nowServer;
      g_stepLossLastHitSide     = sideName;
      g_stepLossLastHitEmerg    = isEmergency;
      g_stepLossLastHitAdvGap   = advMove;
      g_stepLossLastHitSidePct  = sideDdPct;
      g_stepLossLastHitEqDdPct  = eqDdPct;
      g_stepLossLastHitPartials = partHits;
      g_stepLossLastHitFulls    = fullHits;
      g_stepLossLastHitLots     = lotsCutTot;
      g_stepLossLastHitPL       = estPLTot;

      if(!isTestRun)
        {
         GlobalVariableSet(gvAncK, nextAnchor);
         GlobalVariableSet(gvStpK, (double)nextStep);
        }

      PrintFormat(">>> [ADVERSE STEP LOSS COMPLETE%s #%d] %s Dubai=%s (Broker=%s) | Adv=$%.1f (>= $%.0f) | %sLoss=%.2f%% EqDD=%.2f%% | Partial:%d Full0.01:%d (-%.2fL, EstPL=%s$%.2f, Fail=%d) | NextAnchor=%s",
                  (isEmergency ? " EMERGENCY" : ""), nextStep, sideName,
                  TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  TimeToString(nowServer, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  advMove, reqGap, sideName, sideDdPct, eqDdPct,
                  partHits, fullHits, lotsCutTot, (estPLTot >= 0.0 ? "+" : "-"), MathAbs(estPLTot),
                  failCount, DoubleToString(nextAnchor, Digits));

      DrawAdversePriceStepCutIcon(sideName, isEmergency, nextStep, advMove, sideDdPct, eqDdPct, partHits, fullHits, lotsCutTot, estPLTot, nowServer);
      LastDashboardUpdateMs = 0;
      if(ShowLeftLiveOrdersDashboard)
         UpdateLeftLiveOrdersDashboard();
     }
   else
      if(failCount > 0)
        {
         if(isBuy)
            g_stepLossBuyFailLogTime = nowServer;
         else
            g_stepLossSellFailLogTime = nowServer;
        }
  }

//+------------------------------------------------------------------+
//| ManageAdversePriceStepLossCut                                    |
//| Runs every tick alongside 1H Plan A/B, Gap>1000+5%, and Dubai    |
//| Night: continuously monitors BUY and SELL independently for      |
//| adverse market-price moves (3000 raw normal / 2000 raw when      |
//| Equity DD > 30%) once losing side > 10% Balance, partial-closing |
//| 20%/35% LOT down to 0.01L and closing worst 0.01L losers step by |
//| step so runaway losing equity cannot compound unmitigated.       |
//+------------------------------------------------------------------+
void ManageAdversePriceStepLossCut()
  {
   if(!InpEnableAdversePriceStepLossCut)
      return;

   datetime nowServer = TimeCurrent();
   if(nowServer <= 0)
      return;

   bool isTestRun = (IsTesting() || IsOptimization());
   if(!g_stepLossLoaded)
     {
      if(!isTestRun)
        {
         string bAncK = StepLossGvKey("B_ANC");
         string bStpK = StepLossGvKey("B_STP");
         string sAncK = StepLossGvKey("S_ANC");
         string sStpK = StepLossGvKey("S_STP");
         if(GlobalVariableCheck(bAncK) && GlobalVariableGet(bAncK) > 0.0)
           {
            g_stepLossBuyAnchor = GlobalVariableGet(bAncK);
            g_stepLossBuySteps  = GlobalVariableCheck(bStpK) ? (int)MathRound(GlobalVariableGet(bStpK)) : 0;
           }
         if(GlobalVariableCheck(sAncK) && GlobalVariableGet(sAncK) > 0.0)
           {
            g_stepLossSellAnchor = GlobalVariableGet(sAncK);
            g_stepLossSellSteps  = GlobalVariableCheck(sStpK) ? (int)MathRound(GlobalVariableGet(sStpK)) : 0;
           }
        }
      g_stepLossLoaded = true;
     }

   double balance = AccountBalance();
   double equity  = AccountEquity();
   if(balance <= 0.0)
      return;

   double eqDdPct   = (equity < balance) ? (((balance - equity) / balance) * 100.0) : 0.0;
   double buyNetPL  = 0.0, buyDdPct = 0.0, sellNetPL = 0.0, sellDdPct = 0.0;
   int    buyCount  = 0, sellCount = 0;
   CalcEqDdSideDrawdowns(balance, buyNetPL, buyDdPct, sellNetPL, sellDdPct, buyCount, sellCount);

   ProcessAdversePriceStepCutForSide(OP_BUY,  balance, equity, eqDdPct, buyNetPL,  buyDdPct,  buyCount,  nowServer);
   ProcessAdversePriceStepCutForSide(OP_SELL, balance, equity, eqDdPct, sellNetPL, sellDdPct, sellCount, nowServer);
  }

//+------------------------------------------------------------------+
//| Calculate raw price difference from 2 hours ago                  |
//+------------------------------------------------------------------+
double Get2HourPriceDifferenceRaw()
  {
   RefreshRates();
   double currentPrice = (Bid + Ask) / 2.0;
   datetime targetTime = TimeCurrent() - 120 * 60*4; // 120 minutes = 2 hours

   int shift = -1;
   if(iBars(Symbol(), PERIOD_M1) > 0)
      shift = iBarShift(Symbol(), PERIOD_M1, targetTime, false);

   double oldPrice = 0.0;
   if(shift >= 0)
      oldPrice = iClose(Symbol(), PERIOD_M1, shift);

   if(oldPrice <= 0.0)
     {
      int pShift = iBarShift(Symbol(), Period(), targetTime, false);
      if(pShift >= 0)
         oldPrice = iClose(Symbol(), Period(), pShift);
     }

   if(oldPrice <= 0.0)
     {
      int h1Shift = iBarShift(Symbol(), PERIOD_H1, targetTime, false);
      if(h1Shift >= 0)
         oldPrice = iClose(Symbol(), PERIOD_H1, h1Shift);
     }

   if(oldPrice <= 0.0)
      return 0.0;

   return MathAbs(currentPrice - oldPrice);
  }

double GetEmaAngleDegrees(int lookbackBars = 5);

//+------------------------------------------------------------------+
//| Check50PctDrawdownReliefTightenSL:                               |
//| USER RULE (VMULTI-1097):                                         |
//| "Solution 2: Tighten Losing Order SLs to the Relief Price Level. |
//|  Condition is this should be activate tighten when the          |
//|  difference between account balance - equity is more than 100."  |
//|                                                                  |
//| 1. Only activates if Peak Drawdown (Balance - Equity) >= $100.0  |
//| 2. When floating loss reduces by >= 50% from that peak, tightens |
//|    all losing order SLs behind relief market price (Bid-50/Ask+50).|
//| 3. Locks in the 50% reduced loss so adverse trend resumption     |
//|    cannot expand drawdown back into catastrophic losses!         |
//+------------------------------------------------------------------+
void Check50PctDrawdownReliefTightenSL()
  {
   if(!InpEnableDrawdownReliefTightenSL)
      return;

   double balance = AccountBalance();
   double equity  = AccountEquity();
   if(balance <= 0.0)
      return;

   double currentDrawdown = balance - equity;

// Auto-reset when equity >= balance (no floating drawdown)
   if(currentDrawdown <= 0.0)
     {
      if(g_drawdownReliefArmed)
        {
         Print(">>> [DRAWDOWN RELIEF RESET] Equity ($", DoubleToString(equity, 2),
               ") >= Balance ($", DoubleToString(balance, 2), "). Drawdown cleared! Resetting peak tracker.");
        }
      ResetDrawdownReliefCycle("Equity >= Balance (drawdown cleared)");
      return;
     }

// Check open losing orders count for this symbol & magic number
   int losingCount = 0;
   double totalLosingPL = 0.0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;

      double pl = OrderProfit() + OrderSwap() + OrderCommission();
      if(pl < 0.0)
        {
         losingCount++;
         totalLosingPL += pl;
        }
     }

// If no losing orders remain, reset tracker
   if(losingCount == 0)
     {
      if(g_drawdownReliefArmed)
        {
         Print(">>> [DRAWDOWN RELIEF RESET] No open losing orders. Resetting peak tracker.");
        }
      ResetDrawdownReliefCycle("No open losing orders");
      return;
     }

   double mult = (balancelomultipler > 0) ? balancelomultipler : 1.0;
   double minPeakRequired = InpDrawdownReliefMinPeakUSD * mult;
   if(minPeakRequired <= 0.0)
      minPeakRequired = 100.0;

// Track highest drawdown reached during this cycle
   if(currentDrawdown > g_drawdownReliefPeakUSD)
     {
      g_drawdownReliefPeakUSD  = currentDrawdown;
      g_drawdownReliefPeakTime = TimeCurrent();
      g_drawdownReliefExecuted = false; // Reset executed flag if a new worse peak is made
     }

// Arm only when peak reaches or breaches minimum threshold ($100 * mult)
   if(g_drawdownReliefPeakUSD >= minPeakRequired)
     {
      if(!g_drawdownReliefArmed)
        {
         g_drawdownReliefArmed = true;
         PrintFormat(">>> [DRAWDOWN RELIEF ARMED] Peak Drawdown reached $%.2f >= Minimum $%.2f ($100*mult). Monitoring for 50%% relief bounce (Target Drawdown <= $%.2f)...",
                     g_drawdownReliefPeakUSD, minPeakRequired, g_drawdownReliefPeakUSD * (1.0 - InpDrawdownReliefPercent));
        }
     }
   else
     {
      // Below $100 -> do not activate, avoid interfering with small fluctuations
      return;
     }

// If already executed for this peak level, wait until a new worse peak occurs or cycle resets
   if(g_drawdownReliefExecuted)
      return;

// Check if current drawdown has reduced by >= 50% from the peak
   double reliefFraction = (InpDrawdownReliefPercent > 0.0 && InpDrawdownReliefPercent < 1.0) ? InpDrawdownReliefPercent : 0.50;
   double reliefTargetDrawdown = g_drawdownReliefPeakUSD * (1.0 - reliefFraction);

   if(currentDrawdown > reliefTargetDrawdown)
      return; // Has not reduced by 50% yet

// Check 2-hour price difference condition (> $2000 raw price)
   double priceDiff2h = 0.0;
   if(InpDrawdownReliefMinPriceDiff2Hours > 0.0)
     {
      priceDiff2h = Get2HourPriceDifferenceRaw();
      if(priceDiff2h <= InpDrawdownReliefMinPriceDiff2Hours)
        {
         // Price difference in last 2 hours is <= $2000; wait for large price movement
         return;
        }
     }

// Check minimum EMA angle condition (MathAbs(EMAangle) > 6.0)
   double curEmaAng = (GlobalEmaAngle30 != 0.0) ? GlobalEmaAngle30 : GetEmaAngleDegrees(30);
   if(InpDrawdownReliefMinEmaAngle > 0.0 && MathAbs(curEmaAng) <= InpDrawdownReliefMinEmaAngle)
     {
      // EMA angle is too flat (<= 6.0 deg); wait for strong trend momentum
      return;
     }

// 50% RELIEF BOUNCE DETECTED! Tighten all losing orders to relief price level!
   RefreshRates();
   double curBid = MarketInfo(Symbol(), MODE_BID);
   double curAsk = MarketInfo(Symbol(), MODE_ASK);
   double minStopDist = GetRequiredStopDistance();
   if(minStopDist < 20.0)
      minStopDist = 20.0;

   double reliefGap = (InpDrawdownReliefSLGapUSD > 0.0) ? InpDrawdownReliefSLGapUSD : 50.0;
   if(reliefGap < minStopDist)
      reliefGap = minStopDist;

   double winningReliefGap = (InpDrawdownReliefWinningSLGapUSD > 0.0) ? InpDrawdownReliefWinningSLGapUSD : 100.0;
   if(winningReliefGap < minStopDist)
      winningReliefGap = minStopDist;

   int modifiedCount   = 0;
   int losingModified  = 0;
   int winningModified = 0;

   for(int k = OrdersTotal() - 1; k >= 0; k--)
     {
      if(!OrderSelect(k, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int tkt = OrderTicket();
      string cmt = OrderComment();

      // Exclude recovery orders and FLIP basket support orders (managed separately)
      if(IsFLIPBasketSupportOrder(tkt, cmt) || IsAnyRecoveryOrder(tkt, cmt))
         continue;

      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;

      double pl = OrderProfit() + OrderSwap() + OrderCommission();
      bool isWinner = (pl >= 0.0);
      if(isWinner && !InpDrawdownReliefModifyWinningOrders)
         continue;

      // Losing orders use reliefGap ($50), Winning orders use winningReliefGap ($100)
      double gapToUse = isWinner ? winningReliefGap : reliefGap;
      double oOpen = OrderOpenPrice();
      double curSL = OrderStopLoss();
      double curTP = OrderTakeProfit();
      double targetSL = 0.0;

      if(oType == OP_BUY)
        {
         targetSL = NormalizeDouble(curBid - gapToUse, Digits);
         if((curBid - targetSL) < minStopDist)
            targetSL = NormalizeDouble(curBid - minStopDist, Digits);

         // One-Way Tighten: Only modify if curSL is 0.0 OR targetSL is HIGHER than curSL
         if(targetSL < curBid && (curSL <= 0.0 || (targetSL > curSL && (targetSL - curSL) >= MinimumSLModifyGapRaw)))
           {
            ResetLastError();
            color modColor = isWinner ? clrLimeGreen : clrOrange;
            string modComment = isWinner ? "DrawdownReliefWin100" : "DrawdownRelief50Pct";
            bool ok = SafeOrderModify(tkt, oOpen, targetSL, curTP, 0, modColor, modComment);
            if(ok)
              {
               modifiedCount++;
               if(isWinner)
                  winningModified++;
               else
                  losingModified++;
               RegisterDrawdownReliefTicket(tkt);
               if(isWinner)
                 {
                  PrintFormat(">>> [50%% DRAWDOWN RELIEF WINNER SL TIGHTENED] BUY #%d (Lots=%.2f, Profit=+$%.2f) | Old SL=%.2f -> New Tight SL=%.2f (Relief Bid=%.2f - $%.2f) | 2H Diff=$%.2f | EMA Ang=%.2f deg",
                              tkt, OrderLots(), pl, curSL, targetSL, curBid, gapToUse, priceDiff2h, curEmaAng);
                 }
               else
                 {
                  PrintFormat(">>> [50%% DRAWDOWN RELIEF SL TIGHTENED] BUY #%d (Lots=%.2f, Loss=$-%.2f) | Old SL=%.2f -> New Tight SL=%.2f (Relief Bid=%.2f - $%.2f) | Peak DD=$%.2f -> Current DD=$%.2f (Reduced by >50%%) | 2H Diff=$%.2f | EMA Ang=%.2f deg",
                              tkt, OrderLots(), MathAbs(pl), curSL, targetSL, curBid, gapToUse, g_drawdownReliefPeakUSD, currentDrawdown, priceDiff2h, curEmaAng);
                 }
              }
           }
        }
      else
         if(oType == OP_SELL)
           {
            targetSL = NormalizeDouble(curAsk + gapToUse, Digits);
            if((targetSL - curAsk) < minStopDist)
               targetSL = NormalizeDouble(curAsk + minStopDist, Digits);

            // One-Way Tighten: Only modify if curSL is 0.0 OR targetSL is LOWER than curSL
            if(targetSL > curAsk && (curSL <= 0.0 || (targetSL < curSL && (curSL - targetSL) >= MinimumSLModifyGapRaw)))
              {
               ResetLastError();
               color modColor = isWinner ? clrLimeGreen : clrOrange;
               string modComment = isWinner ? "DrawdownReliefWin100" : "DrawdownRelief50Pct";
               bool ok = SafeOrderModify(tkt, oOpen, targetSL, curTP, 0, modColor, modComment);
               if(ok)
                 {
                  modifiedCount++;
                  if(isWinner)
                     winningModified++;
                  else
                     losingModified++;
                  RegisterDrawdownReliefTicket(tkt);
                  if(isWinner)
                    {
                     PrintFormat(">>> [50%% DRAWDOWN RELIEF WINNER SL TIGHTENED] SELL #%d (Lots=%.2f, Profit=+$%.2f) | Old SL=%.2f -> New Tight SL=%.2f (Relief Ask=%.2f + $%.2f) | 2H Diff=$%.2f | EMA Ang=%.2f deg",
                                 tkt, OrderLots(), pl, curSL, targetSL, curAsk, gapToUse, priceDiff2h, curEmaAng);
                    }
                  else
                    {
                     PrintFormat(">>> [50%% DRAWDOWN RELIEF SL TIGHTENED] SELL #%d (Lots=%.2f, Loss=$-%.2f) | Old SL=%.2f -> New Tight SL=%.2f (Relief Ask=%.2f + $%.2f) | Peak DD=$%.2f -> Current DD=$%.2f (Reduced by >50%%) | 2H Diff=$%.2f | EMA Ang=%.2f deg",
                                 tkt, OrderLots(), MathAbs(pl), curSL, targetSL, curAsk, gapToUse, g_drawdownReliefPeakUSD, currentDrawdown, priceDiff2h, curEmaAng);
                    }
                 }
              }
           }
     }

   if(modifiedCount > 0)
     {
      g_drawdownReliefExecuted = true;
      g_drawdownReliefAppliedCount++;
      PrintFormat(">>> [50%% DRAWDOWN RELIEF SL APPLIED #%d] Successfully tightened SL on %d orders (%d losing -$%.0f gap, %d winning -$%.0f gap) | 2H Price Diff=$%.2f | EMA Ang=%.2f deg. Ready to repeat on next peak after hit success.",
                  g_drawdownReliefAppliedCount, modifiedCount, losingModified, reliefGap, winningModified, winningReliefGap, priceDiff2h, curEmaAng);
      DrawDrawdownReliefIcon("APPLIED", modifiedCount, g_drawdownReliefPeakUSD, currentDrawdown, reliefGap, TimeCurrent(), (curBid > 0 ? curBid : 0.0), 0);
      SendDrawdownReliefPhase1Alert(modifiedCount, g_drawdownReliefPeakUSD, currentDrawdown, reliefGap);
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void ApplyEmaFlipWideBreathingProtection(int prevDirection, int newDirection)
  {
   PruneEmaFlipBreathingTickets();
   RefreshRates();
   double minStopDist = MarketInfo(Symbol(), MODE_STOPLEVEL) * Point;
   if(minStopDist < 10.0 * Point)
      minStopDist = 10.0 * Point;
   double extraSafe = (InpEmaFlipWideBreathingSafeExtraRaw > 0.0) ? InpEmaFlipWideBreathingSafeExtraRaw : 100.0;

// CASE 1: Bullish to Bearish flip (+1 to -1) -> Protect losing BUY orders
   if(prevDirection == 1 && newDirection == -1)
     {
      double peakPrice = (g_prevEmaPeakPrice > 0.0) ? g_prevEmaPeakPrice : GetHighestPriceSinceEmaFlip();
      double highestEmaDist = (g_prevEmaHighestDistance > 0.0) ? g_prevEmaHighestDistance : GetHighestEmaDistanceSinceEmaFlip();
      double livePrice = Bid;
      double liveEma = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, 0);

      double dropFromPeak = MathMax(0.0, peakPrice - livePrice);
      double mult = (InpEmaFlipWideBreathingMultiplier > 0.0) ? InpEmaFlipWideBreathingMultiplier : 4.0;
      double minFloor = (InpEmaFlipWideBreathingMinFloorRaw > 0.0) ? InpEmaFlipWideBreathingMinFloorRaw : 1000.0;
      double buffer = (g_prevEma4XBuffer > 0.0) ? g_prevEma4XBuffer : MathMax((highestEmaDist * mult) + extraSafe, dropFromPeak + extraSafe);
      if(buffer < minFloor)
         buffer = minFloor;

      // Arm half-distance tracker
      g_emaFlipHalfDistanceCutGap = buffer * 0.5;
      g_emaFlipHalfDistanceReferencePrice = livePrice;
      g_emaFlipHalfDistanceDirection = -1;

      for(int i = OrdersTotal() - 1; i >= 0; i--)
        {
         if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
            continue;
         if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
            continue;
         if(OrderType() != OP_BUY)
            continue;

         int tkt = OrderTicket();
         string comm = OrderComment();
         if(IsEquityHitSecuredOrder(tkt))
           {
            Print(">>> [EMA FLIP WIDE SL SKIPPED] BUY Order #", tkt,
                  " was secured by Equity Target Hit. Preserving secured StopLoss against wide loss SL!");
            continue;
           }
         if(!InpApplyBreathingToHorizontalOrders && IsHorizontalLineOrder(tkt, comm))
           {
            Print(">>> [EMA FLIP WIDE SL SKIPPED] BUY Order #", tkt, " is a horizontal line order. Keeping existing SL logic.");
            continue;
           }

         // Target only BUY orders that are currently in loss
         double pl = OrderProfit() + OrderSwap() + OrderCommission();
         if(pl < 0.0)
           {
            // If already received breathing protection on a previous flip, do not widen SL again
            if(IsEmaFlipBreathingOrder(tkt))
              {
               Print(">>> [EMA FLIP WIDE SL SKIPPED] BUY Order #", tkt,
                     " already received EMA breathing protection. Preserving current SL cushion.");
               continue;
              }

            double openPrice = OrderOpenPrice();
            double curSL = OrderStopLoss();
            double curTP = OrderTakeProfit();

            // Set targetSL with full buffer from openPrice and livePrice (ensuring at least $2318+ breathing room)
            double targetSL = NormalizeDouble(MathMin(openPrice - buffer, livePrice - buffer), Digits);
            if(livePrice - targetSL < minStopDist)
               targetSL = NormalizeDouble(livePrice - minStopDist - Point * 10, Digits);

            // STRICT RISK RULE: Never widen existing Stop Loss downward into a bigger loss!
            if(curSL > 0.0 && InpNeverWidenEmaFlipStopLoss && targetSL <= curSL)
              {
               Print(">>> [EMA FLIP WIDE SL SKIPPED] BUY Order #", tkt,
                     " Proposed targetSL=", DoubleToString(targetSL, Digits),
                     " <= Current SL=", DoubleToString(curSL, Digits),
                     ". Rule: NEVER widen Stop Loss downward!");
               continue;
              }

            if(curSL > 0.0)
              {
               bool isInitialEmergencySL = (MathAbs(openPrice - curSL) >= 3000.0);
               double curLossAtSL    = CalcOrderLockedProfitUSD(OP_BUY, openPrice, curSL, OrderLots());
               double targetLossAtSL = CalcOrderLockedProfitUSD(OP_BUY, openPrice, targetSL, OrderLots());
               if(!isInitialEmergencySL && InpKeepWideLossCushionSL && curLossAtSL < 0.0 && targetLossAtSL > curLossAtSL)
                 {
                  Print(">>> [EMA FLIP WIDE SL SKIPPED] BUY Order #", tkt,
                        " already has wider loss cushion SL=", DoubleToString(curSL, Digits),
                        " ($", DoubleToString(curLossAtSL, 2),
                        ") vs Proposed tighter SL=", DoubleToString(targetSL, Digits),
                        " ($", DoubleToString(targetLossAtSL, 2),
                        "). Rule: Keep wide cushion!");
                  continue;
                 }
              }

            if(MathAbs(curSL - targetSL) >= Point * 10)
              {
               ResetLastError();
               bool res = SafeOrderModify(tkt, openPrice, targetSL, curTP, 0, clrRed, "EmaFlipBreathing");
               if(res)
                 {
                  RegisterEmaFlipBreathingTicket(tkt);
                  InvalidateTotalEAOrdersCache();
                  Print(">>> [EMA FLIP WIDE SL] Bullish->Bearish Flip (+1 to -1): BUY Order #", tkt,
                        " in Loss ($", DoubleToString(pl, 2), ") modified with Wide Breathing SL=",
                        DoubleToString(targetSL, Digits), " (Buffer=$", DoubleToString(buffer, 2),
                        ", GapFromOpen=$", DoubleToString(openPrice - targetSL, 2),
                        ", Peak=", DoubleToString(peakPrice, Digits),
                        ", HighestEmaDist=$", DoubleToString(highestEmaDist, 2), ")");
                 }
               else
                 {
                  Print(">>> [EMA FLIP WIDE SL SKIPPED/FAILED] Ticket #", tkt, " Err=", GetLastError());
                 }
              }
           }
        }
     }
// CASE 2: Bearish to Bullish flip (-1 to +1) -> Protect losing SELL orders
   else
      if(prevDirection == -1 && newDirection == 1)
        {
         double lowestPrice = (g_prevEmaPeakPrice > 0.0) ? g_prevEmaPeakPrice : GetLowestPriceSinceEmaFlip();
         double lowestEmaDist = (g_prevEmaHighestDistance > 0.0) ? g_prevEmaHighestDistance : GetLowestEmaDistanceSinceEmaFlip();
         double livePrice = Ask;
         double liveEma = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, 0);

         double riseFromBottom = MathMax(0.0, livePrice - lowestPrice);
         double mult = (InpEmaFlipWideBreathingMultiplier > 0.0) ? InpEmaFlipWideBreathingMultiplier : 4.0;
         double minFloor = (InpEmaFlipWideBreathingMinFloorRaw > 0.0) ? InpEmaFlipWideBreathingMinFloorRaw : 1000.0;
         double buffer = (g_prevEma4XBuffer > 0.0) ? g_prevEma4XBuffer : MathMax((lowestEmaDist * mult) + extraSafe, riseFromBottom + extraSafe);
         if(buffer < minFloor)
            buffer = minFloor;

         // Arm half-distance tracker
         g_emaFlipHalfDistanceCutGap = buffer * 0.5;
         g_emaFlipHalfDistanceReferencePrice = livePrice;
         g_emaFlipHalfDistanceDirection = 1;

         for(int i = OrdersTotal() - 1; i >= 0; i--)
           {
            if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
               continue;
            if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
               continue;
            if(OrderType() != OP_SELL)
               continue;

            int tkt = OrderTicket();
            string comm = OrderComment();
            if(IsEquityHitSecuredOrder(tkt))
              {
               Print(">>> [EMA FLIP WIDE SL SKIPPED] SELL Order #", tkt,
                     " was secured by Equity Target Hit. Preserving secured StopLoss against wide loss SL!");
               continue;
              }
            if(!InpApplyBreathingToHorizontalOrders && IsHorizontalLineOrder(tkt, comm))
              {
               Print(">>> [EMA FLIP WIDE SL SKIPPED] SELL Order #", tkt, " is a horizontal line order. Keeping existing SL logic.");
               continue;
              }

            // Target only SELL orders that are currently in loss
            double pl = OrderProfit() + OrderSwap() + OrderCommission();
            if(pl < 0.0)
              {
               // If already received breathing protection on a previous flip, do not widen SL again
               if(IsEmaFlipBreathingOrder(tkt))
                 {
                  Print(">>> [EMA FLIP WIDE SL SKIPPED] SELL Order #", tkt,
                        " already received EMA breathing protection. Preserving current SL cushion.");
                  continue;
                 }

               double openPrice = OrderOpenPrice();
               double curSL = OrderStopLoss();
               double curTP = OrderTakeProfit();

               // Set targetSL with full buffer from openPrice and livePrice (ensuring at least $2318+ breathing room)
               double targetSL = NormalizeDouble(MathMax(openPrice + buffer, livePrice + buffer), Digits);
               if(targetSL - livePrice < minStopDist)
                  targetSL = NormalizeDouble(livePrice + minStopDist + Point * 10, Digits);

               // STRICT RISK RULE: Never widen existing Stop Loss upward into a bigger loss!
               if(curSL > 0.0 && InpNeverWidenEmaFlipStopLoss && targetSL >= curSL)
                 {
                  Print(">>> [EMA FLIP WIDE SL SKIPPED] SELL Order #", tkt,
                        " Proposed targetSL=", DoubleToString(targetSL, Digits),
                        " >= Current SL=", DoubleToString(curSL, Digits),
                        ". Rule: NEVER widen Stop Loss upward!");
                  continue;
                 }

               if(curSL > 0.0)
                 {
                  bool isInitialEmergencySL = (MathAbs(openPrice - curSL) >= 3000.0);
                  double curLossAtSL    = CalcOrderLockedProfitUSD(OP_SELL, openPrice, curSL, OrderLots());
                  double targetLossAtSL = CalcOrderLockedProfitUSD(OP_SELL, openPrice, targetSL, OrderLots());
                  if(!isInitialEmergencySL && InpKeepWideLossCushionSL && curLossAtSL < 0.0 && targetLossAtSL > curLossAtSL)
                    {
                     Print(">>> [EMA FLIP WIDE SL SKIPPED] SELL Order #", tkt,
                           " already has wider loss cushion SL=", DoubleToString(curSL, Digits),
                           " ($", DoubleToString(curLossAtSL, 2),
                           ") vs Proposed tighter SL=", DoubleToString(targetSL, Digits),
                           " ($", DoubleToString(targetLossAtSL, 2),
                           "). Rule: Keep wide cushion!");
                     continue;
                    }
                 }

               if(MathAbs(curSL - targetSL) >= Point * 10)
                 {
                  ResetLastError();
                  bool res = SafeOrderModify(tkt, openPrice, targetSL, curTP, 0, clrBlue, "EmaFlipBreathing");
                  if(res)
                    {
                     RegisterEmaFlipBreathingTicket(tkt);
                     InvalidateTotalEAOrdersCache();
                     Print(">>> [EMA FLIP WIDE SL] Bearish->Bullish Flip (-1 to +1): SELL Order #", tkt,
                           " in Loss ($", DoubleToString(pl, 2), ") modified with Wide Breathing SL=",
                           DoubleToString(targetSL, Digits), " (Buffer=$", DoubleToString(buffer, 2),
                           ", GapFromOpen=$", DoubleToString(targetSL - openPrice, 2),
                           ", Lowest=", DoubleToString(lowestPrice, Digits),
                           ", LowestEmaDist=$", DoubleToString(lowestEmaDist, 2), ")");
                    }
                  else
                    {
                     Print(">>> [EMA FLIP WIDE SL SKIPPED/FAILED] Ticket #", tkt, " Err=", GetLastError());
                    }
                 }
              }
           }
        }
  }

//+------------------------------------------------------------------+
//| IsFLIPBasketSupportOrder: Identifies FLIP Basket Support orders  |
//+------------------------------------------------------------------+
bool IsFLIPBasketSupportOrder(int ticket, string comment = "")
  {
   string cmt = comment;
   if(StringFind(cmt, "FLIPBasketSupport") >= 0)
      return true;
   if(cmt == "" && ticket > 0)
     {
      int savedTicket = OrderTicket();
      if(OrderTicket() == ticket)
         cmt = OrderComment();
      else
         if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
            cmt = OrderComment();
         else
            if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_HISTORY))
               cmt = OrderComment();
      if(savedTicket > 0 && OrderTicket() != savedTicket)
        {
         if(!OrderSelect(savedTicket, SELECT_BY_TICKET, MODE_TRADES))
            bool selHist = OrderSelect(savedTicket, SELECT_BY_TICKET, MODE_HISTORY);
        }
     }
   if(StringFind(cmt, "FLIPBasketSupport") >= 0)
      return true;
   if(ticket > 0 && (cmt == "" || IsPartialCloseOrderComment(cmt)))
     {
      string effCmt = GetEffectiveOrderComment(ticket, cmt);
      if(StringFind(effCmt, "FLIPBasketSupport") >= 0)
         return true;
     }
   return false;
  }

//+------------------------------------------------------------------+
//| HasOpenFLIPBasketSupportOrder: Returns true if an active         |
//| FLIPBasketSupport order exists.                                  |
//| targetType: OP_BUY, OP_SELL, or -1 (checks ANY open support order)|
//+------------------------------------------------------------------+
bool HasOpenFLIPBasketSupportOrder(int targetType = -1, bool excludeLsd = false)
  {
   int count=0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      if(!IsFLIPBasketSupportOrder(OrderTicket(), OrderComment()))
         continue;
      if(excludeLsd && StringFind(OrderComment(), "FLIPBasketSupport_LSD") >= 0)
         continue;

      int oType = OrderType();
      if(targetType == OP_BUY)
        {
         if(oType != OP_BUY && oType != OP_BUYSTOP && oType != OP_BUYLIMIT)
            continue;
        }
      else
         if(targetType == OP_SELL)
           {
            if(oType != OP_SELL && oType != OP_SELLSTOP && oType != OP_SELLLIMIT)
               continue;
           }
         else
            if(targetType >= 0 && oType != targetType)
              {
               continue;
              }

      count++;
     }
   if(count < 1)
      return false;

   return true;
  }

//+------------------------------------------------------------------+
//| InitializeFLIPBasketSupportTracking: Initializes active ticket   |
//| and latest closed support order time from account history.       |
//+------------------------------------------------------------------+
void InitializeFLIPBasketSupportTracking()
  {
   g_lastActiveFLIPBasketSupportTicket = -1;
   LastClosedFLIPBasketSupportTime = 0;

// 1. Audit active open orders for existing FLIPBasketSupport runner
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      if(IsFLIPBasketSupportOrder(OrderTicket(), OrderComment()))
        {
         g_lastActiveFLIPBasketSupportTicket = OrderTicket();
         break;
        }
     }

// 2. Audit recent history for latest closed FLIPBasketSupport order
   int totalHist = OrdersHistoryTotal();
   int scanLimit = MathMin(totalHist, 100);
   for(int h = totalHist - 1; h >= totalHist - scanLimit; h--)
     {
      if(!OrderSelect(h, SELECT_BY_POS, MODE_HISTORY))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      string cmt = OrderComment();
      if(StringFind(cmt, "FLIPBasketSupport") >= 0)
        {
         datetime cTime = OrderCloseTime();
         if(cTime > LastClosedFLIPBasketSupportTime)
            LastClosedFLIPBasketSupportTime = cTime;
        }
     }
  }

//+------------------------------------------------------------------+
//| GetLastClosedFLIPBasketSupportCloseTime: Returns close time of   |
//| the most recently closed FLIPBasketSupport order.                |
//+------------------------------------------------------------------+
datetime GetLastClosedFLIPBasketSupportCloseTime()
  {
   datetime lastCloseTime = LastClosedFLIPBasketSupportTime;

// 1. Check if tracked active ticket recently moved to history
   if(g_lastActiveFLIPBasketSupportTicket > 0)
     {
      if(OrderSelect(g_lastActiveFLIPBasketSupportTicket, SELECT_BY_TICKET, MODE_HISTORY))
        {
         datetime histClose = OrderCloseTime();
         if(histClose > lastCloseTime)
            lastCloseTime = histClose;
         LastClosedFLIPBasketSupportTime = lastCloseTime;
         g_lastActiveFLIPBasketSupportTicket = -1;
        }
     }

// 2. Scan recent closed orders in account history
   int totalHistory = OrdersHistoryTotal();
   int scanLimit = MathMin(totalHistory, 100);

   for(int i = totalHistory - 1; i >= totalHistory - scanLimit; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_HISTORY))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      string cmt = OrderComment();
      if(StringFind(cmt, "FLIPBasketSupport") >= 0)
        {
         datetime cTime = OrderCloseTime();
         if(cTime > lastCloseTime)
            lastCloseTime = cTime;
        }
     }

   if(lastCloseTime > LastClosedFLIPBasketSupportTime)
      LastClosedFLIPBasketSupportTime = lastCloseTime;

   return lastCloseTime;
  }

//+------------------------------------------------------------------+
//| CloseFLIPBasketSupportOrders: Closes active FLIPBasketSupport    |
//| orders on flip change, basket close, or orphan cleanup.          |
//| targetType: OP_BUY, OP_SELL, or -1 (all)                         |
//+------------------------------------------------------------------+
void CloseFLIPBasketSupportOrders(int targetType = -1, bool closeLsdOrders = false)
  {
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      if(!IsFLIPBasketSupportOrder(OrderTicket(), OrderComment()))
         continue;
      if(!closeLsdOrders && StringFind(OrderComment(), "FLIPBasketSupport_LSD") >= 0)
         continue;

      int oType = OrderType();

      // Check targetType matching (matches market & pending for the direction)
      if(targetType == OP_BUY)
        {
         if(oType != OP_BUY && oType != OP_BUYSTOP && oType != OP_BUYLIMIT)
            continue;
        }
      else
         if(targetType == OP_SELL)
           {
            if(oType != OP_SELL && oType != OP_SELLSTOP && oType != OP_SELLLIMIT)
               continue;
           }
         else
            if(targetType >= 0 && oType != targetType)
              {
               continue;
              }

      int ticket = OrderTicket();
      double lots = OrderLots();

      if(oType == OP_BUY || oType == OP_SELL)
        {
         bool closed = false;
         for(int attempt = 0; attempt < 3; attempt++)
           {
            RefreshRates();
            double closePrice = (oType == OP_BUY) ? Bid : Ask;
            closePrice = NormalizeDouble(closePrice, Digits);
            ResetLastError();
            closed = OrderClose(ticket, lots, closePrice, Slippage, (oType == OP_BUY ? clrRed : clrBlue));
            if(closed)
              {
               LastClosedFLIPBasketSupportTime = TimeCurrent();
               if(ticket == g_lastActiveFLIPBasketSupportTicket)
                  g_lastActiveFLIPBasketSupportTicket = -1;
               Print("FLIPBasketSupport Ticket #", ticket, " (", (oType == OP_BUY ? "BUY" : "SELL"), ") closed successfully at ", DoubleToString(closePrice, Digits));
               InvalidateTotalEAOrdersCache();
               break;
              }
            Sleep(100);
           }

         if(!closed)
           {
            Print("Direct OrderClose failed for FLIPBasketSupport #", ticket, ", trying SafeOrderCloseMarket...");
            if(SafeOrderCloseMarket(ticket, lots, Slippage, (oType == OP_BUY ? clrRed : clrBlue)))
              {
               LastClosedFLIPBasketSupportTime = TimeCurrent();
               if(ticket == g_lastActiveFLIPBasketSupportTicket)
                  g_lastActiveFLIPBasketSupportTicket = -1;
               InvalidateTotalEAOrdersCache();
              }
           }
        }
      else
         if(oType == OP_BUYSTOP || oType == OP_SELLSTOP || oType == OP_BUYLIMIT || oType == OP_SELLLIMIT)
           {
            SafeOrderDelete(ticket, clrYellow);
            LastClosedFLIPBasketSupportTime = TimeCurrent();
            if(ticket == g_lastActiveFLIPBasketSupportTicket)
               g_lastActiveFLIPBasketSupportTicket = -1;
            InvalidateTotalEAOrdersCache();
           }
     }
  }

//+------------------------------------------------------------------+
//| CheckAndCloseOrphanFLIPBasketSupportOrders                       |
//| Ensures a FLIPBasketSupport order never remains orphan / single. |
//| - If all regular SELL market orders are closed, close any SELL   |
//|   FLIPBasketSupport order immediately.                           |
//| - If all regular BUY market orders are closed, close any BUY     |
//|   FLIPBasketSupport order immediately.                           |
//| - Also deletes pending FLIPBasketSupport orders if all regular   |
//|   orders in that direction are gone.                             |
//+------------------------------------------------------------------+
void CheckAndCloseOrphanFLIPBasketSupportOrders()
  {
   if(!EAStartupComplete)
      return;
   if(OnlyAllowFLIPBasketSupportOrders)
      return;

   int regularBuyMarketCount   = 0;
   int regularSellMarketCount  = 0;
   int regularBuyTotalCount    = 0;
   int regularSellTotalCount   = 0;

   int supportBuyMarketCount   = 0;
   int supportSellMarketCount  = 0;
   int supportBuyPendingCount  = 0;
   int supportSellPendingCount = 0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      bool isSupport = IsFLIPBasketSupportOrder(OrderTicket(), OrderComment());
      if(isSupport && StringFind(OrderComment(), "FLIPBasketSupport_LSD") >= 0)
         continue; // LSD-triggered FLIPBasketSupport orders are standalone entries and must not be closed as orphans

      if(oType == OP_BUY)
        {
         if(isSupport)
            supportBuyMarketCount++;
         else
           {
            regularBuyMarketCount++;
            regularBuyTotalCount++;
           }
        }
      else
         if(oType == OP_BUYSTOP || oType == OP_BUYLIMIT)
           {
            if(isSupport)
               supportBuyPendingCount++;
            else
               regularBuyTotalCount++;
           }
         else
            if(oType == OP_SELL)
              {
               if(isSupport)
                  supportSellMarketCount++;
               else
                 {
                  regularSellMarketCount++;
                  regularSellTotalCount++;
                 }
              }
            else
               if(oType == OP_SELLSTOP || oType == OP_SELLLIMIT)
                 {
                  if(isSupport)
                     supportSellPendingCount++;
                  else
                     regularSellTotalCount++;
                 }
     }

// 1. SELL SIDE: If support SELL market order exists but 0 regular SELL market orders remain -> ORPHAN! Close it!
   if(supportSellMarketCount > 0 && regularSellMarketCount == 0)
     {
      Print("ORPHAN FLIPBasketSupport SELL DETECTED: All regular SELL orders are closed (0 market SELL left). Closing FLIPBasketSupport SELL immediately.");
      CloseFLIPBasketSupportOrders(OP_SELL);
     }


// 2. BUY SIDE: If support BUY market order exists but 0 regular BUY market orders remain -> ORPHAN! Close it!
   if(supportBuyMarketCount > 0 && regularBuyMarketCount == 0)
     {
      Print("ORPHAN FLIPBasketSupport BUY DETECTED: All regular BUY orders are closed (0 market BUY left). Closing FLIPBasketSupport BUY immediately.");
      CloseFLIPBasketSupportOrders(OP_BUY);
     }

  }

//+------------------------------------------------------------------+
//| HasOppositeOrderTypeLossOver5: Checks if opposite order type has |
//| net loss > $5.00 or any single order has loss > $5.00.           |
//+------------------------------------------------------------------+
bool HasOppositeOrderTypeLossOver5(int currentDirection, double &outOppositeTotalPL, double &outMaxSingleLoss)
  {
   outOppositeTotalPL = 0.0;
   outMaxSingleLoss = 0.0;
   int oppType = (currentDirection == 1) ? OP_SELL : OP_BUY;
   int oppCount = 0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      if(OrderType() != oppType)
         continue;

      oppCount++;
      double pl = OrderProfit() + OrderSwap() + OrderCommission();
      outOppositeTotalPL += pl;
      if(pl < 0.0)
        {
         double lossVal = MathAbs(pl);
         if(lossVal > outMaxSingleLoss)
            outMaxSingleLoss = lossVal;
        }
     }

   if(oppCount == 0)
      return false;

// Condition satisfied if total net loss on opposite side > $5.00 OR single opposite order loss > $5.00
   if(outOppositeTotalPL < -FLIPBasketSupportRecreateOppositeMinLossUSD ||
      outMaxSingleLoss > FLIPBasketSupportRecreateOppositeMinLossUSD)
     {
      return true;
     }

   return false;
  }

bool IsBlockedByActiveHorizontalLines(int orderType, double reqPrice, string orderComment = "");

//+------------------------------------------------------------------+
//| SendFLIPBasketSupportOrder: Dedicated direct order placement     |
//| for FLIPBasketSupport orders. Bypasses regular order filters     |
//| in SafeOrderSend (loss thresholds, counter-trend gates, etc.)    |
//| while ensuring lot normalization and retry resilience on error.  |
//+------------------------------------------------------------------+
int SendFLIPBasketSupportOrder(int pendingType, double lots, double price, double stopLoss, double takeProfit, string comment, color arrowColor)
  {
   lots       = NormalizeLots(lots);
   price      = NormalizeDouble(price, Digits);
   stopLoss   = (stopLoss > 0.0) ? NormalizeDouble(stopLoss, Digits) : 0.0;
   takeProfit = (takeProfit > 0.0) ? NormalizeDouble(takeProfit, Digits) : 0.0;

   if(IsBlockedByActiveHorizontalLines(pendingType, price, comment))
      return -1;

   int ticket = -1;
   int maxAttempts = 3;

   for(int attempt = 0; attempt < maxAttempts; attempt++)
     {
      RefreshRates();
      ResetLastError();

      ticket = OrderSend(Symbol(), pendingType, lots, price, Slippage, stopLoss, takeProfit, comment, MagicNumber, 0, arrowColor);
      if(ticket > 0)
        {
         InvalidateTotalEAOrdersCache();
         return ticket;
        }

      int err = GetLastError();
      Print("FLIPBasketSupport OrderSend attempt ", (attempt + 1), " failed. Err=", err);

      // Retry on transient quote/busy errors
      if(err == 136 || err == 138 || err == 135 || err == 137 || err == 146)
        {
         Sleep(100);
         continue;
        }

      break;
     }

   return ticket;
  }

//+------------------------------------------------------------------+
//| CreateFLIPBasketSupportOrder: Opens 1 market order on every flip |
//| Supported long-term for basket profit until $10 equity lock      |
//| SAFEST METHOD: Closes already open support order before creating |
//| new one; strictly maximum 1 active support order in total!       |
//| Take profit set to 500 raw BTC price distance                    |
//+------------------------------------------------------------------+
int CreateFLIPBasketSupportOrder(int flipDirection, bool ignoreEmaDistanceGate = false, bool ignoreAllGates = false, string commentSuffix = "")
  {
   if(!EAStartupComplete)
      return -1;
   if(GetTotalEAOrders() >= MaxOpenOrders)
     {
      Print("FLIPBasketSupport order skipped: MaxOpenOrders reached");
      return -1;
     }

   if(!ignoreAllGates)
     {
      // Gate: Order blocked if elapsed time since EmaFlipTime is less than 15 minutes (minimum 15 min after flip time)
      if(EmaFlipTime == 0 || (TimeCurrent() - EmaFlipTime) < FLIPBasketSupportMinFlipElapsedSeconds)
        {
         static datetime lastFlipElapsedLogTime = 0;
         if(TimeCurrent() - lastFlipElapsedLogTime >= 30) // Throttle journal logs to once per 30 seconds
           {
            lastFlipElapsedLogTime = TimeCurrent();
            if(EmaFlipTime == 0)
              {
               Print("FLIPBasketSupport order blocked: No EMA flip recorded yet (EmaFlipTime == 0). Requires minimum 15 min after flip time.");
              }
            else
              {
               int elapsedSec = (int)(TimeCurrent() - EmaFlipTime);
               int remainingSec = FLIPBasketSupportMinFlipElapsedSeconds - elapsedSec;
               Print("FLIPBasketSupport order blocked: Elapsed time since EMA flip < 15 min (TimeCurrent() - EmaFlipTime > 60*15 required). Elapsed=",
                     elapsedSec, "s (", (elapsedSec / 60), "m ", (elapsedSec % 60), "s), Required >= ", FLIPBasketSupportMinFlipElapsedSeconds,
                     "s (15 min). Remaining=", remainingSec, "s (", (remainingSec / 60), "m ", (remainingSec % 60), "s).");
              }
           }
         return -1;
        }

      int targetOrderType = (flipDirection == 1) ? OP_BUY : OP_SELL;

      if(GetOpenPL(targetOrderType)>=0)
        {
         //      return -1;
        }

      // 0C. Weak Trend Gate: Do not create FLIPBasketSupport order when IsEmaWEAKDistanceReduced50PercentFromPeak is weak
      if(FLIPBasketSupportBlockOnWeakEma)
        {
         if(IsEmaWEAKDistanceReduced50PercentFromPeak(targetOrderType) || IsEmaWEAKDistanceReduced50PercentFromPeak(-1))
           {
            static datetime lastWeakSupportPrintTime = 0;
            if(TimeCurrent() - lastWeakSupportPrintTime >= 30) // Throttle journal logs to once per 30 seconds
              {
               lastWeakSupportPrintTime = TimeCurrent();
               Print("FLIPBasketSupport order blocked: IsEmaWEAKDistanceReduced50PercentFromPeak() is WEAK. (Trend is exhausted / pulling back from peak).");
              }
            return -1;
           }
        }

      // 0D. Weak State Count Gate: Block FLIPBasketSupport if strong=" Weak" was detected more than once this EMA cycle
      if(GetWeakStateCountPerEmaFlip() > 1)
        {
         static datetime lastWeakCountPrintTime = 0;
         if(TimeCurrent() - lastWeakCountPrintTime >= 30)
           {
            lastWeakCountPrintTime = TimeCurrent();
            Print("FLIPBasketSupport order blocked [Gate 0D]: Weak state detected ",
                  GetWeakStateCountPerEmaFlip(), " times this EMA cycle (> 1). Trend is exhausted.");
           }
         return -1;
        }

      // Gate 9: EMA State Gate (string emaState="N/A"; emaState should be "BULLISH" for buy orders, "BEARISH" for sell orders)
      RefreshRates();
      double ema200Val = iMA(Symbol(), Period(), InpEMA200Period, 0, MODE_EMA, PRICE_CLOSE, InpEMAPriceShift);
      string emaState = "N/A";
      if(ema200Val > 0.0)
        {
         if(Bid > ema200Val)
            emaState = "BULLISH";
         else
            if(Bid < ema200Val)
               emaState = "BEARISH";
            else
               emaState = "AT EMA";
        }

      string checkEmaState = emaState;
      StringToUpper(checkEmaState);

      if(flipDirection == 1) // BUY orders require BULLISH emaState
        {
         if(checkEmaState != "BULLISH")
           {
            static datetime lastEmaStateBuyLogTime = 0;
            if(TimeCurrent() - lastEmaStateBuyLogTime >= 30) // Throttle journal logs to once per 30 seconds
              {
               lastEmaStateBuyLogTime = TimeCurrent();
               Print("FLIPBasketSupport order blocked [Gate 9]: emaState is '", emaState,
                     "' (Bid=", DoubleToString(Bid, Digits), ", EMA200=", DoubleToString(ema200Val, Digits),
                     "). Required: 'BULLISH' for BUY orders.");
              }
            return -1;
           }
        }
      else
         if(flipDirection == -1) // SELL orders require BEARISH emaState
           {
            if(checkEmaState != "BEARISH")
              {
               static datetime lastEmaStateSellLogTime = 0;
               if(TimeCurrent() - lastEmaStateSellLogTime >= 30) // Throttle journal logs to once per 30 seconds
                 {
                  lastEmaStateSellLogTime = TimeCurrent();
                  Print("FLIPBasketSupport order blocked [Gate 9]: emaState is '", emaState,
                        "' (Bid=", DoubleToString(Bid, Digits), ", EMA200=", DoubleToString(ema200Val, Digits),
                        "). Required: 'BEARISH' for SELL orders.");
                 }
               return -1;
              }
           }

      // 0E. Order Position Gate (Gate 6):
      //     - In BUY EMA: At least one open BUY order must already exist ABOVE the proposed entry price
      //       with a minimum raw price gap of $100: (Existing BUY OpenPrice - Proposed Entry >= $100.0).
      //     - In SELL EMA: At least one open SELL order must already exist BELOW the proposed entry price
      //       with a minimum raw price gap of $100: (Proposed Entry - Existing SELL OpenPrice >= $100.0).
      //     - In addition, proposed entry must maintain minimum $100 raw price gap from ANY open order in that direction.
      RefreshRates();
      double testPendingGap = (FLIPBasketSupportPendingGapRaw > 0.0) ? FLIPBasketSupportPendingGapRaw : ProfitReEntryGapRaw;
      if(testPendingGap <= 0.0)
         testPendingGap = 20.0;
      double testMinGap = GetRequiredStopDistance();
      double proposedEntryPrice = 0.0;

      if(flipDirection == 1) // BUY
        {
         proposedEntryPrice = Ask + testPendingGap;
         if(proposedEntryPrice < Ask + testMinGap)
            proposedEntryPrice = Ask + testMinGap;
        }
      else
         if(flipDirection == -1) // SELL
           {
            proposedEntryPrice = Bid - testPendingGap;
            if(proposedEntryPrice > Bid - testMinGap)
               proposedEntryPrice = Bid - testMinGap;
           }
      proposedEntryPrice = NormalizeDouble(proposedEntryPrice, Digits);

      double minOpenOrderGap = (FLIPBasketSupportMinOpenOrderGapRaw > 0.0) ? FLIPBasketSupportMinOpenOrderGapRaw : 100.0;
      bool hasQualifyingOpenOrder = false;
      int openSameDirCount = 0;
      double extremeOpenPrice = (flipDirection == 1) ? -1.0 : 999999999.0;
      int tooCloseOrderTicket = -1;
      double tooCloseOrderPrice = 0.0;
      double tooCloseOrderGap = 0.0;

      for(int posIdx = OrdersTotal() - 1; posIdx >= 0; posIdx--)
        {
         if(!OrderSelect(posIdx, SELECT_BY_POS, MODE_TRADES))
            continue;
         if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
            continue;
         if(IsFLIPBasketSupportOrder(OrderTicket(), OrderComment()) || IsAnyRecoveryOrder(OrderTicket(), OrderComment()))
            continue;

         int curType = OrderType();
         if(flipDirection == 1) // BUY EMA: Look for BUY orders above proposed entry
           {
            if(curType != OP_BUY && curType != OP_BUYSTOP && curType != OP_BUYLIMIT)
               continue;
            openSameDirCount++;
            double oPrice = OrderOpenPrice();
            if(oPrice > extremeOpenPrice)
               extremeOpenPrice = oPrice;

            // Gate 6: Qualifying order must be above proposed entry with >= $100 raw price gap
            if((oPrice - proposedEntryPrice) >= minOpenOrderGap)
               hasQualifyingOpenOrder = true;

            // Check proximity: Maintain minimum $100 raw price gap from any open BUY order
            double dist = MathAbs(proposedEntryPrice - oPrice);
            if(dist < minOpenOrderGap)
              {
               tooCloseOrderTicket = OrderTicket();
               tooCloseOrderPrice  = oPrice;
               tooCloseOrderGap    = dist;
              }
           }
         else
            if(flipDirection == -1) // SELL EMA: Look for SELL orders below proposed entry
              {
               if(curType != OP_SELL && curType != OP_SELLSTOP && curType != OP_SELLLIMIT)
                  continue;
               openSameDirCount++;
               double oPrice = OrderOpenPrice();
               if(oPrice < extremeOpenPrice)
                  extremeOpenPrice = oPrice;

               // Gate 6: Qualifying order must be below proposed entry with >= $100 raw price gap
               if((proposedEntryPrice - oPrice) >= minOpenOrderGap)
                  hasQualifyingOpenOrder = true;

               // Check proximity: Maintain minimum $100 raw price gap from any open SELL order
               double dist = MathAbs(proposedEntryPrice - oPrice);
               if(dist < minOpenOrderGap)
                 {
                  tooCloseOrderTicket = OrderTicket();
                  tooCloseOrderPrice  = oPrice;
                  tooCloseOrderGap    = dist;
                 }
              }
        }

      if(!hasQualifyingOpenOrder)
        {
         static datetime lastOrderPosPrintTime = 0;
         if(TimeCurrent() - lastOrderPosPrintTime >= 30)
           {
            lastOrderPosPrintTime = TimeCurrent();
            if(openSameDirCount == 0)
              {
               Print("FLIPBasketSupport order blocked [Gate 6]: No existing open ",
                     (flipDirection == 1 ? "BUY" : "SELL"), " orders found. FlipBasketSupport requires at least one existing order ",
                     (flipDirection == 1 ? "above" : "below"), " it.");
              }
            else
              {
               Print("FLIPBasketSupport order blocked [Gate 6]: No existing open ",
                     (flipDirection == 1 ? "BUY" : "SELL"), " order found with min $100 raw gap ",
                     (flipDirection == 1 ? "above" : "below"), " proposed entry (", DoubleToString(proposedEntryPrice, Digits),
                     "). Extreme open price=", DoubleToString(extremeOpenPrice, Digits),
                     " (Gap=", DoubleToString(MathAbs(extremeOpenPrice - proposedEntryPrice), 2),
                     " < Required Min $100.00). Must have at least one order >= $100 ",
                     (flipDirection == 1 ? "above" : "below"), " it.");
              }
           }
         return -1;
        }

      if(tooCloseOrderTicket > 0)
        {
         static datetime lastOrderCloseGapPrintTime = 0;
         if(TimeCurrent() - lastOrderCloseGapPrintTime >= 30)
           {
            lastOrderCloseGapPrintTime = TimeCurrent();
            Print("FLIPBasketSupport order blocked [Gate 6 - Min Gap]: Too close to open ",
                  (flipDirection == 1 ? "BUY" : "SELL"), " order #", tooCloseOrderTicket,
                  " at ", DoubleToString(tooCloseOrderPrice, Digits),
                  " | Proposed Entry=", DoubleToString(proposedEntryPrice, Digits),
                  " | Gap=$", DoubleToString(tooCloseOrderGap, 2), " < Required Min $100.00.");
           }
         return -1;
        }

      // Top / Bottom Position Guard for FLIPBasketSupport (V10078)
      // FLIPBasketSupport order must not be in the top position or within $100 of extreme price after EMA flip
      if(flipDirection == 1) // BUY
        {
         double highestAfterFlip = GetHighestPriceSinceEmaFlip();
         if(proposedEntryPrice >= (highestAfterFlip - 100.0))
           {
            static datetime lastFlipTopLogTime = 0;
            if(TimeCurrent() - lastFlipTopLogTime >= 30)
              {
               lastFlipTopLogTime = TimeCurrent();
               Print("FLIPBasketSupport order blocked [Gate 0E - Top Position]: Proposed BUY entry (",
                     DoubleToString(proposedEntryPrice, Digits), ") is within $100 of peak price since EMA flip (",
                     DoubleToString(highestAfterFlip, Digits), "). FlipBasketSupport must not be in top position.");
              }
            return -1;
           }
        }
      else
         if(flipDirection == -1) // SELL
           {
            double lowestAfterFlip = GetLowestPriceSinceEmaFlip();
            if(proposedEntryPrice <= (lowestAfterFlip + 100.0))
              {
               static datetime lastFlipBottomLogTime = 0;
               if(TimeCurrent() - lastFlipBottomLogTime >= 30)
                 {
                  lastFlipBottomLogTime = TimeCurrent();
                  Print("FLIPBasketSupport order blocked [Gate 0E - Bottom Position]: Proposed SELL entry (",
                        DoubleToString(proposedEntryPrice, Digits), ") is within $100 of lowest price since EMA flip (",
                        DoubleToString(lowestAfterFlip, Digits), "). FlipBasketSupport must not be in bottom position.");
                 }
               return -1;
              }
           }

      // 0F. 0.05 Lot Minimum Gap Gate:
      // Maintain minimum $100 raw price gap between FLIPBasketSupportOrder and any open 0.05 lot order (same EMA direction)
      int tooClose005Ticket = -1;
      double tooClose005Price = 0.0;
      double tooClose005Gap = 0.0;

      for(int cIdx = OrdersTotal() - 1; cIdx >= 0; cIdx--)
        {
         if(!OrderSelect(cIdx, SELECT_BY_POS, MODE_TRADES))
            continue;
         if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
            continue;
         if(IsFLIPBasketSupportOrder(OrderTicket(), OrderComment()) || IsAnyRecoveryOrder(OrderTicket(), OrderComment()))
            continue;

         int curType = OrderType();
         if(flipDirection == 1) // BUY EMA
           {
            if(curType != OP_BUY && curType != OP_BUYSTOP && curType != OP_BUYLIMIT)
               continue;
           }
         else
            if(flipDirection == -1) // SELL EMA
              {
               if(curType != OP_SELL && curType != OP_SELLSTOP && curType != OP_SELLLIMIT)
                  continue;
              }
            else
               continue;

         double oLots = OrderLots();
         bool is005Lot = (MathAbs(oLots - 0.05) < 0.000001 || (balancelomultipler > 1 && MathAbs(oLots - (0.05 * balancelomultipler)) < 0.000001));
         if(!is005Lot)
            continue;

         double oOpen = OrderOpenPrice();
         double dist = MathAbs(proposedEntryPrice - oOpen);
         if(dist < 100.0)
           {
            tooClose005Ticket = OrderTicket();
            tooClose005Price = oOpen;
            tooClose005Gap = dist;
            break;
           }
        }

      if(tooClose005Ticket > 0)
        {
         static datetime last005GapPrintTime = 0;
         if(TimeCurrent() - last005GapPrintTime >= 30)
           {
            last005GapPrintTime = TimeCurrent();
            Print("FLIPBasketSupport order blocked [Gate 0F]: Too close to open 0.05 lot order #", tooClose005Ticket,
                  " at ", DoubleToString(tooClose005Price, Digits),
                  " | Proposed Entry=", DoubleToString(proposedEntryPrice, Digits),
                  " | Gap=$", DoubleToString(tooClose005Gap, 2), " < Required Min $100.00.");
           }
         return -1;
        }
     } // End if(!ignoreAllGates)

   int targetOrderType = (flipDirection == 1) ? OP_BUY : OP_SELL;

// USER RULE: Separate maximum counts (BUY support order max is 1, SELL support order max is 1)
   if(HasOpenFLIPBasketSupportOrder(targetOrderType))
     {
      Print("FLIPBasketSupport order skipped: An active FLIPBasketSupport order in direction ", (targetOrderType == OP_BUY ? "BUY" : "SELL"), " is already open (Separate max is 1).");
      return -1;
     }

   RefreshRates();
   double flipLots = FLIPBasketSupportLot * (balancelomultipler > 0 ? balancelomultipler : 1);

// Booster & Method 2 lot enforcement for FLIPBasketSupport
   double boosterMinLot = (InpLsdBoosterMinLot > 0.0) ? InpLsdBoosterMinLot : 0.02;
   bool eqhR_active = (IsLsdSweepRedLinePresent() || GetEQR_R_Price(true) > 0.0);
   bool eqhG_active = (IsLsdSweepGreenLinePresent() || GetEQR_G_Price(true) > 0.0);

   if(flipDirection == 1) // BUY support order
     {
      // Method 1 booster (EQH-R + EMA -1)
      if(eqhR_active && EMADirection == -1 && flipLots < boosterMinLot)
         flipLots = boosterMinLot;

      // Method 2 booster (EQH-G + EMA ANY: min 0.02)
      if(eqhG_active && (InpLsdSupportMode == LSD_MODE_METHOD2_BOUNCE || InpLsdSupportMode == LSD_MODE_BOTH))
        {
         double m2BuyMin = InpLsdMethod2MinLotBase * (InpLsdMethod2BuyUsesMultiplier ? (balancelomultipler > 0 ? balancelomultipler : 1) : 1);
         if(flipLots < m2BuyMin)
            flipLots = m2BuyMin;
        }
     }
   else
      if(flipDirection == -1) // SELL support order
        {
         // Method 1 booster (EQH-G + EMA 1)
         if(eqhG_active && EMADirection == 1 && flipLots < boosterMinLot)
            flipLots = boosterMinLot;

         // Method 2 booster (EQH-R + EMA ANY: min 0.02Xmultiplier)
         if(eqhR_active && (InpLsdSupportMode == LSD_MODE_METHOD2_BOUNCE || InpLsdSupportMode == LSD_MODE_BOTH))
           {
            double m2SellMin = InpLsdMethod2MinLotBase * (balancelomultipler > 0 ? balancelomultipler : 1);
            if(flipLots < m2SellMin)
               flipLots = m2SellMin;
           }
        }

   flipLots = NormalizeLots(flipLots);

   int ticket = -1;
   string comment = "FLIPBasketSupport" + commentSuffix;

// Raw gap for pending stop order placement (like ProfitReEntryGapRaw)
   double pendingGap = (FLIPBasketSupportPendingGapRaw > 0.0) ? FLIPBasketSupportPendingGapRaw : ProfitReEntryGapRaw;
   if(pendingGap <= 0.0)
      pendingGap = 20.0;

   double minimumGap = GetRequiredStopDistance();

// Take profit set to raw BTC price distance
   double tpDist = (FLIPBasketSupportTakeProfitDistanceRaw > 0.0) ? FLIPBasketSupportTakeProfitDistanceRaw : 2000.0;

   if(flipDirection == 1) // FLIP to BUY -> Pending BUY STOP
     {
      int pendingType = OP_BUYSTOP;
      double entryPrice = Ask + pendingGap;
      if(entryPrice < Ask + minimumGap)
         entryPrice = Ask + minimumGap;
      entryPrice = NormalizeDouble(entryPrice, Digits);

      double slDistance = (FLIPBasketSupportStopLossRaw > 0.0) ? FLIPBasketSupportStopLossRaw : 200.0;
      double stopLoss = (slDistance > 0) ? NormalizeDouble(entryPrice - slDistance, Digits) : 0.0;
      double takeProfit = (tpDist > 0) ? NormalizeDouble(entryPrice + tpDist, Digits) : 0.0;

      ticket = SendFLIPBasketSupportOrder(pendingType, flipLots, entryPrice, stopLoss, takeProfit, comment, clrLime);
      if(ticket > 0)
        {
         g_lastActiveFLIPBasketSupportTicket = ticket;
         Print("FLIP BASKET SUPPORT PENDING ORDER CREATED: BUY STOP Ticket #", ticket, " Lots=", DoubleToString(flipLots, 2),
               " Entry=", DoubleToString(entryPrice, Digits), " (Ask+", DoubleToString(pendingGap, 2), ")",
               " SL=", DoubleToString(stopLoss, Digits), " TP=", DoubleToString(takeProfit, Digits), " (TPdist=", DoubleToString(tpDist, 2), ")");
        }
     }
   else
      if(flipDirection == -1) // FLIP to SELL -> Pending SELL STOP
        {
         int pendingType = OP_SELLSTOP;
         double entryPrice = Bid - pendingGap;
         if(entryPrice > Bid - minimumGap)
            entryPrice = Bid - minimumGap;
         entryPrice = NormalizeDouble(entryPrice, Digits);

         double slDistance = (FLIPBasketSupportStopLossRaw > 0.0) ? FLIPBasketSupportStopLossRaw : 200.0;
         double stopLoss = (slDistance > 0) ? NormalizeDouble(entryPrice + slDistance, Digits) : 0.0;
         double takeProfit = (tpDist > 0) ? NormalizeDouble(entryPrice - tpDist, Digits) : 0.0;

         ticket = SendFLIPBasketSupportOrder(pendingType, flipLots, entryPrice, stopLoss, takeProfit, comment, clrTomato);
         if(ticket > 0)
           {
            g_lastActiveFLIPBasketSupportTicket = ticket;
            Print("FLIP BASKET SUPPORT PENDING ORDER CREATED: SELL STOP Ticket #", ticket, " Lots=", DoubleToString(flipLots, 2),
                  " Entry=", DoubleToString(entryPrice, Digits), " (Bid-", DoubleToString(pendingGap, 2), ")",
                  " SL=", DoubleToString(stopLoss, Digits), " TP=", DoubleToString(takeProfit, Digits), " (TPdist=", DoubleToString(tpDist, 2), ")");
           }
        }

   if(ticket > 0)
     {
      g_flipBasketSupportCreatedInCycle++;
     }

   return ticket;
  }

//+------------------------------------------------------------------+
//| ManageFLIPBasketSupportTrailingStopLoss: Dedicated step-trailing |
//| StopLoss engine for FLIPBasketSupport AND Recovery orders.       |
//| Ratchets StopLoss forward on every 100 raw BTC step move after   |
//| the initial extra threshold (+25 raw -> +125 for Step 1):        |
//| Step 1 (+125 move): SL = openPrice +/- 25  (+25 profit locked)   |
//| Step 2 (+225 move): SL = openPrice +/- 125 (+125 profit locked)  |
//| Step 3 (+325 move): SL = openPrice +/- 225 (+225 profit locked)  |
//| Step N (+N*100+25): SL = openPrice +/- ((N-1)*100 + 25)          |
//| Respects broker MODE_STOPLEVEL / GetRequiredStopDistance().      |
//+------------------------------------------------------------------+
void ManageFLIPBasketSupportTrailingStopLoss()
  {
   if(!EAStartupComplete)
      return;
   if(FLIPBasketSupportTakeProfitDistanceStopLossStep <= 0.0)
      return;

   double stepSize = FLIPBasketSupportTakeProfitDistanceStopLossStep;
   if(stepSize <= 0.0)
      stepSize = 100.0;
   double extraMove = MathMax(0.0, FLIPBasketSupportTakeProfitStepExtraMoveRaw);
   double extraSL   = MathMax(0.0, FLIPBasketSupportTakeProfitStepExtraSLRaw);

   RefreshRates();
   double stopLevel = MarketInfo(Symbol(), MODE_STOPLEVEL) * Point;
   double spreadBuf = (Ask - Bid) * 1.5;
   double reqDistance = GetRequiredStopDistance();
   double minSafeDist = MathMax(reqDistance, MathMax(stopLevel, spreadBuf));
   if(minSafeDist < Point * 10.0)
      minSafeDist = Point * 10.0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      bool isFlipSupport = IsFLIPBasketSupportOrder(OrderTicket(), OrderComment());
      bool isRecovery    = IsAnyRecoveryOrder(OrderTicket(), OrderComment());

      if(!isFlipSupport && !isRecovery)
         continue;

      int ticket       = OrderTicket();
      int oType        = OrderType();
      double openPrice = OrderOpenPrice();
      double curSL     = OrderStopLoss();
      double curTP     = OrderTakeProfit();

      if(oType == OP_BUY)
        {
         double favorableMove = Bid - openPrice;
         if(favorableMove + (Point * 0.5) < (stepSize + extraMove))
            continue; // Not yet reached 1st step (+125)

         int steps = (int)MathFloor(((favorableMove - extraMove) + (Point * 0.5)) / stepSize);
         if(steps < 1)
            continue;

         // Step 1 (+125 move): targetSL = openPrice + 25  (+25 profit locked)
         // Step 2 (+225 move): targetSL = openPrice + 125 (+125 profit locked)
         // Step 3 (+325 move): targetSL = openPrice + 225 (+225 profit locked)
         // Step N (+N*100+25 move): targetSL = openPrice + ((N - 1) * stepSize + extraSL)
         double lockedDist = ((steps - 1) * stepSize) + extraSL;
         double targetSL   = NormalizeDouble(openPrice + lockedDist, Digits);

         // Broker safety: SL cannot be closer to Bid than minSafeDist
         if(targetSL > Bid - minSafeDist)
            targetSL = NormalizeDouble(Bid - minSafeDist, Digits);

         // Ratchet check: Only move SL forward (higher), never loosen
         if(curSL == 0.0 || targetSL > curSL + (Point * 0.5))
           {
            ResetLastError();
            bool modified = SafeOrderModify(ticket, openPrice, targetSL, curTP, 0, clrLimeGreen);
            double actualSL = curSL;
            if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
               actualSL = OrderStopLoss();
            if(!modified || (curSL == 0.0 && actualSL > 0.0) || actualSL > curSL + (Point * 0.5))
              {
               Print("Step-Trailing [", (isFlipSupport ? "FLIP_SUPPORT" : "RECOVERY"), "]: BUY #", ticket,
                     " Step=", steps, " (+", DoubleToString(favorableMove, 2), " pts)",
                     " | Prev SL=", DoubleToString(curSL, Digits),
                     " | New SL=", DoubleToString(actualSL, Digits),
                     " | Target SL=", DoubleToString(targetSL, Digits),
                     " | Success=", modified);
              }
           }
        }
      else
         if(oType == OP_SELL)
           {
            double favorableMove = openPrice - Ask;
            if(favorableMove + (Point * 0.5) < (stepSize + extraMove))
               continue; // Not yet reached 1st step (+125)

            int steps = (int)MathFloor(((favorableMove - extraMove) + (Point * 0.5)) / stepSize);
            if(steps < 1)
               continue;

            // Step 1 (+125 move): targetSL = openPrice - 25  (+25 profit locked)
            // Step 2 (+225 move): targetSL = openPrice - 125 (+125 profit locked)
            // Step 3 (+325 move): targetSL = openPrice - 225 (+225 profit locked)
            // Step N (+N*100+25 move): targetSL = openPrice - ((N - 1) * stepSize + extraSL)
            double lockedDist = ((steps - 1) * stepSize) + extraSL;
            double targetSL   = NormalizeDouble(openPrice - lockedDist, Digits);

            // Broker safety: SL cannot be closer to Ask than minSafeDist
            if(targetSL < Ask + minSafeDist)
               targetSL = NormalizeDouble(Ask + minSafeDist, Digits);

            // Ratchet check: Only move SL forward (lower), never loosen
            if(curSL == 0.0 || targetSL < curSL - (Point * 0.5))
              {
               ResetLastError();
               bool modified = SafeOrderModify(ticket, openPrice, targetSL, curTP, 0, clrTomato);
               double actualSL = curSL;
               if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
                  actualSL = OrderStopLoss();
               if(!modified || (curSL == 0.0 && actualSL > 0.0) || actualSL < curSL - (Point * 0.5))
                 {
                  Print("Step-Trailing [", (isFlipSupport ? "FLIP_SUPPORT" : "RECOVERY"), "]: SELL #", ticket,
                        " Step=", steps, " (+", DoubleToString(favorableMove, 2), " pts)",
                        " | Prev SL=", DoubleToString(curSL, Digits),
                        " | New SL=", DoubleToString(actualSL, Digits),
                        " | Target SL=", DoubleToString(targetSL, Digits),
                        " | Success=", modified);
                 }
              }
           }
     }
  }



// STREAMLINING CONTROL FLAGS:
bool   InpEnableEquityBalanceProfitTarget   = false;  // DISABLED: Prevents premature 25-cent clamp; Manage5PercentLadderReset handles equity targets
bool   InpEnableDynamicStepLadder           = false;  // DISABLED: Consolidated into master Manage5PercentLadderReset

// ===== 5 MULTI-ORDER COMBINATION & BASKET METHODS ($1*MULT PROFIT & $150 SL GAP) =====
// Method 2 & 3: Buy-Only & Sell-Only Basket Modifiers
bool   InpEnableModifyOnlyBuySellBasket     = false;//true;   // Method 2 & 3: Enable Buy-Only and Sell-Only basket trailing SL
double InpModifyOnlyBuySellSLGapUSD         = 100.0;  // Method 2 & 3: StopLoss gap in USD points ($150) for Buy/Sell basket

// Method 1: Multi-Order Combination Profit Live SL Modifier
bool   EnablePairProfitSLModify             =false;// true;   // Method 1: Enable Multi-Order Combination Profit Live SL Modifier
double PairCombinationProfitThresholdUSD    = 5;//1.0;    // Method 1: Base profit threshold in USD ($1.00)
double PairCombinationSLDistanceRaw         = 100.0;  // Method 1: StopLoss gap in USD points ($150)
bool   PairCombinationUseBalanceMultiplier  = true;   // Method 1: Scale threshold by balance multiplier (> $1.00 * multiplier)
bool   InpPairCombinationIncludeFlipBasket  = false;  // Method 1: Include FLIPBasketSupport orders in combinations

// Method 4: Combination Profit Handler (Modify SL with $150 gap or Close)
bool   InpEnableCombinationProfitClose      = true;   // Method 4: Enable multi-order combination profit handler (Option B: closes combinations > $5*mult at market)
double InpCombinationCloseProfitUSD         = 5.0;    // Method 4: Profit threshold in USD ($5.00 * multiplier)
bool   InpCombinationModifySLWithGap        = false;  // Method 4: Modify SL with $150 gap (true) or close directly at market (false)
double InpCombinationSLGapUSD               = 100.0;  // Method 4: StopLoss gap in USD points ($150)
bool   InpCombinationIncludeSingleOrders    = false;  // Method 4: Also close single orders at profit threshold (default false: combinations only)

// Method 5: Overall Hedged Basket Profit Modifier
bool   InpEnableOverallBasketProfitModify   =false;// true;   // Method 5: Enable overall hedged basket profit SL modifier
double InpOverallBasketProfitTargetUSD      = 5;//1.0;    // Method 5: Overall hedged basket profit target in USD ($1.00 * multiplier)
double InpOverallBasketSLGapUSD             = 100.0;  // Method 5: Overall hedged basket StopLoss gap in USD points ($150)

// Method 6: Multi-Order Combinations (> 2 orders, Profit or Loss mix) > $20 Profit SL Modifier
bool   InpEnableMethod6CombinationSLModify  = true;   // Method 6: Check combinations of >2 orders (profit/loss mix) > $20 profit
double InpMethod6ProfitThresholdUSD         = 5;//10;//20.0;   // Method 6: Base profit threshold in USD ($20.00 * multiplier)
double InpMethod6SLDistanceUSD              = 20.0;  // Method 6: StopLoss gap in USD points ($150)
int    InpMethod6MinOrderCount              = 2;      // Method 6: Minimum number of orders in combination (default 2 or 3)
bool   InpDrawMethod6HitIcon                = true;   // Method 6: Draw chart icon when combination profit threshold is hit
color  InpMethod6HitIconColor               = clrGold;// Method 6: Chart icon & text color
int    InpMethod6HitFontSize                = 10;     // Method 6: Chart icon text font size
int    InpMethod6HitIconCode                = 159;    // Method 6: Chart icon Wingdings code (159=circle dot, 171=star, 251=check)
void   DrawMethod6HitIcon(int orderCount, double comboProfit, datetime hitTime = 0, double hitPrice = 0.0);

// Universal Trend-Aware StopLoss Modifier (Applies across all order modify methods)
// User Rule:
// - BUY  & EMADirection ==  1 & EMA Strong -> use standard gap with existing logic
// - BUY  & (EMADirection == -1 || EMA Weak) -> tighten StopLoss to Live Price (Bid - minStopDist)
// - SELL & EMADirection == -1 & EMA Strong -> use standard gap with existing logic
// - SELL & (EMADirection ==  1 || EMA Weak) -> tighten StopLoss to Live Price (Ask + minStopDist)
bool   InpEnableEmaTrendAwareSL            = false;//true;  // Trend-Aware SL: Strong aligned uses gap; Counter/Weak EMA tightens to Live Price
double InpEmaTrendAwareLivePriceGapUSD     = 0.0;   // Live Price SL Buffer USD (0 = closest broker minStopDist, or custom buffer)

// USER RULE (VMULTI-1096): Double StopLoss gap (e.g. $150 -> $300) when MathAbs(EMAangle) > 3.0 and raw profit gap > $500.0 in profitable direction
bool   InpEnableDoubleSlGapOnSteepAngle    = true;  // Double SL gap (e.g. $150 -> $300) when MathAbs(EMAangle) > 3.0 & raw profit gap > $500
double InpDoubleSlGapAngle                 = 3.0;   // Minimum EMA angle (degrees) to double the SL gap (MathAbs(EMAangle) > 3.0)
double InpDoubleSlMinProfitGapRaw          = 350;//500.0; // Minimum raw price gap ($500.0) in profit direction (openprice - liveprice)
double InpDoubleSlGapMultiplier            = 2.0;   // Gap multiplier (default 2.0 = double gap $150 to $300)

// USER RULE (VMULTI-1105): EMA Angle > 4 Breakeven Extra -50 Raw Gap Breathing SL
bool   InpEnableEmaAngleBreakevenBreathing = true;   // When MathAbs(EMAangle) > 4: allow extra -50 raw gap when SL is at openPrice
double InpEmaAngleBreakevenBreathingAngle  = 4.0;    // Minimum MathAbs(EMAangle) threshold (default > 4.0)
double InpEmaAngleBreakevenBreathingGapRaw = 50.0;   // Extra raw price gap based on order price (-50.0 raw gap)

// USER RULE (VMULTI-1097): 50% Drawdown Relief StopLoss Tightening (Peak Drawdown >= $100)
bool   InpEnableDrawdownReliefTightenSL   = false;  // Disabled: Tighten Losing Order SL on 50% Drawdown Relief (RLF)
double InpDrawdownReliefMinPeakUSD        = 50;//100.0;  // Minimum peak drawdown in USD ($100 * mult) to qualify
double InpDrawdownReliefPercent           = 0.50;   // Drawdown reduction percentage from peak (50% = 0.50)
double InpDrawdownReliefSLGapUSD          = 50.0;   // SL cushion in USD ($50) behind relief market price for losing orders (Bid - 50 / Ask + 50)
bool   InpDrawdownReliefModifyWinningOrders = true;   // Also modify winning orders during Drawdown Relief
double InpDrawdownReliefWinningSLGapUSD     = 100.0;  // SL cushion in USD ($100) behind relief market price for winning orders (Bid - 100 / Ask + 100)
double InpDrawdownReliefMinPriceDiff2Hours =0;// 1000;//0;//1000;//2000.0; // Minimum price difference in raw USD from last 2 hours (> $2000)
double InpDrawdownReliefMinEmaAngle       =0;// 6.0;    // Minimum MathAbs(EMAangle) required to trigger relief SL (> 6.0 degrees)
double g_drawdownReliefPeakUSD            = 0.0;    // Highest floating drawdown (Balance - Equity) during current cycle
double g_drawdownReliefLastPeakUSD        = 0.0;    // Preserved peak drawdown for reporting when orders close
datetime g_drawdownReliefPeakTime         = 0;      // Time when peak drawdown was reached
bool   g_drawdownReliefArmed              = false;  // True when peak drawdown reached >= InpDrawdownReliefMinPeakUSD
bool   g_drawdownReliefExecuted           = false;  // True when relief SL tightening was executed for current cycle
void   Check50PctDrawdownReliefTightenSL();

// USER RULE (VMULTI-1098): Special Chart Icon for Drawdown Relief SL Hit / Applied
bool   InpDrawDrawdownReliefIcon           = true;    // Draw special chart icon when tight relief SL succeeds / is hit
color  InpDrawdownReliefIconColor          = clrGold; // Chart icon & text color for Drawdown Relief
int    InpDrawdownReliefIconCode           = 251;     // Chart icon Wingdings code (251=checkmark, 171=star, 159=dot, 238=shield)
int    InpDrawdownReliefFontSize           = 10;      // Chart icon text font size
void   DrawDrawdownReliefIcon(string iconType, int orderCount, double peakDD, double currentDD, double slGap, datetime hitTime = 0, double hitPrice = 0.0, int primaryTicket = 0);
