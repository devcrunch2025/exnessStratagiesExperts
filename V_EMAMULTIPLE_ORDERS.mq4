// ===== CUSTOM USER RULES SETTINGS =====
bool   InpEnableCustomRules      = true;
double InpPriceGapFromExtreme    = 100.0;
bool   InpEnableEmaAngleFilter   = false;
double InpMinEmaAngleDegrees     = 1.0;

// ===== DUBAI TIMEZONE SETTINGS =====
bool     EnableDubaiTradingPause             = true;
string   DubaiTradingPauseHours              = "";// "19,20";
int      ServerToDubaiOffsetHours            = 4;
bool     InpEnableDubaiNightOneSideCloseAll  = true;  // Close all open orders 1x/day when Dubai time is 11AM-4PM (11-16) and Buy==0 or Sell==0
int      InpDubaiNightCloseStartHour         = 11;    // Window start hour in Dubai time (11 = 11:00 AM inclusive)
int      InpDubaiNightCloseEndHour           = 16;    // Window end hour in Dubai time (16 = 4:00 PM exclusive; covers 11:00..15:59:59)
bool     InpEnableDubaiNightForceCloseAll    = true;  // If not triggered before 11:45 PM Dubai, force close ALL open orders at/after 11:45 PM
int      InpDubaiNightForceCloseHour         = 23;    // Fallback force close-all hour in Dubai time (23 = 11 PM)
int      InpDubaiNightForceCloseMinute       = 45;    // Fallback force close-all minute in Dubai time (45 = 11:45 PM)
bool     InpEnableDubaiNightEmaAngleFilter   = true;  // Require MathAbs(EMAangle) between Min & Max (0 to 1 deg) for one-side / 11:45PM triggers
double   InpDubaiNightMinEmaAngleDeg         = 0.0;   // Minimum allowed MathAbs(EMAangle30) inclusive (0.0 deg)
double   InpDubaiNightMaxEmaAngleDeg         = 1.0;   // Maximum allowed MathAbs(EMAangle30) inclusive (1.0 deg)
bool     InpEnableDubaiNightDayProfitClose   = true;  // OR after window start: close ALL open orders once/day if equity profit > 5% vs Dubai opening day equity
double   InpDubaiNightDayProfitPct           = 5.0;   // Required day profit % on opening day equity (> 5.0%, e.g. $500 -> >$525)
double   InpDubaiNightPartialCutPct          = 50.0;  // Path B before 11:45PM: partial-close 50% lots per order every 30 min (leaves minLot)
int      InpDubaiNightCutIntervalMinutes     = 60;    // Path B partial 50% lot cut interval in minutes (30 min)
int      g_dubaiNightCloseDayKey             = -1;    // Active Dubai calendar day key (Year*1000 + DayOfYear)
double   g_dubaiDayOpeningEquity             = 0.0;   // AccountEquity() captured at Dubai day start (00:00)
datetime g_dubaiNightLastCutTime             = 0;     // Broker TimeCurrent() of last Path B 50% lot cut pass
int      g_dubaiNightCutCountToday           = 0;     // Number of Path B 30-min 50% lot cut passes executed today
bool     g_dubaiNightCloseDoneToday          = false; // Daily final close-all execution latch (resets on next day start)
bool     g_dubaiNightCloseRetryPending       = false; // True if partial close had transient failure needing completion
datetime g_dubaiNightCloseLastHitTime        = 0;     // Broker TimeCurrent() when daily final close-all completed
string   g_dubaiNightLastCloseTag            = "";    // Latest full close trigger tag ("DAY>5%" or "23:45 ALL")
int      g_dubaiNightLastCloseOrders         = 0;     // Number of orders closed in latest full close-all
double   g_dubaiNightLastCloseLots           = 0.0;   // Total lots closed in latest full close-all
double   g_dubaiNightLastClosePL             = 0.0;   // Net realized P/L of latest full close-all
string   g_dubaiNightLastCutZeroSide         = "";    // Which side had 0 orders during latest 50% cut ("BUY"/"SELL")
int      g_dubaiNightLastCutOrders           = 0;     // Number of orders partial-cut in latest Path B pass
double   g_dubaiNightLastCutLots             = 0.0;   // Total lots partial-closed in latest Path B pass
double   g_dubaiNightLastCutPL               = 0.0;   // Estimated P/L of latest Path B pass
