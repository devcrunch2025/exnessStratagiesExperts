      if(orderType == OP_BUY || orderType == OP_BUYSTOP || orderType == OP_BUYLIMIT)
         takeProfit = NormalizeDouble(sendPrice + rawTPDist, Digits);
      else
         if(orderType == OP_SELL || orderType == OP_SELLSTOP || orderType == OP_SELLLIMIT)
            takeProfit = NormalizeDouble(sendPrice - rawTPDist, Digits);
     }
   double safeSL=stopLoss;
   if(safeSL<=0.0)
     {
      double rawSLDist = (StopLossRawPriceGap > 0.0) ? StopLossRawPriceGap : 2000.0;
      if(orderType == OP_BUY || orderType == OP_BUYSTOP || orderType == OP_BUYLIMIT)
         safeSL = NormalizeDouble(sendPrice - rawSLDist, Digits);
      else
         if(orderType == OP_SELL || orderType == OP_SELLSTOP || orderType == OP_SELLLIMIT)
            safeSL = NormalizeDouble(sendPrice + rawSLDist, Digits);
     }






   if(safeSL>0.0 && !PrepareStopLossForOrder(orderType,sendPrice,safeSL))
     {
      BlockTradeErrorUntilNextTick(key);
      MarkServerError(130,"OrderSend/unsafe-SL");
      return -1;
     }
   datetime requestTime=TimeCurrent();
   if(!CanSendTradeRequest("OrderSend",comment))
      return -1;
   ResetLastError();
   uint tradeStartMs=GetTickCount();
   int ticket=OrderSend(symbol,orderType,lots,sendPrice,slippage,safeSL,takeProfit,comment,magic,0,arrowColor);
   LogTradeTiming("OrderSend",tradeStartMs);
   if(ticket>0)
     {
      InvalidateTotalEAOrdersCache();
      RegisterPostOrderSLTPVerification(ticket,safeSL,takeProfit);
      return ticket;
     }
   int err=GetLastError();
   int existing=FindExistingOrderForRequest(orderType,lots,sendPrice,comment,requestTime);
   if(existing>0)
     {
      if(OrderSelect(existing,SELECT_BY_TICKET,MODE_TRADES))
         RegisterPostOrderSLTPVerification(existing,safeSL,takeProfit);
      ServerRecoveryPending=false;
      return existing;
     }
   BlockTradeErrorUntilNextTick(key);
   MarkServerError(err,"OrderSend");
   return -1;
  }
//+------------------------------------------------------------------+
//| Safely modify in-profit orders or close in-loss orders by ticket |
//+------------------------------------------------------------------+
bool SafeOrderCloseNew(int ticket, double lots, int orderType, int slippage, color arrowColor)
  {
   if(TradeOperationFailedThisTick)
      return false;

   string key = MakeTradeErrorKey("MANAGE", ticket, "");
   if(IsTradeErrorBlockedThisTick(key))
      return false;

   if(!OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
     {
      if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_HISTORY))
         return true; // Already closed
      return false;
     }

// Calculate total profit including commission and swap
   double totalProfit = OrderProfit() + OrderSwap() + OrderCommission();
   double openPrice = OrderOpenPrice();
   double currentTP = OrderTakeProfit();

   RefreshRates();

// --- BRANCH 1: IN PROFIT -> MODIFY STOP LOSS TO LOCK IN GAINS ---
   if(totalProfit >= 0)
     {
      double newStopLoss = 0;

      if(orderType == OP_BUY)
        {
         newStopLoss = Bid - (15 * Point);
         if(newStopLoss < openPrice)
            newStopLoss = openPrice + (2 * Point); // Ensure it locks in a slight profit above entry
        }
      else
         if(orderType == OP_SELL)
           {
            newStopLoss = Ask + (15 * Point);
            if(newStopLoss > openPrice)
               newStopLoss = openPrice - (2 * Point); // Ensure it locks in a slight profit below entry
           }

      newStopLoss = NormalizeDouble(newStopLoss, Digits);

      if(!CanSendTradeRequest("OrderModify", "Ticket=" + IntegerToString(ticket)))
         return false;

      ResetLastError();
      bool modResult =SafeOrderModify(ticket, openPrice, newStopLoss, currentTP, 0, arrowColor);

      if(modResult)
        {
         InvalidateTotalEAOrdersCache();
         return true;
        }

      int modErr = GetLastError();
      BlockTradeErrorUntilNextTick(key);
      MarkServerError(modErr, "OrderModify");
      return false;
     }
// --- BRANCH 2: IN LOSS -> CLOSE ORDER ---
   else
     {
      double closePrice = (orderType == OP_BUY) ? Bid : Ask;
      closePrice = NormalizeDouble(closePrice, Digits);

      if(!CanSendTradeRequest("OrderClose", "Ticket=" + IntegerToString(ticket)))
         return false;

      ResetLastError();
      bool closeResult = OrderClose(ticket, lots, closePrice, slippage, arrowColor);

      if(closeResult)
        {
         InvalidateTotalEAOrdersCache();
         return true;
        }

      int closeErr = GetLastError();
      if(!OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
        {
         if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_HISTORY))
            return true;
        }

      BlockTradeErrorUntilNextTick(key);
      MarkServerError(closeErr, "OrderClose");
      return false;
     }
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool SafeOrderClose(int ticket, double lots, int orderType, int slippage, color arrowColor)
  {
   if(TradeOperationFailedThisTick)
      return false;

   string key = MakeTradeErrorKey("CLOSE_MOD", ticket, "");
   if(IsTradeErrorBlockedThisTick(key))
      return false;

   if(!OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
     {
      // If it's already in history, the order is successfully closed
      if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_HISTORY))
         return true;
      return false;
     }

   RefreshRates();

// Server error condition: direct market close allowed ONLY on server error
   if(ServerRecoveryPending || !IsConnected())
     {
      return SafeOrderCloseMarket(ticket, lots, slippage, arrowColor);
     }

   double pl = OrderProfit() + OrderSwap() + OrderCommission();
   double openPrice = OrderOpenPrice();
   double currentSL = OrderStopLoss();
   double currentTP = OrderTakeProfit();
   double newSL = 0.0;

// Calculate safe stop limits to prevent Error 130
   double stopLevel = MarketInfo(Symbol(), MODE_STOPLEVEL) * Point;
   double spreadBuf = (Ask - Bid) * 2.0;
   double minSafeDistance = MathMax(stopLevel, spreadBuf);
   if(minSafeDistance < 10.0 * Point)
      minSafeDistance = 10.0 * Point;

// ==================================================================
// Modify order with Proportional Profit Ladder across ALL Lot Tiers
// ==================================================================
   double ladderSL = CalculateProportionalLadderSL(orderType, openPrice, lots);
   if(ladderSL > 0.0)
     {
      newSL = ladderSL;
     }
   else
     {
      // If before Level 1 step, protect 0 Loss (Breakeven) or breathing SL if currently in profit
      if((orderType == OP_BUY && Bid > openPrice) || (orderType == OP_SELL && Ask < openPrice))
        {
         newSL = GetEmaAngleBreakevenBreathingSL(orderType, openPrice, openPrice);
        }
      else
        {
         double rawPriceGap = GetLotBasedPriceGap(lots, balancelomultipler);
         newSL = (orderType == OP_BUY) ? (Bid - rawPriceGap) : (Ask + rawPriceGap);
        }
     }

   double slGapMin = GetEffectiveMinSLModifyGap();

   if(orderType == OP_BUY)
     {
      if(Bid - newSL < minSafeDistance)
         newSL = Bid - minSafeDistance;
      newSL = NormalizeDouble(newSL, Digits);

      if(currentSL > 0.0)
        {
         if(currentSL >= newSL)
            return true;
         if(newSL - currentSL < slGapMin)
            return true;
        }
     }
   else
      if(orderType == OP_SELL)
        {
         if(newSL - Ask < minSafeDistance)
            newSL = Ask + minSafeDistance;
         newSL = NormalizeDouble(newSL, Digits);

         if(currentSL > 0.0)
           {
            if(currentSL <= newSL)
               return true;
            if(currentSL - newSL < slGapMin)
               return true;
           }
        }
      else
        {
         return false;
        }

// Check if the SL is already at the target to prevent unnecessary modification spam
   if(MathAbs(currentSL - newSL) < Point / 2.0)
      return true;

// Final check against broker limits before sending
   if(orderType == OP_BUY && Bid - newSL < minSafeDistance)
      return false;
   if(orderType == OP_SELL && newSL - Ask < minSafeDistance)
      return false;

   if(!CanSendTradeRequest("OrderModify", "Ticket=" + IntegerToString(ticket)))
      return false;

   ResetLastError();

// Execute Modify instead of direct Close
   bool result = SafeOrderModify(ticket, openPrice, newSL, currentTP, 0, arrowColor);

   if(result)
     {
      InvalidateTotalEAOrdersCache();
      Print("SafeOrderClose: Modified SL with live price and $50 raw gap. Ticket: ", ticket, " | New SL: ", DoubleToString(newSL, Digits));
      return true;
     }

   int err = GetLastError();

   if(!OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
     {
      if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_HISTORY))
         return true;
     }

   BlockTradeErrorUntilNextTick(key);
   MarkServerError(err, "OrderModify (Intercepted from Close)");
   return false;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool SafeOrderCloseOld(int ticket,double lots,int orderType,int slippage,color arrowColor)
  {
   if(TradeOperationFailedThisTick)
      return false;
   string key=MakeTradeErrorKey("CLOSE",ticket,"");
   if(IsTradeErrorBlockedThisTick(key))
      return false;
   if(!OrderSelect(ticket,SELECT_BY_TICKET,MODE_TRADES))
     {
      if(OrderSelect(ticket,SELECT_BY_TICKET,MODE_HISTORY))
         return true;
      return false;
     }
   RefreshRates();
   double closePrice=(OrderType()==OP_BUY)?Bid:Ask;
   closePrice=NormalizeDouble(closePrice,Digits);
   if(!CanSendTradeRequest("OrderClose","Ticket="+IntegerToString(ticket)))
      return false;
   ResetLastError();
   bool result=OrderClose(ticket,OrderLots(),closePrice,slippage,arrowColor);
   if(result)
     {
      InvalidateTotalEAOrdersCache();
      return true;
     }
   int err=GetLastError();
   if(!OrderSelect(ticket,SELECT_BY_TICKET,MODE_TRADES))
     {
      if(OrderSelect(ticket,SELECT_BY_TICKET,MODE_HISTORY))
         return true;
     }
   BlockTradeErrorUntilNextTick(key);
   MarkServerError(err,"OrderClose");
   return false;
  }

//+------------------------------------------------------------------+
//| CalcOrderLockedProfitUSD                                         |
//| Calculates the dollar profit locked by a given Stop Loss price   |
//+------------------------------------------------------------------+
double CalcOrderLockedProfitUSD(int orderType, double openPrice, double slPrice, double lots)
  {
   if(slPrice <= 0.0 || lots <= 0.0)
      return 0.0;
   double tickValue = MarketInfo(Symbol(), MODE_TICKVALUE);
   double tickSize  = MarketInfo(Symbol(), MODE_TICKSIZE);
   if(tickSize <= 0.0)
      tickSize = Point;
   if(tickValue <= 0.0)
      tickValue = 1.0;

   double pointsDiff = (orderType == OP_BUY) ? (slPrice - openPrice) : (openPrice - slPrice);
   double profitUSD  = (pointsDiff / tickSize) * tickValue * lots;
   return profitUSD;
  }

//+------------------------------------------------------------------+
//| CanModifyStopLossForHigherProfit                                 |
//| GLOBAL PROFIT-LOCKING GUARD:                                     |
//| Ensures an order's StopLoss is NEVER modified with less profit.  |
//| If an order currently locks +$5 profit, any function attempting  |
//| to modify it with +$3 (or less) is BLOCKED.                      |
//| Only modifications that lock HIGHER profit (or reduce loss) are  |
//| permitted, preserving the highest secured profit at all times.   |
//+------------------------------------------------------------------+
bool CanModifyStopLossForHigherProfit(int ticket, double proposedSL, string callerName = "")
  {
   if(proposedSL <= 0.0)
      return false;

   if(!OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
      return false;

   int    oType     = OrderType();
   double oOpen     = OrderOpenPrice();
   double curSL     = OrderStopLoss();
   double oLots     = OrderLots();
   double normPropSL= NormalizeDouble(proposedSL, Digits);

// USER RULE: Orders secured by Equity Target Hit:
// "profit stoploss value ok. loss stoploss is not ok."
   if(IsEquityHitSecuredOrder(ticket) && callerName != "EquityTargetHit_LossTighten" && callerName != "DrawdownRelief50Pct" && StringFind(callerName, "Method") < 0)
     {
      bool isLossSL = (oType == OP_BUY && normPropSL < oOpen) || (oType == OP_SELL && normPropSL > oOpen);
      if(isLossSL)
        {
         // USER RULE (VMULTI-1105): Allow extra -50 raw gap breathing SL when MathAbs(EMAangle) > 4.0
         double beBreathing = GetEmaAngleBreakevenBreathingSL(oType, oOpen, oOpen);
         bool isAllowedBreathing = (InpEnableEmaAngleBreakevenBreathing &&
                                    ((oType == OP_BUY && normPropSL >= beBreathing) ||
                                     (oType == OP_SELL && normPropSL <= beBreathing)));
         if(!isAllowedBreathing)
           {
            Print(">>> [EQUITY HIT ORDER PROTECTED] Ticket #", ticket, " (", (oType == OP_BUY ? "BUY " : "SELL "),
                  DoubleToString(oLots, 2), "L) was secured by Equity Target Hit.",
                  " | Proposed SL=", DoubleToString(normPropSL, Digits),
                  " is a LOSS Stop Loss (Open=", DoubleToString(oOpen, Digits), ")",
                  (callerName != "" ? " | Caller=" + callerName : ""),
                  " | REJECTED: Rule: Only profit stoploss value is permitted, loss stoploss is NOT OK!");
            return false;
           }
        }
     }

// 1. If order currently has NO Stop Loss (0.0), any valid initial SL is permitted
   if(curSL <= 0.0)
      return true;

   curSL = NormalizeDouble(curSL, Digits);

// EXCEPTION: Emergency 90% SL Adverse Cut & SL Expansion (Only for emergency adverse halving)
   if(callerName == "Emergency90PercentSLCutPlus500SL" || callerName == "Emergency90PercentSLCutDoubleSL")
      return true;

// =========================================================================
// UNIVERSAL COMMON GATE BARRIER (APPLIES ACROSS ALL METHODS):
// USER RULE: "modify order with stoploss should not go back to (loss price)
// from the previous order stoploss modification. Applicable to all order
// modify with stoploss prices. Adjust logic for order type (BUY or SELL).
// Example: One method modified BUY order at $5 profit (floating profit is $10).
// Then another method tries to modify with $4 profit.
// BLOCK $4 order modification and continue. This is common gate barrier to all
// methods which call modify order with stoploss."
// =========================================================================

   double slGapMin = GetEffectiveMinSLModifyGap();

// 2. Evaluate BUY order: Must be strictly GREATER than curSL (above current SL)
   if(oType == OP_BUY)
     {
      // STRICT RULE: If proposed SL is below or equal to current SL, DO NOT ALLOW THIS!
      if(normPropSL <= curSL)
        {
         double curLockedUSD  = CalcOrderLockedProfitUSD(oType, oOpen, curSL, oLots);
         double propLockedUSD = CalcOrderLockedProfitUSD(oType, oOpen, normPropSL, oLots);

         Print(">>> [COMMON GATE BARRIER BLOCKED] Ticket #", ticket, " (BUY ", DoubleToString(oLots, 2), "L)",
               " | Current SL=", DoubleToString(curSL, Digits), " (Locks $", DoubleToString(curLockedUSD, 2), ")",
               " >= Proposed Worse SL=", DoubleToString(normPropSL, Digits), " (Locks $", DoubleToString(propLockedUSD, 2), ")",
               (callerName != "" ? " | Caller=" + callerName : ""),
               " | REJECTED: StopLoss cannot go backwards to less profit / worse price than previous modification!");
         return false;
        }

      // Enforce anti-spam minimum modify gap
      if((normPropSL - curSL) < slGapMin)
         return false;

      return true;
     }

// 3. Evaluate SELL order: Must be strictly LESS than curSL (below current SL)
   if(oType == OP_SELL)
     {
      // STRICT RULE: If proposed SL is above or equal to current SL, DO NOT ALLOW THIS!
      if(normPropSL >= curSL)
        {
         double curLockedUSD  = CalcOrderLockedProfitUSD(oType, oOpen, curSL, oLots);
         double propLockedUSD = CalcOrderLockedProfitUSD(oType, oOpen, normPropSL, oLots);

         Print(">>> [COMMON GATE BARRIER BLOCKED] Ticket #", ticket, " (SELL ", DoubleToString(oLots, 2), "L)",
               " | Current SL=", DoubleToString(curSL, Digits), " (Locks $", DoubleToString(curLockedUSD, 2), ")",
               " <= Proposed Worse SL=", DoubleToString(normPropSL, Digits), " (Locks $", DoubleToString(propLockedUSD, 2), ")",
               (callerName != "" ? " | Caller=" + callerName : ""),
               " | REJECTED: StopLoss cannot go backwards to less profit / worse price than previous modification!");
         return false;
        }

      // Enforce anti-spam minimum modify gap
      if((curSL - normPropSL) < slGapMin)
         return false;

      return true;
     }

   return false;
  }
//+------------------------------------------------------------------+
double GetTrendAwareStopLoss(int orderType, double standardGapUSD, double curSL = 0.0, string callerName = "", double orderProfit = 0.0, double openPrice = 0.0)
  {
   RefreshRates();
   double curBid = MarketInfo(Symbol(), MODE_BID);
   double curAsk = MarketInfo(Symbol(), MODE_ASK);
   double minStopDist = GetRequiredStopDistance();
   if(minStopDist < 20.0)
      minStopDist = 20.0;

   double gap = (standardGapUSD > 0.0) ? standardGapUSD : 150.0;
   if(gap < minStopDist)
      gap = minStopDist;

// USER RULE (VMULTI-1095): Double StopLoss gap (e.g. $150 -> $300) when MathAbs(EMAangle) > 3.0 and raw profit gap > $300.0
   double curAngle = GlobalEmaAngle30;
   if(curAngle == 0.0)
      curAngle = GetEmaAngleDegrees(30);

   double rawProfitGap = 0.0;
   if(openPrice > 0.0)
     {
      if(orderType == OP_BUY)
         rawProfitGap = curBid - openPrice;
      else
         if(orderType == OP_SELL)
            rawProfitGap = openPrice - curAsk;
     }

   bool isSteepAngle = (InpEnableDoubleSlGapOnSteepAngle && MathAbs(curAngle) > InpDoubleSlGapAngle);
   bool isProfitGapReached = (rawProfitGap > InpDoubleSlMinProfitGapRaw);

   if(isSteepAngle && isProfitGapReached)
     {
      double oldGap = gap;
      gap = gap * InpDoubleSlGapMultiplier;
      Print(">>> [DOUBLE SL GAP] MathAbs(EMAangle)=", DoubleToString(MathAbs(curAngle), 2),
            " > ", DoubleToString(InpDoubleSlGapAngle, 1),
            " deg & Raw Profit Gap=$", DoubleToString(rawProfitGap, 2),
            " > $", DoubleToString(InpDoubleSlMinProfitGapRaw, 2),
            " | Doubled SL gap from $", DoubleToString(oldGap, 2),
            " to $", DoubleToString(gap, 2), " (", callerName, ")");
     }

   if(!InpEnableEmaTrendAwareSL)
     {
      // If trend-aware SL is disabled, preserve standard gap logic
      if(orderType == OP_BUY)
        {
         double sl = NormalizeDouble(curBid - gap, Digits);
         if((curBid - sl) < minStopDist)
            sl = NormalizeDouble(curBid - minStopDist, Digits);
         if(openPrice > 0.0 && sl < openPrice && (isProfitGapReached || rawProfitGap > 0.0 || orderProfit > 0.0))
            sl = GetEmaAngleBreakevenBreathingSL(orderType, openPrice, openPrice, curAngle); // USER RULE (VMULTI-1105): Breakeven or breathing SL
         if(curSL > 0.0 && sl <= curSL)
            sl = curSL;
         return sl;
        }
      else
         if(orderType == OP_SELL)
           {
            double sl = NormalizeDouble(curAsk + gap, Digits);
            if((sl - curAsk) < minStopDist)
               sl = NormalizeDouble(curAsk + minStopDist, Digits);
            if(openPrice > 0.0 && sl > openPrice && (isProfitGapReached || rawProfitGap > 0.0 || orderProfit > 0.0))
               sl = GetEmaAngleBreakevenBreathingSL(orderType, openPrice, openPrice, curAngle); // USER RULE (VMULTI-1105): Breakeven or breathing SL
            if(curSL > 0.0 && sl >= curSL)
               sl = curSL;
            return sl;
           }
      return 0.0;
     }

   bool isEmaWeak = IsEmaWEAKDistanceReduced50PercentFromPeak(orderType);
   double liveBuffer = (InpEmaTrendAwareLivePriceGapUSD > minStopDist) ? InpEmaTrendAwareLivePriceGapUSD : minStopDist;
   double targetSL = 0.0;

   if(orderType == OP_BUY)
     {
      // Condition 1: BUY and EMADirection == 1 and EMA strong -> standard gap logic
      if(EMADirection == 1 && !isEmaWeak)
        {
         targetSL = NormalizeDouble(curBid - gap, Digits);
         if((curBid - targetSL) < minStopDist)
            targetSL = NormalizeDouble(curBid - minStopDist, Digits);
        }
      else
        {
         // Condition 2: BUY and (EMADirection == -1 or EMA weak) -> live price to avoid extra loss
         targetSL = NormalizeDouble(curBid - liveBuffer, Digits);
         if(curSL <= 0.0 || targetSL > curSL)
           {
            Print(">>> [TREND-AWARE SL] BUY", (callerName != "" ? " (" + callerName + ")" : ""),
                  ": EMA Dir=", EMADirection, ", Weak=", isEmaWeak,
                  " -> Setting SL to Live Price (Bid - ", DoubleToString(liveBuffer, Digits), ") = ",
                  DoubleToString(targetSL, Digits), " (Standard gap $", DoubleToString(gap, 2), " skipped to prevent loss)");
           }
        }

      // Ensure profit-locking order maintains at least Breakeven / breathing floor
      if(openPrice > 0.0 && targetSL < openPrice && isProfitGapReached)
         targetSL = GetEmaAngleBreakevenBreathingSL(orderType, openPrice, openPrice, curAngle);

      // Universal Ratchet: StopLoss can never go backwards from existing curSL
      if(curSL > 0.0 && targetSL <= curSL)
         targetSL = curSL;
     }
   else
      if(orderType == OP_SELL)
        {
         // Condition 1: SELL and EMADirection == -1 and EMA strong -> standard gap logic
         if(EMADirection == -1 && !isEmaWeak)
           {
            targetSL = NormalizeDouble(curAsk + gap, Digits);
            if((targetSL - curAsk) < minStopDist)
               targetSL = NormalizeDouble(curAsk + minStopDist, Digits);
           }
         else
           {
            // Condition 2: SELL and (EMADirection == 1 or EMA weak) -> live price to avoid extra loss
            targetSL = NormalizeDouble(curAsk + liveBuffer, Digits);
            if(curSL <= 0.0 || targetSL < curSL)
              {
               Print(">>> [TREND-AWARE SL] SELL", (callerName != "" ? " (" + callerName + ")" : ""),
                     ": EMA Dir=", EMADirection, ", Weak=", isEmaWeak,
                     " -> Setting SL to Live Price (Ask + ", DoubleToString(liveBuffer, Digits), ") = ",
                     DoubleToString(targetSL, Digits), " (Standard gap $", DoubleToString(gap, 2), " skipped to prevent loss)");
              }
           }

         // Ensure profit-locking order maintains at least Breakeven / breathing floor
         if(openPrice > 0.0 && targetSL > openPrice && isProfitGapReached)
            targetSL = GetEmaAngleBreakevenBreathingSL(orderType, openPrice, openPrice, curAngle);

         // Universal Ratchet: StopLoss can never go backwards from existing curSL
         if(curSL > 0.0 && targetSL >= curSL)
            targetSL = curSL;
        }

   return targetSL;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool SafeOrderModify(int ticket,double openPrice,double stopLoss,double takeProfit,datetime expiration,color arrowColor,string callerName = "")
  {
   if(TradeOperationFailedThisTick)
      return false;
   string key=MakeTradeErrorKey("MODIFY",ticket,"");
   if(IsTradeErrorBlockedThisTick(key))
      return false;
   if(!OrderSelect(ticket,SELECT_BY_TICKET,MODE_TRADES))
      return false;
   int orderType=OrderType();

   string comment = OrderComment();

   RefreshRates();
   double requestedSL = (stopLoss > 0.0) ? NormalizeDouble(stopLoss, Digits) : 0.0;
   double requestedTP = (takeProfit > 0.0) ? NormalizeDouble(takeProfit, Digits) : 0.0;

   if(requestedSL > 0.0)
     {
      // Proportional Profit Ladder Universal Alignment:
      // If an order is in profit and any method is modifying its SL above openPrice (BUY) or below openPrice (SELL),
      // ensure the SL aligns with the Proportional Profit Ladder schedule instead of choking the trade directly off live price!
      double oOpen = OrderOpenPrice();
      double oLots = OrderLots();
      double curNetPL = OrderProfit() + OrderSwap() + OrderCommission();
      bool isMethodCaller = (StringFind(callerName, "Method") >= 0 || callerName == "Emergency90PercentSLCutPlus500SL" || callerName == "Emergency90PercentSLCutDoubleSL");

      // USER RULE (VMULTI-1095 & VMULTI-1105): EMA angle calculation & Breakeven Breathing Floor
      double curEmaAng = GlobalEmaAngle30;
      if(curEmaAng == 0.0)
         curEmaAng = GetEmaAngleDegrees(30);

      double beFloor = GetEmaAngleBreakevenBreathingSL(orderType, oOpen, oOpen, curEmaAng);
      bool isSecuringProfit = (orderType == OP_BUY && requestedSL >= beFloor) || (orderType == OP_SELL && requestedSL <= beFloor);

      double rawProfitGap = (orderType == OP_BUY) ? (Bid - oOpen) : (oOpen - Ask);
      bool isProfitGapReached = (rawProfitGap > InpDoubleSlMinProfitGapRaw);
      bool isSteepAngle = (InpEnableDoubleSlGapOnSteepAngle && MathAbs(curEmaAng) > InpDoubleSlGapAngle);

      if(!isMethodCaller && isSecuringProfit && isSteepAngle && isProfitGapReached)
        {
         double liveGap = (orderType == OP_BUY) ? (Bid - requestedSL) : (requestedSL - Ask);
         if(liveGap > 0.0)
           {
            double doubledLiveGap = liveGap * InpDoubleSlGapMultiplier;
            if(doubledLiveGap > liveGap)
              {
               double existingSL = NormalizeDouble(OrderStopLoss(), Digits);
               if(orderType == OP_BUY)
                 {
                  double wideSL = NormalizeDouble(Bid - doubledLiveGap, Digits);
                  if(wideSL < beFloor)
                     wideSL = beFloor; // Maintain at least Breakeven / Breathing Floor
                  if(existingSL > 0.0 && wideSL <= existingSL)
                     wideSL = existingSL; // Common Gate Barrier: never downgrade existing SL
                  if(wideSL < requestedSL && (existingSL <= 0.0 || wideSL > existingSL))
                    {
                     Print(">>> [DOUBLE SL GAP IN SAFEMODIFY] BUY #", ticket, " Raw Profit Gap=$", DoubleToString(rawProfitGap, 2),
                           " | Doubled gap from $", DoubleToString(liveGap, 2), " to $", DoubleToString(doubledLiveGap, 2),
                           " | SL adjusted from ", DoubleToString(requestedSL, Digits), " to ", DoubleToString(wideSL, Digits),
                           " (MathAbs(EMAangle)=", DoubleToString(MathAbs(curEmaAng), 2), " > ", DoubleToString(InpDoubleSlGapAngle, 1), " deg)");
                     requestedSL = wideSL;
                    }
                 }
               else
                  if(orderType == OP_SELL)
                    {
                     double wideSL = NormalizeDouble(Ask + doubledLiveGap, Digits);
                     if(wideSL > beFloor)
                        wideSL = beFloor; // Maintain at least Breakeven / Breathing Floor
                     if(existingSL > 0.0 && wideSL >= existingSL)
                        wideSL = existingSL; // Common Gate Barrier: never downgrade existing SL
                     if(wideSL > requestedSL && (existingSL <= 0.0 || wideSL < existingSL))
                       {
                        Print(">>> [DOUBLE SL GAP IN SAFEMODIFY] SELL #", ticket, " Raw Profit Gap=$", DoubleToString(rawProfitGap, 2),
                              " | Doubled gap from $", DoubleToString(liveGap, 2), " to $", DoubleToString(doubledLiveGap, 2),
                              " | SL adjusted from ", DoubleToString(requestedSL, Digits), " to ", DoubleToString(wideSL, Digits),
                              " (MathAbs(EMAangle)=", DoubleToString(MathAbs(curEmaAng), 2), " > ", DoubleToString(InpDoubleSlGapAngle, 1), " deg)");
                        requestedSL = wideSL;
                       }
                    }
              }
           }
        }

      // USER RULE (VMULTI-1096 & VMULTI-1105): Clamped to Breakeven or extra -50 raw gap breathing SL when MathAbs(EMAangle) > 4
      if(isSteepAngle && isProfitGapReached)
        {
         if(orderType == OP_BUY && requestedSL < beFloor)
           {
            Print(">>> [LOSS MODIFICATION PREVENTED] BUY #", ticket, " requestedSL=", DoubleToString(requestedSL, Digits),
                  " clamped to floor=", DoubleToString(beFloor, Digits), " (Rule: Breakeven / Breathing Floor)");
            requestedSL = beFloor;
           }
         else
            if(orderType == OP_SELL && requestedSL > beFloor)
              {
               Print(">>> [LOSS MODIFICATION PREVENTED] SELL #", ticket, " requestedSL=", DoubleToString(requestedSL, Digits),
                     " clamped to floor=", DoubleToString(beFloor, Digits), " (Rule: Breakeven / Breathing Floor)");
               requestedSL = beFloor;
              }
        }

      if(!isMethodCaller && curNetPL > 0.0 && isSecuringProfit && !IsAnyRecoveryOrder(ticket, comment) && !IsFLIPBasketSupportOrder(ticket, comment))
        {
         double propLadderSL = CalculateProportionalLadderSL(orderType, oOpen, oLots);
         double curExistingSL = OrderStopLoss();
         if(propLadderSL > 0.0)
           {
            // If caller proposes an SL tighter than the ladder rung (e.g. Bid - 20),
            // align it with propLadderSL so the trade retains its full 1-gap breathing cushion!
            // Common Gate Barrier: never downgrade below existing StopLoss!
            if(orderType == OP_BUY && requestedSL > propLadderSL && (curExistingSL <= 0.0 || propLadderSL > curExistingSL))
              {
               Print(">>> [COMMON LADDER ENFORCED] BUY #", ticket, " (", DoubleToString(oLots, 2),
                     "L): Proposed SL=", DoubleToString(requestedSL, Digits),
                     " aligned to Proportional Ladder SL=", DoubleToString(propLadderSL, Digits),
                     " (Locks +$", DoubleToString(propLadderSL - oOpen, 2), " pts with breathing cushion)");
               requestedSL = propLadderSL;
              }
            else
               if(orderType == OP_SELL && requestedSL < propLadderSL && (curExistingSL <= 0.0 || propLadderSL < curExistingSL))
                 {
                  Print(">>> [COMMON LADDER ENFORCED] SELL #", ticket, " (", DoubleToString(oLots, 2),
                        "L): Proposed SL=", DoubleToString(requestedSL, Digits),
                        " aligned to Proportional Ladder SL=", DoubleToString(propLadderSL, Digits),
                        " (Locks +$", DoubleToString(oOpen - propLadderSL, 2), " pts with breathing cushion)");
                  requestedSL = propLadderSL;
                 }
           }
         else
           {
            // Order has not reached Level 1 gap yet (favorable move < stepPriceGap)
            // Clamp to Breakeven/Floor so liveprice modifications do not prematurely choke the trade before Level 1!
            // Common Gate Barrier: never downgrade below existing StopLoss!
            if(orderType == OP_BUY && requestedSL > beFloor && (curExistingSL <= 0.0 || beFloor > curExistingSL))
              {
               Print(">>> [COMMON LADDER ENFORCED] BUY #", ticket, " (", DoubleToString(oLots, 2),
                     "L): Proposed SL=", DoubleToString(requestedSL, Digits),
                     " clamped to Breakeven/Floor=", DoubleToString(beFloor, Digits),
                     " (Price has not reached Level 1 step gap yet)");
               requestedSL = beFloor;
              }
            else
               if(orderType == OP_SELL && requestedSL < beFloor && (curExistingSL <= 0.0 || beFloor < curExistingSL))
                 {
                  Print(">>> [COMMON LADDER ENFORCED] SELL #", ticket, " (", DoubleToString(oLots, 2),
                        "L): Proposed SL=", DoubleToString(requestedSL, Digits),
                        " clamped to Breakeven/Floor=", DoubleToString(beFloor, Digits),
                        " (Price has not reached Level 1 step gap yet)");
                  requestedSL = beFloor;
                 }
           }
        }

      // Universal Trend-Aware StopLoss Enforcement:
      // Rule: When InpEnableEmaTrendAwareSL is true, if BUY & (EMADirection==-1 || EMA Weak)
      //       or SELL & (EMADirection==1 || EMA Weak), tighten SL directly to Live Price to prevent extra loss.
      if(InpEnableEmaTrendAwareSL && callerName != "Emergency90PercentSLCutPlus500SL" && callerName != "Emergency90PercentSLCutDoubleSL")
        {
         bool isEmaWeak = IsEmaWEAKDistanceReduced50PercentFromPeak(orderType);
         double minStopDist = GetRequiredStopDistance();
         if(minStopDist < 20.0)
            minStopDist = 20.0;
         double liveBuffer = (InpEmaTrendAwareLivePriceGapUSD > minStopDist) ? InpEmaTrendAwareLivePriceGapUSD : minStopDist;

         double existingSL = OrderStopLoss();

         if(orderType == OP_BUY)
           {
            if(EMADirection == -1 || isEmaWeak)
              {
               double livePriceSL = NormalizeDouble(Bid - liveBuffer, Digits);
               // Strict One-Way Ratchet: Tighten only if higher than requestedSL AND higher than existing SL (never downgrade profit!)
               if(livePriceSL > requestedSL && (existingSL <= 0.0 || livePriceSL > existingSL))
                 {
                  Print(">>> [TREND-AWARE SL ENFORCED] SafeOrderModify BUY #", ticket,
                        (callerName != "" ? " (" + callerName + ")" : ""),
                        ": Counter/Weak EMA (EMADir=", EMADirection, ", Weak=", isEmaWeak,
                        ") - Tightened SL from ", DoubleToString(requestedSL, Digits),
                        " to Live Price SL=", DoubleToString(livePriceSL, Digits), " to avoid extra loss");
                  requestedSL = livePriceSL;
                 }
              }
           }
         else
            if(orderType == OP_SELL)
              {
               if(EMADirection == 1 || isEmaWeak)
                 {
                  double livePriceSL = NormalizeDouble(Ask + liveBuffer, Digits);
                  // Strict One-Way Ratchet: Tighten only if lower than requestedSL AND lower than existing SL (never downgrade profit!)
                  if((livePriceSL < requestedSL || requestedSL == 0.0) && (existingSL <= 0.0 || livePriceSL < existingSL))
                    {
                     Print(">>> [TREND-AWARE SL ENFORCED] SafeOrderModify SELL #", ticket,
                           (callerName != "" ? " (" + callerName + ")" : ""),
                           ": Counter/Weak EMA (EMADir=", EMADirection, ", Weak=", isEmaWeak,
                           ") - Tightened SL from ", DoubleToString(requestedSL, Digits),
                           " to Live Price SL=", DoubleToString(livePriceSL, Digits), " to avoid extra loss");
                     requestedSL = livePriceSL;
                    }
                 }
              }
        }

      // USER RULE (VMULTI-1105): "when mathabs EMAangle is morethan 4 , then allow order to modify extra -50 raw gap based on order price . add this in common method where new SL price is equal to orderopenprice and mathabs emaangle is more than 4"
      if(NormalizeDouble(requestedSL, Digits) == NormalizeDouble(oOpen, Digits))
        {
         double breathingSL = GetEmaAngleBreakevenBreathingSL(orderType, oOpen, requestedSL, curEmaAng);
         if(NormalizeDouble(breathingSL, Digits) != NormalizeDouble(requestedSL, Digits))
           {
            double curExistingSL = OrderStopLoss();
            // Common Gate Barrier: Only move forward (BUY: higher, SELL: lower) relative to existing SL
            if((orderType == OP_BUY && (curExistingSL <= 0.0 || breathingSL > curExistingSL)) ||
               (orderType == OP_SELL && (curExistingSL <= 0.0 || breathingSL < curExistingSL)))
              {
               Print(">>> [COMMON METHOD: BE SL TO BREATHING SL] Ticket #", ticket, " (", (orderType == OP_BUY ? "BUY" : "SELL"),
                     ") SL adjusted from openPrice ", DoubleToString(requestedSL, Digits),
                     " to Breathing SL ", DoubleToString(breathingSL, Digits),
                     " (extra -50 raw gap based on order price, MathAbs(EMAangle)=", DoubleToString(MathAbs(curEmaAng), 2),
                     " > ", DoubleToString(InpEmaAngleBreakevenBreathingAngle, 1), " deg)");
               requestedSL = breathingSL;
              }
           }
        }

      if(!PrepareStopLossForOrder(orderType, OrderOpenPrice(), requestedSL))
        {
         BlockTradeErrorUntilNextTick(key);
         MarkServerError(130, "OrderModify/unsafe-SL");
         return false;
        }
      if(!CanModifyStopLossForHigherProfit(ticket, requestedSL, (callerName != "" ? callerName : comment)))
        {
         return false;
        }
     }
   else
      if(requestedSL <= 0.0 && OrderStopLoss() > 0.0)
        {
         double curLockedUSD = CalcOrderLockedProfitUSD(orderType, OrderOpenPrice(), OrderStopLoss(), OrderLots());
         if(curLockedUSD > 0.0)
           {
            Print(">>> [ZERO SL BLOCKED] Ticket #", ticket, " currently locks +$", DoubleToString(curLockedUSD, 2), " profit. Cannot remove SL!");
            return false;
           }
        }
   double slGapMin = GetEffectiveMinSLModifyGap();
   bool sameSL = (requestedSL <= 0.0 && OrderStopLoss() <= 0.0) || (requestedSL > 0.0 && MathAbs(OrderStopLoss() - requestedSL) < slGapMin);
   bool sameTP = (requestedTP <= 0.0 && OrderTakeProfit() <= 0.0) || (requestedTP > 0.0 && MathAbs(OrderTakeProfit() - requestedTP) <= Point);
   if(sameSL && sameTP)
      return true;

   bool modified = false;
   int err = 0;
   int maxAttempts = 3;

   for(int attempt = 0; attempt < maxAttempts; attempt++)
     {
      ResetLastError();
      if(!CanSendTradeRequest("OrderModify", "Ticket=" + IntegerToString(ticket)))
         return false;

      modified = OrderModify(ticket, openPrice, requestedSL, requestedTP, expiration, arrowColor);
      if(modified)
         return true;

      err = GetLastError();

      // Retry on transient broker quote errors (136 Off Quotes, 138 Requote, 135 Price Changed, 137 Broker Busy, 146 Context Busy)
      if(err == 136 || err == 138 || err == 135 || err == 137 || err == 146)
        {
         Sleep(100);
         RefreshRates();

         // Re-validate and adapt SL distance if live price moved
         if(requestedSL > 0.0)
           {
            if(!PrepareStopLossForOrder(orderType, OrderOpenPrice(), requestedSL))
               break;
           }
         continue;
        }

      // Non-retryable error
      break;
     }

   if(!modified)
     {
      Print("ORDER MODIFY FAILED with server error ", err, " on Ticket #", ticket,
            " (Type=", GetOrderTypeText(orderType), "). Closing order immediately at market as requested...");

      if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
        {
         double curLots = OrderLots();
         int curType = OrderType();

         if(curType == OP_BUY || curType == OP_SELL)
           {
            for(int cAttempt = 0; cAttempt < 3; cAttempt++)
              {
               RefreshRates();
               double closePrice = (curType == OP_BUY) ? Bid : Ask;
               closePrice = NormalizeDouble(closePrice, Digits);
               ResetLastError();
               bool closed = OrderClose(ticket, curLots, closePrice, Slippage, (curType == OP_BUY ? clrRed : clrBlue));
               if(closed)
                 {
                  Print("ORDER CLOSED SUCCESSFULLY on modify error fallback: Ticket #", ticket,
                        " at ", DoubleToString(closePrice, Digits));
                  InvalidateTotalEAOrdersCache();
                  break;
                 }
               int closeErr = GetLastError();
               Print("OrderClose fallback attempt ", (cAttempt + 1), " failed for Ticket #", ticket, " | Error=", closeErr);
               Sleep(100);
              }
           }
         else
            if(curType == OP_BUYSTOP || curType == OP_SELLSTOP || curType == OP_BUYLIMIT || curType == OP_SELLLIMIT)
              {
               ResetLastError();
               bool deleted = OrderDelete(ticket, clrYellow);
               if(deleted)
                 {
                  Print("PENDING ORDER DELETED on modify error fallback: Ticket #", ticket);
                  InvalidateTotalEAOrdersCache();
                 }
              }
        }
      else
        {
         Print("Order #", ticket, " no longer open in MODE_TRADES (already closed).");
        }

      BlockTradeErrorUntilNextTick(key);
      MarkServerError(err, "OrderModify");
      return false;
     }

   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool ReducePendingOrderLotTo01() { return true; }
bool ForceDeletePendingOrder(int ticket,color arrowColor) { return SafeOrderDelete(ticket, arrowColor); }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool SafeOrderDelete(int ticket,color arrowColor)
  {
   if(TradeOperationFailedThisTick)
      return false;
   string key=MakeTradeErrorKey("DELETE",ticket,"");
   if(IsTradeErrorBlockedThisTick(key))
      return false;
   if(!OrderSelect(ticket,SELECT_BY_TICKET,MODE_TRADES))
      return true;
   int ageSeconds=(int)(TimeCurrent()-OrderOpenTime());
   int requiredAgeSeconds =0;// 6*60*60;
   if(ageSeconds < requiredAgeSeconds)
      return false;
   if(!CanSendTradeRequest("OrderDelete","Ticket="+IntegerToString(ticket)))
      return false;
   ResetLastError();
   bool result=OrderDelete(ticket,arrowColor);
   if(result)
      return true;
   int err=GetLastError();
   if(!OrderSelect(ticket,SELECT_BY_TICKET,MODE_TRADES))
      return true;
   BlockTradeErrorUntilNextTick(key);
   MarkServerError(err,"OrderDelete");
   return false;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| Get direction for any specified timeframe based on current bar   |
//+------------------------------------------------------------------+
int GetCurrentMDirection(int timeframe)
  {
   double openPrice  = iOpen(Symbol(), timeframe, 0);
   double closePrice = iClose(Symbol(), timeframe, 0);

   if(openPrice <= 0.0 || closePrice <= 0.0)
      return 0;

   if(closePrice > openPrice)
      return 1;
   if(closePrice < openPrice)
      return -1;

   return 0;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int GetCurrentM30Direction()
  {
   double m30Open  = iOpen(Symbol(), PERIOD_M30, 0);
   double m30Close = iClose(Symbol(), PERIOD_M30, 0);

   if(m30Open <= 0.0 || m30Close <= 0.0)
      return 0;

   if(m30Close > m30Open)
      return 1;
   if(m30Close < m30Open)
      return -1;

   return 0;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int GetM5Direction()
  {
   int candles = M5ConfirmationCandles;
   if(candles < 1)
      candles = 1;
   if(candles > 5)
      candles = 5;
   int bullish = 0, bearish = 0;
   for(int shift=1; shift<=candles; shift++)
     {
      double m5Open  = iOpen(Symbol(), PERIOD_M5, shift);
      double m5Close = iClose(Symbol(), PERIOD_M5, shift);
      if(m5Open <= 0.0 || m5Close <= 0.0)
         continue;
      if(m5Close > m5Open)
         bullish++;
      else
         if(m5Close < m5Open)
            bearish++;
     }
   if(bullish > bearish && bullish >= (candles/2 + 1))
      return 1;
   if(bearish > bullish && bearish >= (candles/2 + 1))
      return -1;
   return 0;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double GetM5CandleATRRatio()
  {
   if(!EnableATRVolatilityProtection)
      return 0.0;
   int tf = ATRVolatilityTimeframe;
   if(tf <= 0)
      tf = PERIOD_M5;
   int period = ATRVolatilityPeriod;
   if(period < 2)
      period = 2;
   double high1 = iHigh(Symbol(), tf, 1);
   double low1  = iLow(Symbol(), tf, 1);
   double atr1  = iATR(Symbol(), tf, period, 1);
   if(high1 <= 0.0 || low1 <= 0.0 || atr1 <= 0.0)
      return 0.0;
   return (high1-low1)/atr1;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsExtremeVolatility()
  {
   if(!EnableATRVolatilityProtection)
      return false;
   double ratio = GetM5CandleATRRatio();
   double limit = MathMax(0.1, MaxCandleRangeATRMultiple);
   return (ratio > limit);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double GetMarketMomentLot(int orderType)
  {
   if(orderType != OP_BUY && orderType != OP_SELL)
      return NormalizeLots(OriginalLots);
   int sslDirection = GlobalSSLDirection;
   int requestedDirection = (orderType == OP_BUY) ? 1 : -1;
   if(sslDirection != requestedDirection)
      return NormalizeLots(0.01);
   int h1Direction = GetH1Direction();
   bool h1Aligned = (h1Direction == requestedDirection);
   bool h1Opposite = (h1Direction == -requestedDirection);
   int m5Direction = GetM5Direction();
   bool m5Aligned = (m5Direction == requestedDirection);
   int emaShift = InpEMAPriceShift;
   if(emaShift < 0)
      emaShift = 0;
   int chartBars = iBars(Symbol(), Period());
   if(chartBars <= 0)
      chartBars = Bars;
   if(emaShift >= chartBars)
      emaShift = chartBars - 1;
   double ema = iMA(Symbol(), Period(), InpEMA200Period, 0, MODE_EMA, PRICE_CLOSE, emaShift);
   RefreshRates();
   double emaPrice = (emaShift == 0) ? ((orderType == OP_BUY) ? Ask : Bid) : iClose(Symbol(), Period(), emaShift);
   int emaDirection = 0;
   if(ema > 0.0 && emaPrice > 0.0)
     {
      if(emaPrice > ema)
         emaDirection = 1;
      else
         if(emaPrice < ema)
            emaDirection = -1;
     }
   bool emaAligned = (emaDirection == requestedDirection);
   double momentumDiff = (orderType == OP_BUY) ? Global30MinDiffBuy : Global30MinDiffSell;
   double momentumThreshold = MathAbs(Min30MinutePriceDifference);
   bool momentumAligned = false;
   if(orderType == OP_BUY)
      momentumAligned = (momentumDiff > momentumThreshold);
   else
      momentumAligned = (momentumDiff < -momentumThreshold);
   int confirmationScore = 0;
   if(h1Aligned)
      confirmationScore++;
   if(m5Aligned)
      confirmationScore++;
   if(emaAligned)
      confirmationScore++;
   if(momentumAligned)
      confirmationScore++;

   double lot = 0.01;
   if(confirmationScore == 1)
      lot = 0.01;
   else
      if(confirmationScore == 2)
         lot = 0.03;
      else
         if(confirmationScore == 3)
            lot = 0.06;
         else
            if(confirmationScore >= 4)
               lot = 0.10;

   if(CapLotWhenH1Opposite && h1Opposite)
      lot = MathMin(lot, 0.01);
   bool extremeVolatility = IsExtremeVolatility();
   if(extremeVolatility)
      lot = MathMin(lot, MathAbs(VolatilityLotCap));

   int dayOfWeek = TimeDayOfWeek(TimeCurrent());
   if(dayOfWeek == 0 || dayOfWeek == 6)
      lot = MathMin(lot, 0.02);
   return NormalizeLots(lot);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsSameLotOrderNearBy(int orderType, double checkLot, double gapRawThreshold)
  {
   RefreshRates();
   double currentPrice = (orderType == OP_BUY || orderType == OP_BUYSTOP || orderType == OP_BUYLIMIT) ? Ask : Bid;

   bool isBuyDirection  = (orderType == OP_BUY  || orderType == OP_BUYSTOP  || orderType == OP_BUYLIMIT);
   bool isSellDirection = (orderType == OP_SELL || orderType == OP_SELLSTOP || orderType == OP_SELLLIMIT);

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int existingType = OrderType();
      bool existingIsBuy  = (existingType == OP_BUY  || existingType == OP_BUYSTOP  || existingType == OP_BUYLIMIT);
      bool existingIsSell = (existingType == OP_SELL || existingType == OP_SELLSTOP || existingType == OP_SELLLIMIT);

      if(isBuyDirection && !existingIsBuy)
         continue;
      if(isSellDirection && !existingIsSell)
         continue;

      if(MathAbs(OrderLots() - checkLot) > 0.00001)
         continue;

      double distance = MathAbs(currentPrice - OrderOpenPrice());
      if(distance < gapRawThreshold)
        {
         Print("NEARBY ORDER DETECTED | Ticket: ", OrderTicket(), " | Gap: ", DoubleToString(distance, Digits));
         return true;
        }
     }
   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double CalculateDecreaseLots(int reEntryCounter, double startLot, double endLot)
  {
   if(reEntryCounter < 0)
      reEntryCounter = 0;
   int totalSteps = (int)MathRound((startLot - endLot) / 0.01) + 1;
   if(totalSteps <= 0)
      return startLot;
   int currentStep = reEntryCounter % totalSteps;
   double calculatedLots = startLot - (currentStep * 0.01);
   return NormalizeDouble(calculatedLots, 2);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double CalculateIncreaseLots(int reEntryCounter, double startLot, double endLot)
  {
   if(reEntryCounter < 0)
      reEntryCounter = 0;
   int totalSteps = (int)MathRound((endLot - startLot) / 0.01) + 1;
   if(totalSteps <= 0)
      return startLot;
   int currentStep = reEntryCounter % totalSteps;
   double calculatedLots = startLot + (currentStep * 0.01);
   return NormalizeDouble(calculatedLots, 2);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool CheckFastProfitableRecentOrders()
  {
   int validCount = 0;
   int checkedOrders = 0;
   for(int i = OrdersHistoryTotal() - 1; i >= 0; i--)
     {
      if(checkedOrders >= 2)
         break;
      if(OrderSelect(i, SELECT_BY_POS, MODE_HISTORY))
        {
         if(OrderSymbol() == Symbol() && OrderMagicNumber() == MagicNumber)
           {
            if(OrderType() == OP_BUY || OrderType() == OP_SELL)
              {
               double totalProfit = OrderProfit() + OrderSwap() + OrderCommission();
               int durationSeconds = (int)(OrderCloseTime() - OrderOpenTime());
               if(totalProfit > 0.0 && durationSeconds < 30)
                  validCount++;
               checkedOrders++;
              }
           }
        }
     }
   return (checkedOrders == 2 && validCount == 2);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool DetectBounceback(int direction, int shift)
  {
   if(EnableBounceBackDetection == false)
      return false; // Disable bounceback detection for now
   double ema = iMA(Symbol(), Period(), InpEMA200Period, 0, MODE_EMA, PRICE_CLOSE, shift);
   double c = Close[shift];
   double o = Open[shift];
   double atr = iATR(Symbol(), Period(), 14, shift);
   double distanceFromEMA = MathAbs(c - ema);
   double extremeDistance = atr * 4.0;
   double strongCandleBody = atr * 1.5;

   if(direction == 1)
     {
      if(c < ema && distanceFromEMA > extremeDistance)
        {
         if(c > o && (c - o) > strongCandleBody)
            return true;
        }
     }
   else
      if(direction == -1)
        {
         if(c > ema && distanceFromEMA > extremeDistance)
           {
            if(c < o && (o - c) > strongCandleBody)
               return true;
           }
        }
   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void DrawBouncebackIcon(datetime time, double price, int direction)
  {
   string objName = "BOUNCE_BOX_" + IntegerToString((int)time);
   if(ObjectFind(0, objName) < 0)
     {
      // 1. Width: 5 Minutes (300 seconds)
      datetime endTime = time + (5 * 60);

      // 2. Dynamic Height: Use 50% of the current average candle size
      // This guarantees the box is always visually proportionate to the asset
      double visibleHeight = iATR(Symbol(), Period(), 14, 1) * 0.5;

      double topPrice = 0.0;
      double bottomPrice = 0.0;

      if(direction == 1)
        {
         // Bullish (Green): Box anchors at price and extends UP
         bottomPrice = price;
         topPrice = price + visibleHeight*5;
        }
      else
        {
         // Bearish (Red): Box anchors at price and extends DOWN
         topPrice = price;
         bottomPrice = price - visibleHeight*5;
        }

      ObjectCreate(0, objName, OBJ_RECTANGLE, 0, time, topPrice, endTime, bottomPrice);

      // 3. Properties
      ObjectSetInteger(0, objName, OBJPROP_COLOR, (direction == 1) ? clrGreen : clrRed);
      ObjectSetInteger(0, objName, OBJPROP_BACK, true);
      ObjectSetInteger(0, objName, OBJPROP_FILL, true);
      ObjectSetInteger(0, objName, OBJPROP_SELECTABLE, false);
      // ObjectSetInteger(0, objName, OBJPROP_HIDDEN, true);
      ObjectSetString(0, objName, OBJPROP_TOOLTIP, (direction == 1) ? "Bullish Bounce Block" : "Bearish Bounce Block");
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void DrawHistoricalBouncebacks()
  {
   int lookback = MathMin(1000, Bars - 1);
   for(int i = lookback; i >= 1; i--)
     {
      if(DetectBounceback(1, i))
         DrawBouncebackIcon(Time[i], Low[i] - (50 * Point), 1);
      if(DetectBounceback(-1, i))
         DrawBouncebackIcon(Time[i], High[i] + (50 * Point), -1);
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsBounceOne(int shift, int direction, double minReversalPrice)
  {
   double c0 = Close[shift],   o0 = Open[shift],   h0 = High[shift],   l0 = Low[shift];
   double c1 = Close[shift+1], o1 = Open[shift+1], h1 = High[shift+1], l1 = Low[shift+1];

   if(direction == 1)
     {
      if(c1 < o1 && c0 > o0)
        {
         if((c0 - l0) >= minReversalPrice && c0 > h1)
            return true;
        }
     }
   else
      if(direction == -1)
        {
         if(c1 > o1 && c0 < o0)
           {
            if((h0 - c0) >= minReversalPrice && c0 < l1)
               return true;
           }
        }
   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsDoubleTap(int shift, int direction, int lookback, double tolerancePrice)
  {
   int minSwingBars = 3;

   if(direction == 1)
     {
      double currentLow = Low[shift];
      int prevLowIdx = iLowest(Symbol(), Period(), MODE_LOW, lookback, shift + minSwingBars);
      if(prevLowIdx == -1)
         return false;

      if(MathAbs(currentLow - Low[prevLowIdx]) <= tolerancePrice)
        {
         if(Close[shift] > Open[shift])
            return true;
        }
     }
   else
      if(direction == -1)
        {
         double currentHigh = High[shift];
         int prevHighIdx = iHighest(Symbol(), Period(), MODE_HIGH, lookback, shift + minSwingBars);
         if(prevHighIdx == -1)
            return false;

         if(MathAbs(currentHigh - High[prevHighIdx]) <= tolerancePrice)
           {
            if(Close[shift] < Open[shift])
               return true;
           }
        }
   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsDoubleBottom(int shift, int lookback, double tolerancePrice)
  {
   int searchHalf = lookback / 2;
   int minSwingBars = 5;

   int low2Idx = iLowest(Symbol(), Period(), MODE_LOW, searchHalf, shift + 1);
   if(low2Idx == -1)
      return false;

   int low1Idx = iLowest(Symbol(), Period(), MODE_LOW, searchHalf, low2Idx + minSwingBars);
   if(low1Idx == -1)
      return false;

   int necklineIdx = iHighest(Symbol(), Period(), MODE_HIGH, (low1Idx - low2Idx), low2Idx + 1);
   if(necklineIdx == -1)
      return false;

   double neckline = High[necklineIdx];

   if(MathAbs(Low[low1Idx] - Low[low2Idx]) <= tolerancePrice)
     {
      if(Close[shift+1] <= neckline && Close[shift] > (neckline + (tolerancePrice * 0.25)))
         return true;
     }
   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsDoubleTop(int shift, int lookback, double tolerancePrice)
  {
   int searchHalf = lookback / 2;
   int minSwingBars = 5;

   int high2Idx = iHighest(Symbol(), Period(), MODE_HIGH, searchHalf, shift + 1);
   if(high2Idx == -1)
      return false;

   int high1Idx = iHighest(Symbol(), Period(), MODE_HIGH, searchHalf, high2Idx + minSwingBars);
   if(high1Idx == -1)
      return false;

   int necklineIdx = iLowest(Symbol(), Period(), MODE_LOW, (high1Idx - high2Idx), high2Idx + 1);
   if(necklineIdx == -1)
      return false;

   double neckline = Low[necklineIdx];

   if(MathAbs(High[high1Idx] - High[high2Idx]) <= tolerancePrice)
     {
      if(Close[shift+1] >= neckline && Close[shift] < (neckline - (tolerancePrice * 0.25)))
         return true;
     }
   return false;
  }

