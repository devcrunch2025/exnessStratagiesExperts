//+------------------------------------------------------------------+
//| Preserved Comment Mapping Registry for Partial Closes            |
//| Preserves original "RECOVERY_XXXXX" prefix across MT4 "from #"   |
//| child tickets generated by OrderClose()                          |
//+------------------------------------------------------------------+
struct PreservedCommentMapping
  {
   int               ticket;
   string            comment;
  };
PreservedCommentMapping g_orderCommentRegistry[500];
int g_orderCommentRegistryCount = 0;

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void RegisterPreservedOrderComment(int ticket, string comment)
  {
   if(ticket <= 0 || comment == "")
      return;
   for(int i = 0; i < g_orderCommentRegistryCount; i++)
     {
      if(g_orderCommentRegistry[i].ticket == ticket)
        {
         g_orderCommentRegistry[i].comment = comment;
         return;
        }
     }
   if(g_orderCommentRegistryCount < 500)
     {
      g_orderCommentRegistry[g_orderCommentRegistryCount].ticket = ticket;
      g_orderCommentRegistry[g_orderCommentRegistryCount].comment = comment;
      g_orderCommentRegistryCount++;
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
string GetPreservedOrderComment(int ticket)
  {
   if(ticket <= 0)
      return "";
   for(int i = 0; i < g_orderCommentRegistryCount; i++)
     {
      if(g_orderCommentRegistry[i].ticket == ticket)
         return g_orderCommentRegistry[i].comment;
     }
   return "";
  }

//+------------------------------------------------------------------+
//| GetEffectiveOrderComment: Resolves preserved or root comment     |
//| so partial close child orders retain their RECOVERY_XXXXX prefix |
//+------------------------------------------------------------------+
string GetEffectiveOrderComment(int ticket, string comment = "")
  {
   string curComment = comment;
   if(curComment == "")
     {
      if(OrderTicket() == ticket)
         curComment = OrderComment();
      else
         if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
            curComment = OrderComment();
         else
            if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_HISTORY))
               curComment = OrderComment();
     }

// 1. If raw comment already contains RECOVERY_, register and return it
   if(StringFind(curComment, "RECOVERY_") >= 0)
     {
      RegisterPreservedOrderComment(ticket, curComment);
      return curComment;
     }

// 2. Check internal preserved comment registry
   string preserved = GetPreservedOrderComment(ticket);
   if(preserved != "")
      return preserved;

// 3. Resolve root comment across "from #" history
   if(StringFind(curComment, "from #") >= 0)
     {
      string rootCmt = GetRootOrderComment(ticket, curComment);
      if(StringFind(rootCmt, "RECOVERY_") >= 0)
        {
         RegisterPreservedOrderComment(ticket, rootCmt);
         return rootCmt;
        }
      return rootCmt;
     }

   return curComment;
  }

//+------------------------------------------------------------------+
//| IsAnyRecoveryOrder: Returns true if order is a recovery order    |
//| even if MT4 partial close changed comment to "from #xxxxx"       |
//+------------------------------------------------------------------+
bool IsAnyRecoveryOrder(int ticket, string comment = "")
  {
   string curComment = comment;
   if(curComment == "")
     {
      if(OrderTicket() == ticket)
         curComment = OrderComment();
      else
         if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
            curComment = OrderComment();
         else
            if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_HISTORY))
               curComment = OrderComment();
     }

   if(StringFind(curComment, "RECOVERY_") >= 0)
      return true;

   string effComment = GetEffectiveOrderComment(ticket, curComment);
   if(StringFind(effComment, "RECOVERY_") >= 0)
      return true;

   if(StringFind(curComment, "from #") >= 0)
     {
      string rootCmt = GetRootOrderComment(ticket, curComment);
      if(StringFind(rootCmt, "RECOVERY_") >= 0)
         return true;
     }

   return false;
  }

//+------------------------------------------------------------------+
//| GetRecoveryOrderParentTicket: Extracts parent ticket from root   |
//| or effective comment across partial close chains.                |
//+------------------------------------------------------------------+
int GetRecoveryOrderParentTicket(int ticket, string comment = "")
  {
   string effCmt = GetEffectiveOrderComment(ticket, comment);
   int pos = StringFind(effCmt, "RECOVERY_");
   if(pos >= 0)
     {
      string numPart = StringSubstr(effCmt, pos + 9);
      if(StringFind(numPart, "LSD_") == 0)
         numPart = StringSubstr(numPart, 4);
      return (int)StringToInteger(numPart);
     }
   string rootCmt = GetRootOrderComment(ticket, comment);
   pos = StringFind(rootCmt, "RECOVERY_");
   if(pos >= 0)
     {
      string numPart = StringSubstr(rootCmt, pos + 9);
      if(StringFind(numPart, "LSD_") == 0)
         numPart = StringSubstr(numPart, 4);
      return (int)StringToInteger(numPart);
     }
   return 0;
  }

//+------------------------------------------------------------------+
//| GetRootOrderComment: Resolves root comment across partial closes |
//| so recovery orders never lose their RECOVERY_<parent> identity   |
//+------------------------------------------------------------------+
string GetRootOrderComment(int ticket, string comment = "")
  {
   string curComment = comment;
   if(curComment == "")
     {
      if(OrderTicket() == ticket)
         curComment = OrderComment();
      else
         if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
            curComment = OrderComment();
         else
            if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_HISTORY))
               curComment = OrderComment();
     }

   if(StringFind(curComment, "from #") < 0)
      return curComment;

   int current = ticket;
   int currentSelectedTicket = OrderTicket();
   int loops = 0;

   while(loops < 25)
     {
      loops++;
      int pos = StringFind(curComment, "from #");
      if(pos < 0)
         break;

      string parentStr = StringSubstr(curComment, pos + 6);
      int parentTicket = (int)StringToInteger(parentStr);
      if(parentTicket <= 0 || parentTicket == current)
         break;

      current = parentTicket;
      bool found = false;
      if(OrderSelect(current, SELECT_BY_TICKET, MODE_HISTORY))
        {
         curComment = OrderComment();
         found = true;
        }
      else
         if(OrderSelect(current, SELECT_BY_TICKET, MODE_TRADES))
           {
            curComment = OrderComment();
            found = true;
           }

      if(!found)
         break;
     }

   if(currentSelectedTicket > 0 && OrderTicket() != currentSelectedTicket)
     {
      if(!OrderSelect(currentSelectedTicket, SELECT_BY_TICKET, MODE_TRADES))
        {
         bool selHistOk = OrderSelect(currentSelectedTicket, SELECT_BY_TICKET, MODE_HISTORY);
        }
     }

   return curComment;
  }

//+------------------------------------------------------------------+
//| ResolveRootTicketFromPartialChain: Walks MT4 "from #XXXX" chain  |
//| across trades & history (up to 25 hops) so partial-closed runner |
//| child tickets resolve back to their original root ticket.        |
//+------------------------------------------------------------------+
int ResolveRootTicketFromPartialChain(int ticket, string comment = "")
  {
   if(ticket <= 0)
      return 0;

   int savedTicket = OrderTicket();
   string curComment = comment;
   if(curComment == "")
     {
      if(OrderTicket() == ticket)
         curComment = OrderComment();
      else
         if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
            curComment = OrderComment();
         else
            if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_HISTORY))
               curComment = OrderComment();
     }

   if(StringFind(curComment, "from #") < 0)
     {
      if(savedTicket > 0 && OrderTicket() != savedTicket)
        {
         if(!OrderSelect(savedTicket, SELECT_BY_TICKET, MODE_TRADES))
            bool selHistOk = OrderSelect(savedTicket, SELECT_BY_TICKET, MODE_HISTORY);
        }
      return ticket;
     }

   int current = ticket;
   int loops = 0;

   while(loops < 25)
     {
      loops++;
      int pos = StringFind(curComment, "from #");
      if(pos < 0)
         break;

      string parentStr = StringSubstr(curComment, pos + 6);
      int prevTicket = (int)StringToInteger(parentStr);
      if(prevTicket <= 0 || prevTicket == current)
         break;

      current = prevTicket;
      bool found = false;
      if(OrderSelect(current, SELECT_BY_TICKET, MODE_HISTORY))
        {
         curComment = OrderComment();
         found = true;
        }
      else
         if(OrderSelect(current, SELECT_BY_TICKET, MODE_TRADES))
           {
            curComment = OrderComment();
            found = true;
           }

      if(!found)
         break;
     }

   if(savedTicket > 0 && OrderTicket() != savedTicket)
     {
      if(!OrderSelect(savedTicket, SELECT_BY_TICKET, MODE_TRADES))
         bool selHistOk = OrderSelect(savedTicket, SELECT_BY_TICKET, MODE_HISTORY);
     }

   return current;
  }


//+------------------------------------------------------------------+
//| VISUAL CHART ICONS FOR MULTI-ORDER CLOSES (+2, +3, +4...)        |
//| Displays "+2", "+3", "+4" icons on charts when orders are closed |
//| by any of the 6 multi-order / basket methods.                    |
//+------------------------------------------------------------------+
#define MAX_TRACKED_METHOD_ORDERS 500

struct SMethodModifiedTracker
  {
   int               ticket;
   int               methodId;     // 1: Pair Profit, 2: Buy Basket, 3: Sell Basket, 4: Combo Profit, 5: Overall Basket, 6: Method 6 (>2 Orders >$5)
   int               comboSize;    // 2, 3, 4, etc.
   datetime          modifyTime;
   double            targetProfit;
  };

SMethodModifiedTracker g_methodTrackers[MAX_TRACKED_METHOD_ORDERS];
int                    g_methodTrackerCount = 0;

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void RecordMethodModification(int ticket, int methodId, int comboSize, double targetProfit)
  {
   if(ticket <= 0)
      return;
   for(int i = 0; i < g_methodTrackerCount; i++)
     {
      if(g_methodTrackers[i].ticket == ticket)
        {
         g_methodTrackers[i].methodId = methodId;
         g_methodTrackers[i].comboSize = comboSize;
         g_methodTrackers[i].modifyTime = TimeCurrent();
         g_methodTrackers[i].targetProfit = targetProfit;
         return;
        }
     }
   if(g_methodTrackerCount < MAX_TRACKED_METHOD_ORDERS)
     {
      g_methodTrackers[g_methodTrackerCount].ticket = ticket;
      g_methodTrackers[g_methodTrackerCount].methodId = methodId;
      g_methodTrackers[g_methodTrackerCount].comboSize = comboSize;
      g_methodTrackers[g_methodTrackerCount].modifyTime = TimeCurrent();
      g_methodTrackers[g_methodTrackerCount].targetProfit = targetProfit;
      g_methodTrackerCount++;
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int GetMethodForTicket(int ticket, int &comboSize)
  {
   for(int i = 0; i < g_methodTrackerCount; i++)
     {
      if(g_methodTrackers[i].ticket == ticket)
        {
         comboSize = g_methodTrackers[i].comboSize;
         return g_methodTrackers[i].methodId;
        }
     }
   comboSize = 0;
   return 0;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
string GetMethodDescription(int methodId, int orderCount, double netProfit = 0.0)
  {
   switch(methodId)
     {
      case 1:
         return "Method 1: Pair Profit SL";
      case 2:
         return "Method 2: Buy Basket SL";
      case 3:
         return "Method 3: Sell Basket SL";
      case 4:
         return "Method 4: Combo Profit Close";
      case 5:
         return "Method 5: Basket Profit SL";
      case 6:
         return "Method 6: Multi-Order >$20 SL";
      default:
         if(netProfit < 0.0)
            return StringFormat("Multi-Order Loss / Risk Cut (+%d)", orderCount);
         else
            return StringFormat("Multi-Order Profit Close (+%d)", orderCount);
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void DrawMultiOrderClosedIcon(int orderCount, datetime closeTime, double closePrice, double netProfit, string methodName = "", int primaryTicket = 0)
  {
   if(!InpDrawMultiOrderClosedIcons)
      return;

   if(orderCount < 2)
      return; // Only display for multi-order closes (+2, +3, +4, etc.)

   if(closeTime <= 0)
      closeTime = TimeCurrent();

   if(closePrice <= 0.0)
      closePrice = Bid;

   string baseName = PREFIX + "COMBO_CLOSE_" + IntegerToString((int)closeTime);
   if(primaryTicket > 0)
      baseName = baseName + "_" + IntegerToString(primaryTicket);
   else
      baseName = baseName + "_C" + IntegerToString(orderCount);

// Prevent duplicate drawing
   if(ObjectFind(0, baseName) >= 0 || ObjectFind(0, baseName + "_TXT") >= 0)
      return;

// Also verify if another combo icon was drawn at the exact same time
   string timeWildcard = PREFIX + "COMBO_CLOSE_" + IntegerToString((int)closeTime);
   for(int k = ObjectsTotal() - 1; k >= 0; k--)
     {
      string oName = ObjectName(k);
      if(StringFind(oName, timeWildcard) == 0 && StringFind(oName, "_TXT") < 0)
         return;
     }

   double atr = iATR(Symbol(), Period(), 14, 1);
   if(atr <= 0.0)
      atr = 30 * Point;
   if(atr <= 0.0)
      atr = 1.0;

   color dotColor = (netProfit >= 0.0) ? clrLimeGreen : clrCrimson;
   color txtColor = (netProfit >= 0.0) ? InpMultiOrderClosedIconColor : clrTomato;

   string defaultLabel = (netProfit < 0.0 ? StringFormat("Multi-Order Loss / Risk Cut (+%d)", orderCount)
                          : StringFormat("Multi-Order Profit Close (+%d)", orderCount));
   string methodLabel = (methodName != "" ? methodName : defaultLabel);

   string plFormatted = (netProfit >= 0.0) ? StringFormat("Net Profit: +$%.2f", netProfit)
                        : StringFormat("Net Loss: -$%.2f", MathAbs(netProfit));

   string tooltip = StringFormat("%s | +%d Orders Closed | %s | Price: %.2f | Time: %s",
                                 methodLabel,
                                 orderCount,
                                 plFormatted,
                                 closePrice,
                                 TimeToString(closeTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS));

// 1. Solid Circle Marker at close price
   ObjectCreate(0, baseName, OBJ_ARROW, 0, closeTime, closePrice);
   ObjectSetInteger(0, baseName, OBJPROP_ARROWCODE, 159); // Wingdings 159: Solid round circle dot
   ObjectSetInteger(0, baseName, OBJPROP_COLOR, dotColor);
   ObjectSetInteger(0, baseName, OBJPROP_WIDTH, 4);       // Visible width
   ObjectSetInteger(0, baseName, OBJPROP_BACK, false);
   ObjectSetInteger(0, baseName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, baseName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);

// 2. Bold Text Label ("+2", "+3", etc.) placed above the dot
   string txtName = baseName + "_TXT";
   double lblPrice = closePrice + (atr * 0.35);

   ObjectCreate(0, txtName, OBJ_TEXT, 0, closeTime, lblPrice);
   ObjectSetString(0, txtName, OBJPROP_TEXT, "+" + IntegerToString(orderCount));
   ObjectSetString(0, txtName, OBJPROP_FONT, "Arial Black");
   ObjectSetInteger(0, txtName, OBJPROP_FONTSIZE, (InpMultiOrderClosedFontSize > 0 ? InpMultiOrderClosedFontSize : 10));
   ObjectSetInteger(0, txtName, OBJPROP_COLOR, txtColor);
   ObjectSetInteger(0, txtName, OBJPROP_BACK, false);
   ObjectSetInteger(0, txtName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, txtName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);

   ChartRedraw(0);

   Print(">>> [CHART ICON +", orderCount, "] Placed icon '+", orderCount, "' on chart at ",
         TimeToString(closeTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS), " price ", DoubleToString(closePrice, Digits),
         " | ", plFormatted, " | ", methodLabel);
  }

//+------------------------------------------------------------------+
//| DrawMethod6HitIcon                                               |
//| Draws chart icon and text label when Method 6 combination hits:  |
//| InpEnableMethod6CombinationSLModify + InpMethod6ProfitThresholdUSD|
//+------------------------------------------------------------------+
void DrawMethod6HitIcon(int orderCount, double comboProfit, datetime hitTime = 0, double hitPrice = 0.0)
  {
   if(!InpDrawMethod6HitIcon)
      return;

   if(hitTime <= 0)
      hitTime = TimeCurrent();

   datetime barTime = (Time[0] > 0 ? Time[0] : hitTime);
   string baseName = PREFIX + "M6_HIT_" + IntegerToString((int)barTime);

// Prevent duplicate icon on the same bar
   if(ObjectFind(0, baseName) >= 0 || ObjectFind(0, baseName + "_TXT") >= 0)
      return;

   double atr = iATR(Symbol(), Period(), 14, 1);
   if(atr <= 0.0)
      atr = 30 * Point;
   if(atr <= 0.0)
      atr = 1.0;

   double markerPrice = High[0] + (atr * 0.25);
   double labelPrice  = markerPrice + (atr * 0.35);

   color iconColor = InpMethod6HitIconColor;
   int   iconCode  = (InpMethod6HitIconCode > 0 ? InpMethod6HitIconCode : 159);
   int   fontSize  = (InpMethod6HitFontSize > 0 ? InpMethod6HitFontSize : 10);

   string txtName = baseName + "_TXT";
   string labelText = StringFormat("M6 +%d ($%.2f)", orderCount, comboProfit);
   string tooltip   = StringFormat("Method 6 Combination Hit (>2 Orders >$5) | Orders: +%d | Profit: +$%.2f (Threshold: $%.2f) | SL Gap: $%.1f | Time: %s",
                                   orderCount, comboProfit, InpMethod6ProfitThresholdUSD, InpMethod6SLDistanceUSD,
                                   TimeToString(hitTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS));

// 1. Solid Marker Icon
   ObjectCreate(0, baseName, OBJ_ARROW, 0, barTime, markerPrice);
   ObjectSetInteger(0, baseName, OBJPROP_ARROWCODE, iconCode); // Wingdings 159 (circle dot) or customized
   ObjectSetInteger(0, baseName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, baseName, OBJPROP_WIDTH, 4);
   ObjectSetInteger(0, baseName, OBJPROP_BACK, false);
   ObjectSetInteger(0, baseName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, baseName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);

// 2. Bold Text Label ("M6 +3 ($5.40)")
   ObjectCreate(0, txtName, OBJ_TEXT, 0, barTime, labelPrice);
   ObjectSetString(0, txtName, OBJPROP_TEXT, labelText);
   ObjectSetString(0, txtName, OBJPROP_FONT, "Arial Black");
   ObjectSetInteger(0, txtName, OBJPROP_FONTSIZE, fontSize);
   ObjectSetInteger(0, txtName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, txtName, OBJPROP_BACK, false);
   ObjectSetInteger(0, txtName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, txtName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);

   ChartRedraw(0);

   Print(">>> [M6 CHART ICON] Placed Method 6 Hit icon '", labelText, "' on chart at bar ",
         TimeToString(barTime, TIME_DATE|TIME_MINUTES), " | Profit: $", DoubleToString(comboProfit, 2));
  }

//+------------------------------------------------------------------+
//| Drawdown Relief Ticket Registry & Special Chart Icon Engine      |
//+------------------------------------------------------------------+
#define MAX_DRAWDOWN_RELIEF_TICKETS 100
int    g_drawdownReliefTickets[MAX_DRAWDOWN_RELIEF_TICKETS];
int    g_drawdownReliefTicketCount = 0;

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void RegisterDrawdownReliefTicket(int ticket)
  {
   if(ticket <= 0)
      return;
   for(int i = 0; i < g_drawdownReliefTicketCount; i++)
     {
      if(g_drawdownReliefTickets[i] == ticket)
         return;
     }
   if(g_drawdownReliefTicketCount < MAX_DRAWDOWN_RELIEF_TICKETS)
     {
      g_drawdownReliefTickets[g_drawdownReliefTicketCount] = ticket;
      g_drawdownReliefTicketCount++;
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsDrawdownReliefTicket(int ticket)
  {
   if(ticket <= 0)
      return false;
   for(int i = 0; i < g_drawdownReliefTicketCount; i++)
     {
      if(g_drawdownReliefTickets[i] == ticket)
         return true;
     }
   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void UnregisterDrawdownReliefTicket(int ticket)
  {
   if(ticket <= 0)
      return;
   for(int i = 0; i < g_drawdownReliefTicketCount; i++)
     {
      if(g_drawdownReliefTickets[i] == ticket)
        {
         for(int j = i; j < g_drawdownReliefTicketCount - 1; j++)
            g_drawdownReliefTickets[j] = g_drawdownReliefTickets[j + 1];
         g_drawdownReliefTicketCount--;
         break;
        }
     }
  }

//+------------------------------------------------------------------+
//| DrawDrawdownReliefIcon:                                          |
//| Draws a distinct special chart icon when tight relief SL succeeds|
//| (APPLIED) or when price hits the tight relief SL (HIT).          |
//+------------------------------------------------------------------+
void DrawDrawdownReliefIcon(string iconType, int orderCount, double peakDD, double currentDD, double slGap, datetime hitTime = 0, double hitPrice = 0.0, int primaryTicket = 0)
  {
   if(!InpDrawDrawdownReliefIcon)
      return;

   if(hitTime <= 0)
      hitTime = TimeCurrent();

   datetime barTime = hitTime;
   string baseName = PREFIX + "RLF_" + iconType + "_" + IntegerToString(primaryTicket) + "_" + IntegerToString((int)barTime);

// Prevent duplicate icon on the same bar for the same ticket
   if(ObjectFind(0, baseName) >= 0 || ObjectFind(0, baseName + "_TXT") >= 0)
      return;

   double atr = iATR(Symbol(), Period(), 14, 1);
   if(atr <= 0.0)
      atr = 30 * Point;
   if(atr <= 0.0)
      atr = 1.0;

   double markerPrice = 0.0;
   double labelPrice  = 0.0;

   if(hitPrice > 0.0)
     {
      markerPrice = hitPrice;
      labelPrice  = markerPrice + (atr * 0.35);
     }
   else
     {
      markerPrice = High[0] + (atr * 0.25);
      labelPrice  = markerPrice + (atr * 0.35);
     }

   color iconColor = InpDrawdownReliefIconColor;
   int   iconCode  = (InpDrawdownReliefIconCode > 0 ? InpDrawdownReliefIconCode : 251);
   int   fontSize  = (InpDrawdownReliefFontSize > 0 ? InpDrawdownReliefFontSize : 10);

   string txtName = baseName + "_TXT";
   string labelText = "";
   string tooltip   = "";

   if(iconType == "APPLIED")
     {
      labelText = StringFormat("RLF SL x%d (DD: $%.0f->$%.0f)", orderCount, peakDD, currentDD);
      tooltip   = StringFormat("50%% Drawdown Relief SL Applied | Orders Tightened: %d | Peak DD: $%.2f -> Relief DD: $%.2f (Reduced >50%%) | SL Cushion: $%.1f | Time: %s",
                               orderCount, peakDD, currentDD, slGap,
                               TimeToString(hitTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS));
     }
   else // "HIT"
     {
      labelText = StringFormat("RLF SL HIT #%d ($%.2f)", primaryTicket, currentDD);
      tooltip   = StringFormat("50%% Drawdown Relief SL HIT | Ticket #%d | Loss Capped at: $%.2f (Saved from Peak DD: $%.2f) | ClosePrice: %.2f | Time: %s",
                               primaryTicket, currentDD, peakDD, hitPrice,
                               TimeToString(hitTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS));
     }

// 1. Solid Marker Icon (Wingdings 251 check, 171 star, 159 dot, or 238 shield)
   ObjectCreate(0, baseName, OBJ_ARROW, 0, barTime, markerPrice);
   ObjectSetInteger(0, baseName, OBJPROP_ARROWCODE, iconCode);
   ObjectSetInteger(0, baseName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, baseName, OBJPROP_WIDTH, 4);
   ObjectSetInteger(0, baseName, OBJPROP_BACK, false);
   ObjectSetInteger(0, baseName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, baseName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);

// 2. Bold Text Label
   ObjectCreate(0, txtName, OBJ_TEXT, 0, barTime, labelPrice);
   ObjectSetString(0, txtName, OBJPROP_TEXT, labelText);
   ObjectSetString(0, txtName, OBJPROP_FONT, "Arial Black");
   ObjectSetInteger(0, txtName, OBJPROP_FONTSIZE, fontSize);
   ObjectSetInteger(0, txtName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, txtName, OBJPROP_BACK, false);
   ObjectSetInteger(0, txtName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, txtName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);

   ChartRedraw(0);

   Print(">>> [DRAWDOWN RELIEF SPECIAL CHART ICON] Placed '", labelText, "' on chart at bar ",
         TimeToString(barTime, TIME_DATE|TIME_MINUTES), " | Peak DD: $", DoubleToString(peakDD, 2),
         " -> Current DD: $", DoubleToString(currentDD, 2));
  }

//+------------------------------------------------------------------+
//| ResetDrawdownReliefCycle:                                        |
//| Resets drawdown relief tracking so the process repeats on every  |
//| InpDrawdownReliefMinPeakUSD after hit success or full recovery.  |
//+------------------------------------------------------------------+
void ResetDrawdownReliefCycle(string reason = "")
  {
   if(g_drawdownReliefPeakUSD > 0.0)
      g_drawdownReliefLastPeakUSD = g_drawdownReliefPeakUSD;

   double mult = (balancelomultipler > 0) ? balancelomultipler : 1.0;
   double minPeakRequired = InpDrawdownReliefMinPeakUSD * mult;
   if(minPeakRequired <= 0.0)
      minPeakRequired = 100.0;

   PrintFormat(">>> [DRAWDOWN RELIEF RESET TO REPEAT] %s | Peak DD was $%.2f. Cycle reset! Ready to repeat on next >= $%.2f drawdown (Total Hit Successes: %d, Total Executions: %d).",
               (reason != "" ? reason : "Tight relief SL hit success"),
               g_drawdownReliefLastPeakUSD,
               minPeakRequired,
               g_drawdownReliefHitSuccessCount,
               g_drawdownReliefAppliedCount);

   g_drawdownReliefPeakUSD      = 0.0;
   g_drawdownReliefPeakTime     = 0;
   g_drawdownReliefArmed        = false;
   g_drawdownReliefExecuted     = false;
   g_drawdownReliefTicketCount  = 0;
  }

//+------------------------------------------------------------------+
//| SendDrawdownReliefPhase1Alert:                                   |
//| Sends on-screen popup alert and mobile push notification when    |
//| Phase 1 is hit (50% relief bounce detected & SLs tightened).     |
//+------------------------------------------------------------------+
void SendDrawdownReliefPhase1Alert(int orderCount, double peakDD, double currentDD, double reliefGap)
  {
   if(!InpDrawdownReliefAlertPopup && !InpDrawdownReliefPushNotify)
      return;

   string tfStr = TimeframeToString(Period());
   string alertMsg = StringFormat("[%s %s] Phase 1 Drawdown Relief Activated! Tightened SL on %d losing order(s). Peak DD: $%.2f -> Relief DD: $%.2f (Reduced >50%%). Cushion: $%.1f. Loss capped!",
                                  Symbol(), tfStr, orderCount, peakDD, currentDD, reliefGap);

   if(InpDrawdownReliefAlertPopup)
     {
      Alert(alertMsg);
     }

   if(InpDrawdownReliefPushNotify)
     {
      ResetLastError();
      bool sent = SendNotification(alertMsg);
      if(sent)
        {
         Print(">>> [PHASE 1 ALERT] Mobile push notification sent successfully: ", alertMsg);
        }
      else
        {
         int err = GetLastError();
         Print(">>> [PHASE 1 ALERT] Mobile push notification status (Result=", sent, ", Error=", err, "). On-Screen Alert was displayed.");
        }
     }
  }

//+------------------------------------------------------------------+
//| METHOD-WISE ANALYTICS & LOGGING ENGINE                           |
//| Tracks trigger time, expected profit, participating orders, and  |
//| actual released profit when orders close.                        |
//| Generates structured log lines and an OnDeinit summary report.   |
//+------------------------------------------------------------------+
#define MAX_METHOD_ACTION_CLUSTERS 1000

struct SMethodActionCluster
  {
   int               cClusterId;
   int               cMethodId;          // 1: Method 1, 2: Method 2, 3: Method 3, 4: Method 4, 5: Method 5, 6: Method 6
   string            cMethodName;
   datetime          cTriggerTime;
   int               cOrderCount;
   int               cTickets[10];
   double            cTriggerPL[10];
   double            cExpectedProfit;
   double            cReleasedProfit;
   int               cClosedCount;
   bool              cIsFullyClosed;
   datetime          cLastCloseTime;
  };

SMethodActionCluster g_methodClusters[MAX_METHOD_ACTION_CLUSTERS];
int                  g_methodClusterCount = 0;

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int RecordMethodActionCluster(int pMethodId, int &pTickets[], double &pPLs[], int pCount, double pExpectedProfit, string pActionDetails)
  {
   if(pCount <= 0)
      return -1;

   int cId = g_methodClusterCount;
   if(cId >= MAX_METHOD_ACTION_CLUSTERS)
      return -1;

   g_methodClusters[cId].cClusterId      = cId + 1;
   g_methodClusters[cId].cMethodId       = pMethodId;
   g_methodClusters[cId].cMethodName     = GetMethodDescription(pMethodId, pCount, pExpectedProfit);
   g_methodClusters[cId].cTriggerTime    = TimeCurrent();
   g_methodClusters[cId].cOrderCount     = pCount;
   g_methodClusters[cId].cExpectedProfit = pExpectedProfit;
   g_methodClusters[cId].cReleasedProfit = 0.0;
   g_methodClusters[cId].cClosedCount    = 0;
   g_methodClusters[cId].cIsFullyClosed  = false;
   g_methodClusters[cId].cLastCloseTime  = 0;

   string ordersStr = "";
   for(int k = 0; k < pCount && k < 10; k++)
     {
      g_methodClusters[cId].cTickets[k]   = pTickets[k];
      g_methodClusters[cId].cTriggerPL[k] = pPLs[k];

      // Also link to individual order tracker
      RecordMethodModification(pTickets[k], pMethodId, pCount, pExpectedProfit);

      if(k > 0)
         ordersStr = ordersStr + ", ";
      ordersStr = ordersStr + StringFormat("#%d ($%.2f)", pTickets[k], pPLs[k]);
     }

   g_methodClusterCount++;

// Structured Analytics Trigger Log
   Print(StringFormat(">>> [METHOD_TRIGGER] Cluster #%d | %s | Time: %s | Orders: [%s] | Expected Profit: $%.2f | Action: %s",
                      cId + 1,
                      g_methodClusters[cId].cMethodName,
                      TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                      ordersStr,
                      pExpectedProfit,
                      pActionDetails));

   return (cId + 1);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void ProcessMethodAnalyticsTracker()
  {
   if(g_methodClusterCount <= 0)
      return;

   for(int c = 0; c < g_methodClusterCount; c++)
     {
      if(g_methodClusters[c].cIsFullyClosed)
         continue;

      int closedInCluster = 0;
      double currentReleasedPL = 0.0;
      string closedDetails = "";
      datetime latestCloseTime = 0;

      for(int k = 0; k < g_methodClusters[c].cOrderCount && k < 10; k++)
        {
         int tkt = g_methodClusters[c].cTickets[k];
         if(tkt <= 0)
            continue;

         if(OrderSelect(tkt, SELECT_BY_TICKET, MODE_HISTORY))
           {
            closedInCluster++;
            double p = OrderProfit() + OrderSwap() + OrderCommission();
            currentReleasedPL += p;
            datetime ct = OrderCloseTime();
            if(ct > latestCloseTime)
               latestCloseTime = ct;

            if(closedDetails != "")
               closedDetails = closedDetails + ", ";
            closedDetails = closedDetails + StringFormat("#%d: $%.2f", tkt, p);
           }
        }

      // If newly closed orders detected
      if(closedInCluster > g_methodClusters[c].cClosedCount)
        {
         g_methodClusters[c].cClosedCount = closedInCluster;
         g_methodClusters[c].cReleasedProfit = currentReleasedPL;
         g_methodClusters[c].cLastCloseTime = latestCloseTime;

         if(closedInCluster >= g_methodClusters[c].cOrderCount)
           {
            g_methodClusters[c].cIsFullyClosed = true;

            double expP = g_methodClusters[c].cExpectedProfit;
            double relP = currentReleasedPL;
            double diff = relP - expP;
            double retention = (expP > 0.0) ? (relP / expP * 100.0) : 0.0;
            string statusStr = (relP >= expP - 0.20) ? "TARGET ACHIEVED" : (relP > 0.0 ? "REDUCED PROFIT" : "LOSS GIVEN BACK");

            Print(StringFormat(">>> [METHOD_RELEASED] Cluster #%d | %s | Closed Time: %s | Orders: [%s] | Expected: $%.2f | Released: $%.2f | Diff: $%.2f (Retention: %.1f%%) | Status: %s | Balance: $%.2f",
                               g_methodClusters[c].cClusterId,
                               g_methodClusters[c].cMethodName,
                               TimeToString(latestCloseTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                               closedDetails,
                               expP,
                               relP,
                               diff,
                               retention,
                               statusStr,
                               AccountBalance()));
           }
        }
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void PrintMethodAnalyticsSummaryReport()
  {
   ProcessMethodAnalyticsTracker();

   string sep = "========================================================================================";
   string subSep = "----------------------------------------------------------------------------------------";

   Print(sep);
   Print("                      METHOD-WISE ANALYTICS PERFORMANCE SUMMARY");
   Print(sep);
   Print(StringFormat("%-30s | %-8s | %-8s | %-12s | %-12s | %-12s | %-10s",
                      "Method Name", "Triggers", "Closed", "Expected ($)", "Released ($)", "Giveback ($)", "Retention %"));
   Print(subSep);

   double grandExpected = 0.0;
   double grandReleased = 0.0;
   int grandTriggers = 0;
   int grandClosed = 0;

   string fileReport = sep + "\r\n                      METHOD-WISE ANALYTICS PERFORMANCE SUMMARY\r\n" + sep + "\r\n";
   fileReport = fileReport + StringFormat("%-30s | %-8s | %-8s | %-12s | %-12s | %-12s | %-10s\r\n",
                                          "Method Name", "Triggers", "Closed", "Expected ($)", "Released ($)", "Giveback ($)", "Retention %") + subSep + "\r\n";

   for(int m = 1; m <= 6; m++)
     {
      int trigCount = 0;
      int closedCount = 0;
      double mExpected = 0.0;
      double mReleased = 0.0;
      string mName = GetMethodDescription(m, 2, 0.0);

      for(int c = 0; c < g_methodClusterCount; c++)
        {
         if(g_methodClusters[c].cMethodId == m)
           {
            trigCount++;
            mExpected += g_methodClusters[c].cExpectedProfit;
            if(g_methodClusters[c].cClosedCount > 0)
              {
               closedCount++;
               mReleased += g_methodClusters[c].cReleasedProfit;
              }
           }
        }

      if(trigCount > 0)
        {
         double diff = mReleased - mExpected;
         double ret = (mExpected > 0.0) ? (mReleased / mExpected * 100.0) : 0.0;
         string line = StringFormat("%-30s | %-8d | %-8d | %12.2f | %12.2f | %12.2f | %9.1f%%",
                                    mName, trigCount, closedCount, mExpected, mReleased, diff, ret);
         Print(line);
         fileReport = fileReport + line + "\r\n";

         grandExpected += mExpected;
         grandReleased += mReleased;
         grandTriggers += trigCount;
         grandClosed += closedCount;
        }
     }

   Print(subSep);
   double grandDiff = grandReleased - grandExpected;
   double grandRet = (grandExpected > 0.0) ? (grandReleased / grandExpected * 100.0) : 0.0;
   string totalLine = StringFormat("%-30s | %-8d | %-8d | %12.2f | %12.2f | %12.2f | %9.1f%%",
                                   "TOTAL ACROSS ALL METHODS", grandTriggers, grandClosed, grandExpected, grandReleased, grandDiff, grandRet);
   Print(totalLine);
   Print(sep);
   fileReport = fileReport + subSep + "\r\n" + totalLine + "\r\n" + sep + "\r\n";

   int hFile = FileOpen("Method_Analytics_Summary.txt", FILE_WRITE|FILE_TXT);
   if(hFile != INVALID_HANDLE)
     {
      FileWriteString(hFile, fileReport);
      FileClose(hFile);
     }
  }


//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void CheckAndDrawMultiOrderClosedIcons()
  {
   if(!InpDrawMultiOrderClosedIcons && !InpDrawDrawdownReliefIcon)
      return;

   int histTotal = OrdersHistoryTotal();
   if(histTotal <= 0)
      return;

   static int s_lastCheckedHistTotal = 0;
// If no new orders closed in history, skip
   if(histTotal == s_lastCheckedHistTotal)
      return;

#define MAX_HIST_SCAN 200
   int scanCount = MathMin(histTotal, MAX_HIST_SCAN);
   bool reliefHitSuccess = false;

   struct SClosedOrderInfo
     {
      int            ticket;
      datetime       closeTime;
      double         closePrice;
      double         profit;
      int            methodId;
     };

   SClosedOrderInfo closedList[MAX_HIST_SCAN];
   int cCount = 0;

   for(int i = histTotal - 1; i >= histTotal - scanCount && i >= 0 && cCount < MAX_HIST_SCAN; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_HISTORY))
         continue;

      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;

      datetime cTime = OrderCloseTime();
      if(cTime <= 0)
         continue;

      int tkt = OrderTicket();
      if(IsDrawdownReliefTicket(tkt))
        {
         double cSL = OrderStopLoss();
         double cPrice = OrderClosePrice();
         double pDiff = (cSL > 0.0) ? MathAbs(cPrice - cSL) : 9999.0;
         if(pDiff <= 100.0 * Point || StringFind(OrderComment(), "[sl]") >= 0)
           {
            double netP = OrderProfit() + OrderSwap() + OrderCommission();
            double repDD = (g_drawdownReliefPeakUSD > 0.0 ? g_drawdownReliefPeakUSD : g_drawdownReliefLastPeakUSD);
            g_drawdownReliefHitSuccessCount++;
            DrawDrawdownReliefIcon("HIT", 1, repDD, netP, 0.0, cTime, cPrice, tkt);
            reliefHitSuccess = true;
            if(netP >= 0.0)
              {
               PrintFormat(">>> [DRAWDOWN RELIEF SL HIT - WINNER #%d] Order #%d closed at tight relief SL! Profit banked: +$%.2f. Repeating on every InpDrawdownReliefMinPeakUSD.",
                           g_drawdownReliefHitSuccessCount, tkt, netP);
              }
            else
              {
               PrintFormat(">>> [DRAWDOWN RELIEF SL HIT SUCCESS #%d] Order #%d closed at tight relief SL! Loss capped at $%.2f (Saved from Peak DD: $%.2f). Repeating on every InpDrawdownReliefMinPeakUSD.",
                           g_drawdownReliefHitSuccessCount, tkt, netP, repDD);
              }
           }
         UnregisterDrawdownReliefTicket(tkt);
        }

      int dummyCombo = 0;
      int mId = GetMethodForTicket(tkt, dummyCombo);

      closedList[cCount].ticket     = tkt;
      closedList[cCount].closeTime  = cTime;
      closedList[cCount].closePrice = OrderClosePrice();
      closedList[cCount].profit     = OrderProfit() + OrderSwap() + OrderCommission();
      closedList[cCount].methodId   = mId;
      cCount++;
     }

   s_lastCheckedHistTotal = histTotal;

// USER RULE (VMULTI-1099): Repeat Drawdown Relief process on every InpDrawdownReliefMinPeakUSD after hit success
   if((reliefHitSuccess || g_drawdownReliefTicketCount == 0) && g_drawdownReliefExecuted)
     {
      if(InpDrawdownReliefRepeatOnHitSuccess)
        {
         ResetDrawdownReliefCycle("Tight relief SL hit success - Ready to repeat on next InpDrawdownReliefMinPeakUSD");
        }
     }

   if(cCount < 2)
      return;

// Group orders that closed together within 2 seconds
   bool processed[MAX_HIST_SCAN];
   ArrayInitialize(processed, false);

   for(int i = 0; i < cCount; i++)
     {
      if(processed[i])
         continue;

      int groupCount = 1;
      double groupProfit = closedList[i].profit;
      double sumPrice = closedList[i].closePrice;
      int detectedMethod = closedList[i].methodId;
      datetime grpTime = closedList[i].closeTime;

      for(int j = i + 1; j < cCount; j++)
        {
         if(processed[j])
            continue;

         if(MathAbs((int)(closedList[j].closeTime - grpTime)) <= 2)
           {
            groupCount++;
            groupProfit += closedList[j].profit;
            sumPrice += closedList[j].closePrice;
            if(detectedMethod == 0 && closedList[j].methodId > 0)
               detectedMethod = closedList[j].methodId;
            processed[j] = true;
           }
        }

      processed[i] = true;

      if(groupCount >= 2)
        {
         double avgClosePrice = sumPrice / (double)groupCount;
         string mDesc = GetMethodDescription(detectedMethod, groupCount, groupProfit);
         DrawMultiOrderClosedIcon(groupCount, grpTime, avgClosePrice, groupProfit, mDesc, closedList[i].ticket);
        }
     }
  }

//+------------------------------------------------------------------+
//| ModifyPairProfitWithStopLoss                                     |
//| Multi-Order Combination Profit Live SL Modifier:                 |
//| Evaluates 2-order pairs, 3-order triplets, and basket orders     |
//| (profit or loss). If combined profit >= $1.00 * multiplier,      |
//| modifies all qualifying orders with -$100 raw gap StopLoss.      |
//+------------------------------------------------------------------+
void ModifyPairProfitWithStopLoss()
  {
   if(!EnablePairProfitSLModify)
      return;

// 1. Scan and collect all eligible market orders
#define MAX_PAIR_SCAN_ORDERS 100
   int    candTickets[MAX_PAIR_SCAN_ORDERS];
   int    candTypes[MAX_PAIR_SCAN_ORDERS];
   double candLots[MAX_PAIR_SCAN_ORDERS];
   double candOpenPrices[MAX_PAIR_SCAN_ORDERS];
   double candStopLosses[MAX_PAIR_SCAN_ORDERS];
   double candTakeProfits[MAX_PAIR_SCAN_ORDERS];
   double candProfits[MAX_PAIR_SCAN_ORDERS];
   bool   qualifyForSL[MAX_PAIR_SCAN_ORDERS];
   int    candComboSize[MAX_PAIR_SCAN_ORDERS];
   ArrayInitialize(candTickets, 0);
   ArrayInitialize(candTypes, 0);
   ArrayInitialize(candLots, 0.0);
   ArrayInitialize(candOpenPrices, 0.0);
   ArrayInitialize(candStopLosses, 0.0);
   ArrayInitialize(candTakeProfits, 0.0);
   ArrayInitialize(candProfits, 0.0);
   ArrayInitialize(qualifyForSL, false);
   ArrayInitialize(candComboSize, 0);
   int    candCount = 0;

   double mult = (balancelomultipler > 0) ? balancelomultipler : 1.0;
   double targetThreshold = PairCombinationProfitThresholdUSD * (PairCombinationUseBalanceMultiplier ? mult : 1.0);

   if(IsEmaWEAKDistanceReduced50PercentFromPeak())
     {
      targetThreshold = targetThreshold / 2.0;
     }

   for(int i = OrdersTotal() - 1; i >= 0 && candCount < MAX_PAIR_SCAN_ORDERS; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;

      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;

      string cmt = OrderComment();
      int tkt    = OrderTicket();

      // Exclude recovery orders: Recovery orders manage their own independent basket
      if(IsAnyRecoveryOrder(tkt, cmt) || IsRecoveryOrderWithActiveParent(tkt, cmt))
         continue;

      // Exclude FLIPBasketSupport orders unless explicitly enabled
      if(!InpPairCombinationIncludeFlipBasket)
        {
         if(IsFLIPBasketSupportOrder(tkt, cmt) || StringFind(cmt, "FLIPBasketSupport") >= 0)
            continue;
        }

      candTickets[candCount]    = tkt;
      candTypes[candCount]      = oType;
      candLots[candCount]       = OrderLots();
      candOpenPrices[candCount] = OrderOpenPrice();
      candStopLosses[candCount] = OrderStopLoss();
      candTakeProfits[candCount]= OrderTakeProfit();
      candProfits[candCount]    = OrderProfit() + OrderSwap() + OrderCommission();
      qualifyForSL[candCount]   = false;
      candCount++;
     }

   if(candCount < 2)
      return; // Need at least 2 orders to form a combination

   int qualifyingCombinationsCount = 0;

// 2A. Total Basket Check (All open orders combined)
   double totalBasketPL = 0.0;
   for(int b = 0; b < candCount; b++)
      totalBasketPL += candProfits[b];

   if(totalBasketPL >= targetThreshold)
     {
      for(int b = 0; b < candCount; b++)
        {
         qualifyForSL[b] = true;
         candComboSize[b] = candCount;
        }
      qualifyingCombinationsCount++;
      Print("COMBINATION BASKET PROFIT >= $", DoubleToString(targetThreshold, 2), " HIT: All ", candCount,
            " orders = Total $", DoubleToString(totalBasketPL, 2),
            " | Qualifying all orders for -$100 StopLoss modification.");
     }

// 2B. Evaluate all 2-order combinations (Pairs: i, j) - profit or loss
   for(int i = 0; i < candCount - 1; i++)
     {
      for(int j = i + 1; j < candCount; j++)
        {
         double pairProfit = candProfits[i] + candProfits[j];
         if(pairProfit >= targetThreshold)
           {
            qualifyForSL[i] = true;
            qualifyForSL[j] = true;
            if(candComboSize[i] == 0)
               candComboSize[i] = 2;
            if(candComboSize[j] == 0)
               candComboSize[j] = 2;
            qualifyingCombinationsCount++;
            Print("COMBINATION PAIR PROFIT >= $", DoubleToString(targetThreshold, 2), " HIT: Pair [Ticket #", candTickets[i],
                  " ($", DoubleToString(candProfits[i], 2), ") + Ticket #", candTickets[j],
                  " ($", DoubleToString(candProfits[j], 2), ")] = Total $", DoubleToString(pairProfit, 2),
                  " | Qualifying both orders for -$100 StopLoss modification.");
           }
        }
     }

// 2C. Evaluate all 3-order combinations (Triplets: i, j, k) - profit or loss
   int maxTripletSearch = MathMin(candCount, 15);
   for(int i = 0; i < maxTripletSearch - 2; i++)
     {
      for(int j = i + 1; j < maxTripletSearch - 1; j++)
        {
         for(int k = j + 1; k < maxTripletSearch; k++)
           {
            double tripletProfit = candProfits[i] + candProfits[j] + candProfits[k];
            if(tripletProfit >= targetThreshold)
              {
               qualifyForSL[i] = true;
               qualifyForSL[j] = true;
               qualifyForSL[k] = true;
               if(candComboSize[i] == 0)
                  candComboSize[i] = 3;
               if(candComboSize[j] == 0)
                  candComboSize[j] = 3;
               if(candComboSize[k] == 0)
                  candComboSize[k] = 3;
               qualifyingCombinationsCount++;
               Print("COMBINATION TRIPLET PROFIT >= $", DoubleToString(targetThreshold, 2), " HIT: Triplet [Ticket #", candTickets[i],
                     " ($", DoubleToString(candProfits[i], 2), "), #", candTickets[j],
                     " ($", DoubleToString(candProfits[j], 2), "), #", candTickets[k],
                     " ($", DoubleToString(candProfits[k], 2), ")] = Total $", DoubleToString(tripletProfit, 2),
                     " | Qualifying 3 orders for -$100 StopLoss modification.");
              }
           }
        }
     }

   if(qualifyingCombinationsCount == 0)
      return;

// 3. Modify qualifying orders with -$100 raw gap StopLoss to protect profit/loss recovery
   RefreshRates();
   double minDistance = GetRequiredStopDistance();
   if(minDistance < 20.0)
      minDistance = 20.0;

   double rawGap = (PairCombinationSLDistanceRaw > 0.0) ? PairCombinationSLDistanceRaw : 100.0;
   if(rawGap < minDistance)
      rawGap = minDistance;

   double curBid = MarketInfo(Symbol(), MODE_BID);
   double curAsk = MarketInfo(Symbol(), MODE_ASK);

   for(int k = 0; k < candCount; k++)
     {
      if(!qualifyForSL[k])
         continue;

      int    tkt   = candTickets[k];
      int    oType = candTypes[k];
      double oOpen = candOpenPrices[k];
      double curSL = candStopLosses[k];
      double curTP = candTakeProfits[k];

      RefreshRates();
      curBid = MarketInfo(Symbol(), MODE_BID);
      curAsk = MarketInfo(Symbol(), MODE_ASK);

      double curPL = candProfits[k];
      double proposedSL = GetTrendAwareStopLoss(oType, rawGap, curSL, "Method 1", curPL, oOpen);
      bool   shouldModify = false;

      double rawProfitGap = (oType == OP_BUY) ? (curBid - oOpen) : (oOpen - curAsk);
      bool isSteepAngle = (InpEnableDoubleSlGapOnSteepAngle && MathAbs(GlobalEmaAngle30) > InpDoubleSlGapAngle);
      bool isProfitGapReached = (rawProfitGap > InpDoubleSlMinProfitGapRaw);

      // Clamp proposedSL to openPrice or breathing SL if profit gap reached (USER RULE: VMULTI-1096 & VMULTI-1105)
      double beFloorM1 = GetEmaAngleBreakevenBreathingSL(oType, oOpen, oOpen);
      if(isProfitGapReached)
        {
         if(oType == OP_BUY && proposedSL < beFloorM1)
            proposedSL = beFloorM1;
         else
            if(oType == OP_SELL && proposedSL > beFloorM1)
               proposedSL = beFloorM1;
        }

      bool allowBreathingWidening = (isSteepAngle && isProfitGapReached && (oType == OP_BUY ? proposedSL >= beFloorM1 : proposedSL <= beFloorM1));

      if(oType == OP_BUY)
        {
         // Ensure SL is strictly valid below Bid
         if(proposedSL >= curBid)
            continue;

         // For BUY: Set if no SL (0.0), or move SL strictly forward (higher)
         if(curSL == 0.0 || (proposedSL > curSL && (proposedSL - curSL) >= MinimumSLModifyGapRaw))
           {
            shouldModify = true;
           }
        }
      else
         if(oType == OP_SELL)
           {
            // Ensure SL is strictly valid above Ask
            if(proposedSL <= curAsk)
               continue;

            // For SELL: Set if no SL (0.0), or move SL strictly forward (lower)
            if(curSL == 0.0 || (proposedSL < curSL && (curSL - proposedSL) >= MinimumSLModifyGapRaw))
              {
               shouldModify = true;
              }
           }

      if(shouldModify && proposedSL > 0.0)
        {
         ResetLastError();
         bool modified = SafeOrderModify(tkt, oOpen, proposedSL, curTP, 0, (oType == OP_BUY ? clrLimeGreen : clrTomato), "Method 1");
         if(modified)
           {
            RecordMethodModification(tkt, 1, (candComboSize[k] > 0 ? candComboSize[k] : 2), candProfits[k]);
            Print("COMBINATION PROFIT SL MODIFIED | Ticket #", tkt,
                  " | Type=", (oType == OP_BUY ? "BUY" : "SELL"),
                  " | P/L=$", DoubleToString(candProfits[k], 2),
                  " | Old SL=", DoubleToString(curSL, Digits),
                  " | New SL=", DoubleToString(proposedSL, Digits),
                  " (Gap=$", DoubleToString(rawGap, 1), ")");
           }
         else
           {
            Print("COMBINATION PROFIT SL MODIFY FAILED | Ticket #", tkt, " | Error=", GetLastError());
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| METHOD 6: Multi-Order Combination (> 2 Orders) Execution         |
//| Checks combinations of >= 2 orders (pairs, triplets, quartets,   |
//| basket) where combined profit >= $20 * multiplier.               |
//| USER ACTION:                                                     |
//| 1) FIRST: Close losing orders in the combination at market       |
//| 2) THEN:  Modify winning orders with StopLoss at Current Price   |
//+------------------------------------------------------------------+
void ExecuteMethod6CombinationAction(int &comboIndices[], int comboCount, double comboSum,
                                     int &candTickets[], int &candTypes[], double &candLots[],
                                     double &candOpenPrices[], double &candTakeProfits[],
                                     double &candProfits[], bool &isProcessed[])
  {
   int m6Tkts[10];
   double m6Pls[10];
   for(int m6i = 0; m6i < comboCount && m6i < 10; m6i++)
     {
      m6Tkts[m6i] = candTickets[comboIndices[m6i]];
      m6Pls[m6i]  = candProfits[comboIndices[m6i]];
     }
   RecordMethodActionCluster(6, m6Tkts, m6Pls, comboCount, comboSum, "1) Close losing orders at market, 2) Modify winning orders with SL at current price");

   Print(">>> [METHOD 6 TRIGGERED] Combination of ", comboCount, " orders hit Profit = $", DoubleToString(comboSum, 2),
         " >= Threshold. Executing Action: 1) Close losing orders at market, 2) Modify profit orders with SL at current price.");

// 1. FIRST: Close losing orders at market
   for(int c = 0; c < comboCount; c++)
     {
      int idx = comboIndices[c];
      if(candProfits[idx] < 0.0)
        {
         int tkt = candTickets[idx];
         double lossUSD = candProfits[idx];
         Print(">>> [METHOD 6: CLOSING LOSING ORDER] Ticket #", tkt,
               " (", (candTypes[idx] == OP_BUY ? "BUY " : "SELL "), DoubleToString(candLots[idx], 2), "L)",
               " | Loss=-$", DoubleToString(MathAbs(lossUSD), 2),
               " closed at market as part of +$", DoubleToString(comboSum, 2), " combination!");

         if(CloseMarketOrderDirect(tkt))
           {
            RecordMethodModification(tkt, 6, comboCount, lossUSD);
           }
         isProcessed[idx] = true;
        }
     }

// 2. SECOND: Modify winning orders with StopLoss at Current Price
   RefreshRates();
   double curBid = MarketInfo(Symbol(), MODE_BID);
   double curAsk = MarketInfo(Symbol(), MODE_ASK);
   double minStopDist = GetRequiredStopDistance();
   if(minStopDist < 20.0)
      minStopDist = 20.0;

   for(int c = 0; c < comboCount; c++)
     {
      int idx = comboIndices[c];
      if(candProfits[idx] >= 0.0)
        {
         int tkt = candTickets[idx];
         int oType = candTypes[idx];
         double oOpen = candOpenPrices[idx];
         double oTP = candTakeProfits[idx];
         double winUSD = candProfits[idx];

         RefreshRates();
         curBid = MarketInfo(Symbol(), MODE_BID);
         curAsk = MarketInfo(Symbol(), MODE_ASK);

         // Current Price StopLoss (tightest broker-allowed stop)
         double targetSL = (oType == OP_BUY) ? NormalizeDouble(curBid - minStopDist, Digits)
                           : NormalizeDouble(curAsk + minStopDist, Digits);

         // Ensure profit order maintains at least Breakeven or breathing SL (USER RULE: VMULTI-1105)
         double beFloorM6 = GetEmaAngleBreakevenBreathingSL(oType, oOpen, oOpen);
         if(oType == OP_BUY && targetSL < beFloorM6)
            targetSL = beFloorM6;
         else
            if(oType == OP_SELL && targetSL > beFloorM6)
               targetSL = beFloorM6;

         if(targetSL > 0.0)
           {
            bool modified = SafeOrderModify(tkt, oOpen, targetSL, oTP, 0, (oType == OP_BUY ? clrLimeGreen : clrTomato), "Method 6");
            if(modified)
              {
               RecordMethodModification(tkt, 6, comboCount, winUSD);
               Print(">>> [METHOD 6: WINNER SL LOCKED AT CURRENT PRICE] Ticket #", tkt,
                     " (", (oType == OP_BUY ? "BUY " : "SELL "), DoubleToString(candLots[idx], 2), "L)",
                     " | Profit=+$", DoubleToString(winUSD, 2),
                     " | Locked SL=", DoubleToString(targetSL, Digits),
                     " (Current Price - ", DoubleToString(minStopDist, Digits), ")");
              }
           }
         isProcessed[idx] = true;
        }
     }

// Draw chart icon
   double iconPrice = (candTypes[comboIndices[0]] == OP_BUY ? MarketInfo(Symbol(), MODE_BID) : MarketInfo(Symbol(), MODE_ASK));
   DrawMethod6HitIcon(comboCount, comboSum, TimeCurrent(), iconPrice);
   InvalidateTotalEAOrdersCache();
  }

//+------------------------------------------------------------------+
//| ModifyMethod6MultiOrderCombinationsOver5USD                      |
//+------------------------------------------------------------------+
void ModifyMethod6MultiOrderCombinationsOver5USD()
  {
   if(!InpEnableMethod6CombinationSLModify)
      return;

#define MAX_M6_ORDERS 100
   int    candTickets[MAX_M6_ORDERS];
   int    candTypes[MAX_M6_ORDERS];
   double candLots[MAX_M6_ORDERS];
   double candOpenPrices[MAX_M6_ORDERS];
   double candStopLosses[MAX_M6_ORDERS];
   double candTakeProfits[MAX_M6_ORDERS];
   double candProfits[MAX_M6_ORDERS];
   bool   isProcessed[MAX_M6_ORDERS];
   ArrayInitialize(candTickets, 0);
   ArrayInitialize(candTypes, 0);
   ArrayInitialize(candLots, 0.0);
   ArrayInitialize(candOpenPrices, 0.0);
   ArrayInitialize(candStopLosses, 0.0);
   ArrayInitialize(candTakeProfits, 0.0);
   ArrayInitialize(candProfits, 0.0);
   ArrayInitialize(isProcessed, false);
   int candCount = 0;

   int mult = (balancelomultipler > 0) ? balancelomultipler : 1;
   double threshold = (InpMethod6ProfitThresholdUSD > 0.0 ? InpMethod6ProfitThresholdUSD : 20.0) * mult;
   int minOrders = (InpMethod6MinOrderCount >= 2) ? InpMethod6MinOrderCount : 2;

   for(int i = OrdersTotal() - 1; i >= 0 && candCount < MAX_M6_ORDERS; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;

      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;

      string cmt = OrderComment();
      int tkt    = OrderTicket();

      // Exclude recovery orders
      if(IsAnyRecoveryOrder(tkt, cmt) || IsRecoveryOrderWithActiveParent(tkt, cmt))
         continue;

      // Exclude FLIPBasketSupport orders
      if(IsFLIPBasketSupportOrder(tkt, cmt) || StringFind(cmt, "FLIPBasketSupport") >= 0)
         continue;

      candTickets[candCount]    = tkt;
      candTypes[candCount]      = oType;
      candLots[candCount]       = OrderLots();
      candOpenPrices[candCount] = OrderOpenPrice();
      candStopLosses[candCount] = OrderStopLoss();
      candTakeProfits[candCount]= OrderTakeProfit();
      candProfits[candCount]    = OrderProfit() + OrderSwap() + OrderCommission();
      isProcessed[candCount]    = false;
      candCount++;
     }

   if(candCount < minOrders)
      return;

// 1. PRIORITY PAIR CHECK (Win + Loss): Pair with at least one losing order if sum >= threshold
   if(minOrders <= 2)
     {
      int searchLimit2 = MathMin(candCount, 30);
      for(int i = 0; i < searchLimit2 - 1; i++)
        {
         if(isProcessed[i])
            continue;
         for(int j = i + 1; j < searchLimit2; j++)
           {
            if(isProcessed[j])
               continue;

            if(candProfits[i] < 0.0 || candProfits[j] < 0.0)
              {
               double sum2 = candProfits[i] + candProfits[j];
               if(sum2 >= threshold)
                 {
                  int combo[2];
                  combo[0] = i;
                  combo[1] = j;
                  ExecuteMethod6CombinationAction(combo, 2, sum2, candTickets, candTypes, candLots,
                                                  candOpenPrices, candTakeProfits, candProfits, isProcessed);
                  break;
                 }
              }
           }
        }
     }

// 2. PRIORITY TRIPLET CHECK (Win + Losses): Check combinations of 3 orders with at least one loss
   int searchLimit3 = MathMin(candCount, 20);
   for(int i = 0; i < searchLimit3 - 2; i++)
     {
      if(isProcessed[i])
         continue;
      for(int j = i + 1; j < searchLimit3 - 1; j++)
        {
         if(isProcessed[j])
            continue;
         for(int k = j + 1; k < searchLimit3; k++)
           {
            if(isProcessed[k])
               continue;

            if(candProfits[i] < 0.0 || candProfits[j] < 0.0 || candProfits[k] < 0.0)
              {
               double sum3 = candProfits[i] + candProfits[j] + candProfits[k];
               if(sum3 >= threshold)
                 {
                  int combo[3];
                  combo[0] = i;
                  combo[1] = j;
                  combo[2] = k;
                  ExecuteMethod6CombinationAction(combo, 3, sum3, candTickets, candTypes, candLots,
                                                  candOpenPrices, candTakeProfits, candProfits, isProcessed);
                  break;
                 }
              }
           }
         if(isProcessed[i])
            break;
        }
     }

// 3. PRIORITY QUARTET CHECK (Win + Losses): Check combinations of 4 orders with at least one loss
   int searchLimit4 = MathMin(candCount, 12);
   for(int i = 0; i < searchLimit4 - 3; i++)
     {
      if(isProcessed[i])
         continue;
      for(int j = i + 1; j < searchLimit4 - 2; j++)
        {
         if(isProcessed[j])
            continue;
         for(int k = j + 1; k < searchLimit4 - 1; k++)
           {
            if(isProcessed[k])
               continue;
            for(int m = k + 1; m < searchLimit4; m++)
              {
               if(isProcessed[m])
                  continue;

               if(candProfits[i] < 0.0 || candProfits[j] < 0.0 || candProfits[k] < 0.0 || candProfits[m] < 0.0)
                 {
                  double sum4 = candProfits[i] + candProfits[j] + candProfits[k] + candProfits[m];
                  if(sum4 >= threshold)
                    {
                     int combo[4];
                     combo[0] = i;
                     combo[1] = j;
                     combo[2] = k;
                     combo[3] = m;
                     ExecuteMethod6CombinationAction(combo, 4, sum4, candTickets, candTypes, candLots,
                                                     candOpenPrices, candTakeProfits, candProfits, isProcessed);
                     break;
                    }
                 }
              }
            if(isProcessed[i])
               break;
           }
         if(isProcessed[i])
            break;
        }
     }

// 4. ANY REMAINING PAIRS (e.g. 2 Wins >= threshold)
   if(minOrders <= 2)
     {
      int searchLimit2 = MathMin(candCount, 30);
      for(int i = 0; i < searchLimit2 - 1; i++)
        {
         if(isProcessed[i])
            continue;
         for(int j = i + 1; j < searchLimit2; j++)
           {
            if(isProcessed[j])
               continue;

            double sum2 = candProfits[i] + candProfits[j];
            if(sum2 >= threshold)
              {
               int combo[2];
               combo[0] = i;
               combo[1] = j;
               ExecuteMethod6CombinationAction(combo, 2, sum2, candTickets, candTypes, candLots,
                                               candOpenPrices, candTakeProfits, candProfits, isProcessed);
               break;
              }
           }
        }
     }

// 5. ANY REMAINING TRIPLETS (e.g. 3 Wins >= threshold)
   for(int i = 0; i < searchLimit3 - 2; i++)
     {
      if(isProcessed[i])
         continue;
      for(int j = i + 1; j < searchLimit3 - 1; j++)
        {
         if(isProcessed[j])
            continue;
         for(int k = j + 1; k < searchLimit3; k++)
           {
            if(isProcessed[k])
               continue;

            double sum3 = candProfits[i] + candProfits[j] + candProfits[k];
            if(sum3 >= threshold)
              {
               int combo[3];
               combo[0] = i;
               combo[1] = j;
               combo[2] = k;
               ExecuteMethod6CombinationAction(combo, 3, sum3, candTickets, candTypes, candLots,
                                               candOpenPrices, candTakeProfits, candProfits, isProcessed);
               break;
              }
           }
         if(isProcessed[i])
            break;
        }
     }

// 6. TOTAL BASKET CHECK (All remaining un-processed open orders)
   int remainingCount = 0;
   double totalBasketPL = 0.0;
   int basketIndices[MAX_M6_ORDERS];
   for(int b = 0; b < candCount; b++)
     {
      if(!isProcessed[b])
        {
         basketIndices[remainingCount] = b;
         totalBasketPL += candProfits[b];
         remainingCount++;
        }
     }

   if(remainingCount >= minOrders && totalBasketPL >= threshold)
     {
      ExecuteMethod6CombinationAction(basketIndices, remainingCount, totalBasketPL, candTickets, candTypes, candLots,
                                      candOpenPrices, candTakeProfits, candProfits, isProcessed);
     }
  }

//+------------------------------------------------------------------+
//| Modify SL to live price with $50 gap or close on server error    |
//+------------------------------------------------------------------+
bool CloseMarketOrderDirect(int ticket)
  {
   if(!OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
      return true; // Already closed

   int type = OrderType();
   if(type != OP_BUY && type != OP_SELL)
      return false;

   double lots = OrderLots();

// Direct market close to bank net combination profit
   return SafeOrderCloseMarket(ticket, lots, Slippage, (type == OP_BUY ? clrRed : clrBlue));
  }

//+------------------------------------------------------------------+
//| Close any combination of open orders when sum > $1 * multiplier  |
//| Supports 1, 2, 3 orders or entire basket, Buy or Sell or mixed   |
//+------------------------------------------------------------------+

//+------------------------------------------------------------------+
//| Helper to modify StopLoss with $150 gap or close combination order|
//+------------------------------------------------------------------+
bool ModifyOrCloseCombinationOrder(int ticket)
  {
   if(!InpCombinationModifySLWithGap)
      return CloseMarketOrderDirect(ticket);

   if(!OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
      return false;

   int oType = OrderType();
   double oOpen = OrderOpenPrice();
   double curSL = OrderStopLoss();
   double curTP = OrderTakeProfit();
   RefreshRates();
   double minStopDist = GetRequiredStopDistance();
   double curPL = OrderProfit() + OrderSwap() + OrderCommission();
   double gap = (InpCombinationSLGapUSD > 0.0) ? InpCombinationSLGapUSD : 150.0;
   double proposedSL = GetTrendAwareStopLoss(oType, gap, curSL, "Method 4", curPL, oOpen);

   double rawProfitGap = (oType == OP_BUY) ? (Bid - oOpen) : (oOpen - Ask);
   bool isSteepAngle = (InpEnableDoubleSlGapOnSteepAngle && MathAbs(GlobalEmaAngle30) > InpDoubleSlGapAngle);
   bool isProfitGapReached = (rawProfitGap > InpDoubleSlMinProfitGapRaw);

// Clamp proposedSL to openPrice or breathing SL if profit gap reached (USER RULE: VMULTI-1096 & VMULTI-1105)
   double beFloorM4 = GetEmaAngleBreakevenBreathingSL(oType, oOpen, oOpen);
   if(isProfitGapReached)
     {
      if(oType == OP_BUY && proposedSL < beFloorM4)
         proposedSL = beFloorM4;
      else
         if(oType == OP_SELL && proposedSL > beFloorM4)
            proposedSL = beFloorM4;
     }

   bool allowBreathingWidening = (isSteepAngle && isProfitGapReached && (oType == OP_BUY ? proposedSL >= beFloorM4 : proposedSL <= beFloorM4));

   if(oType == OP_BUY)
     {
      if(proposedSL < Bid && (curSL == 0.0 || (proposedSL > curSL && (proposedSL - curSL) >= MinimumSLModifyGapRaw) ||
                              (allowBreathingWidening && MathAbs(proposedSL - curSL) >= MinimumSLModifyGapRaw)))
         return SafeOrderModify(ticket, oOpen, proposedSL, curTP, 0, clrLimeGreen, "Method 4");
     }
   else
      if(oType == OP_SELL)
        {
         if(proposedSL > Ask && (curSL == 0.0 || (proposedSL < curSL && (curSL - proposedSL) >= MinimumSLModifyGapRaw) ||
                                 (allowBreathingWidening && MathAbs(proposedSL - curSL) >= MinimumSLModifyGapRaw)))
            return SafeOrderModify(ticket, oOpen, proposedSL, curTP, 0, clrTomato, "Method 4");
        }
   return true;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void CloseProfitableOrderCombinations()
  {
   if(!InpEnableCombinationProfitClose)
      return;

   int mult = (balancelomultipler > 0) ? balancelomultipler : 1;
   double minProfitUSD = (InpCombinationCloseProfitUSD > 0.0 ? InpCombinationCloseProfitUSD : 5.0) * mult;

// 1. Collect all open market orders for current symbol & magic number
#define MAX_COMB_ORDERS 100
   int    candTickets[MAX_COMB_ORDERS];
   int    candTypes[MAX_COMB_ORDERS];
   double candLots[MAX_COMB_ORDERS];
   double candProfits[MAX_COMB_ORDERS];
   bool   isClosed[MAX_COMB_ORDERS];
   ArrayInitialize(candTickets, 0);
   ArrayInitialize(candTypes, 0);
   ArrayInitialize(candLots, 0.0);
   ArrayInitialize(candProfits, 0.0);
   ArrayInitialize(isClosed, false);
   int    candCount = 0;

   for(int i = OrdersTotal() - 1; i >= 0 && candCount < MAX_COMB_ORDERS; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;

      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;

      string cmt = OrderComment();
      int tkt    = OrderTicket();

      // EXCLUDE RECOVERY ORDERS: Recovery orders manage their own independent basket
      if(IsAnyRecoveryOrder(tkt, cmt) || IsRecoveryOrderWithActiveParent(tkt, cmt))
         continue;

      // Exclude FLIPBasketSupport orders unless explicitly enabled
      if(!InpPairCombinationIncludeFlipBasket)
        {
         if(IsFLIPBasketSupportOrder(tkt, cmt) || StringFind(cmt, "FLIPBasketSupport") >= 0)
            continue;
        }

      candTickets[candCount] = tkt;
      candTypes[candCount]   = oType;
      candLots[candCount]    = OrderLots();
      candProfits[candCount] = OrderProfit() + OrderSwap() + OrderCommission();
      isClosed[candCount]    = false;
      candCount++;
     }

   if(candCount <= 0)
      return;

   bool anyOrdersClosed = false;

// 2. TOTAL BASKET CHECK (if all open orders combined sum >= minProfitUSD and count >= 2)
   if(candCount >= 2)
     {
      double totalBasketPL = 0.0;
      for(int b = 0; b < candCount; b++)
         totalBasketPL += candProfits[b];

      if(totalBasketPL >= minProfitUSD)
        {
         int m4bTkts[10];
         double m4bPls[10];
         for(int m4bi = 0; m4bi < candCount && m4bi < 10; m4bi++)
           {
            m4bTkts[m4bi] = candTickets[m4bi];
            m4bPls[m4bi] = candProfits[m4bi];
           }
         RecordMethodActionCluster(4, m4bTkts, m4bPls, candCount, totalBasketPL, "Method 4: Basket Combo Close at market");

         Print(">>> [COMBINATION CLOSE - ALL ORDERS] Total Basket Profit = $", DoubleToString(totalBasketPL, 2),
               " >= $", DoubleToString(minProfitUSD, 2), " | Closing ALL ", candCount, " open orders!");

         for(int b = 0; b < candCount; b++)
           {
            if(ModifyOrCloseCombinationOrder(candTickets[b]))
              {
               isClosed[b] = true;
               RecordMethodModification(candTickets[b], 4, candCount, totalBasketPL);
              }
           }
         if(!InpCombinationModifySLWithGap)
            DrawMultiOrderClosedIcon(candCount, TimeCurrent(), (candTypes[0] == OP_BUY ? Bid : Ask), totalBasketPL, "Method 4: Basket Combo Close", candTickets[0]);
         InvalidateTotalEAOrdersCache();
         return;
        }
     }

// 3. PRIORITY PAIR CHECK (Win + Loss): Pair a winning order with a losing order if sum >= minProfitUSD
   for(int i = 0; i < candCount - 1; i++)
     {
      if(isClosed[i])
         continue;
      for(int j = i + 1; j < candCount; j++)
        {
         if(isClosed[j])
            continue;

         // Check if at least one order is in loss (offsets losing order)
         if(candProfits[i] < 0.0 || candProfits[j] < 0.0)
           {
            double pairSum = candProfits[i] + candProfits[j];
            if(pairSum >= minProfitUSD)
              {
               int m4pTkts[2];
               double m4pPls[2];
               m4pTkts[0] = candTickets[i];
               m4pPls[0] = candProfits[i];
               m4pTkts[1] = candTickets[j];
               m4pPls[1] = candProfits[j];
               RecordMethodActionCluster(4, m4pTkts, m4pPls, 2, pairSum, "Method 4: Pair Combo Close at market");

               Print(">>> [COMBINATION CLOSE - PAIR (WIN+LOSS)] Ticket #", candTickets[i],
                     " (", (candTypes[i] == OP_BUY ? "BUY" : "SELL"), " $", DoubleToString(candProfits[i], 2), ") + Ticket #",
                     candTickets[j], " (", (candTypes[j] == OP_BUY ? "BUY" : "SELL"), " $", DoubleToString(candProfits[j], 2),
                     ") = Total $", DoubleToString(pairSum, 2), " >= $", DoubleToString(minProfitUSD, 2), " | Closing Pair!");

               int firstIdx  = (candProfits[i] >= candProfits[j]) ? i : j;
               int secondIdx = (firstIdx == i) ? j : i;

               if(ModifyOrCloseCombinationOrder(candTickets[firstIdx]))
                 {
                  isClosed[firstIdx] = true;
                  RecordMethodModification(candTickets[firstIdx], 4, 2, pairSum);
                 }
               if(ModifyOrCloseCombinationOrder(candTickets[secondIdx]))
                 {
                  isClosed[secondIdx] = true;
                  RecordMethodModification(candTickets[secondIdx], 4, 2, pairSum);
                 }
               if(!InpCombinationModifySLWithGap)
                  DrawMultiOrderClosedIcon(2, TimeCurrent(), (candTypes[i] == OP_BUY ? Bid : Ask), pairSum, "Method 4: Pair Combo Close", candTickets[i]);
               anyOrdersClosed = true;
               break; // ticket i is consumed, break inner loop
              }
           }
        }
     }

// 4. PRIORITY TRIPLET CHECK (Win + Losses): Check combinations of 3 orders with at least one loss
   int maxTripletSearch = MathMin(candCount, 30);
   for(int i = 0; i < maxTripletSearch - 2; i++)
     {
      if(isClosed[i])
         continue;
      for(int j = i + 1; j < maxTripletSearch - 1; j++)
        {
         if(isClosed[j])
            continue;
         for(int k = j + 1; k < maxTripletSearch; k++)
           {
            if(isClosed[k])
               continue;

            if(candProfits[i] < 0.0 || candProfits[j] < 0.0 || candProfits[k] < 0.0)
              {
               double tripletSum = candProfits[i] + candProfits[j] + candProfits[k];
               if(tripletSum >= minProfitUSD)
                 {
                  int m4tTkts[3];
                  double m4tPls[3];
                  m4tTkts[0] = candTickets[i];
                  m4tPls[0] = candProfits[i];
                  m4tTkts[1] = candTickets[j];
                  m4tPls[1] = candProfits[j];
                  m4tTkts[2] = candTickets[k];
                  m4tPls[2] = candProfits[k];
                  RecordMethodActionCluster(4, m4tTkts, m4tPls, 3, tripletSum, "Method 4: Triplet Combo Close at market");

                  Print(">>> [COMBINATION CLOSE - TRIPLET (WITH LOSS)] Tickets [#", candTickets[i], ", #", candTickets[j], ", #", candTickets[k],
                        "] = Total $", DoubleToString(tripletSum, 2), " >= $", DoubleToString(minProfitUSD, 2), " | Closing Triplet!");

                  int tIdx[3];
                  tIdx[0] = i;
                  tIdx[1] = j;
                  tIdx[2] = k;
                  for(int x = 0; x < 2; x++)
                    {
                     for(int y = x + 1; y < 3; y++)
                       {
                        if(candProfits[tIdx[x]] < candProfits[tIdx[y]])
                          {
                           int tmp = tIdx[x];
                           tIdx[x] = tIdx[y];
                           tIdx[y] = tmp;
                          }
                       }
                    }

                  for(int t = 0; t < 3; t++)
                    {
                     if(ModifyOrCloseCombinationOrder(candTickets[tIdx[t]]))
                       {
                        isClosed[tIdx[t]] = true;
                        RecordMethodModification(candTickets[tIdx[t]], 4, 3, tripletSum);
                       }
                    }
                  if(!InpCombinationModifySLWithGap)
                     DrawMultiOrderClosedIcon(3, TimeCurrent(), (candTypes[i] == OP_BUY ? Bid : Ask), tripletSum, "Method 4: Triplet Combo Close", candTickets[i]);
                  anyOrdersClosed = true;
                  break; // break k loop
                 }
              }
           }
         if(isClosed[i])
            break; // ticket i is consumed, break j loop
        }
     }

// 5. ANY REMAINING PAIR CHECK (e.g. 2 Wins >= minProfitUSD)
   for(int i = 0; i < candCount - 1; i++)
     {
      if(isClosed[i])
         continue;
      for(int j = i + 1; j < candCount; j++)
        {
         if(isClosed[j])
            continue;

         double pairSum = candProfits[i] + candProfits[j];
         if(pairSum >= minProfitUSD)
           {
            Print(">>> [COMBINATION CLOSE - PAIR] Ticket #", candTickets[i],
                  " (", (candTypes[i] == OP_BUY ? "BUY" : "SELL"), " $", DoubleToString(candProfits[i], 2), ") + Ticket #",
                  candTickets[j], " (", (candTypes[j] == OP_BUY ? "BUY" : "SELL"), " $", DoubleToString(candProfits[j], 2),
                  ") = Total $", DoubleToString(pairSum, 2), " >= $", DoubleToString(minProfitUSD, 2), " | Closing Pair!");

            int firstIdx  = (candProfits[i] >= candProfits[j]) ? i : j;
            int secondIdx = (firstIdx == i) ? j : i;

            if(ModifyOrCloseCombinationOrder(candTickets[firstIdx]))
              {
               isClosed[firstIdx] = true;
               RecordMethodModification(candTickets[firstIdx], 4, 2, pairSum);
              }
            if(ModifyOrCloseCombinationOrder(candTickets[secondIdx]))
              {
               isClosed[secondIdx] = true;
               RecordMethodModification(candTickets[secondIdx], 4, 2, pairSum);
              }
            if(!InpCombinationModifySLWithGap)
               DrawMultiOrderClosedIcon(2, TimeCurrent(), (candTypes[i] == OP_BUY ? Bid : Ask), pairSum, "Method 4: Pair Combo Close", candTickets[i]);
            anyOrdersClosed = true;
            break; // ticket i is consumed, break j loop
           }
        }
     }

// 6. ANY REMAINING TRIPLET CHECK (e.g. 3 Wins >= minProfitUSD)
   for(int i = 0; i < maxTripletSearch - 2; i++)
     {
      if(isClosed[i])
         continue;
      for(int j = i + 1; j < maxTripletSearch - 1; j++)
        {
         if(isClosed[j])
            continue;
         for(int k = j + 1; k < maxTripletSearch; k++)
           {
            if(isClosed[k])
               continue;

            double tripletSum = candProfits[i] + candProfits[j] + candProfits[k];
            if(tripletSum >= minProfitUSD)
              {
               Print(">>> [COMBINATION CLOSE - TRIPLET] Tickets [#", candTickets[i], ", #", candTickets[j], ", #", candTickets[k],
                     "] = Total $", DoubleToString(tripletSum, 2), " >= $", DoubleToString(minProfitUSD, 2), " | Closing Triplet!");

               int tIdx[3];
               tIdx[0] = i;
               tIdx[1] = j;
               tIdx[2] = k;
               for(int x = 0; x < 2; x++)
                 {
                  for(int y = x + 1; y < 3; y++)
                    {
                     if(candProfits[tIdx[x]] < candProfits[tIdx[y]])
                       {
                        int tmp = tIdx[x];
                        tIdx[x] = tIdx[y];
                        tIdx[y] = tmp;
                       }
                    }
                 }

               for(int t = 0; t < 3; t++)
                 {
                  if(ModifyOrCloseCombinationOrder(candTickets[tIdx[t]]))
                    {
                     isClosed[tIdx[t]] = true;
                     RecordMethodModification(candTickets[tIdx[t]], 4, 3, tripletSum);
                    }
                 }
               if(!InpCombinationModifySLWithGap)
                  DrawMultiOrderClosedIcon(3, TimeCurrent(), (candTypes[i] == OP_BUY ? Bid : Ask), tripletSum, "Method 4: Triplet Combo Close", candTickets[i]);
               anyOrdersClosed = true;
               break; // break k loop
              }
           }
         if(isClosed[i])
            break; // ticket i is consumed, break j loop
        }
     }

// 7. SINGLE ORDER CHECK (Any individual order with profit >= minProfitUSD, disabled by default to preserve ladder/TP)
   if(InpCombinationIncludeSingleOrders)
     {
      for(int i = 0; i < candCount; i++)
        {
         if(isClosed[i])
            continue;

         if(candProfits[i] >= minProfitUSD)
           {
            Print(">>> [COMBINATION CLOSE - SINGLE ORDER] Ticket #", candTickets[i],
                  " (", (candTypes[i] == OP_BUY ? "BUY" : "SELL"), " ", DoubleToString(candLots[i], 2),
                  " lots) Profit = $", DoubleToString(candProfits[i], 2), " >= $", DoubleToString(minProfitUSD, 2), " | Closing Order!");

            if(ModifyOrCloseCombinationOrder(candTickets[i]))
               isClosed[i] = true;
            anyOrdersClosed = true;
           }
        }
     }

   if(anyOrdersClosed)
      InvalidateTotalEAOrdersCache();
  }

//+------------------------------------------------------------------+
void SecureDistanceProfitLadder()
  {
// The raw price gap increment (e.g., 50.0 represents a $50 price movement in BTC)
   double distanceStep = 104;//50.0*3;

   if(distanceStep <= 0)
      return;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;

      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int type = OrderType();
      if(type != OP_BUY && type != OP_SELL)
         continue;

      RefreshRates();

      double currentSL = OrderStopLoss();
      double openPrice = OrderOpenPrice();

      // 1. Calculate safe StopLevel (Fallback to 2x Spread for Crypto brokers with bugged limits)
      double stopLevel = MarketInfo(Symbol(), MODE_STOPLEVEL) * Point;
      double spreadBuf = (Ask - Bid) * 2.0;
      double minSafeDistance = MathMax(stopLevel, spreadBuf);

      double maxLockableDistance = 0.0;

      // 2. Calculate the maximum raw distance we can safely lock right now
      if(type == OP_BUY)
         maxLockableDistance = (Bid - minSafeDistance) - openPrice;
      else
         if(type == OP_SELL)
            maxLockableDistance = openPrice - (Ask + minSafeDistance);

      // If we aren't even in profit, skip
      if(maxLockableDistance <= 0)
         continue;

      // 3. Determine the ladder level (1 = $50, 2 = $100, 3 = $150, etc.)
      int ladderLevel = (int)MathFloor(maxLockableDistance / distanceStep);

      // If price hasn't moved far enough to even lock the first step, skip
      if(ladderLevel < 1)
         continue;

      // 4. Calculate the exact price for this distance ladder rung
      double lockedDistance = ladderLevel * distanceStep;
      double newSL = 0.0;
      bool canModify = false;

      if(type == OP_BUY)
        {
         newSL = NormalizeDouble(openPrice + lockedDistance, Digits);

         // FINAL BROKER CHECK: Ensure live price hasn't suddenly dropped too close to our new SL
         if(Bid - newSL >= minSafeDistance)
           {
            // Ensure we only move the SL forward
            if(currentSL == 0.0 || newSL > currentSL + (Point / 2.0))
               canModify = true;
           }
        }
      else
         if(type == OP_SELL)
           {
            newSL = NormalizeDouble(openPrice - lockedDistance, Digits);

            // FINAL BROKER CHECK: Ensure live price hasn't suddenly spiked too close to our new SL
            if(newSL - Ask >= minSafeDistance)
              {
               // Ensure we only move the SL forward
               if(currentSL == 0.0 || newSL < currentSL - (Point / 2.0))
                  canModify = true;
              }
           }

      // 5. Modify the order with enhanced diagnostic logging
      if(canModify)
        {
         ResetLastError();
         bool modified =SafeOrderModify(OrderTicket(), openPrice, newSL, OrderTakeProfit(), 0, clrDodgerBlue);

         if(modified)
           {
            Print("Secured Distance Ladder: ", ladderLevel, "X (+$", DoubleToString(lockedDistance, 2), " price gap)",
                  " | Ticket=", OrderTicket(),
                  " | Type=", type == OP_BUY ? "BUY" : "SELL",
                  " | New SL=", DoubleToString(newSL, Digits));
           }
         else
           {
            // If it still fails, this print will tell you exactly why
            Print("FAILED MODIFY DISTANCE SL | Ticket=", OrderTicket(),
                  " | Error=", GetLastError(),
                  " | Ask=", DoubleToString(Ask, Digits),
                  " | Bid=", DoubleToString(Bid, Digits),
                  " | Curr SL=", DoubleToString(currentSL, Digits),
                  " | Attempted SL=", DoubleToString(newSL, Digits),
                  " | Min Broker Distance=", DoubleToString(minSafeDistance, Digits));
           }
        }
     }
  }
//+------------------------------------------------------------------+
//| GetLotBasedPriceGap: Dynamic price gap based on lot & multiplier  |
//| Base Lot 0.01 ->  gap                                        |
//| Base Lot 0.02 ->  gap                                         |
//| Base Lot 0.03 ->  gap                                         |
//| Base Lot 0.04 ->  gap                                         |
//| Base Lot 0.05 and above ->  gap                               |
//| Floor strictly at MinimumSLModifyGapRaw (.0)                  |
//+------------------------------------------------------------------+
double GetLotBasedPriceGap(double orderLots, int multiplier)
  {
   if(multiplier < 1)
      multiplier = 1;

// 1. Normalize lot size back to Base Lot
   double baseLot = NormalizeDouble(orderLots / (double)multiplier, 2);

// 2. Apply tiered gap schedule:
   double gap = 50.0;

   if(baseLot <= 0.015)
      gap = 100.0;
   else
      if(baseLot <= 0.025)
         gap = 80.0;
      else
         if(baseLot <= 0.035)
            gap = 70.0;
         else
            if(baseLot <= 0.045)
               gap = 60.0;
            else
               gap = 50.0; // 0.05 and all higher lots

// 3. Absolute safety floor against broker MinimumSLModifyGapRaw ()
   if(gap < MinimumSLModifyGapRaw)
      gap = MinimumSLModifyGapRaw;

   return gap;
  }

//+------------------------------------------------------------------+
//| GetEmaAngleBreakevenBreathingSL                                   |
//| USER RULE (VMULTI-1105):                                         |
//| When MathAbs(EMAangle) is more than 4, allow order to modify     |
//| extra -50 raw gap based on order price when new SL price is equal|
//| to order openprice (Breakeven).                                  |
//|   BUY : openPrice - 50.0 raw price gap                           |
//|   SELL: openPrice + 50.0 raw price gap                           |
//| Prevents orders from being stopped out at 0.00 profit during     |
//| minor 3-5 min pullbacks right before strong trend continuation.  |
//+------------------------------------------------------------------+
double GetEmaAngleBreakevenBreathingSL(int orderType, double openPrice, double proposedSL, double curAngle = 0.0)
  {
   if(!InpEnableEmaAngleBreakevenBreathing)
      return proposedSL;
   if(openPrice <= 0.0 || proposedSL <= 0.0)
      return proposedSL;

// Check if proposed SL is equal to order openPrice (Breakeven)
   if(NormalizeDouble(proposedSL, Digits) != NormalizeDouble(openPrice, Digits))
      return proposedSL;

   if(curAngle == 0.0)
     {
      curAngle = GlobalEmaAngle30;
      if(curAngle == 0.0)
         curAngle = GetEmaAngleDegrees(30);
     }

   if(MathAbs(curAngle) > InpEmaAngleBreakevenBreathingAngle)
     {
      double breathingSL = proposedSL;
      if(orderType == OP_BUY)
         breathingSL = NormalizeDouble(openPrice - InpEmaAngleBreakevenBreathingGapRaw, Digits);
      else
         if(orderType == OP_SELL)
            breathingSL = NormalizeDouble(openPrice + InpEmaAngleBreakevenBreathingGapRaw, Digits);

      Print(">>> [EMA ANGLE BREAKEVEN BREATHING] OrderType=", (orderType == OP_BUY ? "BUY" : "SELL"),
            " | OpenPrice=", DoubleToString(openPrice, Digits),
            " | SL adjusted from openPrice to Breathing SL=", DoubleToString(breathingSL, Digits),
            " (extra -50 raw gap based on order price, MathAbs(EMAangle)=", DoubleToString(MathAbs(curAngle), 2),
            " > ", DoubleToString(InpEmaAngleBreakevenBreathingAngle, 1), " deg)");

      return breathingSL;
     }

   return proposedSL;
  }

//+------------------------------------------------------------------+
//| CalculateProportionalLadderSL:                                   |
//| MAIN COMMON METHOD for Proportional Profit Ladder across ALL     |
//| methods and lot tiers:                                           |
//| Base Lot 0.01 -> Gap $100 (Level 1 @ +$125 -> SL openPrice +/-25)|
//| Base Lot 0.02 -> Gap $80  (Level 1 @ +$105 -> SL openPrice +/-25)|
//| Base Lot 0.03 -> Gap $70  (Level 1 @ +$95  -> SL openPrice +/-25)|
//| Base Lot 0.04 -> Gap $60  (Level 1 @ +$85  -> SL openPrice +/-25)|
//| Base Lot 0.05+-> Gap $50  (Level 1 @ +$75  -> SL openPrice +/-25)|
//|                                                                  |
//| Level 1: triggers at stepPriceGap + 25, locks +25 (openPrice+/-25|
//| Level 2: locks +1x stepPriceGap + 25 ($125 for 0.01L)            |
//| Level 3+:                                                        |
//|   - Under STRONG EMA: locks +(ladderLevel - 2)*stepPriceGap + 25 |
//|   - Under WEAK EMA:   locks +(ladderLevel - 1)*stepPriceGap + 25 |
//+------------------------------------------------------------------+
double CalculateProportionalLadderSL(int orderType, double openPrice, double orderLots)
  {
   if(orderLots <= 0.0 || openPrice <= 0.0)
      return 0.0;

   RefreshRates();
   double stopLevel = GetRequiredStopDistance();
   if(stopLevel < 10.0)
      stopLevel = 10.0;

// 1. Get dynamic step gap based on lot & multiplier
   double stepPriceGap = GetLotBasedPriceGap(orderLots, balancelomultipler);
   double extraMove    = MathMax(0.0, InpLadderStepExtraMoveRaw);
   double extraSL      = MathMax(0.0, InpLadderStepExtraSLRaw);

// 2. Halve the gap if EMA momentum weakened by 50%
   if(IsEmaWEAKDistanceReduced50PercentFromPeak())
     {
      //stepPriceGap = MathMax(MinimumSLModifyGapRaw, stepPriceGap / 2.0);
     }

   if(stepPriceGap <= 0.0)
      return 0.0;

// 3. Calculate maximum distance price has traveled into profit beyond broker buffer
   double maxLockableDistance = 0.0;
   if(orderType == OP_BUY)
      maxLockableDistance = (Bid - stopLevel) - openPrice;
   else
      if(orderType == OP_SELL)
         maxLockableDistance = openPrice - (Ask + stopLevel);

// If price has not reached Level 1 (1x stepPriceGap + extraMove, e.g. $125 for 0.01L), no ladder SL yet
   if(maxLockableDistance + (Point * 0.5) < (stepPriceGap + extraMove))
      return 0.0;

// 4. Determine ladder step (1 = 1x gap + extraMove, 2 = 2x gap + extraMove, etc.)
   int ladderLevel = (int)MathFloor(((maxLockableDistance - extraMove) + (Point * 0.5)) / stepPriceGap);
   if(ladderLevel < 1)
      return 0.0;

// USER RULE (VMULTI-1148):
// Level 1: triggers at stepPriceGap + 25 ($125 for 0.01L), locks +25 (SL = openPrice +/- 25)
// Level 2: locks +(1 * stepPriceGap) + 25 (+$125 for 0.01L)
// Level 3 onwards:
//   - Under STRONG EMA: locks +((ladderLevel - 2) * stepPriceGap) + 25
//   - Under WEAK EMA:   locks +((ladderLevel - 1) * stepPriceGap) + 25
   double lockedDistance = 0.0;
   if(ladderLevel == 1)
     {
      lockedDistance = extraSL;
     }
   else
      if(ladderLevel == 2)
        {
         lockedDistance = (1.0 * stepPriceGap) + extraSL;
        }
      else // ladderLevel >= 3
        {
         if(!IsEmaWEAKDistanceReduced50PercentFromPeak())
           {
            // Under STRONG EMA: Level 3 onwards keep 2x step cushion behind market + extraSL
            lockedDistance = ((ladderLevel - 2) * stepPriceGap) + extraSL;
           }
         else
           {
            // Under WEAK EMA: Retain standard 1x stepPriceGap cushion behind market + extraSL
            lockedDistance = ((ladderLevel - 1) * stepPriceGap) + extraSL;
           }
        }
   double ladderSL = 0.0;

   if(orderType == OP_BUY)
      ladderSL = NormalizeDouble(openPrice + lockedDistance, Digits);
   else
      if(orderType == OP_SELL)
         ladderSL = NormalizeDouble(openPrice - lockedDistance, Digits);

// USER RULE (VMULTI-1105): When Level 1 is exact Breakeven (lockedDistance <= 0) and MathAbs(EMAangle) > 4, allow extra -50 raw gap breathing SL
   if(ladderLevel == 1 && lockedDistance <= 0.0)
     {
      ladderSL = GetEmaAngleBreakevenBreathingSL(orderType, openPrice, ladderSL);
     }

   return ladderSL;
  }



//+------------------------------------------------------------------+
//| SecureOneDollarProfit: Lot & Multiplier-based Profit Ladder      |
//+------------------------------------------------------------------+
void SecureOneDollarProfit()
  {
   if(GetTotalEAOrders() <= 0)
      return;

   double stopLevel = GetRequiredStopDistance();
   if(stopLevel < 10.0)
      stopLevel = 10.0;

   double extraMove = MathMax(0.0, InpLadderStepExtraMoveRaw);
   double extraSL   = MathMax(0.0, InpLadderStepExtraSLRaw);
   double slGapMin  = GetEffectiveMinSLModifyGap();

   RefreshRates();

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;

      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int type = OrderType();
      if(type != OP_BUY && type != OP_SELL)
         continue;

      double orderLots = OrderLots();
      if(orderLots <= 0.0)
         continue;

      if(IsFLIPBasketSupportOrder(OrderTicket(), OrderComment()) || IsAnyRecoveryOrder(OrderTicket(), OrderComment()))
         continue;

      double currentSL = OrderStopLoss();
      double openPrice = OrderOpenPrice();
      int ticket       = OrderTicket();
      double currentTP = OrderTakeProfit();
      double curPL     = OrderProfit() + OrderSwap() + OrderCommission();

      // Check minimum profit with multiplier ($1.00 * multiplier)
      int mult = (balancelomultipler > 0) ? balancelomultipler : 1;
      double minProfitUSD = 1.0 * mult;
      if(curPL < minProfitUSD)
         continue; // Order must reach at least $1.00 * multiplier before securing profit

      // 1. Get dynamic price gap based on Lot & Multiplier
      double stepPriceGap = GetLotBasedPriceGap(orderLots, balancelomultipler);

      // 2. Halve the gap if EMA momentum weakened by 50%
      if(IsEmaWEAKDistanceReduced50PercentFromPeak())
        {
         //stepPriceGap = MathMax(MinimumSLModifyGapRaw, stepPriceGap / 2.0);
        }

      if(stepPriceGap <= 0.0)
         continue;

      // 3. Calculate maximum distance price has traveled into profit beyond broker buffer
      double maxLockableDistance = 0.0;
      if(type == OP_BUY)
         maxLockableDistance = (Bid - stopLevel) - openPrice;
      else
         if(type == OP_SELL)
            maxLockableDistance = openPrice - (Ask + stopLevel);

      if(maxLockableDistance + (Point * 0.5) < (stepPriceGap + extraMove))
         continue; // Price has not yet reached Level 1 threshold (stepPriceGap + extraMove)

      // 4. Determine ladder step (1 = 1x gap + extraMove, 2 = 2x gap + extraMove, etc.)
      int ladderLevel = (int)MathFloor(((maxLockableDistance - extraMove) + (Point * 0.5)) / stepPriceGap);
      if(ladderLevel < 1)
         continue;

      // USER RULE (VMULTI-1148):
      // Level 1: triggers at stepPriceGap + 25 ($125 for 0.01L), locks +25 (SL = openPrice +/- 25)
      // Level 2: locks +(1 * stepPriceGap) + 25 (+$125 for 0.01L)
      // Level 3 onwards:
      //   - Under STRONG EMA: locks +((ladderLevel - 2) * stepPriceGap) + 25
      //   - Under WEAK EMA:   locks +((ladderLevel - 1) * stepPriceGap) + 25
      double lockedDistance = 0.0;
      if(ladderLevel == 1)
        {
         lockedDistance = extraSL;
        }
      else
         if(ladderLevel == 2)
           {
            lockedDistance = (1.0 * stepPriceGap) + extraSL;
           }
         else // ladderLevel >= 3
           {
            if(!IsEmaWEAKDistanceReduced50PercentFromPeak())
              {
               // Under STRONG EMA: Level 3 onwards keep 2x step cushion behind market + extraSL
               lockedDistance = ((ladderLevel - 2) * stepPriceGap) + extraSL;
              }
            else
              {
               // Under WEAK EMA: Retain standard 1x stepPriceGap cushion behind market + extraSL
               lockedDistance = ((ladderLevel - 1) * stepPriceGap) + extraSL;
              }
           }
      double newSL = 0.0;
      bool canModify = false;

      if(type == OP_BUY)
        {
         newSL = NormalizeDouble(openPrice + lockedDistance, Digits);
         if(newSL >= openPrice && (currentSL == 0.0 || newSL >= currentSL + slGapMin))
            canModify = true;
        }
      else
         if(type == OP_SELL)
           {
            newSL = NormalizeDouble(openPrice - lockedDistance, Digits);
            if(newSL <= openPrice && (currentSL == 0.0 || newSL <= currentSL - slGapMin))
               canModify = true;
           }

      // 5. Modify order to lock profit at this ladder rung
      if(canModify)
        {
         ResetLastError();
         bool modified = SafeOrderModify(ticket, openPrice, newSL, currentTP, 0, (type == OP_BUY ? clrGreen : clrTomato));

         if(modified)
           {
            double actualSL = newSL;
            if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
               actualSL = OrderStopLoss();
            if(currentSL == 0.0 || MathAbs(actualSL - currentSL) >= Point * 0.5)
              {
               Print("Secured Lot-Based Ladder: ", ladderLevel, "X (Move>=$", DoubleToString(stepPriceGap + extraMove, 2),
                     " | Gap=$", DoubleToString(stepPriceGap, 2),
                     " | Locked=+$", DoubleToString(lockedDistance, 2), " pts)",
                     " | Ticket=", ticket,
                     " | Lots=", DoubleToString(orderLots, 2),
                     " | Type=", (type == OP_BUY ? "BUY" : "SELL"),
                     " | P/L=$", DoubleToString(curPL, 2), " >= $", DoubleToString(minProfitUSD, 2),
                     " | New SL=", DoubleToString(actualSL, Digits));
              }
           }
         else
           {
            Print("FAILED to secure Lot-Based Ladder SL | Ticket=", ticket,
                  " | Error=", GetLastError(),
                  " | Attempted SL=", DoubleToString(newSL, Digits));
           }
        }
     }
  }
//2026.09.22 09:42:18.950   2026.08.02 09:29:21  SSLCHANEL-1 BTCUSDm,M1: 5% EQUITY LADDER TARGET ADJUSTED | Baseline=$124.88 | CurrentEquity=$103.89 | OldTarget=$131.12 | Difference=$27.23 | NewTarget=$108.89
double gbltargetEquity=0;
int gbltargetEquityCounter=0;

//+------------------------------------------------------------------+
//| DrawTargetEquityHitCircle: Draws green circle icon on chart      |
//| when target equity (gbltargetEquity) is hit.                     |
//+------------------------------------------------------------------+
void DrawTargetEquityHitCircle(datetime time, double price, double targetVal, int step)
  {
   static datetime lastHitTime = 0;
   static double   lastHitTarget = 0.0;
// Prevent duplicate drawing on same bar for identical target value
   if(time == lastHitTime && MathAbs(targetVal - lastHitTarget) < 0.01)
      return;

   string objName = PREFIX + "TARGET_EQ_HIT_" + IntegerToString((int)time) + "_" + IntegerToString((int)targetVal);

   if(ObjectFind(0, objName) < 0)
     {
      // 1. Solid Green Circle Icon (Wingdings 159, Max Width 5)
      ObjectCreate(0, objName, OBJ_ARROW, 0, time, price);
      ObjectSetInteger(0, objName, OBJPROP_ARROWCODE, 159); // Wingdings 159: Solid circle / dot
      ObjectSetInteger(0, objName, OBJPROP_COLOR, clrLime); // Vibrant green color
      ObjectSetInteger(0, objName, OBJPROP_WIDTH, 5);       // Thick, highly visible
      ObjectSetInteger(0, objName, OBJPROP_BACK, false);
      ObjectSetInteger(0, objName, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, objName, OBJPROP_HIDDEN, false);
      ObjectSetString(0, objName, OBJPROP_TOOLTIP, StringFormat("Target Equity Hit: $%.2f | Step %d | Time: %s", targetVal, step, TimeToString(TimeCurrent(), TIME_SECONDS)));

      // 2. Descriptive Label Underneath Circle
      string lblName = objName + "_LBL";
      if(ObjectFind(0, lblName) < 0)
        {
         double lblPrice = price - MathMax(30 * Point, 15.0);
         ObjectCreate(0, lblName, OBJ_TEXT, 0, time, lblPrice);
         ObjectSetString(0, lblName, OBJPROP_TEXT, StringFormat("EQ Hit #%d ($%.2f)", step, targetVal));
         ObjectSetString(0, lblName, OBJPROP_FONT, "Arial Bold");
         ObjectSetInteger(0, lblName, OBJPROP_FONTSIZE, 8);
         ObjectSetInteger(0, lblName, OBJPROP_COLOR, clrLime);
         ObjectSetInteger(0, lblName, OBJPROP_BACK, false);
         ObjectSetInteger(0, lblName, OBJPROP_SELECTABLE, false);
         ObjectSetInteger(0, lblName, OBJPROP_HIDDEN, false);
        }

      ChartRedraw(0);
      lastHitTime = time;
      lastHitTarget = targetVal;
     }
  }

//+------------------------------------------------------------------+
//| Manage 5% / Step Ladder Target and Baseline                      |
//| Automatically resets target when account balance drops (e.g. SL) |
//| and trails target forward as profits are secured.                |
//+------------------------------------------------------------------+
void Manage5PercentLadderReset()
  {
   double currentBalance = AccountBalance();
   double curEquity      = AccountEquity();

// 1. Initial setup of baseline if uninitialized
   if(Ladder5PercentBaseline <= 0.0)
     {
      Ladder5PercentBaseline = currentBalance;
      gbltargetEquityCounter = 0;
     }

// 2. If no open market orders, keep baseline synchronized with current balance
   int marketOrders = GetTotalBuyOrders() + GetTotalSellOrders();
   if(marketOrders == 0)
     {
      Ladder5PercentBaseline = currentBalance;
      gbltargetEquityCounter = 0;
     }
// 3. Balance fall-down check: If an order hit negative loss SL and balance dropped below baseline
   else
      if(Ladder5PercentBaseline - currentBalance >= 0.01)
        {
         Print(
            "5% EQUITY LADDER RESET (BALANCE DROP) | OldBaseline=$", DoubleToString(Ladder5PercentBaseline, 2),
            " | NewBalance=$", DoubleToString(currentBalance, 2),
            " | DroppedBy=$", DoubleToString(Ladder5PercentBaseline - currentBalance, 2),
            " | Resetting baseline and target."
         );
         Ladder5PercentBaseline = currentBalance;
         gbltargetEquityCounter = 0;
        }
      // 4. Balance increase check: If orders closed in profit and balance increased above baseline
      else
         if(currentBalance - Ladder5PercentBaseline >= 0.01)
           {
            Print(
               "5% EQUITY LADDER BASELINE ADVANCED (PROFIT BANKED) | OldBaseline=$", DoubleToString(Ladder5PercentBaseline, 2),
               " | NewBalance=$", DoubleToString(currentBalance, 2),
               " | Gained=$", DoubleToString(currentBalance - Ladder5PercentBaseline, 2)
            );
            Ladder5PercentBaseline = currentBalance;
            gbltargetEquityCounter = 0;
           }

// 5. Calculate step amount based on multiplier
   double stepVal = (CloseOrdersAtProfitFromOpeningBalanceEveryStep > 0.0) ? CloseOrdersAtProfitFromOpeningBalanceEveryStep : 2.0;
   double stepAmount = stepVal * (balancelomultipler > 0 ? balancelomultipler : 1);

// 6. Calculate target equity based on baseline + current ladder step
   double targetEquity = Ladder5PercentBaseline + (stepAmount * (gbltargetEquityCounter + 1));
   gbltargetEquity = targetEquity;

// 7. Check if target equity reached
   if(curEquity >= targetEquity)
     {
      // USER RULE: If only ONE order is open and moving in positive profit direction,
      // PAUSE the equity profit hit process! Let the single-order profit ladder manage it.
      if(InpPauseEquityProfitHitOnSingleWinningOrder)
        {
         int mktCount = 0;
         int posCount = 0;
         int singleTkt = 0;
         double singlePL = 0.0;
         for(int i = OrdersTotal() - 1; i >= 0; i--)
           {
            if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
               continue;
            if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
               continue;
            if(IsAnyRecoveryOrder(OrderTicket(), OrderComment()))
               continue;
            int oType = OrderType();
            if(oType == OP_BUY || oType == OP_SELL)
              {
               mktCount++;
               double pl = OrderProfit() + OrderSwap() + OrderCommission();
               if(pl > 0.0)
                 {
                  posCount++;
                  singleTkt = OrderTicket();
                  singlePL = pl;
                 }
              }
           }
         if(mktCount == 1 && posCount == 1)
           {
            static datetime lastLogTime = 0;
            if(TimeCurrent() - lastLogTime >= 10)
              {
               lastLogTime = TimeCurrent();
               Print(">>> [TARGET EQUITY HIT PAUSED] Only 1 order open (#", singleTkt,
                     ") moving in profit direction (+$", DoubleToString(singlePL, 2),
                     "). Pausing target equity hit process to let single-order ladder run!");
              }
            return;
           }
        }

      Print(
         "5% EQUITY LADDER TARGET REACHED (Step ", (gbltargetEquityCounter + 1), ")",
         " | Equity=$", DoubleToString(curEquity, 2),
         " | Target=$", DoubleToString(targetEquity, 2),
         " | Baseline=$", DoubleToString(Ladder5PercentBaseline, 2),
         " | Securing open orders profit."
      );

      // Display circle green color icon on chart
      double iconOffset = MathMax(50 * Point, 25.0);
      DrawTargetEquityHitCircle(Time[0], Low[0] - iconOffset, targetEquity, gbltargetEquityCounter + 1);

      // Modify open orders to secure profit
      ModifyOpenOrdersToSecureProfit();

      // Advance to next ladder step
      gbltargetEquityCounter++;
      gbltargetEquity = Ladder5PercentBaseline + (stepAmount * (gbltargetEquityCounter + 1));

      InitializeDayProfitLadder();
     }
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void Manage5PercentLadderResetOld()
  {
   if(Ladder5PercentBaseline <= 0.0)
     {
      Ladder5PercentBaseline = AccountBalance();
      return;
     }

   double targetEquity = Ladder5PercentBaseline * (1.0 + (CloseOrdersAtProfitFromOpeningBalanceEveryStep*balancelomultipler / 100.0));

   if(AccountEquity() >= targetEquity)
     {
      Print("5% Equity Ladder Target Reached. Closing all orders and resetting.");
      // for(int i = OrdersTotal() - 1; i >= 0; i--)
      //   {
      //    if(OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
      //      {
