//+------------------------------------------------------------------+
//| Get the highest price reached since the last EMA direction flip  |
//+------------------------------------------------------------------+
double GetHighestPriceSinceEmaFlip()
  {
   RefreshRates();
   double highest = Ask;
   int flipShift = (EmaFlipTime > 0) ? iBarShift(Symbol(), Period(), EmaFlipTime, false) : MathMin(Bars - 1, 100);
   if(flipShift < 0 || flipShift >= Bars)
      flipShift = MathMin(Bars - 1, 100);

   for(int i = flipShift; i >= 0; i--)
     {
      if(High[i] > highest)
         highest = High[i];
     }
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int oType = OrderType();
      if(oType == OP_BUY || oType == OP_BUYSTOP || oType == OP_BUYLIMIT)
        {
         double oPrice = OrderOpenPrice();
         if(oPrice > highest)
            highest = oPrice;
        }
     }
   return highest;
  }

//+------------------------------------------------------------------+
//| Get the lowest price reached since the last EMA direction flip   |
//+------------------------------------------------------------------+
double GetLowestPriceSinceEmaFlip()
  {
   RefreshRates();
   double lowest = Bid;
   int flipShift = (EmaFlipTime > 0) ? iBarShift(Symbol(), Period(), EmaFlipTime, false) : MathMin(Bars - 1, 100);
   if(flipShift < 0 || flipShift >= Bars)
      flipShift = MathMin(Bars - 1, 100);

   for(int i = flipShift; i >= 0; i--)
     {
      if(Low[i] < lowest)
         lowest = Low[i];
     }
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int oType = OrderType();
      if(oType == OP_SELL || oType == OP_SELLSTOP || oType == OP_SELLLIMIT)
        {
         double oPrice = OrderOpenPrice();
         if(oPrice < lowest)
            lowest = oPrice;
        }
     }
   return lowest;
  }

//+------------------------------------------------------------------+
//| Previous EMA Cycle (Before Flip) Highest Values & 4X Buffer      |
//+------------------------------------------------------------------+
double g_prevEmaHighestDistance             = 0.0; // Peak EMA distance recorded during previous EMA trend before flip
double g_prevEma4XBuffer                    = 0.0; // 4X Peak + 100 buffer calculated from previous EMA trend
double g_prevEmaPeakPrice                   = 0.0; // Extreme price reached during previous EMA trend
int    g_prevEmaDirection                   = 0;   // Direction of previous EMA trend (+1 Bullish, -1 Bearish)
datetime g_prevEmaFlipTime                  = 0;   // Timestamp when previous EMA trend started

// Current EMA Cycle Values
double g_currentEmaHighestDistance          = 0.0; // Peak EMA distance during current active EMA trend
double g_currentEma4XBuffer                 = 0.0; // 4X Peak + 100 buffer for current active EMA trend
double g_currentEmaPeakPrice                = 0.0; // Extreme price reached during current active EMA trend

//+------------------------------------------------------------------+
//| Get the highest EMA expansion distance reached since EMA flip    |
//+------------------------------------------------------------------+
double GetHighestEmaDistanceSinceEmaFlip()
  {
   RefreshRates();
   double maxDist = 0.0;
   int flipShift = (EmaFlipTime > 0) ? iBarShift(Symbol(), Period(), EmaFlipTime, false) : MathMin(Bars - 1, 100);
   if(flipShift < 0 || flipShift >= Bars)
      flipShift = MathMin(Bars - 1, 100);

   for(int i = flipShift; i >= 0; i--)
     {
      double barEma = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, i);
      if(barEma > 0.0)
        {
         double dist = High[i] - barEma;
         if(dist > maxDist)
            maxDist = dist;
        }
     }
   return maxDist;
  }

//+------------------------------------------------------------------+
//| Get the lowest EMA expansion distance reached since EMA flip     |
//+------------------------------------------------------------------+
double GetLowestEmaDistanceSinceEmaFlip()
  {
   RefreshRates();
   double maxDist = 0.0;
   int flipShift = (EmaFlipTime > 0) ? iBarShift(Symbol(), Period(), EmaFlipTime, false) : MathMin(Bars - 1, 100);
   if(flipShift < 0 || flipShift >= Bars)
      flipShift = MathMin(Bars - 1, 100);

   for(int i = flipShift; i >= 0; i--)
     {
      double barEma = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, i);
      if(barEma > 0.0)
        {
         double dist = barEma - Low[i];
         if(dist > maxDist)
            maxDist = dist;
        }
     }
   return maxDist;
  }

//+------------------------------------------------------------------+
//| CalculatePreviousEmaCycleHighestDistance:                        |
//| Scans backward through candle history to identify the previous   |
//| EMA trend cycle (before the most recent flip) and finds the peak |
//| expansion distance and peak price reached during that cycle.     |
//+------------------------------------------------------------------+
double CalculatePreviousEmaCycleHighestDistance(int &outPrevDirection, double &outPeakPrice, datetime &outPrevFlipTime)
  {
   RefreshRates();
   outPrevDirection = 0;
   outPeakPrice = 0.0;
   outPrevFlipTime = 0;

   int lookback = MathMin(Bars - 2, 5000);
   if(lookback < 5)
      return 0.0;

   double curEma = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, 0);
   if(curEma <= 0.0)
      return 0.0;
   int currentDir = (Close[0] >= curEma) ? 1 : -1;

   int flip1_shift = -1;
   for(int i = 1; i < lookback; i++)
     {
      double ema_i = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, i);
      if(ema_i <= 0.0)
         continue;
      if(currentDir == 1 && Close[i] < ema_i)
        {
         flip1_shift = i;
         break;
        }
      else
         if(currentDir == -1 && Close[i] > ema_i)
           {
            flip1_shift = i;
            break;
           }
     }

   if(flip1_shift < 0)
      return 0.0;

   int prevDir = -currentDir;
   outPrevDirection = prevDir;

   int flip2_shift = lookback - 1;
   for(int j = flip1_shift; j < lookback; j++)
     {
      double ema_j = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, j);
      if(ema_j <= 0.0)
         continue;
      if(prevDir == 1 && Close[j] < ema_j)
        {
         flip2_shift = j;
         break;
        }
      else
         if(prevDir == -1 && Close[j] > ema_j)
           {
            flip2_shift = j;
            break;
           }
     }

   outPrevFlipTime = Time[flip2_shift];

   double maxDist = 0.0;
   double peakPrice = (prevDir == 1) ? 0.0 : 999999.0;

   for(int k = flip2_shift; k >= flip1_shift; k--)
     {
      double barEma = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, k);
      if(barEma <= 0.0)
         continue;

      if(prevDir == 1)
        {
         double dist = High[k] - barEma;
         if(dist > maxDist)
            maxDist = dist;
         if(High[k] > peakPrice)
            peakPrice = High[k];
        }
      else
        {
         double dist = barEma - Low[k];
         if(dist > maxDist)
            maxDist = dist;
         if(Low[k] < peakPrice)
            peakPrice = Low[k];
        }
     }

   outPeakPrice = peakPrice;
   return maxDist;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void InitializePreviousEmaCycleValues()
  {
   if(g_prevEmaHighestDistance > 0.0)
      return;

   int prevDir = 0;
   double peakPrice = 0.0;
   datetime prevFlipTime = 0;
   double peakDist = CalculatePreviousEmaCycleHighestDistance(prevDir, peakPrice, prevFlipTime);
   if(peakDist > 0.0)
     {
      double mult = (InpEmaFlipWideBreathingMultiplier > 0.0) ? InpEmaFlipWideBreathingMultiplier : 4.0;
      double extraSafe = (InpEmaFlipWideBreathingSafeExtraRaw > 0.0) ? InpEmaFlipWideBreathingSafeExtraRaw : 100.0;
      double minFloor = (InpEmaFlipWideBreathingMinFloorRaw > 0.0) ? InpEmaFlipWideBreathingMinFloorRaw : 1000.0;
      g_prevEmaHighestDistance = peakDist;
      g_prevEmaPeakPrice       = peakPrice;
      g_prevEmaDirection       = prevDir;
      g_prevEmaFlipTime        = prevFlipTime;
      g_prevEma4XBuffer        = MathMax(minFloor, (peakDist * mult) + extraSafe);

      Print(">>> [INIT PREV EMA CYCLE] Loaded from history: PrevDir=", (prevDir == 1 ? "BULLISH(+1)" : "BEARISH(-1)"),
            " | PrevHighestDist=$", DoubleToString(g_prevEmaHighestDistance, 2),
            " | PrevPeakPrice=", DoubleToString(g_prevEmaPeakPrice, Digits),
            " | Prev4XBuffer=$", DoubleToString(g_prevEma4XBuffer, 2),
            " | PrevFlipTime=", TimeToString(g_prevEmaFlipTime));
     }
  }

//+------------------------------------------------------------------+
//| CapStopLossByEmaDistance: Caps BUY SL >= EMA - HighestDist,      |
//| and SELL SL <= EMA + HighestDist to prevent extreme SL placement |
//+------------------------------------------------------------------+
double CapStopLossByEmaDistance(int orderType, double proposedSL)
  {
   if(!InpLimitSLToEmaHighestDistance)
      return proposedSL;
   if(proposedSL <= 0.0)
      return proposedSL;

   double liveEma = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, 0);
   if(liveEma <= 0.0)
      return proposedSL;

   if(orderType == OP_BUY)
     {
      double highestEmaDist = GetHighestEmaDistanceSinceEmaFlip();
      if(highestEmaDist <= 0.0)
         highestEmaDist = 200.0;
      double floorSL = NormalizeDouble(liveEma - highestEmaDist, Digits);
      if(proposedSL < floorSL)
        {
         Print(">>> [EMA DIST SL CAP] BUY Proposed SL=", DoubleToString(proposedSL, Digits),
               " capped to Floor (EMA-HighestDist)=", DoubleToString(floorSL, Digits),
               " | EMA=", DoubleToString(liveEma, Digits), ", Dist=", DoubleToString(highestEmaDist, 2));
         proposedSL = floorSL;
        }
     }
   else
      if(orderType == OP_SELL)
        {
         double maxDist = MathMax(GetLowestEmaDistanceSinceEmaFlip(), GetHighestEmaDistanceSinceEmaFlip());
         if(maxDist <= 0.0)
            maxDist = 200.0;
         double ceilingSL = NormalizeDouble(liveEma + maxDist, Digits);
         if(proposedSL > ceilingSL)
           {
            Print(">>> [EMA DIST SL CAP] SELL Proposed SL=", DoubleToString(proposedSL, Digits),
                  " capped to Ceiling (EMA+Dist)=", DoubleToString(ceilingSL, Digits),
                  " | EMA=", DoubleToString(liveEma, Digits), ", Dist=", DoubleToString(maxDist, 2));
            proposedSL = ceilingSL;
           }
        }

   return proposedSL;
  }

//+------------------------------------------------------------------+
//| ApplyEmaFlipWideBreathingProtection:                             |
//| USER RULE: "If BUY order is in loss and EMADirection changed     |
//|  from 1 to -1, get the highest top EMAdistance before flip       |
//|  (e.g. 200). Then after flip modify BUY order with stoploss      |
//|  200X2+100 (safedistance) or (Peak - LivePrice) + 100.           |
//|  Same for SELL orders also when flipping from -1 to 1."          |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| EMA Flip Half-Distance 50% Partial Loss Cut Tracking             |
//+------------------------------------------------------------------+
double g_emaFlipHalfDistanceCutGap          = 0.0;
double g_emaFlipHalfDistanceReferencePrice  = 0.0;
int    g_emaFlipHalfDistanceDirection       = 0;
int    g_emaFlipCutTickets[];
int    g_emaFlipBreathingTickets[];

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void RegisterEmaFlipBreathingTicket(int ticket)
  {
   int sz = ArraySize(g_emaFlipBreathingTickets);
   ArrayResize(g_emaFlipBreathingTickets, sz + 1);
   g_emaFlipBreathingTickets[sz] = ticket;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsEmaFlipBreathingOrder(int ticket)
  {
   int sz = ArraySize(g_emaFlipBreathingTickets);
   for(int i = 0; i < sz; i++)
     {
      if(g_emaFlipBreathingTickets[i] == ticket)
         return true;
     }
   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void ResetEmaFlipBreathingTickets()
  {
   ArrayResize(g_emaFlipBreathingTickets, 0);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void PruneEmaFlipBreathingTickets()
  {
   int sz = ArraySize(g_emaFlipBreathingTickets);
   if(sz == 0)
      return;
   int kept = 0;
   for(int i = 0; i < sz; i++)
     {
      int tkt = g_emaFlipBreathingTickets[i];
      if(OrderSelect(tkt, SELECT_BY_TICKET, MODE_TRADES))
        {
         if(OrderCloseTime() == 0)
           {
            g_emaFlipBreathingTickets[kept] = tkt;
            kept++;
           }
        }
     }
   if(kept < sz)
      ArrayResize(g_emaFlipBreathingTickets, kept);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool HasTicketBeenEmaFlipCut(int ticket, string comment = "")
  {
   int orig = GetOriginalTicket(ticket, comment);
   int size = ArraySize(g_emaFlipCutTickets);
   for(int i = 0; i < size; i++)
     {
      if(g_emaFlipCutTickets[i] == ticket || g_emaFlipCutTickets[i] == orig)
         return true;
     }
   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void RegisterEmaFlipCutTicket(int ticket)
  {
   int size = ArraySize(g_emaFlipCutTickets);
   ArrayResize(g_emaFlipCutTickets, size + 1);
   g_emaFlipCutTickets[size] = ticket;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void ResetEmaFlipCutTickets()
  {
   ArrayResize(g_emaFlipCutTickets, 0);
   g_emaFlipHalfDistanceCutGap = 0.0;
   g_emaFlipHalfDistanceReferencePrice = 0.0;
   g_emaFlipHalfDistanceDirection = 0;
  }

//+------------------------------------------------------------------+
//| Equity Hit Target Secured Orders Tracking                         |
//| USER RULE: "equity hit target is modified 2 orders. next time    |
//|  horizontal line or emaflip changed or soemthing is happend.     |
//|  then, do not modify these orders with high stoploss values.     |
//|  means, profit stoploss valu ok. , loss stoploss is not ok."     |
//+------------------------------------------------------------------+
int  g_equityHitSecuredTickets[];
bool InpProtectEquityHitOrdersFromLossSL = true; // Protect orders secured by equity target hit from receiving loss StopLoss

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void RegisterEquityHitSecuredOrder(int ticket)
  {
   int sz = ArraySize(g_equityHitSecuredTickets);
   for(int i = 0; i < sz; i++)
     {
      if(g_equityHitSecuredTickets[i] == ticket)
         return;
     }
   ArrayResize(g_equityHitSecuredTickets, sz + 1);
   g_equityHitSecuredTickets[sz] = ticket;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsEquityHitSecuredOrder(int ticket)
  {
   if(!InpProtectEquityHitOrdersFromLossSL)
      return false;
   int sz = ArraySize(g_equityHitSecuredTickets);
   for(int i = 0; i < sz; i++)
     {
      if(g_equityHitSecuredTickets[i] == ticket)
         return true;
     }
   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void PruneEquityHitSecuredTickets()
  {
   int sz = ArraySize(g_equityHitSecuredTickets);
   if(sz == 0)
      return;
   int kept = 0;
   for(int i = 0; i < sz; i++)
     {
      int tkt = g_equityHitSecuredTickets[i];
      if(OrderSelect(tkt, SELECT_BY_TICKET, MODE_TRADES))
        {
         if(OrderCloseTime() == 0)
           {
            g_equityHitSecuredTickets[kept] = tkt;
            kept++;
           }
        }
     }
   if(kept < sz)
      ArrayResize(g_equityHitSecuredTickets, kept);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void ResetEquityHitSecuredTickets()
  {
   ArrayResize(g_equityHitSecuredTickets, 0);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void CheckEmaFlipHalfDistancePartialLossCut()
  {
   if(!InpEnableEmaFlipHalfDistPartialCut)
      return;

// Only active if an EMA flip occurred and we have a stored previous 4X buffer or active breathing orders
   if(g_prevEma4XBuffer <= 0.0 && ArraySize(g_emaFlipBreathingTickets) == 0 && g_emaFlipHalfDistanceCutGap <= 0.0)
      return;

   RefreshRates();

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;

      // Only orders opposite to current EMA trend (e.g. BUY when Bearish -1, SELL when Bullish +1)
      if(EMADirection == -1 && oType != OP_BUY)
         continue;
      if(EMADirection == 1 && oType != OP_SELL)
         continue;

      int tkt = OrderTicket();
      string comm = OrderComment();
      if(!InpApplyBreathingToHorizontalOrders && IsHorizontalLineOrder(tkt, comm))
         continue;
      if(HasTicketBeenEmaFlipCut(tkt, comm))
         continue;

      double oLots = OrderLots();
      if(oLots <= 0.01)
         continue; // User rule: only if LOT > 0.01 (e.g. 0.02)

      double pl = OrderProfit() + OrderSwap() + OrderCommission();
      if(pl >= 0.0)
         continue; // Only for losing orders

      double openPrice = OrderOpenPrice();
      double curSL     = OrderStopLoss();

      // Calculate total dollar loss if price hits Stop Loss:
      // If curSL is set: MathAbs(openPrice - curSL) * oLots in dollars
      // If curSL is not set yet: g_prevEma4XBuffer * oLots in dollars
      double slDist = (curSL > 0.0) ? MathAbs(openPrice - curSL) : g_prevEma4XBuffer;
      if(slDist <= 0.0 && g_prevEma4XBuffer > 0.0)
         slDist = g_prevEma4XBuffer;
      if(slDist <= 0.0)
         continue;

      // Dollar loss at SL (e.g. $2348 * 0.02 = $46.96 total loss at SL)
      double totalLossAtSL = slDist * oLots;
      double calcLoss = MathAbs(CalcOrderLockedProfitUSD(oType, openPrice, (curSL > 0.0 ? curSL : (oType == OP_BUY ? openPrice - slDist : openPrice + slDist)), oLots));
      if(calcLoss > 0.0)
         totalLossAtSL = calcLoss;

      if(totalLossAtSL <= 0.0)
         continue;

      // USER PLAN: "if order current loss the half of the total Stoploss if LOT is 0.02 and new stoploss is $2348 so, total loss is $46+... if loss is like $23 then close the 0.01 LOT from 0.02"
      double halfLossTargetUSD = totalLossAtSL * 0.5;
      double currentLossUSD = MathAbs(pl);

      // Do NOT cut if loss is smaller than half of the StopLoss risk (e.g. -$4.62 is < $23.00)
      if(currentLossUSD < halfLossTargetUSD)
         continue;

      // Reached half of total StopLoss loss! Close 50% of the lot (e.g. 0.01 from 0.02)
      double lotStep = MarketInfo(Symbol(), MODE_LOTSTEP);
      if(lotStep <= 0.0)
         lotStep = 0.01;
      double halfLots = NormalizeDouble(MathFloor((oLots * 0.5) / lotStep) * lotStep, 2);
      if(halfLots < lotStep)
         halfLots = lotStep;
      if(oLots - halfLots < lotStep)
         continue;

      ResetLastError();
      bool closed = SafeOrderCloseMarket(tkt, halfLots, 20, clrOrangeRed);
      if(closed)
        {
         RegisterEmaFlipCutTicket(tkt);
         Print(">>> [EMA FLIP 50% PARTIAL LOSS CUT] Order #", tkt, " (", DoubleToString(oLots, 2),
               "L) reached 50% of total StopLoss dollar risk: Current Loss=$", DoubleToString(currentLossUSD, 2),
               " >= Half SL Loss ($", DoubleToString(halfLossTargetUSD, 2),
               " of $", DoubleToString(totalLossAtSL, 2), " Total SL Risk). Closed 50% (", DoubleToString(halfLots, 2), "L).");
        }
      else
        {
         Print(">>> [EMA FLIP 50% PARTIAL CUT FAILED] Ticket #", tkt, " Err=", GetLastError());
        }
     }
  }

//+------------------------------------------------------------------+
//| CheckMaxLossCap001Lots: Closes 0.01 lot orders if floating loss  |
//| breaches InpMaxLoss001LotsUSD threshold to prevent runaway losses|
//+------------------------------------------------------------------+
void CheckMaxLossCap001Lots()
  {
   if(!InpEnableMaxLossCap001Lots)
      return;

   double maxLossUSD = InpMaxLoss001LotsUSD * balancelomultipler;
   if(maxLossUSD <= 0.0)
      return;

   RefreshRates();

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;

      double oLots = OrderLots();
      // Specifically target 0.01 lot orders (and small runner leftovers <= 0.015 * multiplier)
      if(oLots > 0.015 * balancelomultipler)
         continue;

      double pl = OrderProfit() + OrderSwap() + OrderCommission();
      if(pl <= -maxLossUSD)
        {
         int tkt = OrderTicket();
         ResetLastError();
         bool closed = SafeOrderCloseMarket(tkt, oLots, Slippage, clrRed);
         if(closed)
           {
            Print(">>> [0.01 MAX LOSS CAP HIT] Ticket #", tkt, " (", (oType == OP_BUY ? "BUY " : "SELL "),
                  DoubleToString(oLots, 2), "L) reached max loss cap: Loss=$", DoubleToString(pl, 2),
                  " <= -$", DoubleToString(maxLossUSD, 2), ". Order closed to protect capital!");
            InvalidateTotalEAOrdersCache();
           }
         else
           {
            Print(">>> [0.01 MAX LOSS CAP CLOSE FAILED] Ticket #", tkt, " Err=", GetLastError());
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| 90% StopLoss Adverse Distance 50% LOT Cut & Double SL Cushion    |
//| User Rule:                                                       |
//| - If order StopLoss distance from OpenPrice is > 1000 pts (USD)  |
//| - When adverse price move reaches 90% of that StopLoss distance  |
//|   (e.g. SL distance 1500, adverse move reaches 1350):            |
//|   1. Close 50% of LOT (e.g. 0.06 -> 0.03L)                       |
//|   2. Modify remaining LOT StopLoss to DOUBLE distance (3000 pts) |
//+------------------------------------------------------------------+
#define MAX_90PCT_CUT_ORDERS 500
int      g_orders90PctCutTickets[MAX_90PCT_CUT_ORDERS];
int      g_orders90PctCutCount = 0;

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool HasOrderReceived90PctCut(int ticket, string comment = "")
  {
   if(ticket <= 0)
      return false;

   for(int i = 0; i < g_orders90PctCutCount; i++)
     {
      if(g_orders90PctCutTickets[i] == ticket)
         return true;
     }

   if(GlobalVariableCheck("EA_90PCT_CUT_" + IntegerToString(ticket)))
      return true;

   int parentTkt = GetOriginalTicket(ticket, comment);
   if(parentTkt > 0 && parentTkt != ticket)
     {
      for(int i = 0; i < g_orders90PctCutCount; i++)
        {
         if(g_orders90PctCutTickets[i] == parentTkt)
            return true;
        }
      if(GlobalVariableCheck("EA_90PCT_CUT_" + IntegerToString(parentTkt)))
         return true;
     }
   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void RegisterOrder90PctCut(int ticket)
  {
   if(ticket <= 0)
      return;
   for(int i = 0; i < g_orders90PctCutCount; i++)
     {
      if(g_orders90PctCutTickets[i] == ticket)
         return;
     }
   if(g_orders90PctCutCount < MAX_90PCT_CUT_ORDERS)
     {
      g_orders90PctCutTickets[g_orders90PctCutCount++] = ticket;
     }
// Persist to terminal GlobalVariable so order is strictly modified ONE TIME ONLY
   GlobalVariableSet("EA_90PCT_CUT_" + IntegerToString(ticket), 1.0);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void Check90PctSLAdversePartialCutAndDoubleSL()
  {
   if(!InpEnable90PctSLAdverseCutDoubleSL)
      return;

   if(OrdersTotal() <= 0)
      return;

   RefreshRates();
   double curBid = MarketInfo(Symbol(), MODE_BID);
   double curAsk = MarketInfo(Symbol(), MODE_ASK);
   double lotStep = MarketInfo(Symbol(), MODE_LOTSTEP);
   if(lotStep <= 0.0)
      lotStep = 0.01;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;

      int tkt = OrderTicket();
      string comm = OrderComment();

      if(HasOrderReceived90PctCut(tkt, comm))
         continue;

      double oLots = OrderLots();
      if(oLots <= lotStep)
         continue; // Only orders with Lots > 0.01 can be halved (e.g. 0.02, 0.03, 0.04, 0.06)

      double openPrice = OrderOpenPrice();
      double curSL     = OrderStopLoss();
      if(curSL <= 0.0)
         continue; // Must have an active StopLoss

      // Calculate StopLoss distance in USD / price points from entry
      double slDist = 0.0;
      double adverseDist = 0.0;

      if(oType == OP_BUY)
        {
         slDist = openPrice - curSL;
         adverseDist = openPrice - curBid;
        }
      else
         if(oType == OP_SELL)
           {
            slDist = curSL - openPrice;
            adverseDist = curAsk - openPrice;
           }

      // 1. Condition: StopLoss distance is above 1000 points
      if(slDist < Inp90PctSLMinStopLossDistanceUSD)
         continue;

      // 2. Condition: Adverse distance reached 90% of StopLoss distance (e.g. 1350 of 1500)
      double thresholdDist = slDist * Inp90PctSLAdversePercent;
      if(adverseDist < thresholdDist)
         continue;

      // Calculate 50% lots to close
      double halfLots = NormalizeDouble(MathFloor((oLots * 0.5) / lotStep) * lotStep, 2);
      if(halfLots < lotStep)
         halfLots = lotStep;
      if((oLots - halfLots) < lotStep)
         continue;

      // Calculate new StopLoss with +$500 raw price expansion (ONE TIME ONLY per order, DO NOT DOUBLE)
      double slExpansionUSD = (Inp90PctSLExpansionGapUSD > 0.0) ? Inp90PctSLExpansionGapUSD : 500.0;
      double expandedSLDist = slDist + slExpansionUSD;
      double newSL = 0.0;
      if(oType == OP_BUY)
         newSL = NormalizeDouble(openPrice - expandedSLDist, Digits);
      else
         if(oType == OP_SELL)
            newSL = NormalizeDouble(openPrice + expandedSLDist, Digits);

      Print(">>> [90% SL ADVERSE TRIGGER] Order #", tkt, " (", (oType == OP_BUY ? "BUY " : "SELL "),
            DoubleToString(oLots, 2), "L | Open=", DoubleToString(openPrice, Digits),
            " | SL=", DoubleToString(curSL, Digits), " | SL Dist=$", DoubleToString(slDist, 2),
            "): Adverse Move=$", DoubleToString(adverseDist, 2), " >= 90% ($", DoubleToString(thresholdDist, 2),
            "). Closing 50% LOT (", DoubleToString(halfLots, 2), "L) and Expanding SL by +$",
            DoubleToString(slExpansionUSD, 2), " to $", DoubleToString(expandedSLDist, 2),
            " (New SL=", DoubleToString(newSL, Digits), ") [ONE TIME ONLY]...");

      // Register ticket immediately to prevent duplicate triggers (strictly 1 time per order)
      RegisterOrder90PctCut(tkt);

      // ACTION 1: Expand StopLoss by +$500 FIRST on existing order for immediate breathing room
      ResetLastError();
      bool modified = SafeOrderModify(tkt, openPrice, newSL, OrderTakeProfit(), 0, clrOrange, "Emergency90PercentSLCutPlus500SL");
      if(modified)
        {
         Print(">>> [90% SL ADVERSE SL EXPANDED +$500 FIRST] Order #", tkt, " (", DoubleToString(oLots, 2),
               "L): SL successfully expanded by +$", DoubleToString(slExpansionUSD, 2), " to ", DoubleToString(newSL, Digits),
               " (Total SL Distance: $", DoubleToString(expandedSLDist, 2), ") [ONE TIME ONLY] before closing 50% LOT.");
        }
      else
        {
         Print(">>> [90% SL ADVERSE SL MODIFY FAILED] Order #", tkt, " Err=", GetLastError(),
               " Attempted SL=", DoubleToString(newSL, Digits));
        }

      // ACTION 2: Now close 50% LOT at market
      RefreshRates();
      ResetLastError();
      bool closed = SafeOrderCloseMarket(tkt, halfLots, Slippage, clrOrangeRed);
      if(!closed)
        {
         Print(">>> [90% SL ADVERSE FAILED] Could not close 50% LOT for #", tkt, " Err=", GetLastError());
         continue;
        }

      Print(">>> [90% SL ADVERSE CLOSED 50%] Order #", tkt, " closed ", DoubleToString(halfLots, 2),
            "L successfully. Remaining runner inherits +$500 expanded SL.");

      // Register and verify remaining runner order (or child split ticket)
      RefreshRates();
      for(int r = OrdersTotal() - 1; r >= 0; r--)
        {
         if(!OrderSelect(r, SELECT_BY_POS, MODE_TRADES))
            continue;
         if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
            continue;

         int rTkt = OrderTicket();
         string rComm = OrderComment();
         if(rTkt == tkt || StringFind(rComm, "from #" + IntegerToString(tkt)) >= 0)
           {
            RegisterOrder90PctCut(rTkt); // Also register child ticket
            if(MathAbs(OrderStopLoss() - newSL) > Point)
              {
               SafeOrderModify(rTkt, OrderOpenPrice(), newSL, OrderTakeProfit(), 0, clrOrange, "Emergency90PercentSLCutPlus500SL");
              }
            break;
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| Pure Per-Side BUY / SELL % Drawdown Tiered Lot Reduction         |
//| Measures BUY basket floating loss vs Balance and SELL basket     |
//| floating loss vs Balance INDEPENDENTLY (never combined).         |
//| Example ($600 Balance, InpEqDdEnableTier1 = true):               |
//|   BUY P/L = -$50 & SELL P/L = -$50 -> Neither hits 10% (No Cut)  |
//|   SELL P/L <= -$60  (-10%) -> Cut 10% lots on losing SELLs ONLY  |
//|   SELL P/L <= -$120 (-20%) -> Cut 20% lots on losing SELLs ONLY  |
//|   SELL P/L <= -$180 (-30%) -> Cut 30% lots on losing SELLs ONLY  |
//|   ... continues 10% steps (-40%, -50% ... -90%; no Close-All)    |
//+------------------------------------------------------------------+
#define MAX_EQDD_TRACKED_ORDERS 4000
int      g_eqDdTrackedTickets[MAX_EQDD_TRACKED_ORDERS];
int      g_eqDdTrackedTiers[MAX_EQDD_TRACKED_ORDERS];
int      g_eqDdTrackedSides[MAX_EQDD_TRACKED_ORDERS];
int      g_eqDdTrackedCount          = 0;

// Aggregate / most-recent across sides (for dashboards & summary)
int      g_eqDdCurrentTier           = 0;
double   g_eqDdCurrentPct            = 0.0;
double   g_eqDdPeakPct               = 0.0;
double   g_eqDdSessionPeakPct        = 0.0;
bool     g_eqDdCloseAllPending       = false;
int      g_eqDdTotalPartialCuts      = 0;
int      g_eqDdTotalCloseAllOrders   = 0;
double   g_eqDdTotalLotsReduced      = 0.0;
int      g_eqDdLastIconTier          = 0;
int      g_eqDdCycleHighestTier      = 0;
int      g_eqDdLastLoggedTier        = 0;
datetime g_eqDdLastHitTime           = 0;
string   g_eqDdLastHitSide           = "";
int      g_eqDdLastHitTier           = 0;
double   g_eqDdLastHitPct            = 0.0;
double   g_eqDdLastHitUSD            = 0.0;
double   g_eqDdLastHitCutPct         = 0.0;
int      g_eqDdLastHitOrders         = 0;
double   g_eqDdLastHitLots           = 0.0;
datetime g_eqDdLastReachTime         = 0;
string   g_eqDdLastReachSide         = "";
int      g_eqDdLastReachTier         = 0;
double   g_eqDdLastReachPct          = 0.0;
string   g_eqDdLastReachReason       = "";
datetime g_eqDdLastResetTime         = 0;
string   g_eqDdLastResetSide         = "";
int      g_eqDdLastResetTier         = 0;
int      g_eqDdDayKey                = -1;
datetime g_eqDdDailyResetTime        = 0;
int      g_eqDdPriorDayCuts          = 0;
double   g_eqDdPriorDayPeakPct       = 0.0;
double   g_eqDdPriorDayLotsCut       = 0.0;

// Independent BUY side state
int      g_eqDdBuyCurrentTier        = 0;
double   g_eqDdBuyCurrentPct         = 0.0;
double   g_eqDdBuyCurrentUSD         = 0.0;
double   g_eqDdBuyPeakPct            = 0.0;
bool     g_eqDdBuyCloseAllPending    = false;
int      g_eqDdBuyLastIconTier       = 0;
int      g_eqDdBuyCycleHighestTier   = 0;
int      g_eqDdBuyLastLoggedTier     = 0;
datetime g_eqDdBuyLastReachTime      = 0;
int      g_eqDdBuyLastReachTier      = 0;
double   g_eqDdBuyLastReachPct       = 0.0;
string   g_eqDdBuyLastReachReason    = "";
datetime g_eqDdBuyLastHitTime        = 0;
int      g_eqDdBuyLastHitTier        = 0;
double   g_eqDdBuyLastHitPct         = 0.0;
double   g_eqDdBuyLastHitUSD         = 0.0;
double   g_eqDdBuyLastHitCutPct      = 0.0;
int      g_eqDdBuyLastHitOrders      = 0;
double   g_eqDdBuyLastHitLots        = 0.0;

// Independent SELL side state
int      g_eqDdSellCurrentTier       = 0;
double   g_eqDdSellCurrentPct        = 0.0;
double   g_eqDdSellCurrentUSD        = 0.0;
double   g_eqDdSellPeakPct           = 0.0;
bool     g_eqDdSellCloseAllPending   = false;
int      g_eqDdSellLastIconTier      = 0;
int      g_eqDdSellCycleHighestTier  = 0;
int      g_eqDdSellLastLoggedTier    = 0;
datetime g_eqDdSellLastReachTime     = 0;
int      g_eqDdSellLastReachTier     = 0;
double   g_eqDdSellLastReachPct      = 0.0;
string   g_eqDdSellLastReachReason   = "";
datetime g_eqDdSellLastHitTime       = 0;
int      g_eqDdSellLastHitTier       = 0;
double   g_eqDdSellLastHitPct        = 0.0;
double   g_eqDdSellLastHitUSD        = 0.0;
double   g_eqDdSellLastHitCutPct     = 0.0;
int      g_eqDdSellLastHitOrders     = 0;
double   g_eqDdSellLastHitLots       = 0.0;

void UpdateLeftLiveOrdersDashboard();

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
string EqDdGvKey(int ticket)
  {
   return "EA_EQDD_T_" + IntegerToString(MagicNumber) + "_" + IntegerToString(ticket);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
string EqDdDailyGvKey(string suffix)
  {
   return "EA_EQDD_" + suffix + "_" + IntegerToString(MagicNumber) + "_" + Symbol();
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int GetEqDdSingleTicketTier(int ticket)
  {
   if(ticket <= 0)
      return 0;

   for(int i = 0; i < g_eqDdTrackedCount; i++)
     {
      if(g_eqDdTrackedTickets[i] == ticket)
         return g_eqDdTrackedTiers[i];
     }

// Bypass shared Terminal GlobalVariables during Strategy Tester/Optimization runs
   if(IsTesting() || IsOptimization())
      return 0;

   string gvName = EqDdGvKey(ticket);
   if(GlobalVariableCheck(gvName))
     {
      return (int)MathRound(GlobalVariableGet(gvName));
     }
   return 0;
  }

//+------------------------------------------------------------------+
//| Walk ancestor chain across MT4 partial closes ("from #parent")   |
//+------------------------------------------------------------------+
int GetEqDdOrderExecutedTier(int ticket, string comment = "")
  {
   if(ticket <= 0)
      return 0;

   int maxTier = GetEqDdSingleTicketTier(ticket);

   int prevSelected = OrderTicket();
   int curTicket    = ticket;
   string curComm   = comment;

   for(int hop = 0; hop < 15; hop++)
     {
      if(curComm == "")
        {
         if(OrderSelect(curTicket, SELECT_BY_TICKET, MODE_TRADES))
            curComm = OrderComment();
         else
            if(OrderSelect(curTicket, SELECT_BY_TICKET, MODE_HISTORY))
               curComm = OrderComment();
        }

      int pos = StringFind(curComm, "from #");
      if(pos < 0)
         break;

      int parentTkt = (int)StringToInteger(StringSubstr(curComm, pos + 6));
      if(parentTkt <= 0 || parentTkt == curTicket)
         break;

      int parentTier = GetEqDdSingleTicketTier(parentTkt);
      if(parentTier > maxTier)
         maxTier = parentTier;

      curTicket = parentTkt;
      curComm   = "";
     }

   if(prevSelected > 0)
     {
      if(!OrderSelect(prevSelected, SELECT_BY_TICKET, MODE_TRADES))
        {
         bool histSel = OrderSelect(prevSelected, SELECT_BY_TICKET, MODE_HISTORY);
        }
     }

   return maxTier;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void SetEqDdOrderExecutedTier(int ticket, int tier, int sideType = -1)
  {
   if(ticket <= 0 || tier <= 0)
      return;

   if(sideType != OP_BUY && sideType != OP_SELL)
     {
      int prevSel = OrderTicket();
      if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES) || OrderSelect(ticket, SELECT_BY_TICKET, MODE_HISTORY))
         sideType = OrderType();
      if(prevSel > 0)
        {
         if(!OrderSelect(prevSel, SELECT_BY_TICKET, MODE_TRADES))
           {
            bool hSel = OrderSelect(prevSel, SELECT_BY_TICKET, MODE_HISTORY);
           }
        }
     }

   bool useGv = (!IsTesting() && !IsOptimization());

   for(int i = 0; i < g_eqDdTrackedCount; i++)
     {
      if(g_eqDdTrackedTickets[i] == ticket)
        {
         if(tier > g_eqDdTrackedTiers[i])
            g_eqDdTrackedTiers[i] = tier;
         if(sideType == OP_BUY || sideType == OP_SELL)
            g_eqDdTrackedSides[i] = sideType;
         if(useGv)
            GlobalVariableSet(EqDdGvKey(ticket), (double)g_eqDdTrackedTiers[i]);
         return;
        }
     }

   if(g_eqDdTrackedCount < MAX_EQDD_TRACKED_ORDERS)
     {
      g_eqDdTrackedTickets[g_eqDdTrackedCount] = ticket;
      g_eqDdTrackedTiers[g_eqDdTrackedCount]   = tier;
      g_eqDdTrackedSides[g_eqDdTrackedCount]   = sideType;
      g_eqDdTrackedCount++;
     }
   if(useGv)
      GlobalVariableSet(EqDdGvKey(ticket), (double)tier);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool HasEqDdTrackedSide(int sideType)
  {
   for(int i = 0; i < g_eqDdTrackedCount; i++)
     {
      if(g_eqDdTrackedSides[i] == sideType)
         return true;
     }
   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void ResetEqDdSideCycleState(int sideType, string reason = "")
  {
   int kept = 0;
   for(int i = 0; i < g_eqDdTrackedCount; i++)
     {
      bool matchesSide = (g_eqDdTrackedSides[i] == sideType);
      if(matchesSide)
        {
         if(!IsTesting() && !IsOptimization() && g_eqDdTrackedTickets[i] > 0)
            GlobalVariableDel(EqDdGvKey(g_eqDdTrackedTickets[i]));
        }
      else
        {
         g_eqDdTrackedTickets[kept] = g_eqDdTrackedTickets[i];
         g_eqDdTrackedTiers[kept]   = g_eqDdTrackedTiers[i];
         g_eqDdTrackedSides[kept]   = g_eqDdTrackedSides[i];
         kept++;
        }
     }
   for(int j = kept; j < g_eqDdTrackedCount; j++)
     {
      g_eqDdTrackedTickets[j] = 0;
      g_eqDdTrackedTiers[j]   = 0;
      g_eqDdTrackedSides[j]   = 0;
     }
   g_eqDdTrackedCount = kept;

   if(sideType == OP_BUY)
     {
      g_eqDdBuyCurrentTier      = 0;
      g_eqDdBuyCurrentPct       = 0.0;
      g_eqDdBuyCurrentUSD       = 0.0;
      g_eqDdBuyPeakPct          = 0.0;
      g_eqDdBuyCloseAllPending  = false;
      g_eqDdBuyLastIconTier     = 0;
      g_eqDdBuyCycleHighestTier = 0;
      g_eqDdBuyLastLoggedTier   = 0;
      g_eqDdBuyLastReachTime    = 0;
      g_eqDdBuyLastReachTier    = 0;
      g_eqDdBuyLastReachPct     = 0.0;
      g_eqDdBuyLastReachReason  = "";
     }
   else
      if(sideType == OP_SELL)
        {
         g_eqDdSellCurrentTier      = 0;
         g_eqDdSellCurrentPct       = 0.0;
         g_eqDdSellCurrentUSD       = 0.0;
         g_eqDdSellPeakPct          = 0.0;
         g_eqDdSellCloseAllPending  = false;
         g_eqDdSellLastIconTier     = 0;
         g_eqDdSellCycleHighestTier = 0;
         g_eqDdSellLastLoggedTier   = 0;
         g_eqDdSellLastReachTime    = 0;
         g_eqDdSellLastReachTier    = 0;
         g_eqDdSellLastReachPct     = 0.0;
         g_eqDdSellLastReachReason  = "";
        }

   g_eqDdCurrentTier      = MathMax(g_eqDdBuyCurrentTier, g_eqDdSellCurrentTier);
   g_eqDdCurrentPct       = MathMax(g_eqDdBuyCurrentPct, g_eqDdSellCurrentPct);
   g_eqDdPeakPct          = MathMax(g_eqDdBuyPeakPct, g_eqDdSellPeakPct);
   g_eqDdCloseAllPending  = (g_eqDdBuyCloseAllPending || g_eqDdSellCloseAllPending);
   g_eqDdLastIconTier     = MathMax(g_eqDdBuyLastIconTier, g_eqDdSellLastIconTier);
   g_eqDdCycleHighestTier = MathMax(g_eqDdBuyCycleHighestTier, g_eqDdSellCycleHighestTier);
   g_eqDdLastLoggedTier   = MathMax(g_eqDdBuyLastLoggedTier, g_eqDdSellLastLoggedTier);

   if(sideType == OP_BUY && g_eqDdLastReachSide == "BUY")
     {
      if(g_eqDdSellLastReachTime > 0 && g_eqDdSellCurrentTier >= g_eqDdSellLastReachTier)
        {
         g_eqDdLastReachTime   = g_eqDdSellLastReachTime;
         g_eqDdLastReachSide   = "SELL";
         g_eqDdLastReachTier   = g_eqDdSellLastReachTier;
         g_eqDdLastReachPct    = g_eqDdSellLastReachPct;
         g_eqDdLastReachReason = g_eqDdSellLastReachReason;
        }
      else
        {
         g_eqDdLastReachTime   = 0;
         g_eqDdLastReachSide   = "";
         g_eqDdLastReachTier   = 0;
         g_eqDdLastReachPct    = 0.0;
         g_eqDdLastReachReason = "";
        }
     }
   else
      if(sideType == OP_SELL && g_eqDdLastReachSide == "SELL")
        {
         if(g_eqDdBuyLastReachTime > 0 && g_eqDdBuyCurrentTier >= g_eqDdBuyLastReachTier)
           {
            g_eqDdLastReachTime   = g_eqDdBuyLastReachTime;
            g_eqDdLastReachSide   = "BUY";
            g_eqDdLastReachTier   = g_eqDdBuyLastReachTier;
            g_eqDdLastReachPct    = g_eqDdBuyLastReachPct;
            g_eqDdLastReachReason = g_eqDdBuyLastReachReason;
           }
         else
           {
            g_eqDdLastReachTime   = 0;
            g_eqDdLastReachSide   = "";
            g_eqDdLastReachTier   = 0;
            g_eqDdLastReachPct    = 0.0;
            g_eqDdLastReachReason = "";
           }
        }
      else
         if(g_eqDdCycleHighestTier == 0 && g_eqDdCurrentTier == 0)
           {
            g_eqDdLastReachTime   = 0;
            g_eqDdLastReachSide   = "";
            g_eqDdLastReachTier   = 0;
            g_eqDdLastReachPct    = 0.0;
            g_eqDdLastReachReason = "";
           }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void ResetEqDdCycleState(string reason = "")
  {
   ResetEqDdSideCycleState(OP_BUY, reason);
   ResetEqDdSideCycleState(OP_SELL, reason);
  }

//+------------------------------------------------------------------+
//| CalcEqDdSideDrawdowns                                            |
//| Computes floating net P/L and DD% for BUY & SELL separately      |
//+------------------------------------------------------------------+
void CalcEqDdSideDrawdowns(double balance, double &buyNetPLOut, double &buyDdPctOut, double &sellNetPLOut, double &sellDdPctOut, int &buyCountOut, int &sellCountOut)
  {
   buyNetPLOut  = 0.0;
   sellNetPLOut = 0.0;
   buyDdPctOut  = 0.0;
   sellDdPctOut = 0.0;
   buyCountOut  = 0;
   sellCountOut = 0;

   int prevSel = OrderTicket();
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int ot = OrderType();
      if(ot == OP_BUY)
        {
         buyNetPLOut += (OrderProfit() + OrderSwap() + OrderCommission());
         buyCountOut++;
        }
      else
         if(ot == OP_SELL)
           {
            sellNetPLOut += (OrderProfit() + OrderSwap() + OrderCommission());
            sellCountOut++;
           }
     }
   if(prevSel > 0)
     {
      if(!OrderSelect(prevSel, SELECT_BY_TICKET, MODE_TRADES))
        {
         bool hSel = OrderSelect(prevSel, SELECT_BY_TICKET, MODE_HISTORY);
        }
     }

   if(balance > 0.0)
     {
      if(buyNetPLOut < 0.0)
         buyDdPctOut = ((-buyNetPLOut) / balance) * 100.0;
      if(sellNetPLOut < 0.0)
         sellDdPctOut = ((-sellNetPLOut) / balance) * 100.0;
     }
  }

//------------------------------------------------------------------+
//| ResolveEqDdTierAndCut                                            |
//| Maps current drawdown % to Tier 1..9 (10%..90% lot reduction)    |
//------------------------------------------------------------------+
int ResolveEqDdTierAndCut(double ddPct, double &cutPctOut)
  {
   cutPctOut = 0.0;
   if(ddPct <= 0.0)
      return 0;

   int    maxT     = (InpEqDdMaxTier >= 5 ? InpEqDdMaxTier : 5);
   double stepSize = (InpEqDdStepPct > 0.0 ? InpEqDdStepPct : 10.0);

   for(int t = maxT; t >= 6; t--)
     {
      double threshPct = t * stepSize;
      if((ddPct + 1e-6) >= threshPct)
        {
         cutPctOut = (threshPct <= 95.0 ? threshPct : 95.0);
         return t;
        }
     }

   if((ddPct + 1e-6) >= InpEqDdTier5Pct)
     {
      cutPctOut = InpEqDdTier5CutPct;
      return 5;
     }
   if((ddPct + 1e-6) >= InpEqDdTier4Pct)
     {
      cutPctOut = InpEqDdTier4CutPct;
      return 4;
     }
   if((ddPct + 1e-6) >= InpEqDdTier3Pct)
     {
      cutPctOut = InpEqDdTier3CutPct;
      return 3;
     }
   if((ddPct + 1e-6) >= InpEqDdTier2Pct)
     {
      cutPctOut = InpEqDdTier2CutPct;
      return 2;
     }
   if(InpEqDdEnableTier1 && (ddPct + 1e-6) >= InpEqDdTier1Pct)
     {
      cutPctOut = InpEqDdTier1CutPct;
      return 1;
     }
   return 0;
  }

//------------------------------------------------------------------+
//| GetEqDdTierColor                                                 |
//------------------------------------------------------------------+
color GetEqDdTierColor(int tier)
  {
   if(tier >= 6)
      return clrMagenta;
   if(tier == 5)
      return clrRed;
   if(tier == 4)
      return clrTomato;
   if(tier == 3)
      return clrOrangeRed;
   if(tier == 2)
      return clrOrange;
   if(tier == 1)
      return clrGold;
   return clrSilver;
  }

//------------------------------------------------------------------+
//| GetEqDdTierThresholdPct / ResolveNextEqDdTier / FormatDubaiDT    |
//------------------------------------------------------------------+
double GetEqDdTierThresholdPct(int tier)
  {
   if(tier <= 1)
      return InpEqDdTier1Pct;
   if(tier == 2)
      return InpEqDdTier2Pct;
   if(tier == 3)
      return InpEqDdTier3Pct;
   if(tier == 4)
      return InpEqDdTier4Pct;
   if(tier == 5)
      return InpEqDdTier5Pct;
   double stepSize = (InpEqDdStepPct > 0.0 ? InpEqDdStepPct : 10.0);
   return tier * stepSize;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int ResolveNextEqDdTier(int curTier, int doneTier, double &nextThreshOut)
  {
   int firstTier = InpEqDdEnableTier1 ? 1 : 2;
   int maxT      = (InpEqDdMaxTier >= 5 ? InpEqDdMaxTier : 5);
   int effTier   = MathMax(curTier, InpEqDdOneShotPerTier ? doneTier : 0);
   int nextTier  = (effTier < firstTier) ? firstTier : (effTier + 1);
   if(nextTier > maxT)
     {
      nextThreshOut = InpEqDdEnableCloseAll ? InpEqDdCloseAllPct : GetEqDdTierThresholdPct(maxT);
      return maxT;
     }
   nextThreshOut = GetEqDdTierThresholdPct(nextTier);
   return nextTier;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
string FormatDubaiShortDT(datetime serverTime, bool withSeconds = false)
  {
   if(serverTime <= 0)
      return withSeconds ? "--.-- --:--:--" : "--.-- --:--";
   datetime dubaiDT = serverTime + (ServerToDubaiOffsetHours * 3600);
   int flags = withSeconds ? (TIME_DATE|TIME_MINUTES|TIME_SECONDS) : (TIME_DATE|TIME_MINUTES);
   string fullStr = TimeToString(dubaiDT, flags);
   if(StringLen(fullStr) >= 16)
      return StringSubstr(fullStr, 5);
   return fullStr;
  }

//------------------------------------------------------------------+
//| DrawEqDdHitIcon                                                  |
//| Draws chart icon & bold DD% label when EQ-DD tier is hit         |
//------------------------------------------------------------------+
void DrawEqDdHitIcon(int tier, double ddPct, double ddUSD, double bal, double eq, double cutPct, int ordersHit, double lotsCut, datetime hitTime = 0, double hitPrice = 0.0, string sideTag = "")
  {
   if(!InpDrawEqDdHitIcon || ordersHit <= 0)
      return;

   if(hitTime <= 0)
      hitTime = TimeCurrent();

   datetime barTime = ((Bars > 0 && Time[0] > 0) ? Time[0] : hitTime);
   int      safeTier = (tier >= 1 ? tier : 1);
   string   objSide  = (sideTag != "" ? (sideTag + "_") : "");
   string   baseName = PREFIX + "EQDD_" + objSide + "T" + IntegerToString(safeTier) + "_" + IntegerToString((int)barTime);
   string   txtName  = baseName + "_TXT";

   double atr = iATR(Symbol(), Period(), 14, 1);
   if(atr <= 0.0)
      atr = 30 * Point;
   if(atr <= 0.0)
      atr = 1.0;

   double baseHigh    = ((Bars > 0 && High[0] > 0.0) ? High[0] : Bid);
   double tierOffset  = 0.25 + ((safeTier - 1) % 6) * 0.80 + (sideTag == "SELL" ? 0.35 : 0.0);
   double markerPrice = (hitPrice > 0.0 ? hitPrice : baseHigh) + (atr * tierOffset);
   double labelPrice  = markerPrice + (atr * 0.35);

   color iconColor = GetEqDdTierColor(safeTier);
   int   iconCode  = (InpEqDdHitIconCode > 0 ? InpEqDdHitIconCode : 171);
   int   fontSize  = (InpEqDdHitFontSize > 0 ? InpEqDdHitFontSize : 10);

   string sideBadge  = (sideTag != "" ? (sideTag + " ") : "");
   string sideTitle  = (sideTag != "" ? ("[" + sideTag + "] ") : "");
   bool   isCloseAll = (InpEqDdEnableCloseAll && cutPct >= 99.9);
   string tierTitle  = isCloseAll ? StringFormat("%sTIER %d CLOSE ALL", sideTitle, safeTier) : StringFormat("%sTIER %d (-%.0f%% Lots)", sideTitle, safeTier, cutPct);
   string labelText  = "";
   if(isCloseAll)
     {
      if(ordersHit > 0)
         labelText = StringFormat("%sDD %.1f%% CLOSE ALL (x%d)", sideBadge, ddPct, ordersHit);
      else
         labelText = StringFormat("%sDD %.1f%% T%d CLOSE ALL", sideBadge, ddPct, safeTier);
     }
   else
     {
      if(ordersHit > 0)
         labelText = StringFormat("%sDD %.1f%% (-%.0f%%L | x%d)", sideBadge, ddPct, cutPct, ordersHit);
      else
         labelText = StringFormat("%sDD %.1f%% (T%d -%.0f%%L)", sideBadge, ddPct, safeTier, cutPct);
     }

   string tooltip = StringFormat("EQ-DD %s | Side DD: %.2f%% (-$%.2f) | Bal: $%.2f -> Eq: $%.2f | Orders Hit: %d (-%.2fL) | Time: %s",
                                 tierTitle, ddPct, ddUSD, bal, eq, ordersHit, lotsCut,
                                 TimeToString(hitTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS));

// Prevent duplicate on same bar & tier, unless upgrading threshold-only icon to actual cut icon
   if(ObjectFind(0, baseName) >= 0 || ObjectFind(0, txtName) >= 0)
     {
      if(ordersHit <= 0)
         return;
      if(ObjectFind(0, txtName) >= 0)
        {
         string existingTxt = ObjectGetString(0, txtName, OBJPROP_TEXT);
         if(StringFind(existingTxt, "(-") >= 0 || StringFind(existingTxt, "CLOSE ALL (x") >= 0)
            return;
         ObjectSetString(0, txtName, OBJPROP_TEXT, labelText);
         ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);
        }
      if(ObjectFind(0, baseName) >= 0)
         ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);
      ChartRedraw(0);
      Print(">>> [EQ-DD CHART ICON UPDATED] '", labelText, "' on bar ",
            TimeToString(barTime, TIME_DATE|TIME_MINUTES), " | DD: ", DoubleToString(ddPct, 2),
            "% (-$", DoubleToString(ddUSD, 2), ") | Lots Cut: ", DoubleToString(lotsCut, 2));
      return;
     }

// 1. Solid Marker Icon (Wingdings 171 star, 238 shield, 159 dot, or 251 check)
   ObjectCreate(0, baseName, OBJ_ARROW, 0, barTime, markerPrice);
   ObjectSetInteger(0, baseName, OBJPROP_ARROWCODE, iconCode);
   ObjectSetInteger(0, baseName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, baseName, OBJPROP_WIDTH, 4);
   ObjectSetInteger(0, baseName, OBJPROP_BACK, false);
   ObjectSetInteger(0, baseName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, baseName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);

// 2. Bold Drawdown % Text Label
   ObjectCreate(0, txtName, OBJ_TEXT, 0, barTime, labelPrice);
   ObjectSetString(0, txtName, OBJPROP_TEXT, labelText);
   ObjectSetString(0, txtName, OBJPROP_FONT, "Arial Black");
   ObjectSetInteger(0, txtName, OBJPROP_FONTSIZE, fontSize);
   ObjectSetInteger(0, txtName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, txtName, OBJPROP_BACK, false);
   ObjectSetInteger(0, txtName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, txtName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);

   ChartRedraw(0);

   Print(">>> [EQ-DD CHART ICON] Placed '", labelText, "' on chart at bar ",
         TimeToString(barTime, TIME_DATE|TIME_MINUTES), " | DD: ", DoubleToString(ddPct, 2),
         "% (-$", DoubleToString(ddUSD, 2), ") | Orders Hit: ", ordersHit,
         " | Lots Cut: ", DoubleToString(lotsCut, 2));
  }

//+------------------------------------------------------------------+
//| ManageEquityDrawdownForSide                                      |
//| Evaluates and reduces ONLY one side's (OP_BUY or OP_SELL) losing |
//| orders based strictly on that side's own floating loss % vs Bal. |
//+------------------------------------------------------------------+
void ManageEquityDrawdownForSide(int sideType)
  {
   if(!InpEnableEqDdLotReduction)
      return;

   double balance = AccountBalance();
   double equity  = AccountEquity();
   if(balance <= 0.0)
      return;

   double buyNetPL = 0.0, buyDdPct = 0.0, sellNetPL = 0.0, sellDdPct = 0.0;
   int    buyCount = 0, sellCount = 0;
   CalcEqDdSideDrawdowns(balance, buyNetPL, buyDdPct, sellNetPL, sellDdPct, buyCount, sellCount);

   bool   isBuy          = (sideType == OP_BUY);
   string sideName       = isBuy ? "BUY" : "SELL";
   double sideNetPL      = isBuy ? buyNetPL  : sellNetPL;
   double sideDdPct      = isBuy ? buyDdPct  : sellDdPct;
   double sideDdUSD      = (sideNetPL < 0.0) ? (-sideNetPL) : 0.0;
   int    sideOrderCount = isBuy ? buyCount  : sellCount;

   if(isBuy)
     {
      g_eqDdBuyCurrentPct = sideDdPct;
      g_eqDdBuyCurrentUSD = sideDdUSD;
      if(sideDdPct > g_eqDdBuyPeakPct)
         g_eqDdBuyPeakPct = sideDdPct;
     }
   else
     {
      g_eqDdSellCurrentPct = sideDdPct;
      g_eqDdSellCurrentUSD = sideDdUSD;
      if(sideDdPct > g_eqDdSellPeakPct)
         g_eqDdSellPeakPct = sideDdPct;
     }

   g_eqDdCurrentPct = MathMax(g_eqDdBuyCurrentPct, g_eqDdSellCurrentPct);
   g_eqDdPeakPct    = MathMax(g_eqDdBuyPeakPct, g_eqDdSellPeakPct);
   if(sideDdPct > g_eqDdSessionPeakPct)
      g_eqDdSessionPeakPct = sideDdPct;

   int  sideCurTier         = isBuy ? g_eqDdBuyCurrentTier       : g_eqDdSellCurrentTier;
   int  sideCycleHighest    = isBuy ? g_eqDdBuyCycleHighestTier  : g_eqDdSellCycleHighestTier;
   int  sideLastLogged      = isBuy ? g_eqDdBuyLastLoggedTier    : g_eqDdSellLastLoggedTier;
   bool sideCloseAllPending = isBuy ? g_eqDdBuyCloseAllPending   : g_eqDdSellCloseAllPending;

// Side drawdown cleared (Side P/L >= 0 or 0 open orders on this side) -> reset ONLY this side
   if(sideOrderCount == 0 || sideNetPL >= 0.0)
     {
      if(sideCurTier > 0 || sideCycleHighest > 0 || sideLastLogged > 0 || sideCloseAllPending || HasEqDdTrackedSide(sideType))
        {
         int clearedTier = MathMax(MathMax(sideCurTier, sideCycleHighest), sideLastLogged);
         if(clearedTier > 0)
           {
            g_eqDdLastResetTime = TimeCurrent();
            g_eqDdLastResetSide = sideName;
            g_eqDdLastResetTier = clearedTier;
           }
         PrintFormat(">>> [EQ-DD %s SHIELD RESET] %s P/L ($%s%.2f, Open=%d) >= $0.00. %s drawdown cleared; %s tier locks reset.",
                     sideName, sideName, (sideNetPL >= 0.0 ? "+" : "-"), MathAbs(sideNetPL), sideOrderCount, sideName, sideName);
         ResetEqDdSideCycleState(sideType, "Side P/L >= 0");
        }
      return;
     }

   double activeCutPct = 0.0;
   int    activeTier   = ResolveEqDdTierAndCut(sideDdPct, activeCutPct);
   if(InpEqDdEnableCloseAll && (sideCloseAllPending || (sideDdPct + 1e-6) >= InpEqDdCloseAllPct))
     {
      int maxT = (InpEqDdMaxTier >= 5 ? InpEqDdMaxTier : 5);
      activeTier          = maxT + 1;
      activeCutPct        = 100.0;
      sideCloseAllPending = true;
      if(isBuy)
         g_eqDdBuyCloseAllPending = true;
      else
         g_eqDdSellCloseAllPending = true;
     }

   if(isBuy)
      g_eqDdBuyCurrentTier = activeTier;
   else
      g_eqDdSellCurrentTier = activeTier;

   g_eqDdCurrentTier     = MathMax(g_eqDdBuyCurrentTier, g_eqDdSellCurrentTier);
   g_eqDdCloseAllPending = (g_eqDdBuyCloseAllPending || g_eqDdSellCloseAllPending);

   if(activeTier <= 0)
      return;

   if(InpEqDdOneShotPerTier && activeTier <= sideCycleHighest)
      return;

   RefreshRates();
   double minLot  = MarketInfo(Symbol(), MODE_MINLOT);
   double lotStep = MarketInfo(Symbol(), MODE_LOTSTEP);
   if(minLot <= 0.0)
      minLot = 0.01;
   if(lotStep <= 0.0)
      lotStep = 0.01;

   int lotDigits = (lotStep >= 1.0) ? 0 : ((lotStep >= 0.1) ? 1 : ((lotStep >= 0.01) ? 2 : 3));
   double minCutLots      = MathMax(lotStep, InpEqDdMinCutLots);
   double eqDdMult        = (balancelomultipler > 0) ? balancelomultipler : 1.0;
   double minOrderLossUSD = InpEqDdMinOrderLossUSD * eqDdMult;

// Phase 1: Snapshot losing open market orders STRICTLY on sideType (OP_BUY or OP_SELL)
   int    candTickets[500];
   ArrayInitialize(candTickets, 0);
   int    candCount         = 0;
   int    losingCount       = 0;
   int    skippedSmallLoss  = 0;
   int    skippedMinLot     = 0;
   int    skippedAlreadyCut = 0;
   bool   fullCloseMode     = (InpEqDdEnableCloseAll && activeCutPct >= 99.9);

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      if(OrderType() != sideType)
         continue;

      double netPL = OrderProfit() + OrderSwap() + OrderCommission();
      if(netPL >= 0.0)
         continue;

      losingCount++;

      if(minOrderLossUSD > 0.0 && ((-netPL) + 1e-6) < minOrderLossUSD)
        {
         skippedSmallLoss++;
         continue;
        }

      double oLots = OrderLots();
      if(!fullCloseMode)
        {
         double maxPartialCheck = NormalizeDouble(oLots - minLot, lotDigits);
         if(maxPartialCheck < (lotStep - 1e-8))
           {
            skippedMinLot++;
            continue;
           }
        }

      int tkt      = OrderTicket();
      string comm  = OrderComment();
      int prevTier = GetEqDdOrderExecutedTier(tkt, comm);
      if(prevTier >= activeTier)
        {
         skippedAlreadyCut++;
         continue;
        }

      if(candCount < 500)
        {
         candTickets[candCount] = tkt;
         candCount++;
        }
     }

   if(losingCount == 0)
     {
      if(sideCloseAllPending)
         PrintFormat(">>> [EQ-DD %s CLOSE-ALL COMPLETE] All losing %s orders have been closed.", sideName, sideName);
      if(isBuy)
         g_eqDdBuyCloseAllPending = false;
      else
         g_eqDdSellCloseAllPending = false;
      g_eqDdCloseAllPending = (g_eqDdBuyCloseAllPending || g_eqDdSellCloseAllPending);
      return;
     }

   string waitReason = "";
   if(candCount == 0)
     {
      if(skippedMinLot > 0 && skippedSmallLoss == 0 && skippedAlreadyCut == 0)
         waitReason = StringFormat("MinLot(%d)", skippedMinLot);
      else
         if(skippedSmallLoss > 0 && skippedMinLot == 0 && skippedAlreadyCut == 0)
            waitReason = StringFormat("Loss<$%.0f(%d)", minOrderLossUSD, skippedSmallLoss);
         else
            if(skippedAlreadyCut > 0 && skippedMinLot == 0 && skippedSmallLoss == 0)
               waitReason = StringFormat("CutDone(%d)", skippedAlreadyCut);
            else
               waitReason = StringFormat("ML:%d <$%.0f:%d Cut:%d", skippedMinLot, minOrderLossUSD, skippedSmallLoss, skippedAlreadyCut);

      if(isBuy)
        {
         g_eqDdBuyLastReachPct    = sideDdPct;
         g_eqDdBuyLastReachReason = waitReason;
        }
      else
        {
         g_eqDdSellLastReachPct    = sideDdPct;
         g_eqDdSellLastReachReason = waitReason;
        }
      if(g_eqDdLastReachSide == sideName && g_eqDdLastReachTier == activeTier)
        {
         g_eqDdLastReachPct    = sideDdPct;
         g_eqDdLastReachReason = waitReason;
        }
     }

   if(activeTier > sideLastLogged)
     {
      datetime nowTime = TimeCurrent();
      if(isBuy)
        {
         g_eqDdBuyLastLoggedTier  = activeTier;
         g_eqDdBuyLastReachTime   = nowTime;
         g_eqDdBuyLastReachTier   = activeTier;
         g_eqDdBuyLastReachPct    = sideDdPct;
         g_eqDdBuyLastReachReason = waitReason;
        }
      else
        {
         g_eqDdSellLastLoggedTier  = activeTier;
         g_eqDdSellLastReachTime   = nowTime;
         g_eqDdSellLastReachTier   = activeTier;
         g_eqDdSellLastReachPct    = sideDdPct;
         g_eqDdSellLastReachReason = waitReason;
        }

      g_eqDdLastLoggedTier  = MathMax(g_eqDdBuyLastLoggedTier, g_eqDdSellLastLoggedTier);
      g_eqDdLastReachTime   = nowTime;
      g_eqDdLastReachSide   = sideName;
      g_eqDdLastReachTier   = activeTier;
      g_eqDdLastReachPct    = sideDdPct;
      g_eqDdLastReachReason = waitReason;

      PrintFormat(">>> [EQ-DD %s TIER %d TRIGGERED (-%.0f%% Lots)] Time=%s | Bal=$%.2f Eq=$%.2f | %s DD=%.2f%% (-$%.2f) | Losing=%d Eligible=%d (Skip <$%.2f:%d, MinLot:%d, TierDone:%d)",
                  sideName, activeTier, activeCutPct, TimeToString(nowTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  balance, equity, sideName, sideDdPct, sideDdUSD, losingCount, candCount,
                  minOrderLossUSD, skippedSmallLoss, skippedMinLot, skippedAlreadyCut);
      if(candCount == 0)
        {
         LastDashboardUpdateMs = 0;
         if(ShowLeftLiveOrdersDashboard)
            UpdateLeftLiveOrdersDashboard();
        }
     }

   if(candCount == 0)
      return;

// Phase 2: Execute tier action ONLY on snapshot candidates of sideType
   int    remainingClosedFail = 0;
   int    sweepHits           = 0;
   double sweepLotsCut        = 0.0;
   for(int k = 0; k < candCount; k++)
     {
      int tkt = candTickets[k];
      if(!OrderSelect(tkt, SELECT_BY_TICKET, MODE_TRADES))
         continue;
      if(OrderCloseTime() != 0 || OrderType() != sideType)
         continue;

      double oLots = OrderLots();
      int    oType = OrderType();
      double netPL = OrderProfit() + OrderSwap() + OrderCommission();
      if(netPL >= 0.0)
         continue;
      if(minOrderLossUSD > 0.0 && ((-netPL) + 1e-6) < minOrderLossUSD)
         continue;

      double closeLots   = 0.0;
      bool   isFullClose = false;

      if(InpEqDdEnableCloseAll && activeCutPct >= 99.9)
        {
         closeLots   = oLots;
         isFullClose = true;
        }
      else
        {
         double maxPartial = NormalizeDouble(oLots - minLot, lotDigits);
         if(maxPartial < (lotStep - 1e-8))
            continue;

         double cutFrac = activeCutPct / 100.0;
         closeLots = NormalizeDouble(MathRound((oLots * cutFrac) / lotStep + 1e-9) * lotStep, lotDigits);
         if(closeLots < minCutLots)
            closeLots = minCutLots;
         if(closeLots > maxPartial)
            closeLots = maxPartial;
         if(closeLots < lotStep)
            continue;
        }

      RefreshRates();
      ResetLastError();
      color closeClr = isFullClose ? clrRed : clrOrangeRed;
      g_eqDdForceCloseBudget = true;
      bool closed = SafeOrderCloseMarket(tkt, closeLots, Slippage, closeClr);
      g_eqDdForceCloseBudget = false;

      if(closed)
        {
         SetEqDdOrderExecutedTier(tkt, activeTier, sideType);
         g_eqDdTotalLotsReduced += closeLots;
         sweepHits++;
         sweepLotsCut += closeLots;

         if(isFullClose)
           {
            g_eqDdTotalCloseAllOrders++;
            PrintFormat(">>> [EQ-DD %s TIER %d CLOSE ALL >=%.0f%%] Bal=$%.2f Eq=$%.2f | %s DD=%.2f%% (-$%.2f) | Closed ALL #%d (%s %.2fL, Loss=$%.2f)",
                        sideName, activeTier, InpEqDdCloseAllPct, balance, equity, sideName, sideDdPct, sideDdUSD, tkt,
                        sideName, closeLots, netPL);
           }
         else
           {
            g_eqDdTotalPartialCuts++;
            double remLots = NormalizeDouble(oLots - closeLots, lotDigits);

            int childTkt = 0;
            string fromTag = "from #" + IntegerToString(tkt);
            for(int r = OrdersTotal() - 1; r >= 0; r--)
              {
               if(!OrderSelect(r, SELECT_BY_POS, MODE_TRADES))
                  continue;
               if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
                  continue;
               int rTkt = OrderTicket();
               if(rTkt == tkt || StringFind(OrderComment(), fromTag) >= 0)
                 {
                  SetEqDdOrderExecutedTier(rTkt, activeTier, sideType);
                  childTkt = rTkt;
                  break;
                 }
              }

            PrintFormat(">>> [EQ-DD %s TIER %d LOT CUT %.0f%%] Bal=$%.2f Eq=$%.2f | %s DD=%.2f%% (-$%.2f) | Order #%d (%s %.2fL -> Cut %.2fL, Rem %.2fL, Child #%d, P/L=$%.2f)",
                        sideName, activeTier, activeCutPct, balance, equity, sideName, sideDdPct, sideDdUSD, tkt,
                        sideName, oLots, closeLots, remLots, childTkt, netPL);
           }
        }
      else
        {
         remainingClosedFail++;
         PrintFormat(">>> [EQ-DD %s TIER %d CLOSE FAILED] Ticket #%d (%.2fL of %.2fL) Err=%d | %s DD=%.2f%%",
                     sideName, activeTier, tkt, closeLots, oLots, GetLastError(), sideName, sideDdPct);
        }
     }

   if(sweepHits > 0)
     {
      datetime hitTime = TimeCurrent();
      if(isBuy)
        {
         if(remainingClosedFail == 0 && activeTier > g_eqDdBuyCycleHighestTier)
            g_eqDdBuyCycleHighestTier = activeTier;
         if(activeTier > g_eqDdBuyLastIconTier)
            g_eqDdBuyLastIconTier = activeTier;
         g_eqDdBuyLastHitTime   = hitTime;
         g_eqDdBuyLastHitTier   = activeTier;
         g_eqDdBuyLastHitPct    = sideDdPct;
         g_eqDdBuyLastHitUSD    = sideDdUSD;
         g_eqDdBuyLastHitCutPct = activeCutPct;
         g_eqDdBuyLastHitOrders = sweepHits;
         g_eqDdBuyLastHitLots   = sweepLotsCut;
        }
      else
        {
         if(remainingClosedFail == 0 && activeTier > g_eqDdSellCycleHighestTier)
            g_eqDdSellCycleHighestTier = activeTier;
         if(activeTier > g_eqDdSellLastIconTier)
            g_eqDdSellLastIconTier = activeTier;
         g_eqDdSellLastHitTime   = hitTime;
         g_eqDdSellLastHitTier   = activeTier;
         g_eqDdSellLastHitPct    = sideDdPct;
         g_eqDdSellLastHitUSD    = sideDdUSD;
         g_eqDdSellLastHitCutPct = activeCutPct;
         g_eqDdSellLastHitOrders = sweepHits;
         g_eqDdSellLastHitLots   = sweepLotsCut;
        }

      g_eqDdCycleHighestTier = MathMax(g_eqDdBuyCycleHighestTier, g_eqDdSellCycleHighestTier);
      g_eqDdLastIconTier     = MathMax(g_eqDdBuyLastIconTier, g_eqDdSellLastIconTier);

      g_eqDdLastHitTime   = hitTime;
      g_eqDdLastHitSide   = sideName;
      g_eqDdLastHitTier   = activeTier;
      g_eqDdLastHitPct    = sideDdPct;
      g_eqDdLastHitUSD    = sideDdUSD;
      g_eqDdLastHitCutPct = activeCutPct;
      g_eqDdLastHitOrders = sweepHits;
      g_eqDdLastHitLots   = sweepLotsCut;
      if(isBuy)
         g_eqDdBuyLastReachReason = "";
      else
         g_eqDdSellLastReachReason = "";
      if(g_eqDdLastReachSide == sideName && g_eqDdLastReachTier <= activeTier)
         g_eqDdLastReachReason = "";

      double sidePeak = isBuy ? g_eqDdBuyPeakPct : g_eqDdSellPeakPct;
      PrintFormat(">>> [EQ-DD %s TIER %d HIT CONFIRMED] Time=%s | Bal=$%.2f Eq=$%.2f | %s DD=%.2f%% (-$%.2f) | Action=-%.0f%% Lots | Orders Cut=%d (-%.2fL) | Side Peak=%.2f%%",
                  sideName, activeTier, TimeToString(hitTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                  balance, equity, sideName, sideDdPct, sideDdUSD, activeCutPct, sweepHits, sweepLotsCut, sidePeak);

      DrawEqDdHitIcon(activeTier, sideDdPct, sideDdUSD, balance, equity, activeCutPct, sweepHits, sweepLotsCut, hitTime, 0.0, sideName);
      LastDashboardUpdateMs = 0;
      if(ShowLeftLiveOrdersDashboard)
         UpdateLeftLiveOrdersDashboard();
     }

   if(InpEqDdEnableCloseAll && activeCutPct >= 99.9 && remainingClosedFail == 0)
     {
      int stillLosing = 0;
      for(int j = OrdersTotal() - 1; j >= 0; j--)
        {
         if(!OrderSelect(j, SELECT_BY_POS, MODE_TRADES))
            continue;
         if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
            continue;
         if(OrderType() != sideType)
            continue;
         if((OrderProfit() + OrderSwap() + OrderCommission()) < 0.0)
            stillLosing++;
        }
      if(stillLosing == 0)
        {
         if(isBuy)
            g_eqDdBuyCloseAllPending = false;
         else
            g_eqDdSellCloseAllPending = false;
         g_eqDdCloseAllPending = (g_eqDdBuyCloseAllPending || g_eqDdSellCloseAllPending);
         PrintFormat(">>> [EQ-DD %s CLOSE-ALL COMPLETE] All losing %s orders closed; latch cleared.", sideName, sideName);
        }
     }
  }

//+------------------------------------------------------------------+
//| ExecuteEqDdFreshDayReset                                         |
//| Wipes all EQ-DD state, per-ticket/ancestor locks, session peaks, |
//| cut counters & chronological history for a fresh Dubai day start.|
//+------------------------------------------------------------------+
void ExecuteEqDdFreshDayReset(datetime nowServer, datetime dubaiTime, int dubaiDayKey, bool isTestRun, string triggerReason = "Dubai 00:00 Rollover")
  {
   g_eqDdPriorDayCuts    = g_eqDdTotalPartialCuts + g_eqDdTotalCloseAllOrders;
   g_eqDdPriorDayPeakPct = g_eqDdSessionPeakPct;
   g_eqDdPriorDayLotsCut = g_eqDdTotalLotsReduced;

// 1. Wipe open-order and "from #parent" ancestor GVs persisted across restarts
   if(!isTestRun)
     {
      int prevSel = OrderTicket();
      for(int i = OrdersTotal() - 1; i >= 0; i--)
        {
         if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
            continue;
         if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
            continue;

         int    curTicket = OrderTicket();
         string curComm   = OrderComment();
         for(int hop = 0; hop < 16; hop++)
           {
            if(curTicket <= 0)
               break;
            string tkGv = EqDdGvKey(curTicket);
            if(GlobalVariableCheck(tkGv))
               GlobalVariableDel(tkGv);

            if(curComm == "")
              {
               if(OrderSelect(curTicket, SELECT_BY_TICKET, MODE_TRADES))
                  curComm = OrderComment();
               else
                  if(OrderSelect(curTicket, SELECT_BY_TICKET, MODE_HISTORY))
                     curComm = OrderComment();
              }

            int pos = StringFind(curComm, "from #");
            if(pos < 0)
               break;
            int parentTkt = (int)StringToInteger(StringSubstr(curComm, pos + 6));
            if(parentTkt <= 0 || parentTkt == curTicket)
               break;
            curTicket = parentTkt;
            curComm   = "";
           }
        }
      if(prevSel > 0)
        {
         if(!OrderSelect(prevSel, SELECT_BY_TICKET, MODE_TRADES))
           {
            bool hSel = OrderSelect(prevSel, SELECT_BY_TICKET, MODE_HISTORY);
           }
        }
     }

// 2. Reset tracked ticket array and BUY/SELL/aggregate cycle state
   ResetEqDdCycleState(triggerReason);

// 3. Reset all daily/session stats, counters, hit/reset history to fresh start
   g_eqDdForceCloseBudget    = false;
   g_eqDdSessionPeakPct      = 0.0;
   g_eqDdTotalPartialCuts    = 0;
   g_eqDdTotalCloseAllOrders = 0;
   g_eqDdTotalLotsReduced    = 0.0;

   g_eqDdLastHitTime         = 0;
   g_eqDdLastHitSide         = "";
   g_eqDdLastHitTier         = 0;
   g_eqDdLastHitPct          = 0.0;
   g_eqDdLastHitUSD          = 0.0;
   g_eqDdLastHitCutPct       = 0.0;
   g_eqDdLastHitOrders       = 0;
   g_eqDdLastHitLots         = 0.0;

   g_eqDdLastResetTime       = 0;
   g_eqDdLastResetSide       = "";
   g_eqDdLastResetTier       = 0;

   g_eqDdBuyLastHitTime      = 0;
   g_eqDdBuyLastHitTier      = 0;
   g_eqDdBuyLastHitPct       = 0.0;
   g_eqDdBuyLastHitUSD       = 0.0;
   g_eqDdBuyLastHitCutPct    = 0.0;
   g_eqDdBuyLastHitOrders    = 0;
   g_eqDdBuyLastHitLots      = 0.0;

   g_eqDdSellLastHitTime     = 0;
   g_eqDdSellLastHitTier     = 0;
   g_eqDdSellLastHitPct      = 0.0;
   g_eqDdSellLastHitUSD      = 0.0;
   g_eqDdSellLastHitCutPct   = 0.0;
   g_eqDdSellLastHitOrders   = 0;
   g_eqDdSellLastHitLots     = 0.0;

// Reset idle RLF peak tracker if no active relief SLs are protecting open tickets
   if(!g_drawdownReliefExecuted && g_drawdownReliefTicketCount == 0 && (g_drawdownReliefPeakUSD > 0.0 || g_drawdownReliefArmed))
      ResetDrawdownReliefCycle("Fresh Dubai Day Start");

   g_eqDdDayKey         = dubaiDayKey;
   g_eqDdDailyResetTime = nowServer;

   if(!isTestRun)
     {
      GlobalVariableSet(EqDdDailyGvKey("DAYKEY"), (double)dubaiDayKey);
      GlobalVariableSet(EqDdDailyGvKey("RSTT"), (double)nowServer);
     }

   LastDashboardUpdateMs = 0;

   PrintFormat(">>> [EQ-DD DAILY RESET] %s | DubaiTime=%s (DayKey=%d) | PriorDay Peak=%.2f%% Cuts=%d (-%.2fL) | All tier locks, peaks & counters RESET to Fresh Start.",
               triggerReason, TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
               dubaiDayKey, g_eqDdPriorDayPeakPct, g_eqDdPriorDayCuts, g_eqDdPriorDayLotsCut);
  }

//+------------------------------------------------------------------+
//| CheckEqDdDailyReset                                              |
//| Detects fresh Dubai day start (00:00 GST) or overnight live      |
//| terminal restart and resets all EQ-DD state to Fresh Start.      |
//+------------------------------------------------------------------+
void CheckEqDdDailyReset()
  {
   datetime nowServer = TimeCurrent();
   if(nowServer <= 0)
      return;

   datetime dubaiTime   = nowServer + (ServerToDubaiOffsetHours * 3600);
   int      dubaiDayKey = TimeYear(dubaiTime) * 1000 + TimeDayOfYear(dubaiTime);
   bool     isTestRun   = (IsTesting() || IsOptimization());
   string   gvDayK      = EqDdDailyGvKey("DAYKEY");
   string   gvRstK      = EqDdDailyGvKey("RSTT");

   if(!InpEqDdResetAllOnNewDay)
     {
      if(g_eqDdDayKey != dubaiDayKey)
        {
         g_eqDdDayKey = dubaiDayKey;
         if(!isTestRun)
            GlobalVariableSet(gvDayK, (double)dubaiDayKey);
        }
      return;
     }

   if(g_eqDdDayKey == -1)
     {
      if(!isTestRun && GlobalVariableCheck(gvDayK))
        {
         int savedDay = (int)MathRound(GlobalVariableGet(gvDayK));
         if(savedDay != dubaiDayKey)
           {
            ExecuteEqDdFreshDayReset(nowServer, dubaiTime, dubaiDayKey, isTestRun, "Overnight Restart Fresh Dubai Day");
            return;
           }
         g_eqDdDayKey = dubaiDayKey;
         if(g_eqDdDailyResetTime == 0 && GlobalVariableCheck(gvRstK))
           {
            datetime savedRst = (datetime)MathRound(GlobalVariableGet(gvRstK));
            if(savedRst > 0)
              {
               datetime savedRstDubai = savedRst + (ServerToDubaiOffsetHours * 3600);
               int      savedRstDay   = TimeYear(savedRstDubai) * 1000 + TimeDayOfYear(savedRstDubai);
               if(savedRstDay == dubaiDayKey)
                  g_eqDdDailyResetTime = savedRst;
              }
           }
        }
      else
        {
         g_eqDdDayKey = dubaiDayKey;
         if(!isTestRun)
           {
            GlobalVariableSet(gvDayK, (double)dubaiDayKey);
            if(GlobalVariableCheck(gvRstK))
               GlobalVariableDel(gvRstK);
           }
        }
      return;
     }

   if(dubaiDayKey != g_eqDdDayKey)
     {
      ExecuteEqDdFreshDayReset(nowServer, dubaiTime, dubaiDayKey, isTestRun, "Dubai 00:00 Rollover");
     }
  }

//+------------------------------------------------------------------+
//| ManageEquityDrawdownTieredLotReduction                           |
//| Pure Per-Side mode: checks BUY floating loss and SELL floating   |
//| loss independently (never combines BUY + SELL losses).           |
//+------------------------------------------------------------------+
void ManageEquityDrawdownTieredLotReduction()
  {
   CheckEqDdDailyReset();

   if(!InpEnableEqDdLotReduction)
     {
      g_eqDdBuyCurrentTier  = 0;
      g_eqDdBuyCurrentPct   = 0.0;
      g_eqDdBuyCurrentUSD   = 0.0;
      g_eqDdSellCurrentTier = 0;
      g_eqDdSellCurrentPct  = 0.0;
      g_eqDdSellCurrentUSD  = 0.0;
      g_eqDdCurrentTier     = 0;
      g_eqDdCurrentPct      = 0.0;
      return;
     }

   ManageEquityDrawdownForSide(OP_BUY);
   ManageEquityDrawdownForSide(OP_SELL);
  }

//+------------------------------------------------------------------+
//| Hourly 1-Hour Per-Side Engine:                                   |
//| Plan A: If Day Equity Profit > 5% vs Dubai 00:00 opening equity, |
//|         close ALL open market orders immediately.                |
//| OR Plan B: Otherwise evaluate BUY-only and SELL-only floating    |
//|            loss % vs Balance independently (NO combination) and  |
//|            close 20% LOT (min 0.01) on any side > 20% loss.      |
//+------------------------------------------------------------------+
long     g_hourlySideLossLastSlot       = -1;   // Last checked hour bucket ((long)nowServer / intervalSec)
datetime g_hourlySideLossLastRunTime    = 0;    // Broker TimeCurrent() of latest hourly evaluation
datetime g_hourlySideLossNextRunTime    = 0;    // Broker TimeCurrent() of next scheduled hourly check
int      g_hourlySideLossCheckCount     = 0;    // Total hourly evaluations executed
bool     g_hourlyPlanADoneToday         = false;// Optional Plan A 1x/day lock (when InpHourlyPlanAOncePerDay=true)
int      g_hourlyPlanAHitsToday         = 0;    // Total Plan A (>5% Day Eq Close All) sweeps executed today
int      g_hourlyPlanATotalSweeps       = 0;    // Total Plan A (>5% Day Eq Close All) sweeps executed in session
int      g_hourlyPlanATargetHits        = 0;    // Total 1H Plan A Target HIT detections in session (open orders + flat)
int      g_hourlyPlanATotalOrders       = 0;    // Total open orders closed by Plan A
double   g_hourlyPlanATotalLots         = 0.0;  // Total lots closed by Plan A
datetime g_hourlyPlanALastHitTime       = 0;    // Broker TimeCurrent() of latest Plan A execution
double   g_hourlyPlanALastPct           = 0.0;  // Day equity profit % at latest Plan A execution
double   g_hourlyPlanALastUSD           = 0.0;  // Day equity profit USD at latest Plan A execution
int      g_hourlyPlanALastOrders        = 0;    // Orders closed in latest Plan A execution
double   g_hourlyPlanALastLots          = 0.0;  // Lots closed in latest Plan A execution
double   g_hourlyPlanALastPL            = 0.0;  // Net P/L realized in latest Plan A execution
int      g_hourlySideLossTotalCuts      = 0;    // Plan B: Total individual order partial-cuts executed
int      g_hourlySideLossTotalSweeps    = 0;    // Plan B: Total hourly side-cut passes executed
double   g_hourlySideLossTotalLotsCut   = 0.0;  // Plan B: Total lots partial-closed across all hourly cuts
datetime g_hourlySideLossLastHitTime    = 0;    // Plan B: Broker TimeCurrent() of latest 20% lot cut execution
string   g_hourlySideLossLastHitSide    = "";   // Plan B: Latest cut side ("BUY" or "SELL")
double   g_hourlySideLossLastHitPct     = 0.0;  // Plan B: Side floating loss % of Balance at latest cut
double   g_hourlySideLossLastHitUSD     = 0.0;  // Plan B: Side floating loss USD at latest cut
int      g_hourlySideLossLastHitOrders  = 0;    // Plan B: Number of orders cut in latest pass
double   g_hourlySideLossLastHitLots    = 0.0;  // Plan B: Lots closed in latest pass
double   g_hourlySideLossLastHitPL      = 0.0;  // Plan B: Estimated P/L closed in latest pass
long     g_hourlyPlanCLastSlot          = -1;   // Plan C: Last checked 15-min bucket ((long)nowServer / intervalCSec)
datetime g_hourlyPlanCLastRunTime       = 0;    // Plan C: Broker TimeCurrent() of latest 15-min evaluation
datetime g_hourlyPlanCNextRunTime       = 0;    // Plan C: Broker TimeCurrent() of next scheduled 15-min check
int      g_hourlyPlanCCheckCount        = 0;    // Plan C: Total 15-min evaluations executed
bool     g_hourlyPlanCDoneToday         = false;// Optional Plan C 1x/day lock (when InpHourlyPlanCOncePerDay=true)
int      g_hourlyPlanCHitsToday         = 0;    // Plan C: Total (>10% Day Eq Close All) sweeps executed today
int      g_hourlyPlanCTotalSweeps       = 0;    // Plan C: Total (>10% Day Eq Close All) sweeps executed in session
int      g_hourlyPlanCTotalOrders       = 0;    // Plan C: Total open orders closed by Plan C
double   g_hourlyPlanCTotalLots         = 0.0;  // Plan C: Total lots closed by Plan C
datetime g_hourlyPlanCLastHitTime       = 0;    // Plan C: Broker TimeCurrent() of latest execution
double   g_hourlyPlanCLastPct           = 0.0;  // Plan C: Day equity profit % at latest execution
double   g_hourlyPlanCLastUSD           = 0.0;  // Plan C: Day equity profit USD at latest execution
int      g_hourlyPlanCLastOrders        = 0;    // Plan C: Orders closed in latest execution
double   g_hourlyPlanCLastLots          = 0.0;  // Plan C: Lots closed in latest execution
double   g_hourlyPlanCLastPL            = 0.0;  // Plan C: Net P/L realized in latest execution
long     g_hourlyPlanDLastSlot          = -1;   // Plan D: Last checked 1-min bucket ((long)nowServer / intervalDSec)
long     g_hourlyPlanDCycleHourSlot     = -1;   // Plan D: Active 1-hour cycle bucket ((long)nowServer / cycleSec) for hourly reset tracking
long     g_hourlyPlanDDoneHourSlot      = -1;   // Plan D: Locked hour bucket after Close-All when InpHourlyPlanDOncePerHour=true
bool     g_hourlyPlanDDoneHourLoaded    = false;// Plan D: Live session GV restore flag for g_hourlyPlanDDoneHourSlot
datetime g_hourlyPlanDLastRunTime       = 0;    // Plan D: Broker TimeCurrent() of latest 1-min evaluation
datetime g_hourlyPlanDNextRunTime       = 0;    // Plan D: Broker TimeCurrent() of next scheduled 1-min check
int      g_hourlyPlanDCheckCount        = 0;    // Plan D: Total 1-min evaluations executed
int      g_hourlyPlanDLastMinIdx        = 1;    // Plan D: Last evaluated minute index within the 1h cycle (1..60)
double   g_hourlyPlanDLastThreshPct     = 31.0; // Plan D: Last evaluated threshold % (31.0..90.0)
bool     g_hourlyPlanDDoneToday         = false;// Optional Plan D 1x/day lock (when InpHourlyPlanDOncePerDay=true)
int      g_hourlyPlanDHitsToday         = 0;    // Plan D: Total (>31%..90% Day Eq Close All) sweeps executed today
int      g_hourlyPlanDTotalSweeps       = 0;    // Plan D: Total (>31%..90% Day Eq Close All) sweeps executed in session
int      g_hourlyPlanDTotalOrders       = 0;    // Plan D: Total open orders closed by Plan D
double   g_hourlyPlanDTotalLots         = 0.0;  // Plan D: Total lots closed by Plan D
datetime g_hourlyPlanDLastHitTime       = 0;    // Plan D: Broker TimeCurrent() of latest execution
int      g_hourlyPlanDLastHitMinIdx     = 0;    // Plan D: Minute index (1..60) at latest execution
double   g_hourlyPlanDLastHitThreshPct  = 0.0;  // Plan D: Threshold % at latest execution
double   g_hourlyPlanDLastPct           = 0.0;  // Plan D: Day equity profit % at latest execution
double   g_hourlyPlanDLastUSD           = 0.0;  // Plan D: Day equity profit USD at latest execution
int      g_hourlyPlanDLastOrders        = 0;    // Plan D: Orders closed in latest execution
double   g_hourlyPlanDLastLots          = 0.0;  // Plan D: Lots closed in latest execution
double   g_hourlyPlanDLastPL            = 0.0;  // Plan D: Net P/L realized in latest execution

//+------------------------------------------------------------------+
//| DubaiNightCloseGvKey                                             |
//| Per-magic/symbol GlobalVariable key for live same-day persistence|
//+------------------------------------------------------------------+
string DubaiNightCloseGvKey()
  {
   return "EA_DUBAI_NIGHT_CLOSE_" + IntegerToString(MagicNumber) + "_" + Symbol();
  }

//+------------------------------------------------------------------+
//| SyncDubaiDayOpeningState                                         |
//| Captures Dubai 00:00 GST opening day equity and handles live     |
//| restart / next-day rollover reset for 1H Plan A/C/D & Night      |
//+------------------------------------------------------------------+
void SyncDubaiDayOpeningState(datetime nowServer = 0)
  {
   if(nowServer <= 0)
      nowServer = TimeCurrent();
   if(nowServer <= 0)
      return;

   datetime dubaiTime   = nowServer + (ServerToDubaiOffsetHours * 3600);
   int      dubaiDayKey = TimeYear(dubaiTime) * 1000 + TimeDayOfYear(dubaiTime);
   bool     isTestRun   = (IsTesting() || IsOptimization());
   string   gvKey       = DubaiNightCloseGvKey();
   string   gvOpenDayK  = "EA_DUBAI_OPEN_DAY_"  + IntegerToString(MagicNumber) + "_" + Symbol();
   string   gvOpenEqK   = "EA_DUBAI_OPEN_EQ_"   + IntegerToString(MagicNumber) + "_" + Symbol();
   string   gvLastCutK  = "EA_DUBAI_LAST_CUT_"  + IntegerToString(MagicNumber) + "_" + Symbol();
   string   gvCutCntK   = "EA_DUBAI_CUT_CNT_"   + IntegerToString(MagicNumber) + "_" + Symbol();
   string   gvPlanADnK  = "EA_HRLY_PLANA_DONE_" + IntegerToString(MagicNumber) + "_" + Symbol();
   string   gvPlanCDnK  = "EA_HRLY_PLANC_DONE_" + IntegerToString(MagicNumber) + "_" + Symbol();
   string   gvPlanDDnK  = "EA_HRLY_PLAND_DONE_" + IntegerToString(MagicNumber) + "_" + Symbol();
   string   gvPlanDHrK  = "EA_HRLYD_DONEH_"     + IntegerToString(MagicNumber) + "_" + Symbol();
   double   curEquity   = AccountEquity();
   double   seedEquity  = (curEquity > 0.0) ? curEquity : AccountBalance();

   if(g_dubaiNightCloseDayKey == -1)
     {
      g_dubaiNightCloseDayKey       = dubaiDayKey;
      g_dubaiNightCloseRetryPending = false;
      if(!isTestRun && GlobalVariableCheck(gvKey))
        {
         int savedDay = (int)MathRound(GlobalVariableGet(gvKey));
         if(savedDay == dubaiDayKey)
            g_dubaiNightCloseDoneToday = true;
         else
           {
            GlobalVariableDel(gvKey);
            g_dubaiNightCloseDoneToday = false;
           }
        }
      else
        {
         g_dubaiNightCloseDoneToday = false;
        }

      if(!isTestRun && GlobalVariableCheck(gvPlanADnK))
        {
         int savedPlanADay = (int)MathRound(GlobalVariableGet(gvPlanADnK));
         if(savedPlanADay == dubaiDayKey)
            g_hourlyPlanADoneToday = true;
         else
           {
            GlobalVariableDel(gvPlanADnK);
            g_hourlyPlanADoneToday = false;
           }
        }
      else
        {
         g_hourlyPlanADoneToday = false;
        }

      if(!isTestRun && GlobalVariableCheck(gvPlanCDnK))
        {
         int savedPlanCDay = (int)MathRound(GlobalVariableGet(gvPlanCDnK));
         if(savedPlanCDay == dubaiDayKey)
            g_hourlyPlanCDoneToday = true;
         else
           {
            GlobalVariableDel(gvPlanCDnK);
            g_hourlyPlanCDoneToday = false;
           }
        }
      else
        {
         g_hourlyPlanCDoneToday = false;
        }

      if(!isTestRun && GlobalVariableCheck(gvPlanDDnK))
        {
         int savedPlanDDay = (int)MathRound(GlobalVariableGet(gvPlanDDnK));
         if(savedPlanDDay == dubaiDayKey)
            g_hourlyPlanDDoneToday = true;
         else
           {
            GlobalVariableDel(gvPlanDDnK);
            g_hourlyPlanDDoneToday = false;
           }
        }
      else
        {
         g_hourlyPlanDDoneToday = false;
        }

      if(!isTestRun && GlobalVariableCheck(gvOpenDayK) && GlobalVariableCheck(gvOpenEqK) &&
         (int)MathRound(GlobalVariableGet(gvOpenDayK)) == dubaiDayKey &&
         GlobalVariableGet(gvOpenEqK) > 0.0)
        {
         g_dubaiDayOpeningEquity   = GlobalVariableGet(gvOpenEqK);
         g_dubaiNightLastCutTime   = GlobalVariableCheck(gvLastCutK) ? (datetime)MathRound(GlobalVariableGet(gvLastCutK)) : 0;
         g_dubaiNightCutCountToday = GlobalVariableCheck(gvCutCntK)  ? (int)MathRound(GlobalVariableGet(gvCutCntK)) : 0;
        }
      else
        {
         g_dubaiDayOpeningEquity   = seedEquity;
         g_dubaiNightLastCutTime   = 0;
         g_dubaiNightCutCountToday = 0;
         g_hourlyPlanAHitsToday    = 0;
         g_hourlyPlanCHitsToday    = 0;
         g_hourlyPlanDHitsToday    = 0;
         if(!isTestRun)
           {
            if(GlobalVariableCheck(gvLastCutK))
               GlobalVariableDel(gvLastCutK);
            if(GlobalVariableCheck(gvCutCntK))
               GlobalVariableDel(gvCutCntK);
            if(seedEquity > 0.0)
              {
               GlobalVariableSet(gvOpenDayK, (double)dubaiDayKey);
               GlobalVariableSet(gvOpenEqK,  g_dubaiDayOpeningEquity);
              }
           }
        }
     }
   else
      if(dubaiDayKey != g_dubaiNightCloseDayKey)
        {
         bool wasDoneYesterday = g_dubaiNightCloseDoneToday;
         int  prevCuts         = g_dubaiNightCutCountToday;
         g_dubaiNightCloseDayKey       = dubaiDayKey;
         g_dubaiNightCloseDoneToday    = false;
         g_dubaiNightCloseRetryPending = false;
         g_dubaiNightLastCutTime       = 0;
         g_dubaiNightCutCountToday     = 0;
         g_dubaiDayOpeningEquity       = seedEquity;
         g_dubaiNightLastCloseTag      = "";
         g_dubaiNightLastCloseOrders   = 0;
         g_dubaiNightLastCloseLots     = 0.0;
         g_dubaiNightLastClosePL       = 0.0;
         g_dubaiNightLastCutZeroSide   = "";
         g_dubaiNightLastCutOrders     = 0;
         g_dubaiNightLastCutLots       = 0.0;
         g_dubaiNightLastCutPL         = 0.0;
         g_dubaiNightLastCutSkippedMin = 0;
         g_dubaiNightLastResetTime     = nowServer;
         g_hourlyPlanADoneToday        = false;
         g_hourlyPlanAHitsToday        = 0;
         g_hourlyPlanCDoneToday        = false;
         g_hourlyPlanCHitsToday        = 0;
         g_hourlyPlanDDoneToday        = false;
         g_hourlyPlanDHitsToday        = 0;
         g_hourlyPlanDDoneHourSlot     = -1;
         if(!isTestRun)
           {
            if(GlobalVariableCheck(gvKey))
               GlobalVariableDel(gvKey);
            if(GlobalVariableCheck(gvLastCutK))
               GlobalVariableDel(gvLastCutK);
            if(GlobalVariableCheck(gvCutCntK))
               GlobalVariableDel(gvCutCntK);
            if(GlobalVariableCheck(gvPlanADnK))
               GlobalVariableDel(gvPlanADnK);
            if(GlobalVariableCheck(gvPlanCDnK))
               GlobalVariableDel(gvPlanCDnK);
            if(GlobalVariableCheck(gvPlanDDnK))
               GlobalVariableDel(gvPlanDDnK);
            if(GlobalVariableCheck(gvPlanDHrK))
               GlobalVariableDel(gvPlanDHrK);
            if(seedEquity > 0.0)
              {
               GlobalVariableSet(gvOpenDayK, (double)dubaiDayKey);
               GlobalVariableSet(gvOpenEqK,  g_dubaiDayOpeningEquity);
              }
           }

         PrintFormat(">>> [DUBAI NIGHT CLOSE RESET] Next Day Start | DubaiTime=%s (DayKey=%d) | NewOpeningEq=$%.2f | PrevDone=%s (Cuts=%d) -> Status RESET",
                     TimeToString(dubaiTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                     dubaiDayKey, g_dubaiDayOpeningEquity, (wasDoneYesterday ? "YES" : "NO"), prevCuts);
        }
      else
         if(g_dubaiDayOpeningEquity <= 0.0 && seedEquity > 0.0)
           {
            g_dubaiDayOpeningEquity = seedEquity;
            if(!isTestRun)
              {
               GlobalVariableSet(gvOpenDayK, (double)dubaiDayKey);
               GlobalVariableSet(gvOpenEqK,  g_dubaiDayOpeningEquity);
              }
           }
  }

//+------------------------------------------------------------------+
//| DrawHourlyPlanACloseIcon                                         |
//| Places chart star marker & "1H TARGET HIT" label whenever 1-Hour |
//| Plan A (DayEq > 5%) target is hit (both close-all & flat checks) |
//+------------------------------------------------------------------+
void DrawHourlyPlanACloseIcon(double dayEqPct, double dayEqUSD, double dayOpenEq, double curEq, int ordersClosed, double lotsClosed, double netPL, datetime hitTime = 0, double hitPrice = 0.0, int hitSeq = 0)
  {
   if(!InpDrawHourlyPlanAIcon)
      return;
   if(ordersClosed <= 0 && !InpDrawHourlyPlanAIconWhenFlat)
      return;

   if(hitTime <= 0)
      hitTime = TimeCurrent();

   datetime barTime  = ((Bars > 0 && Time[0] > 0) ? Time[0] : hitTime);
   int      seqTag   = (hitSeq > 0) ? hitSeq : MathMax(1, g_hourlyPlanATargetHits);
   string   baseName = PREFIX + "HRLY_HIT_" + IntegerToString((int)barTime) + "_" + IntegerToString(seqTag);
   string   txtName  = baseName + "_TXT";

   double atr = iATR(Symbol(), Period(), 14, 1);
   if(atr <= 0.0)
      atr = 30 * Point;
   if(atr <= 0.0)
      atr = 1.0;

   double baseHigh    = ((Bars > 0 && High[0] > 0.0) ? High[0] : Bid);
   double atrOffset   = 1.35 + ((seqTag - 1) % 3) * 0.45;
   double markerPrice = (hitPrice > 0.0 ? hitPrice : baseHigh) + (atr * atrOffset);
   double labelPrice  = markerPrice + (atr * 0.35);

   color iconColor = InpHourlyPlanAIconColor;
   int   iconCode  = (InpHourlyPlanAIconCode > 0 ? InpHourlyPlanAIconCode : 171);
   int   fontSize  = (InpHourlySideLossIconFontSize > 0 ? InpHourlySideLossIconFontSize : 10);

   datetime dubaiDT   = hitTime + (ServerToDubaiOffsetHours * 3600);
   string   plSign    = (netPL >= 0.0) ? "+" : "-";
   double   planAThr  = (InpHourlyPlanADayProfitPct > 0.0) ? InpHourlyPlanADayProfitPct : 5.0;
   string   labelText = "";
   string   tooltip   = "";
   if(ordersClosed > 0)
     {
      labelText = StringFormat("1H TARGET HIT +%.1f%% ALL (x%d -%.2fL)", dayEqPct, ordersClosed, lotsClosed);
      tooltip   = StringFormat("1H HOUR TARGET HIT | DayEq: +%.2f%% (+$%.2f) > %.1f%% | Open:$%.2f Cur:$%.2f | Closed ALL %d (-%.2fL, NetPL:%s$%.2f) | Dubai:%s",
                               dayEqPct, dayEqUSD, planAThr, dayOpenEq, curEq,
                               ordersClosed, lotsClosed, plSign, MathAbs(netPL),
                               TimeToString(dubaiDT, TIME_DATE|TIME_MINUTES|TIME_SECONDS));
     }
   else
     {
      labelText = StringFormat("1H TARGET HIT +%.1f%% (0 Open)", dayEqPct);
      tooltip   = StringFormat("1H HOUR TARGET HIT (0 OPEN) | DayEq: +%.2f%% (+$%.2f) > %.1f%% | Open:$%.2f Cur:$%.2f | Flat at hourly check | Dubai:%s",
                               dayEqPct, dayEqUSD, planAThr, dayOpenEq, curEq,
                               TimeToString(dubaiDT, TIME_DATE|TIME_MINUTES|TIME_SECONDS));
     }

   if(ObjectFind(0, baseName) >= 0 || ObjectFind(0, txtName) >= 0)
     {
      if(ObjectFind(0, txtName) >= 0)
        {
         ObjectSetString(0, txtName, OBJPROP_TEXT, labelText);
         ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);
        }
      if(ObjectFind(0, baseName) >= 0)
         ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);
      ChartRedraw(0);
      return;
     }

   ObjectCreate(0, baseName, OBJ_ARROW, 0, barTime, markerPrice);
   ObjectSetInteger(0, baseName, OBJPROP_ARROWCODE, iconCode);
   ObjectSetInteger(0, baseName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, baseName, OBJPROP_WIDTH, 4);
   ObjectSetInteger(0, baseName, OBJPROP_BACK, false);
   ObjectSetInteger(0, baseName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, baseName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);

   ObjectCreate(0, txtName, OBJ_TEXT, 0, barTime, labelPrice);
   ObjectSetString(0, txtName, OBJPROP_TEXT, labelText);
   ObjectSetString(0, txtName, OBJPROP_FONT, "Arial Black");
   ObjectSetInteger(0, txtName, OBJPROP_FONTSIZE, fontSize);
   ObjectSetInteger(0, txtName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, txtName, OBJPROP_ANCHOR, ANCHOR_LOWER);
   ObjectSetInteger(0, txtName, OBJPROP_BACK, false);
   ObjectSetInteger(0, txtName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, txtName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);

   ChartRedraw(0);

   PrintFormat(">>> [1H TARGET HIT CHART ICON] Placed '%s' on bar %s (Dubai %s)",
               labelText, TimeToString(barTime, TIME_DATE|TIME_MINUTES),
               TimeToString(dubaiDT, TIME_MINUTES|TIME_SECONDS));
  }

