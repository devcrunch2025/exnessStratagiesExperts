bool IsDailyEquityStopReacheddmanual()
  {
   double stopEquity = g_dayOpeningBalance *
                       (DailyEquityStopUSD / 100.0);


   stopEquity=g_dayOpeningBalance+(DailyEquityStopUSD* balancelomultipler);

   Print("stopEquity ", DoubleToString(stopEquity, 2), " AccountEquity() ", DoubleToString(AccountEquity(), 2));

   if(AccountEquity() <= stopEquity)
     {
      g_dailyEquityTradingBlocked = true;
      return true;
     }

   return g_dailyEquityTradingBlocked;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| ModifyOpenOrdersToCurrentPriceSL                                 |
//| Locks in profit by moving SL of all open market orders to        |
//| current live market price (with minimum stop distance buffer).   |
//| Called on DailyEquityStopUSD target hit and on each +$5 step hit.|
//+------------------------------------------------------------------+
void ModifyOpenOrdersToCurrentPriceSL(string reason = "Daily Equity Target Hit")
{
   RefreshRates();
   double minDistance = GetRequiredStopDistance();
   if(minDistance < 20.0)
      minDistance = 20.0;

   double curBid = MarketInfo(Symbol(), MODE_BID);
   double curAsk = MarketInfo(Symbol(), MODE_ASK);
   int modifiedCount = 0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;

      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      // Exclude recovery orders: they have their own recovery logic
      if(IsAnyRecoveryOrder(OrderTicket(), OrderComment()))
         continue;

      // Exclude FLIPBasketSupport orders: they have dedicated step-trailing SL
      if(IsFLIPBasketSupportOrder(OrderTicket(), OrderComment()))
         continue;

      int    tkt   = OrderTicket();
      int    oType = OrderType();
      double oOpen = OrderOpenPrice();
      double curSL = OrderStopLoss();
      double curTP = OrderTakeProfit();
      double netPL = OrderProfit() + OrderSwap() + OrderCommission();

      RefreshRates();
      curBid = MarketInfo(Symbol(), MODE_BID);
      curAsk = MarketInfo(Symbol(), MODE_ASK);

      double proposedSL   = 0.0;
      bool   shouldModify = false;

      if(oType == OP_BUY)
      {
         proposedSL = NormalizeDouble(curBid - minDistance, Digits);
         if((curBid - proposedSL) < minDistance)
            proposedSL = NormalizeDouble(curBid - minDistance, Digits);

         if(proposedSL >= curBid)
            continue;

         // For BUY: Set if no SL (0.0), or only move SL forward (higher) by at least 1 point
         if(curSL == 0.0 || (proposedSL > curSL && (proposedSL - curSL) >= Point))
         {
            shouldModify = true;
         }
      }
      else if(oType == OP_SELL)
      {
         proposedSL = NormalizeDouble(curAsk + minDistance, Digits);
         if((proposedSL - curAsk) < minDistance)
            proposedSL = NormalizeDouble(curAsk + minDistance, Digits);

         if(proposedSL <= curAsk)
            continue;

         // For SELL: Set if no SL (0.0), or only move SL forward (lower) by at least 1 point
         if(curSL == 0.0 || (proposedSL < curSL && (curSL - proposedSL) >= Point))
         {
            shouldModify = true;
         }
      }

      if(shouldModify && proposedSL > 0.0)
      {
         ResetLastError();
         bool modified = SafeOrderModify(tkt, oOpen, proposedSL, curTP, 0, (oType == OP_BUY ? clrLimeGreen : clrTomato));
         if(modified)
         {
            modifiedCount++;
            Print(StringFormat("[DAILY EQ STEP SL - %s] Ticket #%d | Type=%s | P/L=$%.2f | Old SL=%.2f -> New SL=%.2f",
                  reason, tkt, (oType == OP_BUY ? "BUY" : "SELL"), netPL, curSL, proposedSL));
         }
      }
   }
}

//+------------------------------------------------------------------+
//| IsDailyEquityStopReached                                         |
//| 1. On DailyEquityStopUSD reached: Modifies open orders SL to     |
//|    current price, continues trading to collect $5 steps.         |
//| 2. On +$5 step hit: Modifies SL to current price step-by-step.   |
//| 3. On 80% Retrace: Closes all orders and pauses for the day.     |
//+------------------------------------------------------------------+
bool IsDailyEquityStopReached()
{
   if(g_dailyEquityTradingBlocked)
      return true;

   double dailyTarget = DailyEquityStopUSD;

   // Get Dubai time (UTC+4)
   datetime dubaiTime = TimeGMT() + (4 * 3600);

   int dayOfWeek = TimeDayOfWeek(dubaiTime);

   // Saturday = 6, Sunday = 0
   if(dayOfWeek == 6 || dayOfWeek == 0)
   {
      dailyTarget = DailyEquityStopUSD / 2.0;
   }

   int mult = (balancelomultipler > 0) ? balancelomultipler : 1;
   double targetEquity = g_dayOpeningBalance + (dailyTarget * mult);
   double stepUSD      = DailyEquityTrailStepUSD * mult;
   double curEquity    = AccountEquity();

   // Track peak equity once target is hit today
   if(g_dailyEquityTargetHitToday && curEquity > g_dailyEquityPeakEquity)
      g_dailyEquityPeakEquity = curEquity;

   // Dynamic 80% Retrace Floor of Total Collected Profit (DailyEquityStopUSD + all $5 steps)
   double totalPeakProfit = (g_dailyEquityPeakEquity > g_dayOpeningBalance) ? (g_dailyEquityPeakEquity - g_dayOpeningBalance) : (dailyTarget * mult);
   if(totalPeakProfit < dailyTarget * mult)
      totalPeakProfit = dailyTarget * mult;

   double floorProfit = totalPeakProfit * (DailyEquityRetraceFloorPct / 100.0);
   double floorEquity = g_dayOpeningBalance + floorProfit;

   // ==============================================================
   // PHASE 1: INITIAL TARGET HIT ($50 * multiplier reached)
   // ==============================================================
   if(!g_dailyEquityTargetHitToday)
   {
      if(curEquity >= targetEquity)
      {
         g_dailyEquityTargetHitToday = true;
         g_dailyEquityPeakEquity     = curEquity;
         g_dailyEquityStepCount      = 0;
         g_dailyEquityNextStepTarget = curEquity + stepUSD; // Next $5 milestone

         totalPeakProfit = g_dailyEquityPeakEquity - g_dayOpeningBalance;
         floorProfit     = totalPeakProfit * (DailyEquityRetraceFloorPct / 100.0);
         floorEquity     = g_dayOpeningBalance + floorProfit;

         Print(StringFormat("[DAILY EQUITY PROFIT TARGET HIT] Target=$%.2f | CurEquity=$%.2f (Profit=+$%.2f) | Modifying SL to Current Price | Trail Step=$%.2f | Dynamic 80%% Floor=$%.2f (80%% of $%.2f) | Continuing trading...",
               targetEquity, curEquity, (curEquity - g_dayOpeningBalance), stepUSD, floorEquity, totalPeakProfit));

         // User Rule: Modify orders with stoploss price at current price
         ModifyOpenOrdersToCurrentPriceSL("Initial Target Hit");

         // Continue trading to collect $5 step profit step-by-step
      }
   }
   // ==============================================================
   // PHASE 2: TARGET HIT TODAY - COLLECT $5 STEPS / RETRACE TO 80%
   // ==============================================================
   else
   {
      // Track peak equity
      if(curEquity > g_dailyEquityPeakEquity)
         g_dailyEquityPeakEquity = curEquity;

      // Recalculate dynamic 80% floor of total peak profit collected (Daily target + steps)
      totalPeakProfit = g_dailyEquityPeakEquity - g_dayOpeningBalance;
      floorProfit     = totalPeakProfit * (DailyEquityRetraceFloorPct / 100.0);
      floorEquity     = g_dayOpeningBalance + floorProfit;

      // Collect +$5 step profit step-by-step
      if(curEquity >= g_dailyEquityNextStepTarget && g_dailyEquityNextStepTarget > 0.0)
      {
         g_dailyEquityStepCount++;
         Print(StringFormat("[DAILY EQUITY +$5 STEP #%d HIT] Equity=$%.2f | Peak=$%.2f (+$%.2f) | Dynamic 80%% Floor=$%.2f (80%% of $%.2f) | Modifying SL to Current Price | Next Step Target=$%.2f",
               g_dailyEquityStepCount, curEquity, g_dailyEquityPeakEquity, totalPeakProfit, floorEquity, totalPeakProfit, (curEquity + stepUSD)));

         g_dailyEquityNextStepTarget = curEquity + stepUSD;

         ModifyOpenOrdersToCurrentPriceSL(StringFormat("+$5 Step #%d", g_dailyEquityStepCount));
      }

      // Stop trading and pause for the day when coming back to 80% of total collected profit
      if(curEquity <= floorEquity)
      {
         g_dailyEquityTradingBlocked = true;

         Print(StringFormat("[DAILY EQUITY 80%% RETRACE STOP] Total peak profit collected was $%.2f (Daily target + %d x $5 steps). Equity dropped to 80%% floor ($%.2f <= $%.2f). Closing all orders and pausing for the day.",
               totalPeakProfit, g_dailyEquityStepCount, curEquity, floorEquity));

         CloseAndDeleteAllEAOrdersOnTradingStop();

         return true;
      }
   }

   return g_dailyEquityTradingBlocked;
}
bool IsDailyEquityStopReachedAlldays()
  {
// Calculates the ceiling equity (e.g., 100 * (1.0 + 0.05) = 105)
   double targetEquity = g_dayOpeningBalance * (1.0 + (DailyEquityStopUSD / 100.0));

   targetEquity=g_dayOpeningBalance+(DailyEquityStopUSD* balancelomultipler);

// Print("targetEquity: ", DoubleToString(targetEquity, 2), " AccountEquity(): ", DoubleToString(AccountEquity(), 2));

// Stop trading if equity hits or exceeds the target
   if(AccountEquity() >= targetEquity)
     {
      g_dailyEquityTradingBlocked = true;

      Print("[DAILY EQUITY PROFIT TARGET HIT] Closing all orders and pausing until new day.");

      CloseAndDeleteAllEAOrdersOnTradingStop();

      return true;
     }

   return g_dailyEquityTradingBlocked;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void OnTick()
  {
CheckForNewDay();
IsDailyEquityStopReached(); // Check target every tick; sets g_dailyEquityTradingBlocked and closes all orders if hit
if(g_dailyEquityTradingBlocked)
  {
   UpdateDubaiTradingPauseDashboard(); // Keep dashboard updated while paused
   UpdateLeftLiveOrdersDashboard();    // Refresh live dashboard while paused
   return ;
  }

   if(AccountEquity()<=0)
      return ;

   CurrentTickSequence++;
   g_onTickSequence++;
   InvalidateOrderCache();
   ResetTradeErrorRetryGuards();
   TradeOperationFailedThisTick = false;
   ResetTradeRequestBudget();
   g_eqDdForceCloseBudget = false;


   profitAfterFlip = GetProfitAfterLastEmaFlip();


if(GetOpenPL(OP_BUY)<0 || GetOpenPL(OP_SELL)<0   )
{

MinimumSLModifyGapRaw=10;//
}



   int lotMultiplierDiv = (AccountMultiplierLOT > 0) ? AccountMultiplierLOT : 500;

   balancelomultipler = (int)(AccountEquity() / lotMultiplierDiv);
   if(balancelomultipler<=0)
      balancelomultipler=1;


   SecureOneDollarProfit();
   CheckEmaFlipHalfDistancePartialLossCut();
   CheckMaxLossCap001Lots();
   Check90PctSLAdversePartialCutAndDoubleSL();
   ManageEquityDrawdownTieredLotReduction();
   ManageHourlySideLoss20PctCut();
   ManageAdversePriceStepLossCut();
   Check50PctDrawdownReliefTightenSL();
