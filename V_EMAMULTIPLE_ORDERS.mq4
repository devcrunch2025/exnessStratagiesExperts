                  Print(">>> [CHANGE_LOTS M1 BOOSTER] EQH-R detected & EMA -1: BUY order lot boosted to MINIMUM ",
                        DoubleToString(boosterMinLot, 2), " (Reason: ", reason, ")");
                 }
              }
        }

      if(eqhG_detected && EMADirection == 1 && applyM1_EQHG)
        {
         if(isBuyOrder)
