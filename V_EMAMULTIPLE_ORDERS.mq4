//+------------------------------------------------------------------+
//| Check if absolute price difference exceeds threshold in timeframe|
//+------------------------------------------------------------------+
bool IsAbsolutePriceDifferenceExceeded(int minutes, double threshold)
  {
// Assuming an M1 chart, 1 minute = 1 bar.
// If your EA runs on M5, M15, etc., you can adjust the multiplier accordingly,
// but assuming M1 execution:
   int barsToCheck = minutes;

   if(Bars < barsToCheck || barsToCheck <= 0)
      return false;

   double highestPrice = High[0];
   double lowestPrice  = Low[0];

// Scan the historical bars within the specified minute window
   for(int i = 1; i < barsToCheck; i++)
     {
      if(High[i] > highestPrice)
         highestPrice = High[i];
      if(Low[i] < lowestPrice)
         lowestPrice  = Low[i];
     }

// Absolute distance between the ceiling and floor within the time window
   double absoluteDifference = highestPrice - lowestPrice;

// Returns true if the absolute range exceeds the user-defined threshold
   if(absoluteDifference > threshold)
     {
      return true;
     }

   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsExtremePriceOrder(int orderType, double requestedLot,double maxLot)
  {
   if(requestedLot < maxLot)
      return false;

   bool isExtreme = true;
   bool hasExistingOrders = false;
   RefreshRates();

   double currentPrice = (orderType == OP_BUY) ? Ask : Bid;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      if(OrderType() != orderType)
         continue;

      hasExistingOrders = true;

      if(orderType == OP_BUY && OrderOpenPrice() >= currentPrice)
         isExtreme = false;
      if(orderType == OP_SELL && OrderOpenPrice() <= currentPrice)
         isExtreme = false;
     }
   return (hasExistingOrders && isExtreme);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int CountActiveRecoveryOrders()
  {
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      if(StringFind(OrderComment(), "RECOVERY_") == 0)
         count++;
     }
   return count;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void CheckRecoveryOrders()
  {
   if(!EnableRecoveryOrders || GetTotalEAOrders() >= MaxOpenOrders || !IsOneCandleOrderAllowed())
      return;
   if(CountActiveRecoveryOrders() >= 1)
      return;

   if(!IsEmaWEAKDistanceReduced50PercentFromPeak() && GlobalSSLDirection !=  EMADirection)
     {
      return;

     }

   double emaAngle = GlobalEmaAngle30;

   RefreshRates();
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderMagicNumber() != MagicNumber || OrderSymbol() != Symbol())
         continue;

      int parentTicket = OrderTicket();
      int parentType   = OrderType();

      if(parentType != OP_BUY && parentType != OP_SELL)
         continue;

      // if(InpEnableEmaAngleFilter)
      //   {
      //    if(parentType == OP_BUY && emaAngle <= InpMinEmaAngleDegrees)
      //       continue;
      //    if(parentType == OP_SELL && emaAngle >= -InpMinEmaAngleDegrees)
      //       continue;
      //   }

      string comment = OrderComment();
      if(StringFind(comment, "RECOVERY_") == 0)
         continue;
      if(!InpAllowRecoveryForHorizontalOrders && IsHorizontalLineOrder(parentTicket, comment))
         continue;

      bool validParent = false;
      if(StringFind(comment, "SSL Long") >= 0 || StringFind(comment, "SSL Short") >= 0 || StringFind(comment, "ReEntry") >= 0)
         validParent = true;
      if(!validParent)
         continue;
      if(InpEnableRecoveryAttemptShield && HasParentExhaustedRecoveryAttempts(parentTicket))
         continue;
      if(HasRecoveryOrder(parentTicket))
         continue;

      double parentLots = OrderLots();
      double currentProfitUSD = OrderProfit() + OrderSwap() + OrderCommission();

      double dynamicRecoveryLossLimit = -MathAbs(RecoveryTriggerLossUSD * parentLots * 100.0);
      if(currentProfitUSD > dynamicRecoveryLossLimit)
         continue;

      double newExecutionPrice = (parentType == OP_BUY) ? Ask : Bid;
      double adverseDistance = (parentType == OP_BUY) ? (OrderOpenPrice() - newExecutionPrice) : (newExecutionPrice - OrderOpenPrice());

      // if(parentType == OP_BUY  && EMADirection == 1)// && GlobalSSLDirection == 1 && emaAngle > 5.0)
      //   {
      //    if(adverseDistance < (RecoveryMinDistanceRaw / 2.0))
      //       continue;
      //   }
      // else
      //    if(parentType == OP_SELL && EMADirection == -1)// && GlobalSSLDirection == -1  && emaAngle < -5.0)
      //      {
      //       if(adverseDistance < (RecoveryMinDistanceRaw / 2.0))
      //          continue;
      //      }
      //    else
        {
         if(adverseDistance < RecoveryMinDistanceRaw)
            continue;
        }

      if(parentType == OP_BUY && GlobalSSLDirection != 1 && EMADirection != 1)
         continue;
      if(parentType == OP_SELL && GlobalSSLDirection != -1 && EMADirection != -1)
         continue;

      double recoveryLots = NormalizeLots(parentLots * RecoveryLotMultiplier);
      if(recoveryLots <= 0)
         continue;

      StopLossUSD=OriginalStopLossUSD;

      int recoveryTicket = -1;
      double slDistance = (RecoveryStopLossDistanceRaw > 0.0) ? RecoveryStopLossDistanceRaw : ((RecoveryStopLossRaw > 0.0) ? RecoveryStopLossRaw : 200.0);
      double tpDistance = (TakeProfitRawPriceGap > 0.0) ? TakeProfitRawPriceGap : 500.0;

      double recoverySL = 0.0;
      double recoveryTP = 0.0;

      if(parentType == OP_BUY)
        {
         recoverySL = (slDistance > 0) ? NormalizeDouble(Ask - slDistance, Digits) : 0;
         recoveryTP = (tpDistance > 0) ? NormalizeDouble(Ask + tpDistance, Digits) : 0;
         recoveryTicket = SafeOrderSend(Symbol(), OP_BUY, recoveryLots, Ask, Slippage, recoverySL, recoveryTP, "RECOVERY_" + IntegerToString(parentTicket), MagicNumber, clrAqua);
        }
      else
        {
         recoverySL = (slDistance > 0) ? NormalizeDouble(Bid + slDistance, Digits) : 0;
         recoveryTP = (tpDistance > 0) ? NormalizeDouble(Bid - tpDistance, Digits) : 0;
         recoveryTicket = SafeOrderSend(Symbol(), OP_SELL, recoveryLots, Bid, Slippage, recoverySL, recoveryTP, "RECOVERY_" + IntegerToString(parentTicket), MagicNumber, clrOrange);
        }

      if(recoveryTicket > 0)
        {
         RegisterParentRecoveryAttempt(parentTicket);
         OrderCreatedThisCandle = true;
         LastOrderCandleTime    = Time[0];
        }
      break;
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void ManageRecoveryBasket()
  {
   if(!EnableRecoveryOrders && !InpEnableLsdStructuralRecovery && !InpEnableType3Recovery && !InpEnableHedgeRecovery && !InpEnableHorizontalLineRecovery && !InpEnableReverse100Order)
      return;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int recoveryTicket = OrderTicket();
      string rawComment = OrderComment();
      string comment = GetEffectiveOrderComment(recoveryTicket, rawComment);
      if(StringFind(comment, "RECOVERY_") != 0)
         continue;

      double recoveryLots = OrderLots();
      int recoveryType = OrderType();
      if(recoveryType != OP_BUY && recoveryType != OP_SELL)
         continue;
      double recoveryProfit = OrderProfit() + OrderSwap() + OrderCommission();

      int parentTicket = GetRecoveryOrderParentTicket(recoveryTicket, comment);
      if(parentTicket <= 0)
         parentTicket = (int)StringToInteger(StringSubstr(comment, 9));
      if(parentTicket <= 0)
         continue;

      bool parentFound = false;
      int parentCurrentTicket = parentTicket;
      double parentLots = 0.0;
      int parentType = -1;
      double parentProfit = 0.0;

      for(int j = OrdersTotal() - 1; j >= 0; j--)
        {
         if(!OrderSelect(j, SELECT_BY_POS, MODE_TRADES))
            continue;
         if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
            continue;
         int candType = OrderType();
         if(candType != OP_BUY && candType != OP_SELL)
            continue;
         int candTicket = OrderTicket();
         string candComment = OrderComment();
         if(candTicket == parentTicket || ResolveRootTicketFromPartialChain(candTicket, candComment) == parentTicket)
           {
            parentFound = true;
            parentCurrentTicket = candTicket;
            parentLots = OrderLots();
            parentType = candType;
            parentProfit = OrderProfit() + OrderSwap() + OrderCommission();
            break;
           }
        }

      if(!parentFound)
         continue;

      bool isRev100 = (StringFind(comment, "_REV") >= 0);
      double basketProfit = recoveryProfit + parentProfit;
      double targetProfit = isRev100 ? InpReverse100BasketProfitUSD : ((StringFind(comment, "_HEDGE") >= 0) ? InpHedgeRecoveryBasketProfitUSD : ((StringFind(comment, "_LSD") >= 0) ? InpLsdRecoveryBasketProfitUSD : ((StringFind(comment, "_TYPE3") >= 0) ? InpType3BasketProfitUSD : RecoveryBasketProfitUSD)));
      if(targetProfit <= 0.0)
         targetProfit = isRev100 ? 2.0 : 1.0;

      if(basketProfit >= targetProfit)
        {
         RecordOrderCloseReason(recoveryTicket, "RECOVERY_BASKET_PROFIT");
         RecordOrderCloseReason(parentCurrentTicket, "RECOVERY_BASKET_PARENT_SACRIFICE");
         if(parentCurrentTicket != parentTicket)
            RecordOrderCloseReason(parentTicket, "RECOVERY_BASKET_PARENT_SACRIFICE");
         RecordBasketOutcome(parentCurrentTicket, recoveryTicket, basketProfit);
         if(parentCurrentTicket != parentTicket)
            RecordBasketOutcome(parentTicket, recoveryTicket, basketProfit);

         if(isRev100)
           {
            g_eqDdForceCloseBudget = true;
            bool recClosed = SafeOrderCloseMarket(recoveryTicket, recoveryLots, Slippage, (recoveryType == OP_BUY ? clrRed : clrBlue));
            bool parClosed = SafeOrderCloseMarket(parentCurrentTicket, parentLots, Slippage, (parentType == OP_BUY ? clrRed : clrBlue));
            g_eqDdForceCloseBudget = false;
            PrintFormat(">>> [REVERSE $100 BASKET CLOSED] Recovery #%d (%s %.2fL, %s$%.2f, Closed=%s) + Parent #%d (Root #%d, %s %.2fL, %s$%.2f, Closed=%s) = Net +$%.2f >= Target $%.2f",
                        recoveryTicket, (recoveryType == OP_BUY ? "BUY" : "SELL"), recoveryLots,
                        (recoveryProfit >= 0.0 ? "+" : "-"), MathAbs(recoveryProfit), (recClosed ? "YES" : "NO"),
                        parentCurrentTicket, parentTicket, (parentType == OP_BUY ? "BUY" : "SELL"), parentLots,
                        (parentProfit >= 0.0 ? "+" : "-"), MathAbs(parentProfit), (parClosed ? "YES" : "NO"),
                        basketProfit, targetProfit);
           }
         else
           {
            SafeOrderClose(recoveryTicket, recoveryLots, recoveryType, Slippage, (recoveryType == OP_BUY ? clrRed : clrBlue));
            SafeOrderClose(parentCurrentTicket, parentLots, parentType, Slippage, (parentType == OP_BUY ? clrRed : clrBlue));
            static datetime lastRecoveryLogTime = 0;
            if(TimeCurrent() - lastRecoveryLogTime >= 5)
              {
               Print(">>> [RECOVERY BASKET SL SECURED] ", (StringFind(comment, "_HEDGE") >= 0 ? "Trend-Shift Hedge" : (StringFind(comment, "_LSD") >= 0 ? "Type 2 Structural" : ((StringFind(comment, "_TYPE3") >= 0) ? "Type 3 Weak EMA" : "Type 1"))),
                     " Basket: Recovery #", recoveryTicket, " (+$", DoubleToString(recoveryProfit, 2),
                     ") + Parent #", parentCurrentTicket, " ($", DoubleToString(parentProfit, 2),
                     ") = Total Net $", DoubleToString(basketProfit, 2), " >= Target $", DoubleToString(targetProfit, 2),
                     " | Trailing SL with $50 gap maintained");
               lastRecoveryLogTime = TimeCurrent();
              }
           }
         break;
        }
     }
  }

// ===== STRICT 1-ATTEMPT SHIELD REGISTRY =====
struct ParentRecoveryTracker
  {
   int               parentTicket;
   int               attempts;
  };
ParentRecoveryTracker g_parentRecoveryAttempts[500];
int g_parentRecoveryAttemptCount = 0;

//+------------------------------------------------------------------+
//| RegisterParentRecoveryAttempt: Records an attempt for a parent   |
//+------------------------------------------------------------------+
void RegisterParentRecoveryAttempt(int parentTicket)
  {
   if(parentTicket <= 0)
      return;
   for(int i = 0; i < g_parentRecoveryAttemptCount; i++)
     {
      if(g_parentRecoveryAttempts[i].parentTicket == parentTicket)
        {
         g_parentRecoveryAttempts[i].attempts++;
         return;
        }
     }
   if(g_parentRecoveryAttemptCount < 500)
     {
      g_parentRecoveryAttempts[g_parentRecoveryAttemptCount].parentTicket = parentTicket;
      g_parentRecoveryAttempts[g_parentRecoveryAttemptCount].attempts = 1;
      g_parentRecoveryAttemptCount++;
     }
  }

//+------------------------------------------------------------------+
//| GetParentRecoveryAttemptCount: Returns total attempts for parent |
//+------------------------------------------------------------------+
int GetParentRecoveryAttemptCount(int parentTicket)
  {
   if(parentTicket <= 0)
      return 0;
   for(int i = 0; i < g_parentRecoveryAttemptCount; i++)
     {
      if(g_parentRecoveryAttempts[i].parentTicket == parentTicket)
         return g_parentRecoveryAttempts[i].attempts;
     }

// Fallback check against open and history orders
   int count = 0;
   string targetPrefix = "RECOVERY_" + IntegerToString(parentTicket);

// Check open trades
   for(int o = OrdersTotal() - 1; o >= 0; o--)
     {
      if(OrderSelect(o, SELECT_BY_POS, MODE_TRADES))
        {
         if(OrderMagicNumber() == MagicNumber && OrderSymbol() == Symbol())
           {
            string effCmt = GetEffectiveOrderComment(OrderTicket(), OrderComment());
            if(effCmt == targetPrefix || StringFind(effCmt, targetPrefix + "_") == 0)
               count++;
           }
        }
     }

// Check closed history orders
   for(int h = OrdersHistoryTotal() - 1; h >= 0; h--)
     {
      if(OrderSelect(h, SELECT_BY_POS, MODE_HISTORY))
        {
         if(OrderMagicNumber() == MagicNumber && OrderSymbol() == Symbol())
           {
            string effCmt = GetEffectiveOrderComment(OrderTicket(), OrderComment());
            if(effCmt == targetPrefix || StringFind(effCmt, targetPrefix + "_") == 0)
               count++;
           }
        }
     }

   if(count > 0)
     {
      RegisterParentRecoveryAttempt(parentTicket);
      for(int i = 0; i < g_parentRecoveryAttemptCount; i++)
        {
         if(g_parentRecoveryAttempts[i].parentTicket == parentTicket)
           {
            g_parentRecoveryAttempts[i].attempts = count;
            break;
           }
        }
     }
   return count;
  }

//+------------------------------------------------------------------+
//| HasParentExhaustedRecoveryAttempts: Checks if parent used limit  |
//+------------------------------------------------------------------+
bool HasParentExhaustedRecoveryAttempts(int parentTicket)
  {
   if(!InpEnableRecoveryAttemptShield)
      return false;
   int maxAllowed = (InpRecoveryMaxAttemptsPerParent > 0) ? InpRecoveryMaxAttemptsPerParent : 1;
   return (GetParentRecoveryAttemptCount(parentTicket) >= maxAllowed);
  }

//+------------------------------------------------------------------+
//| InitParentRecoveryAttemptRegistry: Populates registry at start   |
//+------------------------------------------------------------------+
void InitParentRecoveryAttemptRegistry()
  {
   g_parentRecoveryAttemptCount = 0;
   int hTotal = OrdersHistoryTotal();
   for(int h = 0; h < hTotal; h++)
     {
      if(!OrderSelect(h, SELECT_BY_POS, MODE_HISTORY))
         continue;
      if(OrderMagicNumber() != MagicNumber || OrderSymbol() != Symbol())
         continue;
      int hTkt = OrderTicket();
      string cmt = GetEffectiveOrderComment(hTkt, OrderComment());
      if(StringFind(cmt, "RECOVERY_") == 0)
        {
         int pTicket = GetRecoveryOrderParentTicket(hTkt, cmt);
         if(pTicket > 0)
            RegisterParentRecoveryAttempt(pTicket);
        }
     }

   int tTotal = OrdersTotal();
   for(int t = 0; t < tTotal; t++)
     {
      if(!OrderSelect(t, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderMagicNumber() != MagicNumber || OrderSymbol() != Symbol())
         continue;
      int tTkt = OrderTicket();
      string cmt = GetEffectiveOrderComment(tTkt, OrderComment());
      if(StringFind(cmt, "RECOVERY_") == 0)
        {
         int pTicket = GetRecoveryOrderParentTicket(tTkt, cmt);
         if(pTicket > 0)
            RegisterParentRecoveryAttempt(pTicket);
        }
     }
  }

//+------------------------------------------------------------------+
//| HasRecoveryOrder: Checks if parent has an active recovery order  |
//+------------------------------------------------------------------+
bool HasRecoveryOrder(int ParentTicket)
  {
   int currentSelectedTicket = OrderTicket();
   string targetComment = "RECOVERY_" + IntegerToString(ParentTicket);
   bool found = false;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderMagicNumber() != MagicNumber)
         continue;
      int type = OrderType();
      if(type != OP_BUY && type != OP_SELL)
         continue;
      if(OrderSymbol() != Symbol())
         continue;
      string effCmt = GetEffectiveOrderComment(OrderTicket(), OrderComment());
      if(effCmt == targetComment || StringFind(effCmt, targetComment + "_") == 0)
        {
         found = true;
         break;
        }
     }
   if(currentSelectedTicket > 0)
      OrderSelect(currentSelectedTicket, SELECT_BY_TICKET, MODE_TRADES);
   return found;
  }

//+------------------------------------------------------------------+
//| CountActiveLsdRecoveryOrders: Counts active Type 2 Recovery      |
//+------------------------------------------------------------------+
int CountActiveLsdRecoveryOrders()
  {
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      string cmt = GetEffectiveOrderComment(OrderTicket(), OrderComment());
      if(StringFind(cmt, "RECOVERY_") == 0 && StringFind(cmt, "_LSD") >= 0)
         count++;
     }
   return count;
  }

