//+------------------------------------------------------------------+
//| CheckLsdStructuralRecoveryOrders: EQL/EQH Structural Recovery    |
//| (Type 2). Opens recovery order at confirmed EQL support line     |
//| for losing BUYs, or confirmed EQH resistance line for losing     |
//| SELLs, reducing breakeven distance from $200+ to just ~.      |
//+------------------------------------------------------------------+
void CheckLsdStructuralRecoveryOrders()
  {
   if(!InpEnableLsdStructuralRecovery || GetTotalEAOrders() >= MaxOpenOrders || !IsOneCandleOrderAllowed())
      return;

   int maxActive = (InpLsdRecoveryMaxActiveOrders > 0) ? InpLsdRecoveryMaxActiveOrders : 1;
   if(CountActiveLsdRecoveryOrders() >= maxActive)
      return;

   RefreshRates();

   bool eqhRPresent = (g_lastEqHighPrice > 0.0 && g_lastEqHighLineStart > 0 && IsHorizontalLineActivationWaitSatisfied(true));
   bool eqhGPresent = (g_lastEqLowPrice  > 0.0 && g_lastEqLowLineStart  > 0 && IsHorizontalLineActivationWaitSatisfied(false));

   if(!eqhRPresent && !eqhGPresent)
      return; // No active single structural liquidity lines past activation wait

   double eqhPrice = eqhRPresent ? g_lastEqHighPrice : 0.0;
   double eqlPrice = eqhGPresent ? g_lastEqLowPrice  : 0.0;

   double tolGap     = (InpLsdRecoveryLevelToleranceRaw > 0.0) ? InpLsdRecoveryLevelToleranceRaw : 50.0;
   double minAdvGap   = (InpLsdRecoveryMinAdverseGap > 0.0)      ? InpLsdRecoveryMinAdverseGap     : 100.0;
   double minLossUSD  = (InpLsdRecoveryTriggerLossUSD > 0.0)     ? InpLsdRecoveryTriggerLossUSD    : 1.0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderMagicNumber() != MagicNumber || OrderSymbol() != Symbol())
         continue;

      int parentTicket = OrderTicket();
      int parentType   = OrderType();
      if(parentType != OP_BUY && parentType != OP_SELL)
         continue;

      string comment = OrderComment();
      if(IsAnyRecoveryOrder(parentTicket, comment) || IsFLIPBasketSupportOrder(parentTicket, comment))
         continue;
      if(!InpAllowRecoveryForHorizontalOrders && IsHorizontalLineOrder(parentTicket, comment))
         continue;

      // Only rescue regular trades (SSL Long, SSL Short, ReEntry)
      bool validParent = (StringFind(comment, "SSL Long") >= 0 || StringFind(comment, "SSL Short") >= 0 || StringFind(comment, "ReEntry") >= 0);
      if(!validParent)
         continue;

      if(InpEnableRecoveryAttemptShield && HasParentExhaustedRecoveryAttempts(parentTicket))
         continue;

      if(HasRecoveryOrder(parentTicket))
         continue; // Parent already has an active recovery order (strictly max 1 per parent)

      double parentLots = OrderLots();
      double currentProfitUSD = OrderProfit() + OrderSwap() + OrderCommission();

      // Must be in loss >= minLossUSD
      if(currentProfitUSD > -MathAbs(minLossUSD))
         continue;

      double parentOpen = OrderOpenPrice();

      // =================================================================
      // CASE 1: Underwater BUY parent + GREEN LINE (EQL Support) Detected
      // =================================================================
      if(parentType == OP_BUY && eqhGPresent && eqlPrice > 0.0)
        {
         double livePrice = Ask;
         double adverseDistance = parentOpen - livePrice;

         // Must have dropped at least minAdvGap from parent entry
         if(adverseDistance >= minAdvGap)
           {
            // Price must be near the GREEN Line (within tolerance)
            double distToLine = MathAbs(livePrice - eqlPrice);
            if(distToLine <= tolGap)
              {
               double mult = (InpLsdRecoveryLotMultiplier > 0.0) ? InpLsdRecoveryLotMultiplier : 2.0;
               double recLots = NormalizeLots(parentLots * mult);
               if(recLots <= 0.0)
                  recLots = parentLots * 2.0;

               double slDist = (InpLsdRecoveryStopLossRaw > 0.0) ? InpLsdRecoveryStopLossRaw : 300.0;
               double tpDist = (InpLsdRecoveryTakeProfitRaw > 0.0) ? InpLsdRecoveryTakeProfitRaw : 500.0;

               double recSL = NormalizeDouble(livePrice - slDist, Digits);
               double recTP = NormalizeDouble(livePrice + tpDist, Digits);
               string recComment = "RECOVERY_" + IntegerToString(parentTicket) + "_LSD";

               int recTicket = SafeOrderSend(Symbol(), OP_BUY, recLots, livePrice, Slippage, recSL, recTP, recComment, MagicNumber, clrAqua);
               if(recTicket > 0)
                 {
                  RegisterParentRecoveryAttempt(parentTicket);
                  OrderCreatedThisCandle = true;
                  LastOrderCandleTime    = Time[0];
                  Print(">>> [EQL STRUCTURAL RECOVERY (Type 2)] Created BUY Recovery #", recTicket,
                        " Lots=", DoubleToString(recLots, 2), " at Support EQL=", DoubleToString(eqlPrice, Digits),
                        " (Ask=", DoubleToString(livePrice, Digits), ", DistToLine=$", DoubleToString(distToLine, 2),
                        ") for Parent BUY #", parentTicket, " Open=", DoubleToString(parentOpen, Digits),
                        " AdverseGap=$", DoubleToString(adverseDistance, 2), " Loss=$", DoubleToString(currentProfitUSD, 2));
                  break; // 1 order created per check cycle
                 }
              }
           }
        }

      // =================================================================
      // CASE 2: Underwater SELL parent + RED LINE (EQH Resistance) Detected
      // =================================================================
      else
         if(parentType == OP_SELL && eqhRPresent && eqhPrice > 0.0)
           {
            double livePrice = Bid;
            double adverseDistance = livePrice - parentOpen;

            // Must have risen at least minAdvGap from parent entry
            if(adverseDistance >= minAdvGap)
              {
               // Price must be near the RED Line (within tolerance)
               double distToLine = MathAbs(livePrice - eqhPrice);
               if(distToLine <= tolGap)
                 {
                  double mult = (InpLsdRecoveryLotMultiplier > 0.0) ? InpLsdRecoveryLotMultiplier : 2.0;
                  double recLots = NormalizeLots(parentLots * mult);
                  if(recLots <= 0.0)
                     recLots = parentLots * 2.0;

                  double slDist = (InpLsdRecoveryStopLossRaw > 0.0) ? InpLsdRecoveryStopLossRaw : 300.0;
                  double tpDist = (InpLsdRecoveryTakeProfitRaw > 0.0) ? InpLsdRecoveryTakeProfitRaw : 500.0;

                  double recSL = NormalizeDouble(livePrice + slDist, Digits);
                  double recTP = NormalizeDouble(livePrice - tpDist, Digits);
                  string recComment = "RECOVERY_" + IntegerToString(parentTicket) + "_LSD";

                  int recTicket = SafeOrderSend(Symbol(), OP_SELL, recLots, livePrice, Slippage, recSL, recTP, recComment, MagicNumber, clrMagenta);
                  if(recTicket > 0)
                    {
                     RegisterParentRecoveryAttempt(parentTicket);
                     OrderCreatedThisCandle = true;
                     LastOrderCandleTime    = Time[0];
                     Print(">>> [EQH STRUCTURAL RECOVERY (Type 2)] Created SELL Recovery #", recTicket,
                           " Lots=", DoubleToString(recLots, 2), " at Resistance EQH=", DoubleToString(eqhPrice, Digits),
                           " (Bid=", DoubleToString(livePrice, Digits), ", DistToLine=$", DoubleToString(distToLine, 2),
                           ") for Parent SELL #", parentTicket, " Open=", DoubleToString(parentOpen, Digits),
                           " AdverseGap=$", DoubleToString(adverseDistance, 2), " Loss=$", DoubleToString(currentProfitUSD, 2));
                     break; // 1 order created per check cycle
                    }
                 }
              }
           }
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| CountActiveType3RecoveryOrders: Counts active Type 3 Recovery    |
//+------------------------------------------------------------------+
int CountActiveType3RecoveryOrders()
  {
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      string cmt = GetEffectiveOrderComment(OrderTicket(), OrderComment());
      if(StringFind(cmt, "RECOVERY_") == 0 && StringFind(cmt, "_TYPE3") >= 0)
         count++;
     }
   return count;
  }

//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| GetType3RequiredEmaDistance: Dynamic Time-Ladder for EMA gap     |
//| Hour 1 (<=60m): $100, Hour 2 (<=120m): $200, Hour 3 (<=180m): $300|
//| Hour 4 (<=240m): $500, Hour 5+ (>240m): $700+                    |
//+------------------------------------------------------------------+
double GetType3RequiredEmaDistance(int elapsedMinutes)
  {
   if(!InpType3EnableDynamicTimeLadder)
      return (InpType3MinEmaDistanceRaw > 0.0 ? InpType3MinEmaDistanceRaw : 100.0);

   if(elapsedMinutes <= 60)
      return InpType3GapHour1;
   else
      if(elapsedMinutes <= 120)
         return InpType3GapHour2;
      else
         if(elapsedMinutes <= 180)
            return InpType3GapHour3;
         else
            if(elapsedMinutes <= 240)
               return InpType3GapHour4;
            else
               return InpType3GapHour5Plus;
  }

//+------------------------------------------------------------------+
//| CheckType3WeakEmaRecoveryOrders: Weak EMA Reversal Recovery      |
//| (Type 3 - Mode 1 Fade/Reversal). Opens counter-trend recovery    |
//| order when EMA is WEAK within 30 min of EMA flip time, fading    |
//| the exhausted move to rescue an underwater parent trade.         |
//+------------------------------------------------------------------+
void CheckType3WeakEmaRecoveryOrders()
  {
   if(!InpEnableType3Recovery || GetTotalEAOrders() >= MaxOpenOrders || !IsOneCandleOrderAllowed())
      return;

   int maxActive = (InpType3MaxActiveOrders > 0) ? InpType3MaxActiveOrders : 1;
   if(CountActiveType3RecoveryOrders() >= maxActive)
      return;

// 1. Check EMA Weakness (Momentum is weak / pulling back >= 50% from peak)
   if(!IsEmaWEAKDistanceReduced50PercentFromPeak(-1))
      return;

// 2. Check EMA Flip Timing (< 30 minutes since EMA flip)
   datetime flipTime = EmaFlipTime;
   if(flipTime == 0)
      flipTime = GetActualEmaFlipTime(EMADirection);
   if(flipTime == 0)
      return;

   int elapsedSeconds = (int)(TimeCurrent() - flipTime);
   int elapsedMinutes = elapsedSeconds / 60;
   int maxAllowedMinutes = (InpType3MaxElapsedMinutes > 0 ? InpType3MaxElapsedMinutes : 240);
   if(elapsedSeconds < 0 || (InpType3MaxElapsedMinutes > 0 && elapsedMinutes > maxAllowedMinutes))
      return;

   RefreshRates();

   double minAdvGap       = (InpType3MinAdverseGap > 0.0)      ? InpType3MinAdverseGap      : 200.0;
   double minLossUSD      = (InpType3TriggerLossUSD > 0.0)     ? InpType3TriggerLossUSD     : 2.0;
   double requiredEmaDist = GetType3RequiredEmaDistance(elapsedMinutes);
   int    stepHour        = (elapsedMinutes / 60) + 1;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderMagicNumber() != MagicNumber || OrderSymbol() != Symbol())
         continue;

      int parentTicket = OrderTicket();
      int parentType   = OrderType();
      if(parentType != OP_BUY && parentType != OP_SELL)
         continue;

      string comment = OrderComment();
      if(IsAnyRecoveryOrder(parentTicket, comment) || IsFLIPBasketSupportOrder(parentTicket, comment))
         continue;
      if(!InpAllowRecoveryForHorizontalOrders && IsHorizontalLineOrder(parentTicket, comment))
         continue;

      // Only rescue regular trades (SSL Long, SSL Short, ReEntry)
      bool validParent = (StringFind(comment, "SSL Long") >= 0 || StringFind(comment, "SSL Short") >= 0 || StringFind(comment, "ReEntry") >= 0);
      if(!validParent)
         continue;

      if(InpEnableRecoveryAttemptShield && HasParentExhaustedRecoveryAttempts(parentTicket))
         continue;

      if(HasRecoveryOrder(parentTicket))
         continue; // Parent already has an active recovery order (strictly max 1 per parent)

      double parentLots = OrderLots();
      double currentProfitUSD = OrderProfit() + OrderSwap() + OrderCommission();
      double parentOpen = OrderOpenPrice();

      // =================================================================
      // CASE 1: Parent SELL order in loss + EMADirection is BUY (+1) & WEAK
      // Mode 1 (Fade/Reversal): Open SELL recovery order at exhausted peak
      // =================================================================
      if(parentType == OP_SELL && EMADirection == 1)
        {
         double livePrice = Bid;
         double adverseDistance = livePrice - parentOpen; // adverse move up against SELL

         // Check Minimum EMAdistance ($100 raw gap between live price and EMA)
         double emaDist = GetDistanceToEMAPrice(OP_SELL, true);
         if(emaDist < requiredEmaDist)
            continue;

         bool lossTriggered = (currentProfitUSD <= -MathAbs(minLossUSD));
         bool gapTriggered  = (adverseDistance >= minAdvGap);

         // "loss is <-$2 or minimum raw distance from the open order is $200 (which ever is better)"
         if(lossTriggered || gapTriggered)
           {
            double mult = (InpType3LotMultiplier > 0.0) ? InpType3LotMultiplier : 2.0;
            double recLots = NormalizeLots(parentLots * mult);
            if(recLots <= 0.0)
               recLots = parentLots * 2.0;

            double slDist = (InpType3StopLossRaw > 0.0) ? InpType3StopLossRaw : 300.0;
            double tpDist = (InpType3TakeProfitRaw > 0.0) ? InpType3TakeProfitRaw : 500.0;

            double recSL = NormalizeDouble(livePrice + slDist, Digits);
            double recTP = NormalizeDouble(livePrice - tpDist, Digits);
            string recComment = "RECOVERY_" + IntegerToString(parentTicket) + "_TYPE3";

            int recTicket = SafeOrderSend(Symbol(), OP_SELL, recLots, livePrice, Slippage, recSL, recTP, recComment, MagicNumber, clrOrangeRed);
            if(recTicket > 0)
              {
               RegisterParentRecoveryAttempt(parentTicket);
               OrderCreatedThisCandle = true;
               LastOrderCandleTime    = Time[0];
               Print(">>> [WEAK EMA RECOVERY (Type 3 Mode 1)] Created SELL Recovery #", recTicket,
                     " Lots=", DoubleToString(recLots, 2), " (Parent SELL #", parentTicket, " Open=", DoubleToString(parentOpen, Digits),
                     ") Bid=", DoubleToString(livePrice, Digits),
                     " | Step (Hour ", stepHour, "): EmaDist=$", DoubleToString(emaDist, 2), " >= Req=$", DoubleToString(requiredEmaDist, 2),
                     " AdverseGap=$", DoubleToString(adverseDistance, 2),
                     " Loss=$", DoubleToString(currentProfitUSD, 2),
                     " (Elapsed=", elapsedMinutes, "m/", InpType3MaxElapsedMinutes, "m) | TriggeredBy: ",
                     (lossTriggered && gapTriggered ? "Loss & Gap" : (lossTriggered ? "Loss" : "Gap")));
               break; // 1 order created per check cycle
              }
           }
        }

      // =================================================================
      // CASE 2: Parent BUY order in loss + EMADirection is SELL (-1) & WEAK
      // Mode 1 (Fade/Reversal): Open BUY recovery order at exhausted dip
      // =================================================================
      else
         if(parentType == OP_BUY && EMADirection == -1)
           {
            double livePrice = Ask;
            double adverseDistance = parentOpen - livePrice; // adverse move down against BUY

            // Check Minimum EMAdistance ($100 raw gap between live price and EMA)
            double emaDist = GetDistanceToEMAPrice(OP_BUY, true);
            if(emaDist < requiredEmaDist)
               continue;

            bool lossTriggered = (currentProfitUSD <= -MathAbs(minLossUSD));
            bool gapTriggered  = (adverseDistance >= minAdvGap);

            // "loss is <-$2 or minimum raw distance from the open order is $200 (which ever is better)"
            if(lossTriggered || gapTriggered)
              {
               double mult = (InpType3LotMultiplier > 0.0) ? InpType3LotMultiplier : 2.0;
               double recLots = NormalizeLots(parentLots * mult);
               if(recLots <= 0.0)
                  recLots = parentLots * 2.0;

               double slDist = (InpType3StopLossRaw > 0.0) ? InpType3StopLossRaw : 300.0;
               double tpDist = (InpType3TakeProfitRaw > 0.0) ? InpType3TakeProfitRaw : 500.0;

               double recSL = NormalizeDouble(livePrice - slDist, Digits);
               double recTP = NormalizeDouble(livePrice + tpDist, Digits);
               string recComment = "RECOVERY_" + IntegerToString(parentTicket) + "_TYPE3";

               int recTicket = SafeOrderSend(Symbol(), OP_BUY, recLots, livePrice, Slippage, recSL, recTP, recComment, MagicNumber, clrDodgerBlue);
               if(recTicket > 0)
                 {
                  RegisterParentRecoveryAttempt(parentTicket);
                  OrderCreatedThisCandle = true;
                  LastOrderCandleTime    = Time[0];
                  Print(">>> [WEAK EMA RECOVERY (Type 3 Mode 1)] Created BUY Recovery #", recTicket,
                        " Lots=", DoubleToString(recLots, 2), " (Parent BUY #", parentTicket, " Open=", DoubleToString(parentOpen, Digits),
                        ") Ask=", DoubleToString(livePrice, Digits),
                        " | Step (Hour ", stepHour, "): EmaDist=$", DoubleToString(emaDist, 2), " >= Req=$", DoubleToString(requiredEmaDist, 2),
                        " AdverseGap=$", DoubleToString(adverseDistance, 2),
                        " Loss=$", DoubleToString(currentProfitUSD, 2),
                        " (Elapsed=", elapsedMinutes, "m/", InpType3MaxElapsedMinutes, "m) | TriggeredBy: ",
                        (lossTriggered && gapTriggered ? "Loss & Gap" : (lossTriggered ? "Loss" : "Gap")));
                  break; // 1 order created per check cycle
                 }
              }
           }
     }
  }

//+------------------------------------------------------------------+
//| CheckTrendShiftHedgeRecoveryOrders: Trend-Shift Hedge Rescue     |
//| (Model 2). For an underwater parent order when market trend has  |
//| confirmed flipped against it (EMA and SSL in opposite direction  |
//| for >= 15 min with price beyond EMA and >= $150 adverse move),   |
//| opens a 2x Trend-Following Recovery Order in the new trend       |
//| direction. As market runs with the new trend, the 2x recovery    |
//| order gains to pay off parent loss, closing both at net profit.  |
//+------------------------------------------------------------------+
void CheckTrendShiftHedgeRecoveryOrders()
  {
   if(!InpEnableHedgeRecovery || GetTotalEAOrders() >= MaxOpenOrders || !IsOneCandleOrderAllowed())
      return;

   int maxActive = (InpHedgeRecoveryMaxActiveOrders > 0) ? InpHedgeRecoveryMaxActiveOrders : 1;
   if(CountActiveHedgeRecoveryOrders() >= maxActive)
      return;

   RefreshRates();

   double emaVal = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, 0);
   if(emaVal <= 0.0)
      return;

   double minAdvGap  = (InpHedgeRecoveryMinAdverseGap > 0.0)   ? InpHedgeRecoveryMinAdverseGap   : 150.0;
   double minLossUSD = (InpHedgeRecoveryMinLossUSD > 0.0)      ? InpHedgeRecoveryMinLossUSD      : 2.0;
   int    minElapsed = (InpHedgeRecoveryMinElapsedMin > 0)     ? InpHedgeRecoveryMinElapsedMin   : 15;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderMagicNumber() != MagicNumber || OrderSymbol() != Symbol())
         continue;

      int parentTicket = OrderTicket();
      int parentType   = OrderType();
      if(parentType != OP_BUY && parentType != OP_SELL)
         continue;

      string comment = OrderComment();
      if(IsAnyRecoveryOrder(parentTicket, comment) || IsFLIPBasketSupportOrder(parentTicket, comment))
         continue;
      if(!InpAllowRecoveryForHorizontalOrders && IsHorizontalLineOrder(parentTicket, comment))
         continue;

      // Only rescue regular trades (SSL Long, SSL Short, ReEntry)
      bool validParent = (StringFind(comment, "SSL Long") >= 0 || StringFind(comment, "SSL Short") >= 0 || StringFind(comment, "ReEntry") >= 0);
      if(!validParent)
         continue;

      // 1-ATTEMPT SHIELD: If parent already had a recovery attempt or currently has one, SKIP!
      if(InpEnableRecoveryAttemptShield && HasParentExhaustedRecoveryAttempts(parentTicket))
         continue;
      if(HasRecoveryOrder(parentTicket))
         continue;

      double parentLots = OrderLots();
      double currentProfitUSD = OrderProfit() + OrderSwap() + OrderCommission();

      // Parent must be underwater by at least minLossUSD ($2.00)
      if(currentProfitUSD > -MathAbs(minLossUSD))
         continue;

      double parentOpen = OrderOpenPrice();

      // =====================================================================
      // CASE 1: Parent is BUY in loss, but trend has flipped to confirmed SELL
      // Strategy: Open 2x SELL Hedge in direction of new downtrend to rescue BUY
      // =====================================================================
      if(parentType == OP_BUY)
        {
         // Trend Confirmation: EMA and SSL flipped to SELL (-1), and price below EMA
         if(EMADirection != -1 || GlobalSSLDirection != -1)
            continue;
         if(Bid >= emaVal)
            continue;

         // Adverse Distance: Dropped >= $150 from parent BUY open price
         double adverseDistance = parentOpen - Bid;
         if(adverseDistance < minAdvGap)
            continue;

         // Trend elapsed time: Must be flipped for at least minElapsed minutes (>= 15 min)
         int elapsedSec = 0;
         datetime flipTime = GetActualEmaFlipTime(-1);
         if(flipTime == 0 && EmaFlipTime > 0)
            flipTime = EmaFlipTime;
         if(flipTime > 0)
            elapsedSec = (int)(TimeCurrent() - flipTime);
         if(elapsedSec < minElapsed * 60)
            continue;

         double mult = (InpHedgeRecoveryLotMultiplier > 0.0) ? InpHedgeRecoveryLotMultiplier : 2.0;
         double recLots = NormalizeLots(parentLots * mult);
         if(recLots <= 0.0)
            recLots = parentLots * 2.0;

         double slDist = (InpHedgeRecoveryStopLossRaw > 0.0)   ? InpHedgeRecoveryStopLossRaw   : 300.0;
         double tpDist = (InpHedgeRecoveryTakeProfitRaw > 0.0) ? InpHedgeRecoveryTakeProfitRaw : 500.0;

         double recSL = NormalizeDouble(Bid + slDist, Digits);
         double recTP = NormalizeDouble(Bid - tpDist, Digits);
         string recComment = "RECOVERY_" + IntegerToString(parentTicket) + "_HEDGE";

         int recTicket = SafeOrderSend(Symbol(), OP_SELL, recLots, Bid, Slippage, recSL, recTP, recComment, MagicNumber, clrCrimson);
         if(recTicket > 0)
           {
            RegisterParentRecoveryAttempt(parentTicket);
            OrderCreatedThisCandle = true;
            LastOrderCandleTime    = Time[0];
            Print(">>> [TREND-SHIFT HEDGE RESCUE] Opened 2x SELL Hedge #", recTicket,
                  " Lots=", DoubleToString(recLots, 2), " at Bid=", DoubleToString(Bid, Digits),
                  " to Rescue Parent BUY #", parentTicket, " (Open=", DoubleToString(parentOpen, Digits),
                  ", Loss=$", DoubleToString(currentProfitUSD, 2), ", AdverseGap=$", DoubleToString(adverseDistance, 2),
                  ", EmaVal=", DoubleToString(emaVal, Digits), ", FlipElapsed=", (elapsedSec / 60), "m)");
            break; // Max 1 order created per check cycle
           }
        }

      // =====================================================================
      // CASE 2: Parent is SELL in loss, but trend has flipped to confirmed BUY
      // Strategy: Open 2x BUY Hedge in direction of new uptrend to rescue SELL
      // =====================================================================
      else
         if(parentType == OP_SELL)
           {
            // Trend Confirmation: EMA and SSL flipped to BUY (+1), and price above EMA
            if(EMADirection != 1 || GlobalSSLDirection != 1)
               continue;
            if(Ask <= emaVal)
               continue;

            // Adverse Distance: Risen >= $150 from parent SELL open price
            double adverseDistance = Ask - parentOpen;
            if(adverseDistance < minAdvGap)
               continue;

            // Trend elapsed time: Must be flipped for at least minElapsed minutes (>= 15 min)
            int elapsedSec = 0;
            datetime flipTime = GetActualEmaFlipTime(1);
            if(flipTime == 0 && EmaFlipTime > 0)
               flipTime = EmaFlipTime;
            if(flipTime > 0)
               elapsedSec = (int)(TimeCurrent() - flipTime);
            if(elapsedSec < minElapsed * 60)
               continue;

            double mult = (InpHedgeRecoveryLotMultiplier > 0.0) ? InpHedgeRecoveryLotMultiplier : 2.0;
            double recLots = NormalizeLots(parentLots * mult);
            if(recLots <= 0.0)
               recLots = parentLots * 2.0;

            double slDist = (InpHedgeRecoveryStopLossRaw > 0.0)   ? InpHedgeRecoveryStopLossRaw   : 300.0;
            double tpDist = (InpHedgeRecoveryTakeProfitRaw > 0.0) ? InpHedgeRecoveryTakeProfitRaw : 500.0;

            double recSL = NormalizeDouble(Ask - slDist, Digits);
            double recTP = NormalizeDouble(Ask + tpDist, Digits);
            string recComment = "RECOVERY_" + IntegerToString(parentTicket) + "_HEDGE";

            int recTicket = SafeOrderSend(Symbol(), OP_BUY, recLots, Ask, Slippage, recSL, recTP, recComment, MagicNumber, clrDeepSkyBlue);
            if(recTicket > 0)
              {
               RegisterParentRecoveryAttempt(parentTicket);
               OrderCreatedThisCandle = true;
               LastOrderCandleTime    = Time[0];
               Print(">>> [TREND-SHIFT HEDGE RESCUE] Opened 2x BUY Hedge #", recTicket,
                     " Lots=", DoubleToString(recLots, 2), " at Ask=", DoubleToString(Ask, Digits),
                     " to Rescue Parent SELL #", parentTicket, " (Open=", DoubleToString(parentOpen, Digits),
                     ", Loss=$", DoubleToString(currentProfitUSD, 2), ", AdverseGap=$", DoubleToString(adverseDistance, 2),
                     ", EmaVal=", DoubleToString(emaVal, Digits), ", FlipElapsed=", (elapsedSec / 60), "m)");
               break; // Max 1 order created per check cycle
              }
           }
     }
  }

// ===== $100 ADVERSE OPPOSITE 2X REVERSE ORDER (1-TIME PER ORDER) =====
int      g_rev100TriggeredParents[];
int      g_rev100SkippedPartialTickets[];
int      g_rev100TotalOpened      = 0;
datetime g_rev100LastHitTime      = 0;
int      g_rev100LastRecTicket    = 0;
int      g_rev100LastParentTicket = 0;
double   g_rev100LastAdvGap       = 0.0;
double   g_rev100LastRecLots      = 0.0;

//+------------------------------------------------------------------+
//| Reverse100GvKey: Terminal GV key for live 1-time-per-order guard |
//+------------------------------------------------------------------+
string Reverse100GvKey(int parentTicket)
  {
   return "EA_REV100_" + IntegerToString(MagicNumber) + "_" + Symbol() + "_" + IntegerToString(parentTicket);
  }

//+------------------------------------------------------------------+
//| ResetReverse100RuntimeState: Resets tester/session runtime state |
//+------------------------------------------------------------------+
void ResetReverse100RuntimeState()
  {
   ArrayResize(g_rev100TriggeredParents, 0);
   ArrayResize(g_rev100SkippedPartialTickets, 0);
   ArrayResize(g_rev100StepCutRoots, 0);
   ArrayResize(g_rev100StepCutSteps, 0);
   g_rev100TotalOpened           = 0;
   g_rev100LastHitTime           = 0;
   g_rev100LastRecTicket         = 0;
   g_rev100LastParentTicket      = 0;
   g_rev100LastAdvGap            = 0.0;
   g_rev100LastRecLots           = 0.0;
   g_rev100StepCutTotalCuts      = 0;
   g_rev100StepCutTotalLots      = 0.0;
   g_rev100StepCutLastHitTime    = 0;
   g_rev100StepCutLastRecTicket  = 0;
   g_rev100StepCutLastStep       = 0;
   g_rev100StepCutLastAdvGap     = 0.0;
   g_rev100StepCutFailLogTime    = 0;
  }

//+------------------------------------------------------------------+
//| IsPartialCloseOrderComment: Returns true when MT4 comment marks  |
//| a partially closed order slice (e.g. "from #12345", "from ...")  |
//+------------------------------------------------------------------+
bool IsPartialCloseOrderComment(string comment)
  {
   string cmt = comment;
   StringTrimLeft(cmt);
   StringTrimRight(cmt);
   if(cmt == "")
      return false;
   StringToLower(cmt);
   if(StringFind(cmt, "from #") >= 0 || StringFind(cmt, "from#") >= 0)
      return true;
   if(StringFind(cmt, "from ") == 0 || StringFind(cmt, " from ") >= 0)
      return true;
   return false;
  }

//+------------------------------------------------------------------+
//| RegisterReverse100TriggerMemory: Records parent root ticket      |
//+------------------------------------------------------------------+
void RegisterReverse100TriggerMemory(int ticket)
  {
   if(ticket <= 0)
      return;
   int sz = ArraySize(g_rev100TriggeredParents);
   for(int i = 0; i < sz; i++)
     {
      if(g_rev100TriggeredParents[i] == ticket)
         return;
     }
   ArrayResize(g_rev100TriggeredParents, sz + 1);
   g_rev100TriggeredParents[sz] = ticket;
  }

//+------------------------------------------------------------------+
//| RegisterReverse100Trigger: Locks 1-time reverse execution per    |
//| parent order across partial closes, shared shield & live restarts|
//+------------------------------------------------------------------+
void RegisterReverse100Trigger(int rootParentTicket, int currentParentTicket)
  {
   RegisterReverse100TriggerMemory(rootParentTicket);
   if(currentParentTicket > 0 && currentParentTicket != rootParentTicket)
      RegisterReverse100TriggerMemory(currentParentTicket);

   RegisterParentRecoveryAttempt(rootParentTicket);
   if(currentParentTicket > 0 && currentParentTicket != rootParentTicket)
      RegisterParentRecoveryAttempt(currentParentTicket);

   if(!(IsTesting() || IsOptimization()))
     {
      if(rootParentTicket > 0)
         GlobalVariableSet(Reverse100GvKey(rootParentTicket), (double)TimeCurrent());
      if(currentParentTicket > 0 && currentParentTicket != rootParentTicket)
         GlobalVariableSet(Reverse100GvKey(currentParentTicket), (double)TimeCurrent());
     }
  }

//+------------------------------------------------------------------+
//| InitReverse100TriggeredRegistry: Scans history & live trades at  |
//| startup so 1-time-per-order state persists across restarts       |
//+------------------------------------------------------------------+
void InitReverse100TriggeredRegistry()
  {
   ArrayResize(g_rev100TriggeredParents, 0);
   int histTotal = OrdersHistoryTotal();
   for(int h = 0; h < histTotal; h++)
     {
      if(!OrderSelect(h, SELECT_BY_POS, MODE_HISTORY))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int tkt = OrderTicket();
      string effCmt = GetEffectiveOrderComment(tkt, OrderComment());
      if(StringFind(effCmt, "RECOVERY_") == 0 && StringFind(effCmt, "_REV") >= 0)
        {
         int pTkt = GetRecoveryOrderParentTicket(tkt, effCmt);
         if(pTkt > 0)
            RegisterReverse100TriggerMemory(pTkt);
        }
     }

   int curTotal = OrdersTotal();
   for(int t = 0; t < curTotal; t++)
     {
      if(!OrderSelect(t, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int tkt = OrderTicket();
      string effCmt = GetEffectiveOrderComment(tkt, OrderComment());
      if(StringFind(effCmt, "RECOVERY_") == 0 && StringFind(effCmt, "_REV") >= 0)
        {
         int pTkt = GetRecoveryOrderParentTicket(tkt, effCmt);
         if(pTkt > 0)
            RegisterReverse100TriggerMemory(pTkt);
        }
     }
  }

//+------------------------------------------------------------------+
//| HasReverse100AlreadyTriggered: Returns true if rootParentTicket  |
//| or currentParentTicket EVER had a _REV (or RECOVERY_) trigger    |
//+------------------------------------------------------------------+
bool HasReverse100AlreadyTriggered(int rootParentTicket, int currentParentTicket)
  {
   int sz = ArraySize(g_rev100TriggeredParents);
   for(int i = 0; i < sz; i++)
     {
      if((rootParentTicket > 0 && g_rev100TriggeredParents[i] == rootParentTicket) ||
         (currentParentTicket > 0 && g_rev100TriggeredParents[i] == currentParentTicket))
         return true;
     }

   if(!(IsTesting() || IsOptimization()))
     {
      if(rootParentTicket > 0 && GlobalVariableCheck(Reverse100GvKey(rootParentTicket)))
        {
         RegisterReverse100TriggerMemory(rootParentTicket);
         return true;
        }
      if(currentParentTicket > 0 && currentParentTicket != rootParentTicket && GlobalVariableCheck(Reverse100GvKey(currentParentTicket)))
        {
         RegisterReverse100TriggerMemory(currentParentTicket);
         return true;
        }
     }

   string prefixRoot = (rootParentTicket > 0) ? ("RECOVERY_" + IntegerToString(rootParentTicket)) : "";
   string prefixCur  = (currentParentTicket > 0 && currentParentTicket != rootParentTicket) ? ("RECOVERY_" + IntegerToString(currentParentTicket)) : "";

   for(int t = OrdersTotal() - 1; t >= 0; t--)
     {
      if(!OrderSelect(t, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int tkt = OrderTicket();
      string effCmt = GetEffectiveOrderComment(tkt, OrderComment());
      if((prefixRoot != "" && StringFind(effCmt, prefixRoot) == 0) ||
         (prefixCur  != "" && StringFind(effCmt, prefixCur)  == 0))
        {
         if(StringFind(effCmt, "_REV") >= 0)
           {
            RegisterReverse100TriggerMemory(rootParentTicket > 0 ? rootParentTicket : currentParentTicket);
            return true;
           }
        }
     }

   for(int h = OrdersHistoryTotal() - 1; h >= 0; h--)
     {
      if(!OrderSelect(h, SELECT_BY_POS, MODE_HISTORY))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int tkt = OrderTicket();
      string effCmt = GetEffectiveOrderComment(tkt, OrderComment());
      if((prefixRoot != "" && StringFind(effCmt, prefixRoot) == 0) ||
         (prefixCur  != "" && StringFind(effCmt, prefixCur)  == 0))
        {
         if(StringFind(effCmt, "_REV") >= 0)
           {
            RegisterReverse100TriggerMemory(rootParentTicket > 0 ? rootParentTicket : currentParentTicket);
            return true;
           }
        }
     }

   return false;
  }

//+------------------------------------------------------------------+
//| CountActiveReverse100Orders: Counts live open _REV child orders  |
//+------------------------------------------------------------------+
int CountActiveReverse100Orders()
  {
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;
      int tkt = OrderTicket();
      string effCmt = GetEffectiveOrderComment(tkt, OrderComment());
      if(StringFind(effCmt, "RECOVERY_") == 0 && StringFind(effCmt, "_REV") >= 0)
         count++;
     }
   return count;
  }

//+------------------------------------------------------------------+
//| DrawReverse100OrderIcon: Places chart arrow & label when a 2X    |
//| opposite reverse order opens on > $100 adverse move              |
//+------------------------------------------------------------------+
void DrawReverse100OrderIcon(int recTicket, int rootParentTicket, int recType, double recLots, double recPrice, double parentOpen, double advGap, double parentLossUSD, datetime hitTime = 0)
  {
   if(!InpDrawReverse100Icon || recTicket <= 0)
      return;

   if(hitTime <= 0)
      hitTime = TimeCurrent();

   datetime barTime  = ((Bars > 0 && Time[0] > 0) ? Time[0] : hitTime);
   string   baseName = PREFIX + "REV100_" + IntegerToString(recTicket);
   string   txtName  = baseName + "_TXT";

   double atr = iATR(Symbol(), Period(), 14, 1);
   if(atr <= 0.0)
      atr = 30.0 * Point;
   if(atr <= 0.0)
      atr = 1.0;

   bool   isBuyRev    = (recType == OP_BUY);
   double markerPrice = isBuyRev ? (((Bars > 0 && Low[0] > 0.0) ? Low[0] : recPrice) - atr * 0.90)
                        : (((Bars > 0 && High[0] > 0.0) ? High[0] : recPrice) + atr * 0.90);
   double labelPrice  = isBuyRev ? (markerPrice - atr * 0.35) : (markerPrice + atr * 0.35);

   color  iconColor   = isBuyRev ? InpReverse100BuyIconColor : InpReverse100SellIconColor;
   int    arrowCode   = isBuyRev ? 233 : 234;
   int    fontSize    = (InpReverse100IconFontSize > 0) ? InpReverse100IconFontSize : 9;
   string sideTag     = isBuyRev ? "BUY" : "SELL";

   datetime dubaiDT   = hitTime + (ServerToDubaiOffsetHours * 3600);
   string   labelText = StringFormat("REV100 2X %s %.2fL <- #%d ($%.0f)", sideTag, recLots, rootParentTicket, advGap);

   string   tooltip   = StringFormat("REVERSE >$100 2X ORDER #%d (%s %.2fL @ %s) | Rescues Parent #%d (Open:%s, AdvGap:$%.1f, Loss:-$%.2f) | Pair Target: +$%.2f | Dubai:%s",
                                     recTicket, sideTag, recLots, DoubleToString(recPrice, Digits),
                                     rootParentTicket, DoubleToString(parentOpen, Digits),
                                     advGap, MathAbs(parentLossUSD), InpReverse100BasketProfitUSD,
                                     TimeToString(dubaiDT, TIME_DATE|TIME_MINUTES|TIME_SECONDS));

   ObjectCreate(0, baseName, OBJ_ARROW, 0, barTime, markerPrice);
   ObjectSetInteger(0, baseName, OBJPROP_ARROWCODE, arrowCode);
   ObjectSetInteger(0, baseName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, baseName, OBJPROP_WIDTH, 3);
   ObjectSetInteger(0, baseName, OBJPROP_BACK, false);
   ObjectSetInteger(0, baseName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, baseName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);

   ObjectCreate(0, txtName, OBJ_TEXT, 0, barTime, labelPrice);
   ObjectSetString(0, txtName, OBJPROP_TEXT, labelText);
   ObjectSetString(0, txtName, OBJPROP_FONT, "Arial Bold");
   ObjectSetInteger(0, txtName, OBJPROP_FONTSIZE, fontSize);
   ObjectSetInteger(0, txtName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, txtName, OBJPROP_BACK, false);
   ObjectSetInteger(0, txtName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, txtName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);

   ChartRedraw(0);
  }

//+------------------------------------------------------------------+
//| CheckReverse100OppositeOrders:                                   |
//| When ANY qualifying standard or Horizontal (EQH/EQL) open order  |
//| is strictly in floating loss AND market has moved > $100 raw     |
//| points in the opposite direction:                                |
//| - BUY parent : (OpenPrice - Bid) > 100.0 & FloatPL < 0 -> 2X SELL|
//| - SELL parent: (Ask - OpenPrice) > 100.0 & FloatPL < 0 -> 2X BUY |
//| Runs STRICTLY ONCE per parent order lifetime, skips partially    |
//| closed orders ("from ..."), never triggers on recovery/reverse   |
//| child orders, caps simultaneous active _REV orders (default 2),  |
//| and pairs parent + 2X reverse in ManageRecoveryBasket (+$2.00).  |
//+------------------------------------------------------------------+
void CheckReverse100OppositeOrders()
  {
   if(!InpEnableReverse100Order || !EAStartupComplete)
      return;
   if(ServerRecoveryPending || !IsConnected())
      return;
   if(GetTotalEAOrders() >= MaxOpenOrders)
      return;

   int maxActive = (InpReverse100MaxActiveOrders > 0) ? InpReverse100MaxActiveOrders : 1;
   if(CountActiveReverse100Orders() >= maxActive)
      return;

   RefreshRates();
   if(Bid <= 0.0 || Ask <= 0.0)
      return;

   double minAdvGap  = (InpReverse100MinAdverseGap > 0.0) ? InpReverse100MinAdverseGap : 100.0;
   double minLossUSD = (InpReverse100MinLossUSD >= 0.0)   ? InpReverse100MinLossUSD   : 0.0;

   int      bestParentTicket = -1;
   int      bestRootTicket   = -1;
   int      bestParentType   = -1;
   double   bestParentLots   = 0.0;
   double   bestParentOpen   = 0.0;
   datetime bestParentTime   = 0;
   double   bestAdvDist      = 0.0;
   double   bestLossUSD      = 0.0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int parentType = OrderType();
      if(parentType != OP_BUY && parentType != OP_SELL)
         continue;

      int      parentTicket = OrderTicket();
      double   parentLots   = OrderLots();
      double   parentOpen   = OrderOpenPrice();
      datetime parentTime   = OrderOpenTime();
      string   comment      = OrderComment();
      double   floatNetPL   = OrderProfit() + OrderSwap() + OrderCommission();

      // Must strictly be in floating loss
      if(floatNetPL >= -minLossUSD)
         continue;

      // Opposite raw price distance check (strictly > $100.0 raw points)
      double adverseDistance = (parentType == OP_BUY) ? (parentOpen - Bid) : (Ask - parentOpen);
      if(adverseDistance <= minAdvGap)
         continue;

      // Do not create RECOVERY_..._REV recovery orders for partially closed orders (e.g. "from #12345")
      if(InpReverse100SkipPartialClosed && IsPartialCloseOrderComment(comment))
        {
         bool alreadyLoggedSkip = false;
         int  skipSz = ArraySize(g_rev100SkippedPartialTickets);
         for(int s = 0; s < skipSz; s++)
           {
            if(g_rev100SkippedPartialTickets[s] == parentTicket)
              {
               alreadyLoggedSkip = true;
               break;
              }
           }
         if(!alreadyLoggedSkip)
           {
            if(skipSz < 500)
              {
               ArrayResize(g_rev100SkippedPartialTickets, skipSz + 1);
               g_rev100SkippedPartialTickets[skipSz] = parentTicket;
              }
            PrintFormat(">>> [REV100 SKIPPED PARTIAL] Parent %s #%d (%.2fL, AdvGap=$%.2f, FloatPL=-$%.2f) has partial-close comment '%s' -> Do NOT create _REV recovery order.",
                        (parentType == OP_BUY ? "BUY" : "SELL"), parentTicket, parentLots, adverseDistance, MathAbs(floatNetPL), comment);
           }
         continue;
        }

      // Never trigger a reverse order from another recovery or reverse order (prevents 2X -> 4X -> 8X loops)
      if(IsAnyRecoveryOrder(parentTicket, comment))
         continue;

      string rootComment = GetRootOrderComment(parentTicket, comment);
      string effComment  = GetEffectiveOrderComment(parentTicket, comment);
      if(StringFind(rootComment, "RECOVERY_") >= 0 || StringFind(rootComment, "_REV") >= 0 ||
         StringFind(effComment, "RECOVERY_")  >= 0 || StringFind(effComment, "_REV")  >= 0)
         continue;

      bool isHoriz = IsHorizontalLineOrder(parentTicket, rootComment) || IsHorizontalLineOrder(parentTicket, effComment);
      if(!InpReverse100IncludeHorizontal && isHoriz)
         continue;

      bool isFlipSup = IsFLIPBasketSupportOrder(parentTicket, rootComment) || IsFLIPBasketSupportOrder(parentTicket, effComment);
      if(!InpReverse100IncludeFlipSupport && isFlipSup && !isHoriz)
         continue;

      // Resolve true root ticket across any partial close "from #" chains
      int rootTicket = ResolveRootTicketFromPartialChain(parentTicket, comment);
      if(rootTicket <= 0)
         rootTicket = parentTicket;

      // Strictly 1-time per order lifetime (dedicated REV100 lock + shared 1-attempt recovery shield)
      if(HasReverse100AlreadyTriggered(rootTicket, parentTicket))
         continue;
      if(InpEnableRecoveryAttemptShield &&
         (HasParentExhaustedRecoveryAttempts(rootTicket) || (rootTicket != parentTicket && HasParentExhaustedRecoveryAttempts(parentTicket))))
         continue;
      if(HasRecoveryOrder(rootTicket) || (rootTicket != parentTicket && HasRecoveryOrder(parentTicket)))
         continue;

      // Pick deepest floating loss parent (tie-broken by largest adverse distance, then oldest open time)
      bool isBetterCandidate = false;
      if(bestParentTicket < 0)
         isBetterCandidate = true;
      else
         if(floatNetPL < bestLossUSD - 1e-6)
            isBetterCandidate = true;
         else
            if(MathAbs(floatNetPL - bestLossUSD) <= 1e-6 &&
               (adverseDistance > bestAdvDist + 1e-6 ||
                (MathAbs(adverseDistance - bestAdvDist) <= 1e-6 && parentTime < bestParentTime)))
               isBetterCandidate = true;

      if(isBetterCandidate)
        {
         bestParentTicket = parentTicket;
         bestRootTicket   = rootTicket;
         bestParentType   = parentType;
         bestParentLots   = parentLots;
         bestParentOpen   = parentOpen;
         bestParentTime   = parentTime;
         bestAdvDist      = adverseDistance;
         bestLossUSD      = floatNetPL;
        }
     }

   if(bestParentTicket <= 0 || bestRootTicket <= 0)
      return;

   double mult    = (InpReverse100LotMultiplier > 0.0) ? InpReverse100LotMultiplier : 2.0;
   double recLots = NormalizeLots(bestParentLots * mult);
   if(recLots <= 0.0)
      return;

   RefreshRates();
   int    recType    = (bestParentType == OP_BUY) ? OP_SELL : OP_BUY;
   double entryPrice = (recType == OP_BUY) ? Ask : Bid;
   double slDist     = (InpReverse100StopLossRaw > 0.0)   ? InpReverse100StopLossRaw   : 3000.0;
   double tpDist     = (InpReverse100TakeProfitRaw > 0.0) ? InpReverse100TakeProfitRaw : 500.0;

   double recSL      = (recType == OP_BUY) ? NormalizeDouble(entryPrice - slDist, Digits) : NormalizeDouble(entryPrice + slDist, Digits);
   double recTP      = (recType == OP_BUY) ? NormalizeDouble(entryPrice + tpDist, Digits) : NormalizeDouble(entryPrice - tpDist, Digits);
   color  arrowColor = (recType == OP_BUY) ? InpReverse100BuyIconColor : InpReverse100SellIconColor;
   string recComment = "RECOVERY_" + IntegerToString(bestRootTicket) + "_REV";

   int recTicket = SafeOrderSend(Symbol(), recType, recLots, entryPrice, Slippage, recSL, recTP, recComment, MagicNumber, arrowColor);
   if(recTicket > 0)
     {
      RegisterReverse100Trigger(bestRootTicket, bestParentTicket);
      g_rev100TotalOpened++;
      g_rev100LastHitTime      = TimeCurrent();
      g_rev100LastRecTicket    = recTicket;
      g_rev100LastParentTicket = bestRootTicket;
      g_rev100LastAdvGap       = bestAdvDist;
      g_rev100LastRecLots      = recLots;

      OrderCreatedThisCandle = true;
      LastOrderCandleTime    = Time[0];

      int nowActiveRev = CountActiveReverse100Orders();
      DrawReverse100OrderIcon(recTicket, bestRootTicket, recType, recLots, entryPrice, bestParentOpen, bestAdvDist, bestLossUSD, g_rev100LastHitTime);

      PrintFormat(">>> [REVERSE >$%.0f 2X ORDER #%d] Opened %s %.2fL (2X of %.2fL) at %s (SL=%s, TP=%s) | Rescues %s #%d (Root #%d, Open=%s, AdvGap=$%.2f > $%.0f, FloatPL=-$%.2f) | ActiveRev=%d/%d | Comment=%s",
                  minAdvGap, recTicket, (recType == OP_BUY ? "BUY" : "SELL"), recLots, bestParentLots,
                  DoubleToString(entryPrice, Digits), DoubleToString(recSL, Digits), DoubleToString(recTP, Digits),
                  (bestParentType == OP_BUY ? "BUY" : "SELL"), bestParentTicket, bestRootTicket,
                  DoubleToString(bestParentOpen, Digits), bestAdvDist, minAdvGap, MathAbs(bestLossUSD),
                  nowActiveRev, maxActive, recComment);
     }
  }

//+------------------------------------------------------------------+
//| Reverse100StepGvKey: GV key persisting completed -$100 cut step  |
//+------------------------------------------------------------------+
string Reverse100StepGvKey(int rootRevTicket)
  {
   return "EA_REV100_LSTEP_" + IntegerToString(MagicNumber) + "_" + Symbol() + "_" + IntegerToString(rootRevTicket);
  }

//+------------------------------------------------------------------+
//| GetReverse100AdverseCutStep: Returns highest completed adverse   |
//| step count (1=$100, 2=$200, 3=$300...) for root _REV order       |
//+------------------------------------------------------------------+
int GetReverse100AdverseCutStep(int rootRevTicket)
  {
   if(rootRevTicket <= 0)
      return 0;

   int sz = ArraySize(g_rev100StepCutRoots);
   for(int i = 0; i < sz; i++)
     {
      if(g_rev100StepCutRoots[i] == rootRevTicket)
         return g_rev100StepCutSteps[i];
     }

   if(!(IsTesting() || IsOptimization()))
     {
      string gvKey = Reverse100StepGvKey(rootRevTicket);
      if(GlobalVariableCheck(gvKey))
        {
         int gvStep = (int)MathRound(GlobalVariableGet(gvKey));
         if(gvStep > 0)
           {
            ArrayResize(g_rev100StepCutRoots, sz + 1);
            ArrayResize(g_rev100StepCutSteps, sz + 1);
            g_rev100StepCutRoots[sz] = rootRevTicket;
            g_rev100StepCutSteps[sz] = gvStep;
            return gvStep;
           }
        }
     }
   return 0;
  }

//+------------------------------------------------------------------+
//| SetReverse100AdverseCutStep: Records completed adverse cut step  |
//+------------------------------------------------------------------+
void SetReverse100AdverseCutStep(int rootRevTicket, int step)
  {
   if(rootRevTicket <= 0 || step <= 0)
      return;

   int sz = ArraySize(g_rev100StepCutRoots);
   bool updated = false;
   for(int i = 0; i < sz; i++)
     {
      if(g_rev100StepCutRoots[i] == rootRevTicket)
        {
         if(step > g_rev100StepCutSteps[i])
            g_rev100StepCutSteps[i] = step;
         updated = true;
         break;
        }
     }
   if(!updated)
     {
      ArrayResize(g_rev100StepCutRoots, sz + 1);
      ArrayResize(g_rev100StepCutSteps, sz + 1);
      g_rev100StepCutRoots[sz] = rootRevTicket;
      g_rev100StepCutSteps[sz] = step;
     }

   if(!(IsTesting() || IsOptimization()))
      GlobalVariableSet(Reverse100StepGvKey(rootRevTicket), (double)step);
  }

//+------------------------------------------------------------------+
//| DrawReverse100StepCutIcon: Marks chart on each $100 step cut     |
//+------------------------------------------------------------------+
void DrawReverse100StepCutIcon(int closedTicket, int rootRevTicket, int origParentTicket, int orderType, int stepNo, double advGap, double stepTriggerRaw, double cutLots, double remLots, double openPrice, double closePrice, double estPL, bool isRevOrder = false, datetime hitTime = 0)
  {
   if(!InpDrawReverse100StepCutIcon || rootRevTicket <= 0 || stepNo <= 0)
      return;

   if(hitTime <= 0)
      hitTime = TimeCurrent();

   datetime barTime  = ((Bars > 0 && Time[0] > 0) ? Time[0] : hitTime);
   string   baseName = PREFIX + "STEP100_CUT_" + IntegerToString(rootRevTicket) + "_S" + IntegerToString(stepNo);
   string   txtName  = baseName + "_TXT";

   double atr = iATR(Symbol(), Period(), 14, 1);
   if(atr <= 0.0)
      atr = 30.0 * Point;
   if(atr <= 0.0)
      atr = 1.0;

   bool   isBuyOrd    = (orderType == OP_BUY);
   double markerPrice = isBuyOrd ? (((Bars > 0 && Low[0] > 0.0) ? Low[0] : closePrice) - atr * (1.25 + (stepNo % 3) * 0.25))
                        : (((Bars > 0 && High[0] > 0.0) ? High[0] : closePrice) + atr * (1.25 + (stepNo % 3) * 0.25));
   double labelPrice  = isBuyOrd ? (markerPrice - atr * 0.30) : (markerPrice + atr * 0.30);

   color  iconColor   = InpReverse100StepCutIconColor;
   int    arrowCode   = 251;
   string sideTag     = isBuyOrd ? "BUY" : "SELL";
   string plSign      = (estPL >= 0.0) ? "+" : "-";
   datetime dubaiDT   = hitTime + (ServerToDubaiOffsetHours * 3600);
   string roleTag     = isRevOrder ? "REV" : (origParentTicket > 0 ? "REC" : "ORD");
   string parInfo     = (origParentTicket > 0) ? (", Par #" + IntegerToString(origParentTicket)) : "";

   string labelText = StringFormat("%s CUT #%d -$%.0f (-%.2fL)", roleTag, stepNo, stepTriggerRaw, cutLots);
   string tooltip   = StringFormat("STEP100 #%d PARTIAL CLOSE | %s #%d (Root #%d%s, %s) | Cut:%.2fL Rem:%.2fL | Open:%s Close:%s | Adv:$%.1f>=$%.0f | EstPL:%s$%.2f | Dubai:%s",
                                   stepNo, roleTag, closedTicket, rootRevTicket, parInfo, sideTag,
                                   cutLots, remLots, DoubleToString(openPrice, Digits), DoubleToString(closePrice, Digits),
                                   advGap, stepTriggerRaw, plSign, MathAbs(estPL),
                                   TimeToString(dubaiDT, TIME_DATE|TIME_MINUTES|TIME_SECONDS));

   ObjectCreate(0, baseName, OBJ_ARROW, 0, barTime, markerPrice);
   ObjectSetInteger(0, baseName, OBJPROP_ARROWCODE, arrowCode);
   ObjectSetInteger(0, baseName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, baseName, OBJPROP_WIDTH, 2);
   ObjectSetInteger(0, baseName, OBJPROP_BACK, false);
   ObjectSetInteger(0, baseName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, baseName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, baseName, OBJPROP_TOOLTIP, tooltip);

   ObjectCreate(0, txtName, OBJ_TEXT, 0, barTime, labelPrice);
   ObjectSetString(0, txtName, OBJPROP_TEXT, labelText);
   ObjectSetString(0, txtName, OBJPROP_FONT, "Arial Bold");
   ObjectSetInteger(0, txtName, OBJPROP_FONTSIZE, 8);
   ObjectSetInteger(0, txtName, OBJPROP_COLOR, iconColor);
   ObjectSetInteger(0, txtName, OBJPROP_BACK, false);
   ObjectSetInteger(0, txtName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, txtName, OBJPROP_HIDDEN, false);
   ObjectSetString(0, txtName, OBJPROP_TOOLTIP, tooltip);

   ChartRedraw(0);
  }

//+------------------------------------------------------------------+
//| ManageReverse100AdverseStepPartialClose:                         |
//| Monitors all live open market orders (OP_BUY / OP_SELL) whose    |
//| remaining lot size is strictly > InpReverse100AdverseStepMinLots |
//| (default > 0.05L; regular, horizontal, recovery & _REV).         |
//| Whenever price moves in the loss direction by another $100 step  |
//| ($100, $200, $300...), partial-closes 0.01 lot while keeping a   |
//| minimum remaining floor of 0.05 lot (stops once remaining<=0.05).|
//| - OP_BUY : adverse move = OpenPrice - Bid >= N * $100            |
//| - OP_SELL: adverse move = Ask - OpenPrice >= N * $100            |
//| Tracks completed step N by root order ticket across MT4 "from #" |
//| child tickets so each $100 milestone executes strictly once.     |
//+------------------------------------------------------------------+
void ManageReverse100AdverseStepPartialClose()
  {
   if(!InpReverse100EnableAdverseStepClose || !EAStartupComplete)
      return;
   if(ServerRecoveryPending || !IsConnected())
      return;

   double stepRaw      = (InpReverse100AdverseStepRaw > 0.0)     ? InpReverse100AdverseStepRaw     : 100.0;
   double stepCfgL     = (InpReverse100AdverseStepLots > 0.0)    ? InpReverse100AdverseStepLots    : 0.01;
   double minFloorLots = (InpReverse100AdverseStepMinLots >= 0.0) ? InpReverse100AdverseStepMinLots : 0.05;

   double minLot  = MarketInfo(Symbol(), MODE_MINLOT);
   double lotStep = MarketInfo(Symbol(), MODE_LOTSTEP);
   if(minLot <= 0.0)
      minLot = 0.01;
   if(lotStep <= 0.0)
      lotStep = 0.01;

   int    lotDigits = (lotStep >= 1.0) ? 0 : ((lotStep >= 0.1) ? 1 : ((lotStep >= 0.01) ? 2 : 3));
   double stepLots  = NormalizeDouble(MathRound(stepCfgL / lotStep) * lotStep, lotDigits);
   if(stepLots < minLot)
      stepLots = minLot;

   RefreshRates();
   if(Bid <= 0.0 || Ask <= 0.0)
      return;

// Snapshot qualifying open market tickets (>0.05L) first so partial-close replacements never shift loop indices
   int candTickets[500];
   ArrayInitialize(candTickets, 0);
   int candCount = 0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;
      if(OrderLots() <= minFloorLots + 1e-8)
         continue;

      int    tkt    = OrderTicket();
      string rawCmt = OrderComment();
      if(!InpAdverseStep100AllOrders)
        {
         string effCmt = GetEffectiveOrderComment(tkt, rawCmt);
         if(StringFind(effCmt, "RECOVERY_") != 0 || StringFind(effCmt, "_REV") < 0)
            continue;
        }

      if(candCount < 500)
         candTickets[candCount++] = tkt;
     }

   if(candCount == 0)
      return;

   bool     isTestRun   = (IsTesting() || IsOptimization());
   datetime nowServer   = TimeCurrent();
   bool     anyModified = false;

   for(int k = 0; k < candCount; k++)
     {
      int curTicket = candTickets[k];
      if(!OrderSelect(curTicket, SELECT_BY_TICKET, MODE_TRADES))
         continue;
      if(OrderCloseTime() != 0 || OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int oType = OrderType();
      if(oType != OP_BUY && oType != OP_SELL)
         continue;
      if(OrderLots() <= minFloorLots + 1e-8)
         continue;

      string rawComment = OrderComment();
      string effComment = GetEffectiveOrderComment(curTicket, rawComment);
      bool   isRevOrder = (StringFind(effComment, "RECOVERY_") == 0 && StringFind(effComment, "_REV") >= 0);
      if(!InpAdverseStep100AllOrders && !isRevOrder)
         continue;

      int rootTicket = ResolveRootTicketFromPartialChain(curTicket, rawComment);
      if(rootTicket <= 0)
         rootTicket = curTicket;

      int origParentTicket = (StringFind(effComment, "RECOVERY_") == 0) ? GetRecoveryOrderParentTicket(curTicket, effComment) : 0;

      int guardLoops = 0;
      while(guardLoops < 25)
        {
         guardLoops++;
         if(!OrderSelect(curTicket, SELECT_BY_TICKET, MODE_TRADES))
            break;
         if(OrderCloseTime() != 0 || OrderType() != oType)
            break;

         RefreshRates();
         double openPrice = OrderOpenPrice();
         double curPrice  = (oType == OP_BUY) ? Bid : Ask;
         double curLots   = OrderLots();
         double curNetPL  = OrderProfit() + OrderSwap() + OrderCommission();
         if(curPrice <= 0.0 || openPrice <= 0.0 || curLots < minLot - 1e-8)
            break;
         if(curLots <= minFloorLots + 1e-8)
            break;

         double adverseDistance = (oType == OP_BUY) ? (openPrice - curPrice) : (curPrice - openPrice);
         if(adverseDistance + 1e-6 < stepRaw)
            break;

         int targetStep   = (int)MathFloor((adverseDistance + 1e-6) / stepRaw);
         int lastDoneStep = GetReverse100AdverseCutStep(rootTicket);
         if(targetStep <= lastDoneStep)
            break;

         double maxCutAboveFloor = NormalizeDouble(curLots - minFloorLots, lotDigits);
         if(maxCutAboveFloor < minLot - 1e-8)
           {
            if(!InpReverse100AdverseStepCloseLast)
               break;
            maxCutAboveFloor = NormalizeDouble(curLots, lotDigits);
           }

         double closeLot = stepLots;
         if(closeLot > maxCutAboveFloor + 1e-8)
            closeLot = maxCutAboveFloor;
         closeLot = NormalizeDouble(MathFloor((closeLot + 1e-9) / lotStep) * lotStep, lotDigits);
         if(closeLot < minLot - 1e-8)
            break;

         double remAfter = NormalizeDouble(MathMax(0.0, curLots - closeLot), lotDigits);
         if(remAfter < minFloorLots - 1e-8 && !InpReverse100AdverseStepCloseLast)
            break;
         if(remAfter > 1e-8 && remAfter < minLot - 1e-8)
            break;

         int    nextStep       = lastDoneStep + 1;
         double stepTriggerRaw = nextStep * stepRaw;
         double estSlicePL     = (curLots > 0.0) ? (curNetPL * (closeLot / curLots)) : curNetPL;
         color  closeClr       = InpReverse100StepCutIconColor;
         string reasonPrefix   = isRevOrder ? "REV100" : "STEP100";

         RecordOrderCloseReason(curTicket, StringFormat("%s_STEP%d_%.0f_PARTIAL", reasonPrefix, nextStep, stepTriggerRaw));

         ResetLastError();
         g_eqDdForceCloseBudget = true;
         bool closedOk = SafeOrderCloseMarket(curTicket, closeLot, Slippage, closeClr);
         g_eqDdForceCloseBudget = false;

         if(!closedOk)
           {
            if(g_rev100StepCutFailLogTime == 0 || (nowServer - g_rev100StepCutFailLogTime) >= 10)
              {
               g_rev100StepCutFailLogTime = nowServer;
               PrintFormat(">>> [STEP100 >%.2fL -$%.0f #%d FAIL] #%d (Root #%d, '%s', %.2fL cut %.2fL) | Adv=$%.2f | Err=%d",
                           minFloorLots, stepRaw, nextStep, curTicket, rootTicket, effComment,
                           curLots, closeLot, adverseDistance, GetLastError());
              }
            break;
           }

         int closedTicket = curTicket;
         anyModified = true;
         SetReverse100AdverseCutStep(rootTicket, nextStep);
         g_rev100StepCutTotalCuts++;
         g_rev100StepCutTotalLots     += closeLot;
         g_rev100StepCutLastHitTime    = (nowServer > 0 ? nowServer : TimeCurrent());
         g_rev100StepCutLastRecTicket  = rootTicket;
         g_rev100StepCutLastStep       = nextStep;
         g_rev100StepCutLastAdvGap     = adverseDistance;

         int nextTicket = -1;
         if(remAfter >= minLot - 1e-8)
           {
            // Locate MT4 "from #<closedTicket>" child ticket and preserve original comment mapping
            for(int r = OrdersTotal() - 1; r >= 0; r--)
              {
               if(!OrderSelect(r, SELECT_BY_POS, MODE_TRADES))
                  continue;
               if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
                  continue;
               int rType = OrderType();
               if(rType != OP_BUY && rType != OP_SELL)
                  continue;
               int    rTkt  = OrderTicket();
               string rComm = OrderComment();
               if(rTkt != closedTicket && StringFind(rComm, "from #" + IntegerToString(closedTicket)) >= 0)
                 {
                  RegisterPreservedOrderComment(rTkt, effComment);
                  nextTicket = rTkt;
                  break;
                 }
              }
            if(nextTicket <= 0)
              {
               if(OrderSelect(closedTicket, SELECT_BY_TICKET, MODE_TRADES) && OrderCloseTime() == 0 && OrderLots() >= minLot - 1e-8)
                 {
                  RegisterPreservedOrderComment(closedTicket, effComment);
                  nextTicket = closedTicket;
                 }
              }
           }
         else
            if(!isTestRun)
              {
               string gvKey = Reverse100StepGvKey(rootTicket);
               if(GlobalVariableCheck(gvKey))
                  GlobalVariableDel(gvKey);
              }

         DrawReverse100StepCutIcon(closedTicket, rootTicket, origParentTicket, oType, nextStep, adverseDistance, stepTriggerRaw, closeLot, remAfter, openPrice, curPrice, estSlicePL, isRevOrder, nowServer);

         PrintFormat(">>> [STEP100 >%.2fL -$%.0f #%d CUT] %s #%d (Root #%d, '%s') | Lots %.2fL -> Cut %.2fL, Rem %.2fL (Next #%d) | Open=%s Close=%s | AdvGap=$%.2f >= $%.0f | EstPL=%s$%.2f",
                     minFloorLots, stepRaw, nextStep, (oType == OP_BUY ? "BUY" : "SELL"),
                     closedTicket, rootTicket, effComment,
                     curLots, closeLot, remAfter, MathMax(0, nextTicket),
                     DoubleToString(openPrice, Digits), DoubleToString(curPrice, Digits),
                     adverseDistance, stepTriggerRaw,
                     (estSlicePL >= 0.0 ? "+" : "-"), MathAbs(estSlicePL));

         if(nextTicket <= 0 || remAfter <= minFloorLots + 1e-8)
            break;

         curTicket = nextTicket;
        }
     }

   if(anyModified)
     {
      InvalidateOrderCache();
      InvalidateTotalEAOrdersCache();
      LastDashboardUpdateMs = 0;
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
string GetDayProfitLadderGVPrefix() { return "SSL_DPL_" + IntegerToString(AccountNumber()) + "_" + IntegerToString(MagicNumber) + "_" + Symbol() + "_"; }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
string GetDayProfitLadderDateText() { return TimeToString(TimeCurrent(), TIME_DATE); }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
datetime GetDayProfitLadderDate() { return StrToTime(GetDayProfitLadderDateText()); }
void SaveDayProfitLadderState() { return; }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
datetime GetOldestOpenOrderTime()
  {
   datetime oldestTime = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
        {
         if(OrderSymbol() == Symbol() && OrderMagicNumber() == MagicNumber)
           {
            int type = OrderType();
            if(type == OP_BUY || type == OP_SELL)
              {
               if(oldestTime == 0 || OrderOpenTime() < oldestTime)
                  oldestTime = OrderOpenTime();
              }
           }
        }
     }
   return oldestTime;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double GetDayProfitLadderTarget(int stage)
  {
   if(stage <= 0 || DayProfitLadderStartBalance <= 0.0)
      return DayProfitLadderStartBalance;

   double step1 = MathAbs(DayProfitLadder1Percent) / 100.0;
   double step2 = MathAbs(DayProfitLadder2Percent) / 100.0;

   double target1 = DayProfitLadderStartBalance * (1.0 + step1);
   if(stage == 1)
      return target1;

   double subsequentStepAmount = target1 * step2;
   return target1 + (subsequentStepAmount * (stage - 1));
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double GetDayProfitLadderProtection(int stage)
  {
   if(DayProfitLadderStartBalance <= 0.0)
      return 0.0;
   if(stage <= 0)
      return DayProfitLadderStartBalance * (DayProfitInitialProtectionPercent / 100.0);
   double currentTarget = GetDayProfitLadderTarget(stage);
   double lockRatio = (100.0 - DayProfitLadderLockRatio) / 100.0;
   return currentTarget * lockRatio;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void InitializeDayProfitLadder()
  {
   DayProfitLadderDate = GetDayProfitLadderDate();
   DailyProtectionStartTime = TimeCurrent();
   DayProfitLadderStartBalance = AccountBalance();
   DayProfitLadderStartEquity  = AccountEquity();
   DayProfitLadderStage = 0;
   DayProfitLadderTradingStopped = false;
   DayProfitLadderTargetReachedCandle = 0;
   DayProfitLadderResumePending = false;
   DayProfitLadderResumeDirection = 0;
   DayProfitLadderResumeTradeAttempt = false;
   DayProfitLadderTargetCleanupPending = false;
   DayProfitLadderNextTargetEquity = GetDayProfitLadderTarget(1);
   DayProfitLadderProtectionEquity = DayProfitLadderStartBalance * (1.0 - DayProfitInitialProtectionPercent / 100.0);
   DayProfitLadderInitialized = true;
   SaveDayProfitLadderState();
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void LoadDayProfitLadderState() { InitializeDayProfitLadder(); }
//+------------------------------------------------------------------+
//| Close and delete orders whose direction does not match EMADirection|
//+------------------------------------------------------------------+
void CloseAndDeleteNonEmaMatchingOrders()
  {
   int nonMatchingPendingTickets[1000];
   int nonMatchingPendingCount = 0;

   int nonMatchingOpenTickets[1000];
   int nonMatchingOpenCount = 0;

// 1. Scan and filter open and pending orders
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int type = OrderType();
      bool isPending = (type == OP_BUYSTOP || type == OP_SELLSTOP || type == OP_BUYLIMIT || type == OP_SELLLIMIT);
      bool isMarket  = (type == OP_BUY || type == OP_SELL);

      if(isMarket)
        {
         bool isBuy = (type == OP_BUY);
         // Check if market order direction matches EMADirection (Buy needs EMADirection == 1, Sell needs EMADirection == -1)
         bool matchesEma = (isBuy && EMADirection == 1) || (!isBuy && EMADirection == -1);

         if(!matchesEma && nonMatchingOpenCount < 1000)
           {
            nonMatchingOpenTickets[nonMatchingOpenCount++] = OrderTicket();
           }
        }
      else
         if(isPending)
           {
            bool isBuyPending = (type == OP_BUYSTOP || type == OP_BUYLIMIT);
            bool matchesEma = (isBuyPending && EMADirection == 1) || (!isBuyPending && EMADirection == -1);

            if(!matchesEma && nonMatchingPendingCount < 1000)
              {
               nonMatchingPendingTickets[nonMatchingPendingCount++] = OrderTicket();
              }
           }
     }

// 2. Close non-matching open market orders
   for(int k = 0; k < nonMatchingOpenCount; k++)
     {
      int ticket = nonMatchingOpenTickets[k];
      if(!OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int type = OrderType();
      if(type != OP_BUY && type != OP_SELL)
         continue;

      double lots = OrderLots();
      SafeOrderClose(ticket, lots, type, Slippage, (type == OP_BUY ? clrRed : clrBlue));
     }

// 3. Delete non-matching pending orders
   for(int p = 0; p < nonMatchingPendingCount; p++)
     {
      int pendingTicket = nonMatchingPendingTickets[p];
      if(!OrderSelect(pendingTicket, SELECT_BY_TICKET, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      SafeOrderDelete(pendingTicket, clrRed);
     }
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void CloseAndDeleteAllEAOrdersOnTradingStop()
  {

   Print("CloseAndDeleteAllEAOrdersOnTradingStop");

   int freshPendingTickets[1000];
   int freshPendingCount = 0;
   for(int i=OrdersTotal()-1; i>=0; i--)
     {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES))
         continue;
      if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber)
         continue;
      int type=OrderType();
      if(type==OP_BUYSTOP || type==OP_SELLSTOP || type==OP_BUYLIMIT || type==OP_SELLLIMIT)
        {
         if(freshPendingCount < 1000)
            freshPendingTickets[freshPendingCount++]=OrderTicket();
        }
     }
   int freshOpenTickets[1000];
   int freshOpenCount=0;
   for(int j=OrdersTotal()-1; j>=0; j--)
     {
      if(!OrderSelect(j,SELECT_BY_POS,MODE_TRADES))
         continue;
      if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber)
         continue;
      int marketType=OrderType();
      if(marketType==OP_BUY || marketType==OP_SELL)
        {
         if(freshOpenCount < 1000)
            freshOpenTickets[freshOpenCount++]=OrderTicket();
        }
     }
   for(int k=0; k<freshOpenCount; k++)
     {
      int ticket=freshOpenTickets[k];
      if(!OrderSelect(ticket,SELECT_BY_TICKET,MODE_TRADES))
         continue;
      if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber)
         continue;
      int type=OrderType();
      if(type!=OP_BUY && type!=OP_SELL)
         continue;
      double lots=OrderLots();
      SafeOrderClose(ticket,lots,type,Slippage,(type==OP_BUY ? clrRed : clrBlue));
     }
   for(int p=0; p<freshPendingCount; p++)
     {
      int pendingTicket=freshPendingTickets[p];
      if(!OrderSelect(pendingTicket,SELECT_BY_TICKET,MODE_TRADES))
         continue;
      if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber)
         continue;
      int pendingType=OrderType();
      if(pendingType!=OP_BUYSTOP && pendingType!=OP_SELLSTOP && pendingType!=OP_BUYLIMIT && pendingType!=OP_SELLLIMIT)
         continue;
      SafeOrderDelete(pendingTicket,clrRed);
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool CloseAllEAOrdersForLadderReset()
  {
   bool anyRemaining = false;
   int marketTickets[1000];
   int marketCount = 0;
   int pendingTickets[1000];
   int pendingCount = 0;
   if(DayProfitLadderCleanupStartTime > 0)
     {
      if((int)(TimeCurrent() - DayProfitLadderCleanupStartTime) >= LADDER_CLEANUP_TIMEOUT_SECONDS)
        {
         DayProfitLadderCleanupStartTime = 0;
         return true;
        }
     }
   else
      DayProfitLadderCleanupStartTime = TimeCurrent();

   for(int i=OrdersTotal()-1; i>=0; i--)
     {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES))
         continue;
      if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber)
         continue;
      int type=OrderType();
      if(type==OP_BUY || type==OP_SELL)
        {
         if(marketCount<1000)
            marketTickets[marketCount++]=OrderTicket();
        }
      else
         if(type==OP_BUYSTOP || type==OP_SELLSTOP || type==OP_BUYLIMIT || type==OP_SELLLIMIT)
           {
            if(pendingCount<1000)
               pendingTickets[pendingCount++]=OrderTicket();
           }
     }
   for(int m=0; m<marketCount; m++)
     {
      int ticket=marketTickets[m];
      if(!OrderSelect(ticket,SELECT_BY_TICKET,MODE_TRADES))
         continue;
      if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber)
         continue;
      int type=OrderType();
      if(type!=OP_BUY && type!=OP_SELL)
         continue;
      double lots=OrderLots();
      if(!SafeOrderClose(ticket,lots,type,Slippage,(type==OP_BUY ? clrRed : clrBlue)))
         anyRemaining=true;
     }
   for(int q=0; q<pendingCount; q++)
     {
      int ticket=pendingTickets[q];
      if(!OrderSelect(ticket,SELECT_BY_TICKET,MODE_TRADES))
         continue;
      if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber)
         continue;
      int type=OrderType();
      if(type!=OP_BUYSTOP && type!=OP_SELLSTOP && type!=OP_BUYLIMIT && type!=OP_SELLLIMIT)
         continue;
      if(!SafeOrderDelete(ticket,clrRed))
         anyRemaining=true;
     }
   for(int j=OrdersTotal()-1; j>=0; j--)
     {
      if(!OrderSelect(j,SELECT_BY_POS,MODE_TRADES))
         continue;
      if(OrderSymbol()==Symbol() && OrderMagicNumber()==MagicNumber)
        {
         anyRemaining=true;
         break;
        }
     }
   if(anyRemaining)
      return false;
   DayProfitLadderCleanupStartTime = 0;
   return true;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool CreateDayProfitLadderPending(int direction)
  {
   if(InpEnableCustomRules && !PassesUserRules(direction == OP_BUY ? OP_BUY : OP_SELL))
      return false;
   if(!EnableTrading || DayProfitLadderTradingStopped)
      return false;
   if(direction!=OP_BUY && direction!=OP_SELL)
      return false;
   if(ServerRecoveryPending || !IsConnected() || GetTotalEAOrders() >= MaxOpenOrders)
      return false;
   RefreshRates();
   int pendingType=(direction==OP_BUY) ? OP_BUYSTOP : OP_SELLSTOP;
   double minimumGap=GetRequiredStopDistance();
   double gap=MathAbs(ProfitReEntryGapRaw);
   if(gap<minimumGap)
      gap=minimumGap;
   double entryPrice=0.0;
   if(direction==OP_BUY)
      entryPrice=Ask+gap;
   else
      entryPrice=Bid-gap;
   entryPrice=NormalizeDouble(entryPrice,Digits);
   reEntryCounter=0;
   SaveReEntryCounter();
   ChangeLots(0.0, direction==OP_BUY ? "Day Ladder Buy Stop" : "Day Ladder Sell Stop", direction, 0);
   Lots=NormalizeLots(Lots);
   if(Lots<=0.0)
      return false;
   double slDistance = (StopLossRawPriceGap > 0.0) ? StopLossRawPriceGap : 3000.0;
   double tpDistance = (TakeProfitRawPriceGap > 0.0) ? TakeProfitRawPriceGap : 500.0;

   double stopLoss=(direction==OP_BUY) ? (entryPrice-slDistance) : (entryPrice+slDistance);
   stopLoss=NormalizeDouble(stopLoss,Digits);
   double takeProfit = (direction == OP_BUY) ? (entryPrice + tpDistance) : (entryPrice - tpDistance);
   takeProfit = NormalizeDouble(takeProfit, Digits);
   string comment=(direction==OP_BUY) ? "Day Ladder Buy Stop" : "Day Ladder Sell Stop";
   color orderColor=(direction==OP_BUY) ? BuyColor : SellColor;
   int ticket=SafeOrderSend(Symbol(), pendingType, Lots, entryPrice, Slippage, stopLoss, takeProfit, comment, MagicNumber, orderColor);
   if(ticket<0)
      return false;
   InvalidateTotalEAOrdersCache();
   return true;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void ManageDayProfitLadder()
  {
   if(!EnableDayProfitLadder)
      return;

   double equity = AccountEquity();
   double balance = AccountBalance();

   datetime oldestOrderTime = GetOldestOpenOrderTime();
   if(oldestOrderTime > 0)
     {
      int openDurationSeconds = (int)(TimeCurrent() - oldestOrderTime);
      if(openDurationSeconds >= 7200)
        {
         double previousTarget = (DayProfitLadderStage == 0) ? DayProfitLadderStartBalance : GetDayProfitLadderTarget(DayProfitLadderStage);
         double nextTarget = GetDayProfitLadderTarget(DayProfitLadderStage + 1);
         double requiredLegProfit = nextTarget - previousTarget;
         double halfTargetEquity = previousTarget + (requiredLegProfit * 0.5);

         if(equity >= halfTargetEquity)
           {
            Print("TACTICAL EXIT: 2 Hours elapsed & 50% of leg target reached ($", DoubleToString(equity, 2), "). Closing stale orders.");
            // CloseAndDeleteAllEAOrdersOnTradingStop();
            return;
           }
        }
     }

   if(DayProfitLadderStage > 0)
     {
      double targetEquity = GetDayProfitLadderTarget(DayProfitLadderStage);
      double targetProfit = targetEquity - DayProfitLadderStartBalance;

      if(targetProfit > 0)
        {
         double lockedProfitAmount = targetProfit * (PeakProfitLockPercent / 100.0);
         double dynamicEquityFloor = DayProfitLadderStartBalance + lockedProfitAmount;

         if(AccountEquity() <= dynamicEquityFloor)
           {
            Print("Target Profit Lock Hit! Stage: ", DayProfitLadderStage, " | Target: $", targetEquity, " | Equity dropped below $", dynamicEquityFloor, ". Flattening trades.");
            CloseAndDeleteAllEAOrdersOnTradingStop();
            InitializeDayProfitLadder();
            return;
           }
        }
     }

   datetime today = GetDayProfitLadderDate();
   if(!DayProfitLadderInitialized)
     {
      InitializeDayProfitLadder();
      return;
     }

   if(DayProfitLadderDate != today)
     {
      if(GetEAFloatingPL() >= 0.0)
        {
         InitializeDayProfitLadder();
         return;
        }
     }

   if(DayProfitLadderTradingStopped)
     {
      CloseAndDeleteAllEAOrdersOnTradingStop();
      return;
     }

   if(DayProfitLadderStartBalance <= 0.0)
      return;

   int checkStage = DayProfitLadderStage + 1;
   while(equity >= GetDayProfitLadderTarget(checkStage))
     {
      checkStage++;
     }

   int reachedStage = checkStage - 1;
   if(reachedStage > DayProfitLadderStage)
     {
      DayProfitLadderStage = reachedStage;
      DayProfitLadderTargetReachedCandle = Time[0];
      DayProfitLadderResumeDirection = GlobalSSLDirection;
      if(DayProfitLadderResumeDirection == 0)
         DayProfitLadderResumeDirection = LastLiveSSLDirection;
      DayProfitLadderTargetCleanupPending = true;
      DayProfitLadderResumePending = (DayProfitLadderResumeDirection != 0);

      DayProfitLadderProtectionEquity = GetDayProfitLadderProtection(DayProfitLadderStage);
      DayProfitLadderNextTargetEquity = GetDayProfitLadderTarget(DayProfitLadderStage + 1);
      SaveDayProfitLadderState();
     }

   if(equity <= DayProfitLadderProtectionEquity)
     {
      DayProfitLadderTradingStopped = true;
      DayProfitLadderTargetReachedCandle = 0;
      DayProfitLadderResumePending = false;
      DayProfitLadderResumeDirection = 0;
      DayProfitLadderResumeTradeAttempt = false;
      DayProfitLadderTargetCleanupPending = false;
      SaveDayProfitLadderState();
      CloseAndDeleteAllEAOrdersOnTradingStop();
      for(int dpl_i=0; dpl_i<MAX_DEFERRED_ORDERS; dpl_i++)
         DeferredActive[dpl_i]=false;
      EquityResetReEntryPending=false;

      ReEntryRetryPending=false;
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsDayProfitLadderTradingAllowed()
  {
   if(!EnableDayProfitLadder)
      return true;
   ManageDayProfitLadder();
   if(DayProfitLadderTradingStopped)
      return false;
   return true;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void InitializeDailyProtectionState(DailyProtectionState &state)
  {
   ManageDayProfitLadder();
   state.DayDate = DayProfitLadderDate;
   state.DayStartBalance = DayProfitLadderStartBalance;
   state.DayProtectedBalance = DayProfitLadderProtectionEquity;
   state.ClosedOrdersToday = CountClosedOrdersSinceInitialization();
   state.TradingStopped = DayProfitLadderTradingStopped;
   state.Initialized = true;
   DailyProtectionStartTime = TimeCurrent();
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void StartProtectedEquityWait()
  {
   ProtectedEquityWaitActive = true;
   ProtectedEquityWaitStartTime = TimeCurrent();
   EquityResetReEntryPending = false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
bool IsProtectedEquityWaiting()
  {
   if(!ProtectedEquityWaitActive)
      return false;
   datetime resumeTime = ProtectedEquityWaitStartTime + ProtectedEquityWaitMinutes * 60;
   if(TimeCurrent() < resumeTime)
      return true;
   ProtectedEquityWaitActive = false;
   return false;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int GetProtectedEquityWaitSeconds()
  {
   if(!ProtectedEquityWaitActive)
      return 0;
   int remaining = (int)((ProtectedEquityWaitStartTime + ProtectedEquityWaitMinutes * 60) - TimeCurrent());
   if(remaining < 0)
      remaining = 0;
   return remaining;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
string GetProtectedEquityWaitText()
  {
   int seconds = GetProtectedEquityWaitSeconds();
   return StringFormat("%02d:%02d:%02d", seconds/3600, (seconds%3600)/60, seconds%60);
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void QueueEquityResetReEntry()
  {
   EquityResetReEntryPending = true;
   OrderCreatedThisCandle = false;
   LastOrderCandleTime = 0;
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void ProcessEquityResetReEntry(DailyProtectionState &state)
  {
   if(!EquityResetReEntryPending || !EnableTrading || IsDailyTradingStopped(state) || Bars < SSLPeriod + 20)
      return;
   if(GetTotalEAOrders() > 0)
     {
      EquityResetReEntryPending = false;
      return;
     }
   if(GetTotalEAOrders() >= MaxOpenOrders)
      return;

   int currentDirection = GlobalSSLDirection;
   if(currentDirection > 0)
     {
      OrderCreatedThisCandle = false;
      LastOrderCandleTime = 0;
      DrawLiveSignal(0, true);
      int beforeOrders = GetTotalEAOrders();
      OpenBuy();
      int afterOrders = GetTotalEAOrders();
      if(afterOrders > beforeOrders)
        {
         EquityResetReEntryPending = false;
         TradeResetThisTick = true;
        }
      return;
     }
   if(currentDirection < 0)
     {
      OrderCreatedThisCandle = false;
      LastOrderCandleTime = 0;
      DrawLiveSignal(0, false);
      int beforeOrders = GetTotalEAOrders();
      OpenSell();
      int afterOrders = GetTotalEAOrders();
      if(afterOrders > beforeOrders)
        {
         EquityResetReEntryPending = false;
         TradeResetThisTick = true;
        }
      return;
     }
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void UpdateDailyLossProtection(DailyProtectionState &state)
  {
   if(!EnableDayProfitLadder)
      return;
   state.DayDate = DayProfitLadderDate;
   state.DayStartBalance = DayProfitLadderStartBalance;
   state.DayProtectedBalance = DayProfitLadderProtectionEquity;
   state.TradingStopped = DayProfitLadderTradingStopped;
   state.ClosedOrdersToday = CountClosedOrdersSinceInitialization();
  }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int CountClosedOrdersSinceInitialization()
  {
   int count = 0;
   if(DailyProtectionStartTime <= 0)
      return 0;
   for(int i = OrdersHistoryTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_HISTORY))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;
      if((OrderType() != OP_BUY && OrderType() != OP_SELL) || OrderCloseTime() <= DailyProtectionStartTime)
         continue;
      count++;
     }
   return count;
  }

bool IsDailyTradingStopped(DailyProtectionState &state) { return EnableDayProfitLadder && DayProfitLadderTradingStopped; }

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void DeleteOppositePendingOrders(int newSignalType)
  {
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int orderType = OrderType();

      // FIXED: EMA Direction must be opposite (-1 for OP_BUY, 1 for OP_SELL)
      bool deleteOrder = ((newSignalType == OP_BUY && orderType == OP_SELLSTOP && EMADirection == -1) ||
                          (newSignalType == OP_SELL && orderType == OP_BUYSTOP && EMADirection == 1));

      if(deleteOrder)
         SafeOrderDelete(OrderTicket(), clrYellow);
     }
  }
//+------------------------------------------------------------------+
//| Close opposite profitable orders on SSL signal + EMA condition   |
//+------------------------------------------------------------------+
void CloseOppositeProfitableOrdersOnSignal(int newSignalType)
  {
   if(!EAStartupComplete)
      return;

   RefreshRates();

// 1. Calculate current EMA and local direction
   double ema = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, 0);
   int localEmaDirection = 0;

   if(ema > 0)
     {
      if(Bid > ema)
         localEmaDirection = 1;      // Bullish EMA
      else
         if(Bid < ema)
            localEmaDirection = -1;   // Bearish EMA
     }

// 2. Loop through open orders
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int orderType = OrderType();
      int ticket = OrderTicket();
      double lots = OrderLots();
      double orderPL = OrderProfit() + OrderSwap() + OrderCommission();

      // Calculate profit threshold: $0.25 per 0.01 lot step
      double profitThreshold = 0.25 * (lots / 0.01);

      // Check if the order is opposite to the incoming signal
      bool isOppositeSignal = ((newSignalType == OP_BUY && orderType == OP_SELL) ||
                               (newSignalType == OP_SELL && orderType == OP_BUY));

      if(isOppositeSignal)
        {
         // SCENARIO A: Sell order is open, EMA is Bullish (1), new signal is Buy
         bool isSellOpenBullishEma = (orderType == OP_SELL && localEmaDirection == 1 && newSignalType == OP_BUY);

         // SCENARIO B: Buy order is open, EMA is Bearish (-1), new signal is Sell
         bool isBuyOpenBearishEma  = (orderType == OP_BUY && localEmaDirection == -1 && newSignalType == OP_SELL);

         // If either conflicting condition matches and the order has crossed the profit threshold
         if((isSellOpenBullishEma || isBuyOpenBearishEma) && orderPL >= profitThreshold)
           {
            Print("PROFITABLE OPPOSITE CLOSE: Ticket #", ticket, " | Type: ", GetOrderTypeText(orderType),
                  " | Profit: $", DoubleToString(orderPL, 2), " | Reaching threshold ($", DoubleToString(profitThreshold, 2), ")");

            SafeOrderClose(ticket, lots, orderType, Slippage, (orderType == OP_BUY ? clrRed : clrBlue));
           }
        }
     }
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void CloseOppositeOrders(int newSignalType)
  {
   if(!EAStartupComplete)
      return;
   RefreshRates();

// 1. Calculate EMA and True Direction instantly on this exact tick
   double ema = iMA(Symbol(), Period(), InpEMA200Period, InpEMAPriceShift, MODE_EMA, PRICE_CLOSE, 0);
   int localEmaDirection = 0;

   if(ema > 0)
     {
      if(Bid > ema)
         localEmaDirection = 1;
      else
         if(Bid < ema)
            localEmaDirection = -1;
     }

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int orderType = OrderType();
      int ticket = OrderTicket();
      double lots = OrderLots();
      double orderPL = OrderProfit() + OrderSwap() + OrderCommission();
      double profitThreshold = 0.25 * (lots / 0.01);

      bool isOppositeSignal = ((newSignalType == OP_BUY && orderType == OP_SELL) ||
                               (newSignalType == OP_SELL && orderType == OP_BUY));

      if(isOppositeSignal)
        {
         // 2. Use localEmaDirection for absolute precision
         bool emaMatchesOrder = ((orderType == OP_BUY && localEmaDirection == 1) ||
                                 (orderType == OP_SELL && localEmaDirection == -1));

         bool emaMatchesSignal = ((newSignalType == OP_BUY && localEmaDirection == 1) ||
                                  (newSignalType == OP_SELL && localEmaDirection == -1));

         if(emaMatchesOrder)
           {
            // Instead of closing, lock the SL at the profit threshold
            if(orderPL > profitThreshold)
              {
               double tickValue = MarketInfo(Symbol(), MODE_TICKVALUE);
               double tickSize  = MarketInfo(Symbol(), MODE_TICKSIZE);

               if(tickValue > 0 && tickSize > 0)
                 {
                  // Convert USD profit threshold into raw price distance
                  double lockDistance = (profitThreshold / (tickValue * lots)) * tickSize;
                  double newSL = 0.0;

                  if(orderType == OP_BUY)
                    {
                     newSL = NormalizeDouble(OrderOpenPrice() + lockDistance, Digits);
                     // Only modify if the current SL is lower than the new SL or doesn't exist
                     if(OrderStopLoss() == 0 || newSL > OrderStopLoss())
                       {
                        Print("OPPOSITE SIGNAL: Locking Buy profit at threshold SL.");
                        SafeOrderModify(ticket, OrderOpenPrice(), newSL, OrderTakeProfit(), 0, clrLimeGreen);
                       }
                    }
                  else
                     if(orderType == OP_SELL)
                       {
                        newSL = NormalizeDouble(OrderOpenPrice() - lockDistance, Digits);
                        // Only modify if the current SL is higher than the new SL or doesn't exist
                        if(OrderStopLoss() == 0 || newSL < OrderStopLoss())
                          {
                           Print("OPPOSITE SIGNAL: Locking Sell profit at threshold SL.");
                           SafeOrderModify(ticket, OrderOpenPrice(), newSL, OrderTakeProfit(), 0, clrTomato);
                          }
                       }
                 }
              }
           }
         else
            if(emaMatchesSignal)
              {
               // Close immediately if distance > 100
               double currentPrice = (orderType == OP_BUY) ? Bid : Ask;
               double distanceToEma = MathAbs(currentPrice - ema);

               if(distanceToEma > 100.0)
                 {
                  Print("CLOSE EXECUTED: Fighting EMA & SSL + Distance > 100.");
                  SafeOrderClose(ticket, lots, orderType, Slippage, (orderType==OP_SELL ? clrRed : clrBlue));
                 }
              }
        }
     }
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
int GetOrderDirection(int orderType)
  {
   if(orderType == OP_BUY || orderType == OP_BUYSTOP || orderType == OP_BUYLIMIT)
      return 1;
   if(orderType == OP_SELL || orderType == OP_SELLSTOP || orderType == OP_SELLLIMIT)
      return -1;
   return 0;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void CloseOppositeOrdersold2(int newSignalType)
  {
   if(!EAStartupComplete)
      return;
   RefreshRates();
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != Symbol() || OrderMagicNumber() != MagicNumber)
         continue;

      int orderType = OrderType();
      int ticket = OrderTicket();
      double lots = OrderLots();
      double orderPL = OrderProfit() + OrderSwap() + OrderCommission();
      double profitThreshold = 0.25 * (lots / 0.01);

      // 1. Check if the order is opposite to the new SSL signal
      bool isOppositeSignal = ((newSignalType == OP_BUY && orderType == OP_SELL) ||
                               (newSignalType == OP_SELL && orderType == OP_BUY));

      if(isOppositeSignal)
        {
         // 2. ONLY close if it has reached the profit threshold.
         // If it is below the threshold, it is ignored and left running.
         if(orderPL > profitThreshold)
           {
            SafeOrderClose(ticket, lots, orderType, Slippage, (orderType==OP_SELL ? clrRed : clrBlue));
           }
        }
     }
  }
