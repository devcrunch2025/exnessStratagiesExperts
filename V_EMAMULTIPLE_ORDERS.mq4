int    InpEqDdMaxTier                     = 9;      // Highest tier (9 = 90% DD -> reduce 90% of order lots)
double InpEqDdTier1Pct                    = 10.0;   // Tier 1 DD%: Side Loss >= 10% of Balance -> reduce 10% of lots
double InpEqDdTier1CutPct                 = 10.0;   // Tier 1 Lot Reduction % of order lots (min 0.01)
double InpEqDdTier2Pct                    = 20.0;   // Tier 2 DD%: Equity >= 20% below Balance -> reduce 20% of lots
double InpEqDdTier2CutPct                 = 20.0;   // Tier 2 Lot Reduction % of order lots (min 0.01)
double InpEqDdTier3Pct                    = 30.0;   // Tier 3 DD%: Equity >= 30% below Balance -> reduce 30% of lots
double InpEqDdTier3CutPct                 = 30.0;   // Tier 3 Lot Reduction % of order lots (min 0.01)
double InpEqDdTier4Pct                    = 40.0;   // Tier 4 DD%: Equity >= 40% below Balance -> reduce 40% of lots
double InpEqDdTier4CutPct                 = 40.0;   // Tier 4 Lot Reduction % of order lots (min 0.01)
double InpEqDdTier5Pct                    = 50.0;   // Tier 5 DD%: Equity >= 50% below Balance -> reduce 50% of lots
double InpEqDdTier5CutPct                 = 50.0;   // Tier 5 Lot Reduction % of order lots (min 0.01)
bool   InpEqDdEnableCloseAll              = false;  // Disabled: continue partial cuts instead of full Close-All
double InpEqDdCloseAllPct                 = 100.0;  // Close-All threshold (inactive while InpEqDdEnableCloseAll=false)
double InpEqDdMinCutLots                  = 0.01;   // Minimum partial close lot size (0.01)
double InpEqDdMinOrderLossUSD             = 5.0;    // Min per-order net loss ($5 * mult) required before EQ-DD cuts an order (ignores entry spread)
bool   InpEqDdOneShotPerTier              = true;   // Latch each DD tier once per drawdown cycle (wait for next 10% step or Equity >= Balance reset)
bool   InpEqDdResetAllOnNewDay            = true;   // Reset ALL EQ-DD status, tier locks, cuts, peaks & history on fresh Dubai day (00:00 GST)
bool   InpDrawEqDdHitIcon                 = true;   // Draw chart icon with DD% when Drawdown % tier hits
int    InpEqDdHitIconCode                 = 171;    // Chart icon Wingdings code (171=star, 238=shield, 159=dot, 251=check)
int    InpEqDdHitFontSize                 = 10;     // Chart icon text font size

// ===== HOURLY 1-HOUR PER-SIDE ENGINE: PLAN A (1H DAY EQ >5% CLOSE ALL), PLAN B (1H SIDE LOSS >20% CUT 20% LOT - OFF), PLAN C (30M/15M DAY EQ >10% CLOSE ALL), PLAN D (1M 15->90% HR-RESET CLOSE ALL) =====
bool   InpEnableHourlySideLossCut         = true;   // Run Hourly Profit Close Engine: Plan A (1H >5%), Plan C (30M >10%), Plan D (1M 15-90% HrReset) [Plan B Loss Cut controlled below]
int    InpHourlySideLossIntervalMinutes   = 60;     // Plan A/B execution interval in minutes (60 = every 1 hour)
bool   InpEnableHourlyPlanADayProfitClose = true;   // Plan A: If Day Equity Profit > 5% vs Dubai 00:00 opening equity, close ALL open orders (every 1 hour)
double InpHourlyPlanADayProfitPct         = 5;//10;//1;//5.0;    // Plan A: Day equity profit threshold % (> 5.0%, e.g. $500 -> >$525)
bool   InpHourlyPlanAOncePerDay           = false;  // Plan A repeat mode: false = evaluate every 1 hour without daily lock (true = max 1x/Dubai day)
color  InpHourlyPlanAIconColor            = clrLime;// Plan A: Chart icon & label color when Hour Target HIT (Day Equity >5%) executes
bool   InpDrawHourlyPlanAIcon             = true;   // Plan A: Draw chart icon & label whenever 1H Hour Target HIT (DayEq >5%) triggers
bool   InpDrawHourlyPlanAIconWhenFlat     = true;   // Plan A: Also draw Hour Target HIT chart icon when triggered with 0 open orders
int    InpHourlyPlanAIconCode             = 171;    // Plan A: Chart icon Wingdings code (171=star, 251=check, 238=shield)
bool   InpEnableHourlyPlanBSideLossCut    = true;//false;  // Plan B: DISABLED (1H Per-Side Floating Loss >20% Cut 20% LOT - profit closes only)
double InpHourlySideLossThresholdPct      = 20.0;   // Plan B: Floating loss % of Balance trigger (> 20.0%, BUY and SELL evaluated separately)
double InpHourlySideLossCutPct            = 20.0;   // Plan B: Percentage of each losing order's lots to close (20% LOT)
double InpHourlySideLossMinLot            = 0.01;   // Plan B: Minimum partial-close lot step & minimum preserved remaining order lot (0.01)
bool   InpDrawHourlySideLossIcon          = true;   // Plan B: Draw chart icon & label when 1-Hour 20% side loss cut executes
int    InpHourlySideLossIconCode          = 238;    // Chart icon Wingdings code (238=shield, 171=star, 251=check)
color  InpHourlySideLossIconColor         = clrOrangeRed; // Plan B: Chart icon & text color for 1H side loss cut
int    InpHourlySideLossIconFontSize      = 10;     // Chart icon text font size
bool   InpEnableHourlyPlanCDayProfitClose = true;   // Plan C (Extra): Check every 15 min; if Day Equity Profit > 10% vs Dubai 00:00 opening equity, close ALL open orders
int    InpHourlyPlanCIntervalMinutes      = 30;//15;     // Plan C execution interval in minutes (15 = every 15 minutes)
double InpHourlyPlanCDayProfitPct         = 5;//10;//3.0;   // Plan C: Day equity profit threshold % (> 10.0%, e.g. $500 -> >$550)
bool   InpHourlyPlanCOncePerDay           = false;  // Plan C repeat mode: false = evaluate every 15 min without daily lock (true = max 1x/Dubai day)
color  InpHourlyPlanCIconColor            = clrGold;// Plan C: Chart icon & label color when 15M Plan C (DayEq >10%) executes
bool   InpDrawHourlyPlanCIcon             = true;   // Plan C: Draw chart icon & label whenever 15M Plan C (>10% Close All) executes
int    InpHourlyPlanCIconCode             = 252;    // Plan C: Chart icon Wingdings code (252=checkmark, 171=star, 238=shield)
bool   InpEnableHourlyPlanDDayProfitClose = false;//true;//false;//true;   // Plan D (Extra): Check every 1 min (1st min >31%, 2nd >32%, ..., 60th >90%); close ALL & reset every 1h
int    InpHourlyPlanDIntervalSeconds      = 60;     // Plan D check interval in seconds (60 = every 1 minute)
int    InpHourlyPlanDCycleMinutes         = 60;     // Plan D hourly reset cycle in minutes (60 = reset at top of every hour back to min 1)
double InpHourlyPlanDStartPct             = 5;//10;//6;//15.0;   // Plan D: 1st minute (:00) Day equity profit threshold % (> 21.0%)
double InpHourlyPlanDStepPerMinPct        = 1.0;    // Plan D: Minute step increment % (+1.0% per min -> min 2 >32%, ..., min 59 >89%, min 60 >90%)
double InpHourlyPlanDMaxPct               = 90.0;   // Plan D: Maximum threshold cap % at 60th minute (> 90.0%)
bool   InpHourlyPlanDOncePerHour          = true;   // Plan D repeat mode (Option 3): true = trigger max 1x/hour then wait for :00 hourly reset (false = repeat inside hour)
bool   InpHourlyPlanDOncePerDay           = false;  // Plan D daily lock: false = reset and re-arm every 1 hour (true = max 1x/Dubai day)
color  InpHourlyPlanDIconColor            = clrDeepSkyBlue; // Plan D: Chart icon & label color when 1M Plan D (>31%..90%) executes
bool   InpDrawHourlyPlanDIcon             = true;   // Plan D: Draw chart icon & label whenever 1M Plan D executes
int    InpHourlyPlanDIconCode             = 119;    // Plan D: Chart icon Wingdings code (119=diamond, 171=star, 252=check, 238=shield)

// ===== PRICE GAP (>1000 RAW FROM EMA FLIP / UPDATED ANCHOR) & DAY EQUITY PROFIT (>5%) CLOSE ALL =====
bool   InpEnablePriceGapDayProfitClose    = true;    // Close ALL open orders if |MarketPrice - Anchor| > 1000 raw AND Day Equity Profit > 5%
double InpPriceGapCloseRawGap             = 1000.0;  // Minimum raw price change (> 1000.0) from active EMA flip price / updated anchor
double InpPriceGapCloseDayProfitPct       = 5.0;     // Minimum Day Equity Profit % vs Dubai 00:00 opening equity (> 5.0%)
bool   InpDrawPriceGapCloseIcon           = true;    // Draw chart icon & label when >1000 raw gap & >5% day equity close-all executes
int    InpPriceGapCloseIconCode           = 119;     // Chart icon Wingdings code (119=diamond, 171=star, 238=shield)
color  InpPriceGapCloseIconColor          = clrAqua; // Chart icon & label color
int    InpPriceGapCloseIconFontSize       = 10;      // Chart icon text font size

// ===== ADVERSE PRICE-CHANGE STEP LOSS CUTTER (RUNAWAY TREND STEP-BY-STEP PROTECTION) =====
bool   InpEnableAdversePriceStepLossCut    = false;//true;      // Monitor market change & cut losing orders step-by-step on runaway trends
double InpStepLossRawGap                   = 3000.0;    // Normal mode: Adverse raw price move per step cut (3000.0)
double InpStepLossActivateSidePct          = 10.0;      // Activate step-cutting when BUY-only or SELL-only loss > 10.0% of Balance
double InpStepLossCutPct                   = 20.0;      // Normal mode: % of each >0.01L losing order's lots to close per step (20%)
int    InpStepLossMinLotClosePerStep       = 1;         // Normal mode: Worst losing 0.01L order(s) to full-close per step (1)
double InpStepLossEmergencyDdPct           = 30.0;      // Emergency trigger: Equity drawdown > 30.0% of Balance accelerates step cuts
double InpStepLossEmergencyRawGap          = 4000;//2000.0;    // Emergency mode: Faster adverse price step (2000.0 raw) when Equity DD > 30%
double InpStepLossEmergencyCutPct          = 35.0;      // Emergency mode: Stronger partial-close % on >0.01L losing orders (35%)
int    InpStepLossEmergMinLotClosePerStep  = 2;         // Emergency mode: Worst losing 0.01L order(s) to full-close per step (2)
double InpStepLossMinLot                   = 0.01;      // Minimum lot size step & preserved partial floor (0.01)
double InpStepLossMinOrderLossUSD          = 1.0;       // Min per-order net loss ($1.00) so fresh spread trades are skipped
bool   InpDrawAdverseStepLossIcon          = true;      // Draw chart icon & label when adverse price step loss cut executes
int    InpAdverseStepLossIconCode          = 226;       // Chart icon Wingdings code (226=down arrow, 238=shield, 171=star)
color  InpAdverseStepLossIconColor         = clrOrange; // Chart icon color (Normal mode; Emergency uses clrRed)
int    InpAdverseStepLossIconFontSize      = 10;        // Chart icon text font size

// ===== EQL / EQH STRUCTURAL RECOVERY (TYPE 2) SETTINGS =====
bool   InpEnableLsdStructuralRecovery       = true;  // Enable EQL/EQH Structural Recovery (Type 2)
bool   InpAllowRecoveryForHorizontalOrders  = false; // Do not create recovery order for Horizontal line orders (default: false)
double InpLsdRecoveryMinAdverseGap          = 100.0; // Min adverse distance ($100 raw) from parent entry to allow recovery
double InpLsdRecoveryTriggerLossUSD         = 1.0;   // Min loss in USD (>$1.00) on parent order to allow recovery
double InpLsdRecoveryLevelToleranceRaw      = 50.0;  // Max raw distance ($50) from EQL/EQH line to trigger recovery
double InpLsdRecoveryLotMultiplier          = 2.0;   // Recovery lot multiplier (2x parent lot)
double InpLsdRecoveryBasketProfitUSD        = 0.50;  // Net profit target in USD (>$0.50) to close parent + recovery basket
double InpLsdRecoveryStopLossRaw            = 3000;//300.0; // StopLoss raw points ($300) for Type 2 Recovery order
double InpLsdRecoveryTakeProfitRaw          = 3000;//500.0; // TakeProfit raw points ($500) for Type 2 Recovery order
int    InpLsdRecoveryMaxActiveOrders        = 1;     // Max simultaneous active Type 2 Recovery orders (default 1)

// ===== WEAK EMA REVERSAL RECOVERY (TYPE 3) SETTINGS =====
bool   InpEnableType3Recovery               = false; // Disabled by user request (Weak EMA Reversal Recovery)
int    InpType3MaxElapsedMinutes            = 240;   // Max elapsed minutes after EMA flip (240 min = 4 hours, 0 = unlimited)
bool   InpType3EnableDynamicTimeLadder      = true;  // Enable dynamic EMA distance step ladder based on elapsed hours
double InpType3GapHour1                     = 100.0; // Step 1 - Hour 1 (<= 60 min): Min raw gap ($100) from live price to EMA
double InpType3GapHour2                     = 200.0; // Step 2 - Hour 2 (60 - 120 min): Min raw gap ($200) from live price to EMA
double InpType3GapHour3                     = 300.0; // Step 3 - Hour 3 (120 - 180 min): Min raw gap ($300) from live price to EMA
double InpType3GapHour4                     = 500.0; // Step 4 - Hour 4 (180 - 240 min): Min raw gap ($500) from live price to EMA
double InpType3GapHour5Plus                 = 700.0; // Step 5 - Hour 5+ (> 240 min): Min raw gap ($700) from live price to EMA
double InpType3MinAdverseGap                = 200.0; // Min adverse distance ($200 raw) from parent entry (Mode 1 trigger)
double InpType3MinEmaDistanceRaw            = 100.0; // Min raw distance ($100 raw gap) between live price and EMA
double InpType3TriggerLossUSD               = 2.0;   // Min loss in USD (>$2.00) on parent order (Mode 1 trigger)
double InpType3LotMultiplier                = 2.0;   // Recovery lot multiplier (2x parent lot)
double InpType3BasketProfitUSD              = 1.0;   // Net profit target in USD ($1.00) to close parent + recovery basket
double InpType3StopLossRaw                  = 3000;//300.0; // StopLoss raw points ($300) for Type 3 Recovery order
double InpType3TakeProfitRaw                = 5000.0; // TakeProfit raw points ($500) for Type 3 Recovery order
int    InpType3MaxActiveOrders              = 1;     // Max simultaneous active Type 3 Recovery orders (default 1)

// ===== RECOVERY ATTEMPT SHIELD SETTINGS =====
bool   InpEnableRecoveryAttemptShield       = true;  // Enable Strict 1-Attempt Limit per Parent Order Lifetime
int    InpRecoveryMaxAttemptsPerParent      = 1;     // Max recovery order attempts per parent (Strictly 1)

// ===== TREND-SHIFT HEDGE RECOVERY SETTINGS =====
bool   InpEnableHedgeRecovery               = false; // Replaced by 1-Time >$100 Opposite 2X Reverse Order (VMULTI-1147)
double InpHedgeRecoveryMinLossUSD           = 2.0;   // Min loss in USD (>$2.00) on parent order to allow hedge recovery
double InpHedgeRecoveryMinAdverseGap        = 150.0; // Min adverse distance ($150 raw) from parent entry
int    InpHedgeRecoveryMinElapsedMin        = 15;    // Min elapsed minutes after trend flip confirming new trend
double InpHedgeRecoveryLotMultiplier        = 2.0;   // Hedge recovery lot multiplier (2.0x parent lot)
double InpHedgeRecoveryBasketProfitUSD      = 2.0;   // Net profit target in USD ($2.00) to close parent + hedge basket
double InpHedgeRecoveryStopLossRaw          = 3000;//300.0; // StopLoss raw points ($300) for Hedge Recovery order
double InpHedgeRecoveryTakeProfitRaw        = 5000.0; // TakeProfit raw points ($500) for Hedge Recovery order
int    InpHedgeRecoveryMaxActiveOrders      = 1;     // Max simultaneous active Hedge Recovery orders (default 1)

// ===== $100 ADVERSE OPPOSITE 2X REVERSE ORDER (1-TIME PER ORDER) =====
bool   InpEnableReverse100Order             = false;//true;  // Enable 2X opposite reverse order when any losing order moves > $100 raw opposite (once per order)
double InpReverse100MinAdverseGap           = 100.0; // Strict raw opposite price move required (> 100.0: BUY Open-Bid > 100, SELL Ask-Open > 100)
double InpReverse100MinLossUSD              = 0.0;   // Minimum floating loss USD (strictly < -MinLossUSD, 0.0 = any negative floating net P/L)
double InpReverse100LotMultiplier           = 2.0;   // Opposite reverse order lot multiplier (2.0 = 2X parent open lot)
int    InpReverse100MaxActiveOrders         = 2;     // Max simultaneous active _REV reverse orders allowed at a time (1-2 recommended)
double InpReverse100BasketProfitUSD         = 2.0;   // Combined Parent + 2X Reverse basket net profit target ($2.00) via ManageRecoveryBasket
double InpReverse100StopLossRaw             = 3000.0;// Initial StopLoss raw distance ($3000)
double InpReverse100TakeProfitRaw           = 5000.0; // Initial TakeProfit raw distance ($500)
bool   InpReverse100IncludeHorizontal       = true;  // Include Horizontal line orders (EQH / EQL) as qualifying parents
bool   InpReverse100IncludeFlipSupport      = false; // Exclude internal non-horizontal FLIPBasketSupport orders (default false)
bool   InpReverse100SkipPartialClosed       = false;//true;  // Do not create _REV recovery orders for partially closed orders (comments like "from #...")
bool   InpReverse100EnableAdverseStepClose  = false;//true;  // Partial-close 0.01 lot every $100 adverse move (loss direction) on orders with LOT > 0.05
bool   InpAdverseStep100AllOrders           = true;  // Apply $100 step 0.01 partial close to ALL open orders with LOT > 0.05 (false = _REV only)
double InpReverse100AdverseStepMinLots      = 0.02;  // Keep >0.05L floor: only cut orders with LOT > 0.05 and stop once remaining <= 0.05
double InpReverse100AdverseStepRaw          = 1000;//500;//100.0; // Adverse raw price step per partial close ($100, $200, $300...)
double InpReverse100AdverseStepLots         = 0.01;  // Fixed lot size to partial-close per adverse $100 step (0.01)
bool   InpReverse100AdverseStepCloseLast    = false; // Stop at >0.05 floor (false = never close remaining <=0.05L)
bool   InpDrawReverse100StepCutIcon         = true;  // Draw chart marker & label when a $100 adverse step 0.01 partial close executes
color  InpReverse100StepCutIconColor        = clrOrangeRed; // Chart icon & label color for $100 adverse step partial close
bool   InpDrawReverse100Icon                = true;  // Draw chart arrow & label when a $100 2X Reverse order opens
color  InpReverse100BuyIconColor            = clrDeepSkyBlue; // Chart icon & label color for 2X BUY Reverse order
color  InpReverse100SellIconColor           = clrMagenta;     // Chart icon & label color for 2X SELL Reverse order
int    InpReverse100IconFontSize            = 9;     // Chart label font size

// ===== AGING REVERSAL GAP REDUCTION SETTINGS =====
bool   InpEnableAgingGapReduction          = true;  // Enable gap reduction for stagnant underwater baskets
int    InpAgingGapElapsedMinutes           = 30;    // Minutes since latest order to trigger reduction (30 min)
double InpAgingGapReductionMultiplier      = 0.5;   // Gap reduction multiplier (0.5 = half base order gap)
bool   InpAgingGapRequireTrendConfirmation = true;  // Only reduce gap when SSL/Price confirms momentum in trade direction

// ===== 500 TO 2000 DYNAMIC OSCILLATION & MOMENTUM ENGINE =====
bool   InpEnableOscillationEngine          = true;   // Enable Dynamic 500-2000 Oscillation & Momentum Engine
int    InpOscillationLookbackBars          = 720;    // Rolling lookback bars for range detection (720 M1 = 12h)
double InpOscillationTightThreshold        = 800.0;  // Upper bound for Tight Compression regime ()
double InpOscillationStandardThreshold     = 1500.0; // Upper bound for Standard Oscillation regime (,500)
double InpOscillationMacroThreshold        = 2200.0; // Upper bound for Macro Oscillation regime (,200)

// Boundary Asymmetry Filter (The 35/65 Rule)
bool   InpEnableBoundaryAsymmetryFilter    = true;   // Restrict BUYs at ceiling and SELLs at floor inside oscillation
double InpBoundaryCeilingPercent           = 65.0;   // Above 65% of box: SELL bias only (block new BUYs)
double InpBoundaryFloorPercent             = 35.0;   // Below 35% of box: BUY bias only (block new SELLs)

// Adaptive Grid Gap Scaling (R / 8)
bool   InpEnableAdaptiveGridGap            = true;   // Dynamically scale base order gap to range width (R / 8)
double InpAdaptiveGridGapMin               = 40.0;   // Minimum adaptive order gap ( in tight ranges)
double InpAdaptiveGridGapMax               = 200.0;  // Maximum adaptive order gap ( in wide ranges)

// Dynamic Basket Profit Harvest
double InpTightRangeTargetUSD              = 1.0;    // Basket profit target in tight compression (.00)
double InpStandardRangeTargetUSD           = 2.0;    // Basket profit target in standard oscillation (.00)
double InpMacroRangeTargetUSD              = 3.5;    // Basket profit target in macro oscillation (.50)

// ===== TESTER / LIVE ORDER LOGGER SETTINGS =====
bool   InpEnableOrderLogger                 = true;                    // Enable detailed CSV & Log file order reporting
string InpTesterLogFileName                 = "Tester_Order_Analysis.csv";  // Strategy Tester CSV log filename
string InpTesterSummaryFileName             = "Tester_Summary_Analysis.txt";// Strategy Tester TXT summary filename
string InpLiveLogFileName                   = "Live_Order_Analysis.csv";    // Live Trading CSV log filename
string InpLiveSummaryFileName               = "Live_Summary_Analysis.txt";  // Live Trading TXT summary filename

bool   InpLogToCommonFolder                 = true;                    // Also write to Common\Files folder (accessible outside tester)

